    "types": "node scripts/schema-extract.mjs && ./studio/node_modules/.bin/sanity typegen generate",
    "images": "node scripts/optimize-images.mjs",
    "shots": "node scripts/shots.mjs",
    "intro": "node scripts/intro.mjs",
