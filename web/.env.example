# Veröffentlichbare Werte — PUBLIC_ landet bewusst im Browser-Bundle.
PUBLIC_SANITY_PROJECT_ID=a6bjftwf
PUBLIC_SANITY_DATASET=production

# Lesetoken für Entwürfe (Vorschau). Rechte: Viewer genügt.
#
# OHNE `PUBLIC_`-Präfix — mit ihm backte Astro ihn ins ausgelieferte
# JavaScript, und der Token stünde im Quelltext jeder Seite.
#
# Der Name muss genau so lauten; `lib/vorschau.ts` liest ihn zuerst über
# `process.env` und erst dann über `import.meta.env`.
# SANITY_API_READ_TOKEN=

# Adresse des veröffentlichten Studios. Nur nötig, wenn es veröffentlicht
# ist — sonst greift http://localhost:3333. Stega springt beim Klick in der
# Vorschau dorthin.
# PUBLIC_SANITY_STUDIO_URL=
