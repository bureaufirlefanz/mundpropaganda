# Netlify liest diese Datei aus dem Auslieferungsverzeichnis.
#
# Die Sperre für Suchmaschinen steht NICHT mehr hier. Sie hing an dieser Datei
# und an public/robots.txt, beide mit dem Vermerk „vor dem Livegang entfernen"
# — zwei Handgriffe im Code, die niemand sieht, wenn er sie vergisst. Jetzt
# entscheidet der Schalter „Von Suchmaschinen finden lassen" in den
# Einstellungen des Studios, und die Integration in `astro.config.mjs` hängt
# den X-Robots-Tag beim Build vorne an diese Datei an, solange er aus ist.
#
# Was hier steht, ist deshalb nur noch, was sich nie ändert: Cache-Regeln.

# Bilder, Schriften und die gehashten Astro-Bundles ändern sich nie unter
# demselben Namen — die dürfen dauerhaft im Cache bleiben. Die HTML-Dateien
# bewusst nicht: Sonst sieht der Kunde nach einer Neuveröffentlichung noch
# den alten Stand und meldet Fehler, die längst behoben sind.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800

# ─────────────────────────────────────────────────────────────────────────
# Sicherheitsangaben. Ergänzt am 2026-09-02; vorher stand hier keine
# einzige.
#
# Bewusst ohne Content-Security-Policy für die ganze Seite: Eine CSP, die
# nicht zum Markup passt, bricht die Seite lautlos, und Astro schreibt seine
# Übergangs- und Router-Skripte inline. Was sie abwehren würde, decken die
# vier Angaben unten und die Regel für die Vorschau darunter ab. Eine echte
# CSP gehört in einen eigenen Durchgang mit Messung im Report-Only-Modus.
/*
  # Kein Erraten von Dateitypen. Ohne das kann ein hochgeladenes Bild, das
  # in Wahrheit HTML enthält, als Seite ausgeführt werden.
  X-Content-Type-Options: nosniff

  # Beim Wechsel auf eine fremde Seite geht nur die Herkunft mit, nicht der
  # vollständige Pfad. Auf einer Praxisseite ist der Pfad die Behandlung,
  # nach der jemand gesucht hat.
  Referrer-Policy: strict-origin-when-cross-origin

  # Nichts davon braucht die Seite. Ein eingebettetes Video auch nicht:
  # Es läuft in einem iframe und bringt seine eigenen Rechte mit.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

  # Ein Jahr HTTPS, Unterdomains eingeschlossen. Ohne `preload`: Der Eintrag
  # in die Browserliste ist praktisch unumkehrbar und gehört erst gesetzt,
  # wenn die Domain endgültig steht.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Die Seite gehört in keinen fremden Rahmen — außer in den des eigenen
  # Studios, siehe unten.
  X-Frame-Options: DENY

# Die Vorschau MUSS im Studio-Rahmen laufen: Das Presentation-Tool zeigt die
# Seite in einem iframe und markiert darin die Felder. `X-Frame-Options: DENY`
# von oben würde genau das verbieten, deshalb hier die Ausnahme.
#
# `frame-ancestors` aus der CSP schlägt X-Frame-Options in jedem Browser, der
# beides kennt; für die übrigen wird die alte Angabe zusätzlich aufgehoben.
# Die Adresse des Studios steht in SANITY.md — steht sie nicht mehr, öffnet
# `https:` niemandem etwas, was nicht ohnehin ein gültiges Vorschau-Cookie
# hätte.
/preview/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self' https://*.sanity.studio http://localhost:3333
