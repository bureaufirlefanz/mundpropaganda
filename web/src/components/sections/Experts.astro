---
import Button from "../ui/Button.astro";
import Picture from "../ui/Picture.astro";
import CmsImage from "../ui/CmsImage.astro";
import { istCmsBild, type Bildquelle } from "../../lib/bilder";

/**
 * Teamfoto links, Text rechts.
 *
 * `absaetze` war bis Aufgabe 4 eine Prop mit zwei fest eingebauten Absätzen,
 * die niemand je übergab — im Studio stand daneben ein Feld `expertenText`,
 * das die Seite nie durchreichte. Der Kunde konnte es füllen, ohne dass sich
 * etwas änderte. Beides ist zusammengeführt: Das Feld heißt jetzt
 * `expertenAbsaetze`, ist ein Array wie bei Split und landet hier.
 */
interface Props {
  titel: string;
  namen: string;
  absaetze: string[];
  bild?: Bildquelle;
}

const { titel, namen, absaetze, bild } = Astro.props;
---

<!-- ==================================================================
           UNSERE EXPERTEN
           ================================================================== -->
      <section class="s-experts" id="experten">
        <!-- Bild sitzt links und läuft über den Seitenrand hinaus, der Text
             steht rechts auf einer schmalen Spalte — so im Entwurf. -->
        <div class="s-experts__media" data-reveal="fade">
          {istCmsBild(bild) ? (
            <CmsImage quelle={bild} alt={namen.replace(/\n/g, " ")} widths={[640, 1024, 1600]} sizes="(max-width: 900px) 100vw, 62vw" data-parallax="9" />
          ) : (
            <Picture name="experten" alt="Dr. Hannes Schulte-Ostermann und Dr. Kerrin Gratecap" sizes="(max-width: 900px) 100vw, 62vw" parallax="9" />
          )}
        </div>

        <div class="container grid">
          <div class="s-experts__body">
            <h2 class="s-experts__title" data-split="lines">{titel}</h2>
            {/* Zeilenumbrüche aus dem CMS übernehmen: Die Namenszeile ist
                gesetzt, nicht umgebrochen — sie soll da brechen, wo die
                Redaktion es schreibt. */}
            <p class="s-experts__names" data-reveal="up" data-reveal-trigger=".s-experts" set:html={namen.split("\n").join("<br />")} />
            {absaetze.map((x, i) => (
              <p data-reveal="up" data-reveal-delay={0.06 + i * 0.06} data-reveal-trigger=".s-experts">{x}</p>
            ))}
          </div>
        </div>
      </section>

<style>
  /* Großes Teamfoto links, Text rechts.
     Entwurfsmaße: Bild x=-47…1017 (läuft links über den Rand), Textspalte
     ab x=1154 mit 386px Breite. Deshalb kein Grid, sondern ein absolut
     gesetztes Bild und eine Textspalte, die im Container rechts andockt. */
  .s-experts {
    position: relative;
    min-height: clamp(560px, 53vw, 916px);
    padding-block: var(--section-space);
  }

  .s-experts__media {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -2.7%;
    width: 61.6%;
    border-radius: 0 var(--r-md) var(--r-md) 0;
    overflow: hidden;
  }

  /* :global(img), weil das Bild aus Picture.astro kommt. */
  .s-experts__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Spalte 9 bis 11 des Zwölfer-Rasters — im Entwurf beginnt der Text bei
     x=1154 und endet bei 1541, also drei Spalten breit mit einer freien
     Spalte zum rechten Rand. Vorher stand er per margin-left:auto bündig am
     Rand und lag damit neben dem Raster. */
  .s-experts__body {
    position: relative;
    z-index: 1;
    grid-column: 9 / 12;
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    padding-top: var(--sp-6);
  }

  .s-experts__title {
    font-size: clamp(2rem, 3.7vw, 4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .s-experts__names {
    font-size: var(--fs-text-large);
    font-weight: 500;
    line-height: 1.2;
  }

  .s-experts__body p {
    font-size: var(--fs-text-main);
    color: var(--c-text-muted);
    line-height: 1.45;
  }

  .s-experts__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
  }

  @media (max-width: 900px) {
    .s-experts {
      min-height: 0;
      display: flex;
      flex-direction: column;
      gap: var(--sp-8);
    }

    .s-experts__media {
      position: static;
      width: auto;
      aspect-ratio: 4 / 3;
      margin-right: var(--site-margin);
    }

    .s-experts__body {
      grid-column: 1 / -1;
      max-width: 46ch;
      padding-inline: var(--site-margin);
    }
  }
</style>
