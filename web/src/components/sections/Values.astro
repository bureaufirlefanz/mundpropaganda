---
/**
 * Die Haltung der Praxis: drei bis fünf Punkte, jeder mit einem Wie.
 *
 * Als dunkles Band über die volle Fensterbreite. Das ist keine Dekoration,
 * sondern die Gliederung: Die Praxisseite hat sonst fünf helle Abschnitte
 * hintereinander, und ohne einen Farbwechsel dazwischen liest sie sich als
 * eine einzige lange Spalte. Dieselbe Rolle wie das Band auf der
 * Leistungsseite, nur ohne dessen Bildbühne.
 *
 * Große Ziffern statt Symbolen. Eine Haltung mit Piktogrammen bebildert
 * auszustatten macht sie zur Broschüre — die Ziffer ordnet und behauptet
 * nichts.
 *
 * Jeder Punkt hat Pflicht-Text. Eine Überschrift wie „Ehrlichkeit" allein
 * ist eine Floskel; erst das Wie darunter macht sie überprüfbar. Deshalb ist
 * das Feld im Schema Pflicht und nicht wahlfrei.
 */
interface Value {
  title: string;
  text: string;
}

interface Props {
  topline: string;
  headline: string;
  text?: string;
  items: Value[];
}

const { topline, headline, text, items } = Astro.props;
---

<section class="s-values" data-surface="dark">
  <div class="container s-values__inner">
    <div class="s-values__head">
      <span class="c-topline s-values__topline" data-reveal="fade"
        >{topline}</span
      >
      <h2 class="s-values__title" data-split="lines">{headline}</h2>
      {
        text && (
          <p class="s-values__text" data-reveal="up" data-reveal-delay="0.1">
            {text}
          </p>
        )
      }
    </div>

    <ol class="s-values__list" data-reveal-stagger="0.08">
      {
        items.map((w, i) => (
          <li class="s-values__item" data-reveal-child>
            <span class="c-number s-values__number" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="s-values__item-title">{w.title}</h3>
            <p class="s-values__item-text">{w.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Randlos über die volle Fensterbreite. Die 50vw-Konstruktion bricht aus
     dem zentrierten Raster aus, ohne die Section aus dem Fluss zu nehmen —
     dieselbe wie beim Band der Leistungsseite. */
  .s-values {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block: var(--section-space);
    padding-block: clamp(100px, 11vw, 200px);
    background: var(--c-dark);
    color: var(--c-text);
  }

  .s-values__head {
    max-width: 46ch;
    margin-bottom: var(--flow-xl);
  }

  /* Die Topline ist auf hellem Grund gedacht; auf dem dunklen Band braucht
     sie die Markenfarbe, sonst verschwindet sie. */
  .s-values__topline {
    color: var(--c-brand);
  }

  .s-values__title {
    max-width: 18ch;
    margin-top: var(--sp-4);
    font-size: var(--fs-title);
    font-weight: var(--fw-medium);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
  }

  .s-values__text {
    max-width: var(--measure-text);
    margin-top: var(--sp-5);
    font-size: var(--fs-text-main);
    line-height: var(--lh-text);
    /* The dark surface maps `--c-text-muted` to light grey at 65 %. */
    color: var(--c-text-muted);
  }

  /* `auto-fit` mit Mindestbreite statt fester Spaltenzahl: Der Abschnitt
     trägt drei bis fünf Punkte, und bei vier soll er nicht aussehen, als
     fehle einer. */
  .s-values__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--flow-lg) var(--site-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .s-values__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: var(--sp-5);
    border-top: var(--bw) solid var(--c-line);
  }

  /* Zweistellig mit führender Null und in Mono — die einzige Stelle dieser
     Seite, an der die Monoschrift steht. Sie ist hier eine Kennung und kein
     Fließtext, genau der Fall, für den sie vorgesehen ist. */
  /* War pinke Schrift ohne Fläche: gemessen 1.54:1 gegen den Seitengrund,
     also praktisch unlesbar. Als Kreis mit brauner Ziffer sind es 5.5:1.
     Siehe `.c-number` in shared.css — dass er nicht streckt, steht dort. */
  .s-values__number {
    --number-size: 32px;

    margin-bottom: var(--sp-5);
  }

  .s-values__item-title {
    font: var(--font-card-title);
    margin-bottom: var(--sp-3);
    letter-spacing: var(--tracking-card-title);
    text-wrap: balance;
  }

  .s-values__item-text {
    max-width: var(--measure-narrow);
    font-size: var(--fs-text-main);
    line-height: var(--lh-text);
    color: var(--c-text-muted);
  }

  @media (max-width: 900px) {
    .s-values {
      margin-block: var(--section-space-sm);
    }
  }
</style>
