---
/**
 * Die Praxis in eigenen Worten: Text links, Bild rechts, Zahlen darunter.
 *
 * Das Bild klebt beim Scrollen (`position: sticky`) und der Text läuft daran
 * vorbei. Der Grund ist nicht der Effekt, sondern die Lesbarkeit: Zwei
 * Absätze über 60 Zeichen sind auf einem breiten Fenster hoch, und ein Bild,
 * das mit ihnen nach oben verschwindet, lässt die rechte Hälfte auf halber
 * Strecke leer stehen.
 *
 * Kein `sticky` auf schmalen Fenstern — dort stapelt alles, und ein
 * klebendes Bild würde den Text verdecken, den es begleiten soll.
 *
 * Die Zahlen sind wahlfrei. Ohne sie endet der Abschnitt mit dem Text; eine
 * Reihe aus „0 Jahren" und „0 Behandlungen" wäre schlechter als keine.
 */
import CmsImage from "../ui/CmsImage.astro";
import Picture from "../ui/Picture.astro";
import { isCmsImage, type ImageSource } from "../../lib/images";

interface Figure {
  value: string;
  text: string;
}

interface Props {
  topline: string;
  headline: string;
  columns: string[];
  image?: ImageSource;
  figures?: Figure[];
}

const { topline, headline, columns, image, figures } = Astro.props;
---

<section class="s-story container">
  <div class="s-story__text">
    <span class="c-topline" data-reveal="fade">{topline}</span>
    <h2 class="s-story__title" data-split="lines">{headline}</h2>

    {
      columns.map((paragraph, i) => (
        <p
          class="s-story__paragraph"
          data-reveal="up"
          data-reveal-delay={0.08 * (i + 1)}
        >
          {paragraph}
        </p>
      ))
    }

    {
      figures && figures.length > 0 && (
        <dl class="s-story__figures" data-reveal-stagger="0.08">
          {figures.map((z) => (
            <div class="s-story__figure" data-reveal-child>
              {/* <dd> vor <dt> im Markup wäre falsch herum — die Zahl ist der
                Wert, die Erläuterung der Begriff. `flex-direction: column-
                reverse` dreht nur die Darstellung. */}
              <dt class="s-story__figure-label">{z.text}</dt>
              <dd class="s-story__figure-value">{z.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>

  {
    /* Klasse 3 wie überall auf der Seite: Ohne gepflegtes Motiv steht das
      gestaltete Ersatzbild. Ohne diesen Rückfall bricht das zweispaltige
      Raster in sich zusammen — der Text nähme dann die volle Breite und
      liefe auf 58 Zeichen Lesemaß mitten in einer leeren Spalte. */
  }
  <div class="s-story__media">
    <div class="s-story__image" data-reveal="right">
      {
        isCmsImage(image) ? (
          <CmsImage
            source={image}
            alt=""
            widths={[640, 1024, 1600]}
            sizes="(max-width: 900px) 95vw, 78vw"
          />
        ) : (
          <Picture
            name="experten-gespraech-tisch"
            alt=""
            sizes="(max-width: 900px) 95vw, 78vw"
          />
        )
      }
    </div>
  </div>
</section>

<style>
  .s-story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: var(--flow-xl);
    align-items: start;
    padding-block: var(--section-space);
  }

  .s-story__title {
    max-width: 20ch;
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-6);
    font-size: var(--fs-h2);
    font-weight: 400;
    line-height: var(--lh-title);
    letter-spacing: var(--tracking-snug);
  }

  /* 60 Zeichen ist die Grenze, ab der das Auge die nächste Zeile nicht mehr
     sicher findet. Der Absatz bleibt darunter, auch wenn die Spalte breiter
     werden darf. */
  .s-story__paragraph {
    max-width: 58ch;
    font-size: var(--fs-text-main);
    line-height: var(--lh-loose);
  }

  .s-story__paragraph + .s-story__paragraph {
    margin-top: var(--sp-4);
  }

  /* --- Zahlen ----------------------------------------------------------- */

  .s-story__figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr));
    gap: var(--sp-6) var(--sp-5);
    margin: clamp(var(--sp-8), 5vw, var(--sp-10)) 0 0;
  }

  .s-story__figure {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--sp-1);
    padding-top: var(--sp-4);
    border-top: var(--bw) solid var(--c-line);
  }

  .s-story__figure-value {
    margin: 0;
    font-size: var(--fs-h1-xs);
    font-weight: 500;
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tighter);
  }

  .s-story__figure-label {
    font-size: var(--fs-text-small);
    line-height: 1.35;
    color: var(--c-text-muted);
  }

  /* --- Bild ------------------------------------------------------------- */

  /* Der Abstand nach oben ist Absicht: Das Bild setzt eine Stufe unter der
     Topline an, sonst stünden Überschrift und Bildkante auf einer Linie und
     die Spalte sähe aus wie eine Tabelle. */
  .s-story__media {
    position: sticky;
    top: clamp(96px, 12vh, 160px);
    margin-top: clamp(var(--sp-6), 4vw, var(--sp-10));
  }

  .s-story__image {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    /* Skala, nicht Sonderwert: Nur das Kopfbild einer Seite ist stark
       gerundet. Jedes andere Bild nimmt `--r-md`. */
    border-radius: var(--r-md);
    background: var(--c-tint);
  }

  /* :global(img), weil das Bild aus CmsImage.astro kommt. */
  .s-story__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .s-story {
      grid-template-columns: 1fr;
      padding-block: var(--section-space-sm);
    }

    /* Kein Kleben, wenn gestapelt wird — das Bild würde den Text verdecken,
       den es begleiten soll. */
    .s-story__media {
      position: static;
      margin-top: var(--sp-8);
    }

    .s-story__image {
      aspect-ratio: 3 / 2;
    }
  }
</style>
