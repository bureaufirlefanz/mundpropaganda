---
/**
 * "Auf einen Blick" — a compact term/value overview at the top of a service
 * page: duration, cost, durability, anaesthesia.
 *
 * A definition list and not a table: there is no second axis here, only a
 * term and its answer. A table would promise a comparison the content does
 * not have, and screen readers would announce row and column numbers for it.
 *
 * No image on purpose. This block is the answer to the four questions a
 * visitor already has when they arrive, and it has to be readable before
 * anything else on the page has loaded.
 */
interface Props {
  id?: string;
  topline?: string;
  headline?: string;
  /** A value with `href` is a link: a number to dial, a page to open. */
  items: {
    label: string;
    value: string;
    href?: string | null;
    /** Cards only: the sentence between the term and the value. */
    text?: string | null;
  }[];
  /**
   * `list` (default): term and value in a row, the quiet form of the pillar
   * pages. `cards`: one card per item, the value large on top, the term as
   * the line under it. For a page where the values are the point, the
   * emergency page with its numbers.
   */
  variant?: "list" | "cards";
}

const { id, topline, headline, items, variant = "list" } = Astro.props;
---

{
  items.length > 0 && (
    <section
      class:list={[
        "s-quickfacts",
        "container",
        variant === "cards" && "s-quickfacts--cards",
      ]}
      id={id}
    >
      {(topline || headline) && (
        <div class="s-quickfacts__head">
          {topline && (
            <span class="c-topline" data-reveal="fade">
              {topline}
            </span>
          )}
          {headline && (
            <h2 class="s-quickfacts__title" data-split="lines">
              {headline}
            </h2>
          )}
        </div>
      )}

      <dl class="s-quickfacts__list" data-reveal-stagger="0.04">
        {items.map((item) => (
          <div
            class="s-quickfacts__row"
            data-surface={variant === "cards" ? "card" : undefined}
            data-reveal-child
          >
            <dt class="s-quickfacts__label">{item.label}</dt>
            {variant === "cards" && item.text && (
              <dd class="s-quickfacts__text">{item.text}</dd>
            )}
            <dd class="s-quickfacts__value">
              {item.href ? (
                <a class="c-link" href={item.href}>
                  {item.value}
                </a>
              ) : (
                item.value
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

<style>
  .s-quickfacts {
    padding-block: var(--section-space);
  }

  .s-quickfacts__head {
    max-width: 40ch;
    margin-bottom: var(--sp-8);
  }

  .s-quickfacts__title {
    font: var(--font-section-title);
    letter-spacing: var(--tracking-section-title);
    margin-top: var(--sp-4);
  }

  /* Two columns from 700px up. `auto-fit` with a `min(100%, …)` floor keeps
     the rows from being squeezed below their own text width — below the
     breakpoint the same rule already collapses to one column, the media
     query only makes that intent explicit. */
  .s-quickfacts__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 0 var(--site-gutter);
    margin: 0;
  }

  /* The rule sits on top of every row, not below: with an even number of
     rows in two columns the last line would otherwise close only one
     column and leave the block visibly lopsided. */
  /* `fit-content(45%)`, not `max-content`: a long term ("Notdienst nachts und
     am Wochenende") took the whole row as max-content and pushed the value
     out of sight. Now it wraps at under half the row; short terms, the
     usual case, are unaffected. */
  .s-quickfacts__row {
    display: grid;
    grid-template-columns: fit-content(45%) minmax(0, 1fr);
    gap: 0 var(--sp-5);
    padding-block: var(--sp-3);
    border-top: var(--bw) solid var(--c-line);
  }

  .s-quickfacts__label {
    font: var(--font-small);
    color: var(--c-text-muted);
  }

  .s-quickfacts__value {
    margin: 0;
    font-size: var(--fs-text-main);
    line-height: var(--lh-body);
    color: var(--c-text);
  }

  /* --- Cards --------------------------------------------------------------
     Each item on its own card: the term as a short title, the sentence
     under it, the value at the bottom edge, large. Cards in a row end on
     the same line because the value is pushed down with `margin-top: auto`. */
  .s-quickfacts--cards .s-quickfacts__list {
    gap: var(--site-gutter);
  }

  .s-quickfacts--cards .s-quickfacts__row {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-5);
    border-top: 0;
    border-radius: var(--r-md);
    background: var(--c-white);
  }

  .s-quickfacts--cards .s-quickfacts__label {
    font: var(--font-card-title);
    letter-spacing: var(--tracking-card-title);
    color: var(--c-text);
  }

  .s-quickfacts--cards .s-quickfacts__text {
    margin: 0;
    font: var(--font-body);
    color: var(--c-text-muted);
  }

  .s-quickfacts--cards .s-quickfacts__value {
    margin-top: auto;
    padding-top: var(--sp-5);
    font-size: var(--fs-text-large);
    font-weight: var(--fw-medium);
  }

  @media (max-width: 900px) {
    .s-quickfacts {
      padding-block: var(--section-space-sm);
    }
  }

  @media (max-width: 700px) {
    .s-quickfacts__list {
      grid-template-columns: 1fr;
    }
  }
</style>
