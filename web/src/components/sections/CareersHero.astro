---
/**
 * Der Kopf der Karriere- UND der Praxisseite: ein Wort, darunter der Bogen.
 *
 * Zwei Seiten, ein Baustein. Die Praxisseite hatte einen eigenen Kopf
 * (der frühere `PracticeHero`) mit zweispaltigem Text und zwei versetzten
 * Bildern; er ist mit diesem Umbau entfallen. Der
 * ist entfallen: Beide Seiten stellen dieselbe Frage — wo lande ich, und bei
 * wem — und beantworten sie am besten mit einem Wort und einem Raum.
 *
 * Anders als `ServiceHero`, und aus einem Grund: Eine Leistungsseite muss
 * erklären, was sie anbietet — dort trägt der Kopf Topline, Titel und einen
 * Absatz nebeneinander. Die Karriereseite muss zuerst wirken. Wer hier
 * landet, weiß schon, worum es geht; er will sehen, wo er arbeiten würde und
 * mit wem.
 *
 * Deshalb steht hier nur ein Wort, groß und mittig, und darunter das Bild.
 * Der Einstiegstext steht NICHT hier, sondern im Abschnitt darunter, bei der
 * Haltung, zu der er gehört. Ein Absatz zwischen Bild und Überschrift wäre
 * ein dritter Anfang auf derselben Seite.
 *
 * Das Bild ist oben stärker gerundet als unten. Das ist kein Zierrat: Die
 * Linien im Hintergrund (`ToothLines`, aus dem Zahnumriss abgeleitet) laufen
 * als flache Bögen durch die Seite, und ein Bild mit gleicher Rundung an
 * allen vier Ecken stünde quer dazu. So sitzt es in ihnen drin.
 */
import CmsImage from "../ui/CmsImage.astro";
import Picture from "../ui/Picture.astro";
import ToothLines from "../ui/ToothLines.astro";
import { isCmsImage, type ImageSource } from "../../lib/images";

interface Props {
  title: string;
  topline?: string;
  image?: ImageSource;
  alt?: string;
  /**
   * Das gestaltete Ersatzmotiv, solange im Studio keines hängt.
   *
   * Wählbar, seit dieser Kopf auch die Praxisseite trägt: Dort wäre ein
   * Behandlungsbild das falsche Versprechen — man will die Räume sehen, nicht
   * den Stuhl. Voreinstellung bleibt die Karriereseite.
   */
  fallback?: string;
  /**
   * Ob das Bild beim Scrollen auf Vollbild aufzieht.
   *
   * Wahlfrei und aus: Auf der Karriereseite steht der Kopf für sich, dort
   * wäre das eine Bewegung ohne Anlass. Auf der Praxisseite trägt sie den
   * Übergang vom Kopf in die Seite — man fährt in den Raum hinein, in den
   * man kommt.
   */
  zoom?: boolean;
}

const {
  title,
  topline,
  image,
  alt = "",
  fallback = "team-management",
  zoom = false,
} = Astro.props;
---

<section class="s-chero">
  {
    /* Liegt hinter allem und läuft in die folgende Section weiter — dieselbe
      Behandlung wie im Hero der Startseite. */
  }
  <ToothLines />

  <div class="container s-chero__inner">
    {
      topline && (
        <span class="c-topline s-chero__topline" data-reveal="fade">
          {topline}
        </span>
      )
    }

    {
      /* `data-split="lines"` und nicht `chars`: Ein einzelnes Wort in Zeichen
        zerlegt sieht aus wie eine Ladeanimation. */
    }
    <h1 class="s-chero__title" data-split="lines">{title}</h1>

    {
      /* Einblendung NUR ohne Zoom.

       Beide schreiben `transform`, und `reveal.js` fährt am Ende jeder
       Variante `REST` an — darin steht `scale: 1`. Lagen beide auf demselben
       Element, überschrieb die Einblendung den Zoom, sobald sie fertig war:
       Der Maßstab sprang zurück auf 1, das Bild blieb in seinem Kasten.
       Gemessen als `translate(0px, 0px)` in der inline-Angabe, wo
       `scale(1.0588)` stehen sollte.

       Auch `fade` hilft nicht — `REST` gilt für alle Varianten. Deshalb keine
       Einblendung, sondern gar keine: Das Kopfbild steht über der Falz und
       ist von der ersten Sekunde an zu sehen. Seine Bewegung ist der Zoom. */
    }
    <div
      class="s-chero__media"
      data-reveal={zoom ? undefined : "scale"}
      data-chero-zoom={zoom ? "" : undefined}
    >
      {
        isCmsImage(image) ? (
          <CmsImage
            source={image}
            alt={alt}
            widths={[640, 1024, 1600, 2200]}
            sizes="(max-width: 900px) 92vw, 94vw"
            eager
          />
        ) : (
          <Picture
            name={fallback}
            alt={alt}
            sizes="(max-width: 900px) 92vw, 94vw"
            eager
          />
        )
      }
    </div>
  </div>
</section>

<style>
  /* `overflow-x: clip` und nicht `hidden`: Die Linien laufen bewusst über die
     Unterkante in die nächste Section, nur seitlich sollen sie die Seite
     nicht breiter machen. `hidden` erzeugte einen Scrollcontainer und nähme
     dem klebenden Kopf darin seine Wirkung. */
  .s-chero {
    position: relative;
    overflow-x: clip;
    padding-block: var(--page-top) var(--section-space);
  }

  .s-chero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .s-chero__topline {
    margin-bottom: var(--sp-5);
  }

  /* Ein Wort über die Satzbreite. `--fs-display-2` ist die Stufe der
     Wortmarke im Fuß; darüber liegt nur noch der Hero der Startseite. */
  .s-chero__title {
    max-width: 14ch;
    font-size: var(--fs-display-2);
    font-weight: var(--fw-medium);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-tighter);
    text-transform: uppercase;
  }

  /* Der Bogen. Oben rund wie die Linien dahinter, unten nur leicht gebrochen —
     das Bild soll aufsteigen und nicht schweben. */
  .s-chero__media {
    width: 100%;
    margin-top: var(--flow-xl);
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border-radius: clamp(120px, 16vw, 260px) clamp(120px, 16vw, 260px)
      var(--r-lg) var(--r-lg);
    background: var(--c-tint);
  }

  /* :global(img), weil das Bild aus CmsImage.astro bzw. Picture.astro kommt
     und das Scope-Attribut dieser Datei nicht trägt. */
  .s-chero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Das Aufziehen.

     Das Bild sitzt im Fluss und bekommt beim Scrollen einen Maßstab, bis es
     den Bildschirm deckt. Danach läuft die Seite gewöhnlich weiter — es gibt
     kein Pinning, keine Extrastrecke, keine Bühne.

     `transform-origin: center top`: Es soll nach unten und zu den Seiten
     aufmachen, nicht nach oben unter die Navigation schieben.

     `will-change` nur solange nötig — das setzt das Modul, nicht diese Regel:
     eine dauerhafte Kompositionsebene für ein Bild dieser Größe kostet
     Speicher, den man auf einem Telefon merkt. */
  .s-chero__media[data-chero-zoom] {
    /* Oben mittig: Das Bild macht nach unten und zu den Seiten auf und
       schiebt sich nicht nach oben unter die Navigationsleiste. */
    transform-origin: top center;
  }

  /* Ohne Bewegung passiert nichts — der Kopf steht, wie er steht. */
  @media (prefers-reduced-motion: reduce) {
    .s-chero__media[data-chero-zoom] {
      transform: none !important;
    }
  }

  @media (max-width: 900px) {
    .s-chero {
      padding-block: var(--page-top-sm) var(--section-space-sm);
    }

    /* Auf schmalen Fenstern wieder hochformatig: 16:9 auf 390px Breite wäre
       ein 220px hoher Streifen, in dem vom Raum nichts zu erkennen ist. */
    .s-chero__media {
      aspect-ratio: 3 / 4;
      border-radius: clamp(72px, 22vw, 160px) clamp(72px, 22vw, 160px)
        var(--r-md) var(--r-md);
    }
  }
</style>
