---
/**
 * FAQ: Panel-Rahmen plus Akkordeon. Startseite und Leistungsseiten benutzen
 * denselben Baustein, nur mit anderen Fragen.
 */
import Panel from "../ui/Panel.astro";
import Accordion from "../ui/Accordion.astro";
import type { Frage } from "../../lib/formen";

interface Props {
  title: string;
  questions: Frage[];
  topline?: string;
  text?: string;
}

const { title, questions, topline = "FAQ", text } = Astro.props;
---

<Panel id="faq" topline={topline} title={title} text={text}>
  <Accordion questions={questions} />
</Panel>
