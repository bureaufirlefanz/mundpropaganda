---
/**
 * Hero einer Leistungsseite: Text links, randabfallendes Bild rechts.
 *
 * Fährt dieselbe Choreografie wie der Hero der Startseite, nur ohne Zahn —
 * über die data-Attribute, nicht über eigenen Code.
 */
import Button from "../ui/Button.astro";
import CmsImage from "../ui/CmsImage.astro";
import Picture from "../ui/Picture.astro";
import Reviews from "../ui/Reviews.astro";
import ToothLines from "../ui/ToothLines.astro";
import { isCmsImage, type ImageSource } from "../../lib/images";
import { serviceMotif } from "../../lib/service-images";

/* Der Titel trägt den Hero und ist Pflicht. Topline, Fließtext und Bild sind
   wahlfrei (Klasse 2): Eine Leistung, die noch keinen Einstiegstext hat, zeigt
   keinen — bis Aufgabe 4 zeigte sie den einer anderen Behandlung.
   Für das Bild gilt weiter der Rückfall auf das gestaltete Motiv. */
interface Props {
  title: string;
  /** Entscheidet über das Ersatzmotiv. Siehe `lib/service-images.ts`. */
  slug?: string;
  topline?: string;
  /**
   * Wofür die Praxis bei dieser Behandlung steht. Steht anstelle des
   * Leistungsnamens in der Überschrift — siehe `heading` unten.
   *
   * Wahlfrei: Ohne Anspruch trägt die Überschrift weiter den Namen, und alle
   * übrigen Leistungsseiten bleiben unverändert.
   */
  claim?: string;
  text?: string;
  image?: ImageSource;
  alt?: string;
  /** Beschriftung des Buttons. */
  action?: string;
  actionHref?: string;
}

const {
  title,
  slug,
  topline,
  claim,
  text,
  image,
  alt = "",
  action = "Termin buchen",
  actionHref = "#kontakt",
} = Astro.props;

/* Was in der Überschrift steht.
 *
 * Normalerweise der Leistungsname, einzeln und groß. Trägt die Leistung einen
 * Anspruch, steht der stattdessen da — auf der Veneers-Seite „Wir feilen am
 * Lächeln, nicht an der Substanz" statt „VENEERS".
 *
 * `title` bleibt davon unberührt und wird weiter gebraucht: für den
 * Seitentitel, das Angebotsformular, den Magazin-Teaser und die Überschrift
 * der Fragen. Die Topline darüber („Veneers in Berlin") nennt die Behandlung
 * ohnehin weiter beim Namen, der Leistungsname geht also nicht verloren. */
const heading = claim || title;

/* Das längste Wort — und zwar so, wie die Hero-Choreografie es abgrenzt:
   SplitText trennt ausschließlich an Leerzeichen, und die Wort-Container
   tragen `white-space: nowrap` (siehe base.css). Ein Bindestrich ist damit
   KEINE Trennstelle mehr. „Parodontitis-Behandlung" zählt deshalb als 23
   Zeichen, nicht als 12 — genau daran lief die Überschrift zuletzt noch ins
   Bild, als ich den Bindestrich mitgezählt hatte. */
const longestUnit =
  heading
    .split(/\s+/)
    .filter(Boolean)
    .reduce((a, b) => (b.length > a.length ? b : a), "").length || 1;

/* Gemessen, nicht geschätzt: In dieser Schrift belegt ein Versalzeichen
   zwischen 0.562 em („PARODONTITIS“) und 0.639 em („WURZELBEHANDLUNG“) —
   breite Rundungen wie O, B, D, G ziehen den Wert nach oben. Maßgeblich ist
   das Maximum, nicht der Mittelwert: mit 0.62 liefen genau die drei
   breitesten Namen weiter ins Bild. 0.67 sind das Maximum plus 5 % Reserve.

   Daraus der Höchstgrad in Prozent der Spaltenbreite: Bei welchem Grad füllt
   das längste Wort die Spalte gerade aus? Darüber liefe es hinaus — und zwar
   ins Bild rechts daneben, weil nowrap es nicht umbrechen ließ. */
const sizeCap = (100 / (0.67 * longestUnit)).toFixed(2);

/* Klasse 3: das Ersatzmotiv, solange im Studio keines hochgeladen ist. Ohne
   den Rückfall bliebe die halbe Seite weiß, und ein leeres Bildfeld heißt
   „noch nicht hochgeladen", nicht „bewusst gelöscht".

   Hier stand EIN fester Pfad für alle elf Leistungsseiten — jede zeigte
   dasselbe Bild, und keines davon passte zu mehr als einer Leistung. Jetzt
   kommt es aus `lib/service-images.ts`, derselben Quelle, aus der auch die
   Tabelle auf der Startseite liest. Wer dort auf „Bleaching" klickt, findet
   das Bild wieder, das ihn hergebracht hat.

   Veneers ist die eine bewusste Ausnahme von diesem Grundsatz: der Hero
   zeigt `veneers-anprobe` statt `veneers-farbbestimmung` aus der Liste —
   dort wird gelächelt, in der Farbbestimmung nicht. Die Tabelle auf der
   Startseite bleibt unangetastet und zeigt weiter das Listenbild; sie war
   ausdrücklich nicht Teil dieser Änderung. */
const HERO_MOTIF_OVERRIDE: Record<string, string> = {
  veneers: "veneers-anprobe",
};
const MOTIF = (slug && HERO_MOTIF_OVERRIDE[slug]) || serviceMotif(slug);
---

<section class="s-shero container" data-hero>
  <ToothLines />

  <div class="s-shero__body">
    {
      /* Die Überschrift trägt `data-hero-word` — damit greift die
        Hero-Choreografie: der Leistungsname steigt zeichenweise hinter seiner
        Maske auf.

        Topline und Fließtext laufen NICHT über diese Timeline. `hero.js`
        liest `data-hero-meta` zwar aus, lässt die Zeilen dort aber bewusst
        außen vor (siehe den Kommentar vor dem `foot`-Tween) — gebraucht wird
        das Attribut nur noch im Zweig für reduzierte Bewegung, der beide
        Zeilen sofort sichtbar setzt.

        Bewegt werden sie wie der übrige Seiteninhalt: die Topline blendet
        auf, der Fließtext fährt zeilenweise hinter seiner Maske hoch. Dieselbe
        Paarung wie in Benefits.astro. Der Highlight-Marker, der auf der
        Startseite hier steht, wäre zu laut: seine Balken sind der Auftritt
        der Startseite, nicht der einer Unterseite.

        Die Zeiten richten sich nach der Überschrift: die steigt in der
        Timeline von hero.js bei 0.25s an. Die Topline läuft mit ihr zugleich
        los, der Fließtext kurz danach. Vorher standen hier 1.1 und 1.25 —
        die Zeilen kamen erst, als die Überschrift schon fertig stand, und
        der Hero baute sich in drei getrennten Schüben auf. */
    }
    {
      topline && (
        <p
          class="s-shero__topline"
          data-hero-meta
          data-reveal="fade"
          data-reveal-delay="0.25"
        >
          {topline}
        </p>
      )
    }
    <h1
      class:list={["s-shero__title", claim && "s-shero__title--claim"]}
      style={`--shero-cap: ${sizeCap}cqw`}
      data-hero-word
      data-hero-pace={claim ? "quick" : undefined}
    >
      {heading}
    </h1>
    {
      /* Der Fließtext blendet als Ganzes auf und kommt dabei leicht von
        unten — nicht zeilenweise. Zeilenweise war er zu lang dafür: der
        Einstiegstext läuft über fünf bis sechs Zeilen, und die letzte stünde
        eine Dreiviertelsekunde nach der ersten. Ein Absatz, der sich
        zeilenweise aufbaut, wird gelesen wie ein Ladevorgang.

        Er folgt der Topline um 0.15s — zwei Zeilen, die gleichzeitig
        anlaufen, lesen sich als ein Block statt als Folge. */
      text && (
        <p data-hero-meta data-reveal="up" data-reveal-delay="0.4">
          {text}
        </p>
      )
    }

    <div class="s-shero__actions" data-hero-foot>
      <Button label={action} href={actionHref} />
    </div>

    <div class="s-shero__reviews" data-hero-foot>
      <Reviews />
    </div>
  </div>

  <div class="s-shero__media">
    {
      /* LCP-Bild der Seite — deshalb eager. Es füllt die halbe Fensterbreite,
        unter 900px die ganze. */
    }
    {
      isCmsImage(image) ? (
        <CmsImage
          source={image}
          alt={alt}
          widths={[640, 1024, 1600, 2200]}
          sizes="(max-width: 900px) 100vw, 50vw"
          eager
        />
      ) : (
        /* `Picture` und nicht `CmsImage` mit einem Pfad: `serviceMotif` gibt
         einen Motivnamen zurück, keinen fertigen Pfad — und nur `Picture`
         liefert dafür AVIF und WebP samt srcset. Vorher stand hier eine
         einzelne 1600er WebP für alle elf Leistungsseiten. */
        <Picture
          name={MOTIF}
          alt={alt}
          sizes="(max-width: 900px) 100vw, 50vw"
          eager
        />
      )
    }
  </div>
</section>

<style>
  .s-shero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--site-gutter);
    align-items: center;
    padding-top: var(--hero-offset);
    padding-bottom: var(--sp-8);
    overflow: hidden;
  }

  /* Maßbezug für den Grad der Überschrift: `cqw` rechnet gegen die Breite
     dieser Spalte, nicht gegen das Fenster. Nur so lässt sich der Grad so
     deckeln, dass das längste Wort hineinpasst.

     Ohne `max-width: 46ch`: die Fessel galt für die ganze Spalte und damit
     auch für die Überschrift, obwohl das Zeilenmaß nur den Fließtext angeht.
     Der hat seine eigene Begrenzung. Der Überschrift standen dadurch 530px
     statt der vollen 900px zur Verfügung — und je enger die Spalte, desto
     kleiner muss der Grad ausfallen. */
  .s-shero__body {
    position: relative;
    z-index: 1;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .s-shero__topline {
    font-family: var(--f-mono);
    font-weight: var(--fw-light);
    font-size: var(--fs-title-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .s-shero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-5);
    margin-top: var(--sp-3);
  }

  .s-shero__reviews {
    margin-top: var(--sp-8);
  }

  /* Mehrzeilig, wenn nötig — vorher stand hier `white-space: nowrap`. Das
     hielt den Namen zwar auf einer Zeile, ließ ihn aber aus seiner Spalte
     laufen: gemessen bis zu 901px weit ins Bild daneben, bei zehn von
     vierzehn Leistungen. Eine Box wird von nowrap nicht breiter, der Text
     läuft einfach darüber hinaus — deshalb fiel es in keiner Prüfung auf,
     die Elementkanten misst.

     Der dritte Wert im min() ist der im Frontmatter gerechnete Deckel: er
     hält den Grad dort, wo das längste Wort gerade noch in die Spalte passt.
     Mehrwortige Namen brechen um und behalten ihren Grad, einwortige werden
     kleiner — umbrechen können sie ja nicht. */
  .s-shero__title {
    font-size: min(var(--fs-display-2), 13vw, var(--shero-cap, 100cqw));
    font-weight: var(--fw-medium);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-tighter);
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* Ein Anspruch ist ein Satz, kein Wort — und ein Satz trägt tiefer.
     „VENEERS" allein füllt die Spalte in --fs-display-2 (125px) und soll das
     auch; „Wir feilen am Lächeln, nicht an der Substanz" stünde darin über
     vier Zeilen und schöbe Button und Bewertungen aus dem Bild.

     --fs-title-page (70px), eine Sprosse unter --fs-display-sm (90px): die Leiter in
     tokens.css läuft 125 · 90 · 70 · 64 · 55 · 48 · 40.

     Nur hier, nicht am Grundgrad: Die zehn übrigen Leistungsseiten tragen
     weiter ihren Namen und behalten ihren Auftritt. Und nur der Grad ändert
     sich — die Überschrift bleibt das <h1> der Seite. */
  .s-shero__title--claim {
    font-size: min(var(--fs-title-page), 13vw, var(--shero-cap, 100cqw));
    /* Versalien setzen einen Namen, keinen Satz: „VENEERS" ist eine
       Wortmarke, „Wir feilen am Lächeln, nicht an der Substanz" ein Satz mit
       Groß- und Kleinschreibung. In Versalien liest er sich als Ansage und
       verliert die Satzzeichen aus dem Blick. */
    text-transform: none;
  }

  /* Size and line height only, no `font:` shorthand: this selector also
     matches the topline (a <p>) and outweighs `.s-shero__topline`, so a
     shorthand would reset its mono family and light weight. */
  .s-shero__body p {
    max-width: var(--measure-medium);
    font-size: var(--fs-text-main);
    line-height: var(--lh-text);
  }

  /* Läuft nach rechts aus der Section heraus, steht senkrecht aber mittig —
     an der Unterkante verankert wirkte es auf großen Schirmen abgeschnitten
     und saß zu tief. Die Höhe folgt dem Fenster, damit das Feld auf großen
     Schirmen mitwächst statt bei 780px stehenzubleiben. */
  .s-shero__media {
    position: relative;
    height: min(78vh, 1100px);
    margin-right: calc(var(--site-margin) * -1);
    /* Der Hero hat oben mehr Innenabstand als unten (Platz für die Leiste).
       Zentriert würde das Feld dadurch um die halbe Differenz zu tief
       sitzen — der negative obere Rand holt es auf die Sectionmitte. */
    margin-top: calc((var(--sp-8) - var(--hero-offset)) / 2);
    border-radius: 120px 0 0 var(--r-md);
    overflow: hidden;
  }

  /* :global(img), weil das Bild aus CmsImage.astro kommt. */
  .s-shero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }

  @media (max-width: 900px) {
    .s-shero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .s-shero__media {
      order: -1;
      height: 60vh;
      margin-inline: calc(var(--site-margin) * -1);
      border-radius: var(--r-md);
    }
  }
</style>
