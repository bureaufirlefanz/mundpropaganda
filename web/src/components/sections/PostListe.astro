---
/**
 * Die Beiträge als Raster — die Übersicht unter /magazin.
 *
 * Zeigt dieselbe Karte wie das Karussell auf der Startseite. Bis hierher war
 * es eine zweite, flachere: Bild oben, Text darunter. Die Begründung dafür
 * stand hier und war richtig, aber sie zielte auf die falsche Stellschraube.
 * Sie lautete: In einem Raster aus drei Spalten stoßen die Überlappungen
 * aneinander. Das stimmt — die Komposition rechnet in Anteilen ihrer eigenen
 * Breite und braucht rund 420px. Bei drei Spalten hat sie die nicht, bei
 * zwei schon. Also zwei Spalten und eine Karte statt drei Spalten und zwei
 * Karten.
 */
import PostKarte from "../ui/PostKarte.astro";
import type { Beitrag } from "../../lib/magazin";

interface Props {
  beitraege: Beitrag[];
}

const { beitraege } = Astro.props;
---

<section class="container s-postliste">
  <div class="s-postliste__raster" data-reveal-stagger="0.06">
    {beitraege.map((p, i) => (
      <PostKarte
        beitrag={p}
        position={i}
        sizes="(max-width: 700px) 100vw, 30vw"
        mitDatum
        mitKnopf
        ueberschrift="h2"
        data-reveal-child
      />
    ))}
  </div>
</section>

<style>
  .s-postliste {
    padding-block: var(--section-space-sm) var(--section-space);
  }

  /* Zwei Spalten, nicht drei. Die Karte trägt ihren Text in einer Fläche,
     die 57 % ihrer Breite einnimmt; unter etwa 420px Kartenbreite bleibt
     davon zu wenig übrig, und die Fläche wächst über das Bild hinaus.

     Gedeckelt auf dieselben 554px wie im Karussell, und die Spalten stehen
     auseinander statt zu dehnen. Ohne den Deckel ergaben zwei Spalten auf
     1440px Fenster rund 660px je Karte: Das Bild wuchs auf 520px Höhe, die
     weiße Fläche auf 460 — bei unverändert drei Zeilen Text. Viel Fläche für
     wenig Inhalt, und gegenüber dem Karussell dieselbe Karte in zwei Größen.

     `align-items: start` ist kein Feinschliff, sondern nötig: Rasterzellen
     dehnen ihren Inhalt auf die Zeilenhöhe, und die weiße Fläche reicht mit
     `bottom: 0` bis an die Unterkante des Kastens. Gedehnt hing sie deshalb
     58px unter dem Knopf statt bündig mit ihm. */
  .s-postliste__raster {
    /* Flacher als im Karussell. Dort füllt der Text die Fläche, hier stünde
       sie zu einem Drittel leer: Die Karte ist breiter, dieselben drei Zeilen
       brauchen weniger Höhe. Die Unterkante bleibt am Knopf. */
    --post-fläche-oben: 42%;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 554px));
    justify-content: space-between;
    align-items: start;
    gap: var(--sp-10) var(--site-gutter);
  }

  @media (max-width: 700px) {
    .s-postliste__raster {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-10) 0;
    }

  }
</style>
