---
/**
 * Die Beiträge als Raster — die Übersicht unter /magazin.
 *
 * Bewusst nicht dieselbe Karte wie im Karussell: Dort überlappt eine weiße
 * Fläche das Bild nach rechts unten, und das lebt davon, dass die Karten
 * nebeneinander laufen. In einem Raster mit drei Spalten stoßen die
 * Überlappungen aneinander. Hier steht das Bild oben und der Text darunter.
 */
import CmsImage from "../ui/CmsImage.astro";
import Picture from "../ui/Picture.astro";
import { istCmsBild } from "../../lib/bilder";
import { kategorieText, beitragPfad, datumText, type Beitrag } from "../../lib/magazin";

interface Props {
  beitraege: Beitrag[];
}

const { beitraege } = Astro.props;

/* Klasse 3: die gestalteten Motive, solange an einem Beitrag kein
   Vorschaubild hängt. Positionsgenau, damit nicht alle gleich aussehen.
   Über `Picture`, damit AVIF und srcset erhalten bleiben. */
const MOTIVE = [
  { name: "motion-04", breiten: "640,1024" },
  { name: "teeth-macro", breiten: "640,1024,1600,2048" },
  { name: "lab-veneers", breiten: "640,1024,1600,2200" },
  { name: "treatment-03", breiten: "640,1024,1600,2200" },
];
---

<section class="container s-postliste">
  <div class="s-postliste__raster" data-reveal-stagger="0.06">
    {beitraege.map((p, i) => (
      <article class="c-karte" data-reveal-child>
        <a class="c-karte__link" href={beitragPfad(p.slug)}>
          <div class="c-karte__media">
            {istCmsBild(p.vorschaubild) ? (
              <CmsImage quelle={p.vorschaubild} alt="" widths={[640, 1024]} sizes="(max-width: 900px) 100vw, 33vw" />
            ) : (
              <Picture name={MOTIVE[i % MOTIVE.length].name} widths={MOTIVE[i % MOTIVE.length].breiten} alt="" sizes="(max-width: 900px) 100vw, 33vw" />
            )}
          </div>

          <div class="c-karte__kopf">
            {p.kategorie && <span class="c-karte__kicker">{kategorieText(p.kategorie)}</span>}
            {p.datum && <time class="c-karte__datum" datetime={p.datum}>{datumText(p.datum)}</time>}
          </div>

          <h2 class="c-karte__titel">{p.titel}</h2>
          {p.einleitung && <p class="c-karte__text">{p.einleitung}</p>}
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .s-postliste {
    padding-block: var(--section-space-sm) var(--section-space);
  }

  .s-postliste__raster {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-10) var(--site-gutter);
  }

  /* Die ganze Karte ist der Link — ein zweiter „weiterlesen" darunter wäre
     ein zweites Ziel für dieselbe Sache. */
  .c-karte__link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .c-karte__media {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    margin-bottom: var(--sp-4);
  }

  /* :global(img), weil das Bild aus CmsImage.astro kommt. */
  .c-karte__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--d-slow) var(--e-out);
  }

  @media (hover: hover) {
    .c-karte__link:hover .c-karte__media :global(img) {
      scale: 1.04;
    }
  }

  .c-karte__kopf {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-2);
    font-family: var(--f-mono);
    font-weight: 300;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .c-karte__titel {
    font-size: var(--fs-h5);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .c-karte__text {
    margin-top: var(--sp-3);
    font-size: var(--fs-text-small);
    line-height: 1.5;
    color: var(--c-text-muted);
  }

  @media (max-width: 900px) {
    .s-postliste__raster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-8) var(--site-gutter);
    }
  }

  @media (max-width: 700px) {
    .s-postliste__raster {
      grid-template-columns: 1fr;
    }
  }
</style>
