---
/**
 * Offene Stellen — jede Zeile klappt auf und zeigt Aufgaben, Profil und den
 * Weg zur Bewerbung.
 *
 * Neuer Baustein, aber ohne neues JavaScript: Die Zeilen tragen dieselben
 * data-Attribute wie das Akkordeon (`data-accordion="single"`), damit greift
 * modules/ui.js unverändert. Ein zweites Auf-und-Zu-Modul wäre dieselbe
 * Mechanik ein zweites Mal — und die zweite Fassung ist die, die man beim
 * nächsten Fehler vergisst.
 *
 * Das Erscheinungsbild folgt der Leistungstabelle: Zeilen mit Trennlinie,
 * Titel links, Angaben rechts, beim Überfahren färbt sich die Linie.
 */
import Button from "../ui/Button.astro";
import { applicationLink, type Job } from "../../lib/careers";

interface Props {
  id?: string;
  topline: string;
  headline: string;
  jobs: Job[];
  /** Adresse für Bewerbungen. Steht im Karriere-Dokument, nicht hier. */
  applicationEmail: string;
  /** Der Anspruch über der Liste. Wahlfrei — ohne ihn beginnt sie sofort. */
  text?: string;
}
const { id, topline, headline, jobs, applicationEmail, text } = Astro.props;
---

<section class="s-jobs container" id={id}>
  <div class="s-jobs__head">
    <span class="c-topline" data-reveal="fade">{topline}</span>
    <h2 class="s-jobs__title" data-split="lines">{headline}</h2>
    {
      text && (
        <p class="s-jobs__text" data-reveal="up" data-reveal-delay="0.08">
          {text}
        </p>
      )
    }
  </div>

  <div class="s-jobs__list" data-accordion="single" data-reveal-stagger="0.06">
    {
      jobs.map((s, i) => (
        <article
          class="s-jobs__item"
          data-accordion-item
          data-reveal-child
          id={`stelle-${s.handle}`}
        >
          {/* Die Überschrift steckt IM Button, nicht daneben: Vorlesegeräte
            geben dann beim Ansteuern der Zeile den Stellentitel aus und
            nicht nur „Schaltfläche". */}
          <h3 class="s-jobs__row-title">
            <button class="s-jobs__row" data-accordion-trigger type="button">
              {/* Reine Ordnungszahl. `aria-hidden`, weil sie sonst der
                Überschrift vorangestellt vorgelesen würde — „null eins
                Zahnmedizinische Fachangestellte". Die Reihenfolge ergibt
                sich für Vorlesegeräte ohnehin aus der Liste. */}
              <span class="c-number s-jobs__number" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>

              <span class="s-jobs__name">{s.title}</span>

              <span class="s-jobs__meta">
                <span class="s-jobs__badge">{s.kind}</span>
                <span class="s-jobs__location">{s.location}</span>
                <span class="s-jobs__hours">{s.hours}</span>
              </span>

              <span class="s-jobs__icon" aria-hidden="true">
                <svg>
                  <use href="#i-chevron" />
                </svg>
              </span>
            </button>
          </h3>

          <div class="s-jobs__panel" data-accordion-panel>
            <div class="s-jobs__content">
              <p class="s-jobs__lead">{s.lead}</p>

              <div class="s-jobs__columns">
                <div>
                  <h4 class="s-jobs__subtitle">Deine Aufgaben</h4>
                  <ul class="s-jobs__bullets">
                    {(s.duties ?? []).map((a) => (
                      <li>{a}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class="s-jobs__subtitle">Das bringst du mit</h4>
                  <ul class="s-jobs__bullets">
                    {(s.profile ?? []).map((a) => (
                      <li>{a}</li>
                    ))}
                  </ul>
                </div>
              </div>

              {s.highlight && <p class="s-jobs__note">{s.highlight}</p>}

              <div class="s-jobs__action">
                {/* Der Betreff ist vorbereitet — sonst landen vier Stellen in
                  einem Postfach unter „Bewerbung". */}
                <Button
                  label="Auf diese Stelle bewerben"
                  href={applicationLink(applicationEmail, s)}
                />
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .s-jobs {
    padding-block: var(--section-space);
  }

  .s-jobs__head {
    max-width: 32ch;
    margin-bottom: var(--sp-8);
  }

  .s-jobs__head .c-topline {
    margin-bottom: var(--sp-4);
  }

  .s-jobs__title {
    font: var(--font-section-title);
    letter-spacing: var(--tracking-section-title);
  }

  /* Schmaler als die Liste darunter: Der Absatz wird gelesen, die Liste
     überflogen — 60 Zeichen ist die Grenze, ab der das Auge die nächste
     Zeile nicht mehr sicher findet. */
  .s-jobs__text {
    max-width: var(--measure-text);
    margin-top: var(--sp-5);
    font-size: var(--fs-text-main);
    line-height: var(--lh-text);
    color: var(--c-text-muted);
  }

  /* Die Überschrift trägt keine eigene Gestalt — sie ist nur die Ebene, die
     Vorlesegeräten die Gliederung gibt. Ausgesehen wird der Button darin. */
  .s-jobs__row-title {
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
  }

  .s-jobs__item {
    border-top: var(--bw) solid var(--c-line);
  }

  .s-jobs__item:last-child {
    border-bottom: var(--bw) solid var(--c-line);
  }

  /* Vier Spalten: Nummer, Titel, Angaben, Zeichen. Die Angaben rücken auf
     schmalen Fenstern unter den Titel. */
  .s-jobs__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--sp-4);
    width: 100%;
    padding-block: var(--sp-5);
    text-align: left;
    color: inherit;
    transition: color var(--d-fast) var(--e-swift);
  }

  /* Siehe `.c-number` in shared.css. Stand vorher als stumpfe Ziffer in
     `--c-text-muted` da — dieselbe Aufzählung, drei Seiten weiter mit Kreis. */
  .s-jobs__number {
    --number-size: 28px;
    --number-font: var(--fs-label-lg);
  }

  .s-jobs__name {
    font: var(--font-card-title);
    letter-spacing: var(--tracking-card-title);
    text-wrap: balance;
  }

  /* "Prophylaxeassistenz" is wider than the name column of a 320px phone and
     ran 17px into the arrow beside it. */
  @media (max-width: 700px) {
    .s-jobs__name {
      hyphens: auto;
    }
  }

  .s-jobs__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-4);
    font-weight: var(--fw-regular);
    font-size: var(--fs-text-small);
    letter-spacing: 0;
    color: var(--c-text-muted);
  }

  /* Die Art der Stelle ist die wichtigste der drei Angaben — sie bekommt
     als einzige eine Fläche. Braun auf Taupe: 5.31:1, WCAG verlangt 4.5:1
     für Text dieser Größe. */
  .s-jobs__badge {
    padding: 0.25em 0.7em;
    border-radius: var(--r-round);
    background: var(--c-tint);
    color: var(--c-text);
  }

  /* Kreis mit Winkel, wie im Akkordeon. Dreht sich beim Aufklappen. */
  .s-jobs__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-round);
    border: var(--bw) solid var(--c-line);
    transition:
      transform var(--d-base) var(--e-out),
      background var(--d-fast) var(--e-swift),
      border-color var(--d-fast) var(--e-swift),
      color var(--d-fast) var(--e-swift);
  }

  .s-jobs__icon svg {
    width: var(--icon-sm);
    height: var(--icon-sm);
  }

  .s-jobs__item[data-open="true"] .s-jobs__icon {
    transform: rotate(180deg);
    background: var(--c-brand);
    border-color: var(--c-brand);
    color: var(--c-dark);
  }

  @media (hover: hover) {
    .s-jobs__row:hover .s-jobs__icon {
      background: var(--c-brand);
      border-color: var(--c-brand);
      color: var(--c-dark);
    }
  }

  /* Höhe 0 im Ausgangszustand setzt das Modul. `overflow: hidden` muss aus
     dem CSS kommen — sonst ragt der Inhalt beim Zuklappen heraus. */
  .s-jobs__panel {
    overflow: hidden;
  }

  .s-jobs__content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    /* Auf Höhe des Titels einrücken, nicht auf Höhe der Nummer — der Text
       soll unter dem Stellennamen beginnen. */
    padding: 0 0 var(--sp-8) calc(2ch + var(--sp-4));
  }

  .s-jobs__lead {
    font: var(--font-lead);
    max-width: var(--measure-text);
  }

  .s-jobs__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-6) var(--site-gutter);
    max-width: var(--measure-long);
  }

  .s-jobs__subtitle {
    margin-bottom: var(--sp-3);
    font-weight: var(--fw-light);
    font-size: var(--fs-text-small);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .s-jobs__bullets {
    font: var(--font-body);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Eigener Punkt statt des Listenzeichens: dasselbe Zeichen wie in der
     Topline, dadurch bleibt die Seite bei einer Formensprache. */
  .s-jobs__bullets li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7em;
    align-items: baseline;
  }

  .s-jobs__bullets li::before {
    content: "";
    width: 0.4em;
    height: 0.4em;
    border-radius: var(--r-round);
    background: var(--c-brand);
    /* Der Punkt sitzt auf der Grundlinie der ersten Zeile, nicht mittig zur
       ganzen Zeile — bei zweizeiligen Punkten rutschte er sonst nach unten. */
    translate: 0 -0.25em;
  }

  .s-jobs__note {
    font: var(--font-body);
    max-width: var(--measure-text);
    padding: var(--sp-3) var(--sp-4);
    border-left: 2px solid var(--c-brand);
    color: var(--c-text-muted);
  }

  @media (max-width: 1000px) {
    .s-jobs__row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      row-gap: var(--sp-3);
    }

    /* Die Angaben unter den Titel, in dessen Spalte. */
    .s-jobs__meta {
      grid-column: 2;
    }

    .s-jobs__icon {
      grid-row: 1 / span 2;
      grid-column: 3;
    }
  }

  @media (max-width: 700px) {
    .s-jobs__columns {
      grid-template-columns: 1fr;
    }

    .s-jobs__content {
      padding-left: 0;
    }
  }
</style>
