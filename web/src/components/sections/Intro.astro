---
import Button from "../ui/Button.astro";
import CmsImage from "../ui/CmsImage.astro";
import Picture from "../ui/Picture.astro";
import type { ImageSource } from "../../lib/images";
/**
 * Einstiegstext: Überschrift links, daneben zwei Textspalten.
 */
interface Props {
  /**
   * Die Rubrik über der Überschrift.
   *
   * Wahlfrei: Der Einstiegsblock der Pillar Pages trägt keine — dort steht
   * die Rubrik schon im Kopf darüber, und zweimal „Guides" untereinander
   * wäre eine Dopplung. Alle bestehenden Aufrufer geben eine mit, ihr Markup
   * bleibt dadurch unverändert.
   */
  topline?: string;
  /** Wahlfrei: Auf Pillar Pages steht die Überschrift als eigener,
      nummerierter Block darüber (`ui/SectionHeading.astro`). */
  headline?: string;
  columns: string[];
  /**
   * Bild über den Spalten. Nur in der Ausprägung `centered` vorgesehen —
   * dort steht es mittig und schmäler als die Seite (Figma 177:1731).
   */
  image?: ImageSource;
  alt?: string;
  /**
   * `centered` ist die Fassung der Pillar Pages: Bild mittig, darunter zwei
   * Textspalten als zentrierter Block. Die Überschrift steht dort nicht hier,
   * sondern nummeriert darüber (`ui/SectionHeading.astro`).
   *
   * Ohne Angabe bleibt es beim dreispaltigen Raster der übrigen Seiten —
   * deren Markup ändert sich dadurch nicht.
   */
  variant?: "default" | "centered";
  /**
   * Der Einstiegstext, der vorher im Kopf der Seite stand.
   *
   * Er gehört hierher: Im Kopf war er ein dritter Anfang zwischen Bild und
   * Überschrift, hier trägt er die Aussage, die der Abschnitt ausbuchstabiert.
   */
  lead?: string;
  action?: string;
  actionHref?: string;
  /**
   * Ein randloses Bild über dem Abschnitt, als Motivname aus der
   * Bildpipeline (`Picture.astro`), nicht als CMS-Bild.
   *
   * Es bricht über die volle Fensterbreite aus und läuft ohne Rundung bis an
   * beide Kanten — dieselbe Begründung wie bei `PostImage` in der Fassung
   * `full`: Eine Rundung an einer Kante, die am Fensterrand endet, sieht aus
   * wie ein Fehler beim Zuschneiden.
   *
   * `alt` beschreibt das Bild, das tatsächlich gerendert wird. `bleed` und
   * `image` schließen sich in der Praxis aus: das eine ist die randlose
   * Fassung, das andere das mittige Bild der Pillar Pages.
   */
  bleed?: string;
}

const {
  topline,
  headline,
  columns,
  lead,
  action,
  actionHref,
  image,
  alt = "",
  variant = "default",
  bleed,
} = Astro.props;
---

<section
  class:list={[
    "container",
    "s-intro",
    variant === "centered" && "s-intro--centered",
  ]}
>
  {
    bleed && (
      <figure class="s-intro__bleed">
        <Picture name={bleed} alt={alt} sizes="100vw" />
      </figure>
    )
  }

  <div class="s-intro__head">
    {
      topline && (
        <span class="c-topline" data-reveal="fade">
          {topline}
        </span>
      )
    }
    {
      headline && (
        <h2 class="s-intro__title" data-split="lines">
          {headline}
        </h2>
      )
    }
    {
      lead && (
        <p class="s-intro__lead" data-reveal="up">
          {lead}
        </p>
      )
    }
    {
      action && (
        <div class="s-intro__action" data-reveal="up" data-reveal-delay="0.08">
          <Button label={action} href={actionHref ?? "#stellen"} />
        </div>
      )
    }
  </div>
  {
    image && (
      <figure class="s-intro__media" data-reveal="scale">
        <CmsImage
          source={image}
          alt={alt}
          widths={[640, 1024, 1600]}
          sizes="(max-width: 1000px) 92vw, 48vw"
        />
      </figure>
    )
  }

  {
    /* Die Hülle nur in der zentrierten Fassung: Dort trägt sie das
      Zweispaltenraster. Sie auch sonst zu setzen änderte das DOM der
      Leistungsseiten — `display: contents` hielte zwar die Darstellung
      gleich, aber `npm run web:styles` vergleicht die Elementfolge, und ein
      zusätzliches Element ist eben doch eine Änderung. */
  }
  {
    variant === "centered" ? (
      <div class="s-intro__columns">
        {columns.map((t, i) => (
          <p data-reveal="up" data-reveal-delay={i * 0.08}>
            {t}
          </p>
        ))}
      </div>
    ) : (
      columns.map((t, i) => (
        <p data-reveal="up" data-reveal-delay={i * 0.08}>
          {t}
        </p>
      ))
    )
  }
</section>

<style>
  .s-intro {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--sp-8) var(--site-gutter);
    /* Unten knapper: direkt darunter beginnt das farbige Benefits-Band, das
       seinen eigenen Innenabstand mitbringt. */
    padding-block: var(--section-space) var(--section-space-sm);
  }

  /* Das randlose Bild über dem Raster.
   *
   * `width: 100vw` plus `margin-inline: calc(50% - 50vw)` holt es aus dem
   * Satzspiegel zurück an die Fensterkanten — derselbe Griff wie in
   * `PostImage` bei `data-width="full"`. Der negative obere Abstand hebt das
   * Polster des Abschnitts auf, damit das Bild bündig oben ansetzt.
   *
   * `aspect-ratio` deckelt die Höhe: Ein 3:2-Foto über 1440px wäre 960px
   * hoch und damit höher als das Fenster. Auf schmalen Fenstern darf es
   * wieder hochkant werden, sonst bleibt vom Motiv ein Streifen. */
  .s-intro__bleed {
    grid-column: 1 / -1;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block: calc(var(--section-space) * -1) var(--sp-10);
    overflow: hidden;
    aspect-ratio: 2 / 1;
  }

  /* :global(img), weil das Bild aus Picture.astro kommt und das
     Scope-Attribut dieser Datei nicht trägt. */
  .s-intro__bleed :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  @media (max-width: 900px) {
    .s-intro__bleed {
      aspect-ratio: 4 / 3;
    }
  }

  .s-intro__lead {
    font: var(--font-lead);
    margin-top: var(--sp-5);
    color: var(--c-text-muted);
  }

  .s-intro__action {
    margin-top: var(--sp-6);
  }

  .s-intro__head {
    max-width: 32ch;
  }

  .s-intro__head .c-topline {
    margin-bottom: var(--sp-4);
  }

  .s-intro__title {
    font: var(--font-section-title);
    letter-spacing: var(--tracking-section-title);
  }

  .s-intro p {
    font: var(--font-body);
    max-width: var(--measure-medium);
  }

  /* --- Die Fassung der Pillar Pages ------------------------------------
     Bild mittig und schmäler als die Seite, darunter zwei Textspalten als
     zentrierter Block. Maße aus dem Entwurf: Bild etwa 47 % der Breite, der
     Textblock etwa 60 %. */
  .s-intro--centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 0 var(--section-space);
  }

  .s-intro--centered .s-intro__media {
    width: min(47%, 100%);
    margin: 0;
    overflow: hidden;
    border-radius: var(--r-md);
  }

  .s-intro--centered .s-intro__media :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .s-intro--centered .s-intro__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--flow-md);
    width: min(60%, 100%);
    margin-top: clamp(var(--sp-6), 2.6vw, 46px);
  }

  .s-intro--centered p {
    max-width: none;
  }

  @media (max-width: 1000px) {
    .s-intro--centered .s-intro__media {
      width: 92%;
    }

    .s-intro--centered .s-intro__columns {
      width: 100%;
    }
  }

  @media (max-width: 700px) {
    .s-intro--centered .s-intro__columns {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    .s-intro {
      grid-template-columns: 1fr;
    }
  }
</style>
