---
import Button from "../ui/Button.astro";
import PostCard from "../ui/PostCard.astro";
import type { Post } from "../../lib/magazine";

/**
 * Dieselben Beiträge überall, nur der Einstieg wechselt: auf der Startseite
 * allgemein, auf einer Leistungsseite auf sie bezogen.
 *
 * Die Karten kamen bis hierher aus dem Markup — vier Beiträge mit Kategorie,
 * Titel, Anrisstext und Bild, dazu zwei Links auf `#`. Sie stehen jetzt als
 * Dokumente im Studio.
 */
interface Props {
  topline: string;
  title: string;
  text: string;
  posts: Post[];
}

/* Keine Vorgaben: Die drei Textfelder sind im Schema Pflicht, die Seite
   reicht sie durch. Eine Vorgabe hier wäre der stille Rückfall, den
   Aufgabe 4 abgeschafft hat — der Kunde löschte die Zeile und sähe sie
   weiter stehen. */
const { topline, title, text, posts } = Astro.props;
---

{
  /* ==================================================================
           MAGAZIN — Wortmarke auf Markerbalken, daneben der Einstieg,
           darunter ein Karussell aus Bild + überlappender weißer Karte
           ================================================================== */
}
<section class="s-magazine" id="magazin" data-magazine>
  <div class="container">
    <span class="c-topline" data-reveal="fade">{topline}</span>

    <div class="s-magazine__head">
      {
        /* Die Balken sind Flächen hinter der Schrift, keine Textfarbe.
                 Leicht gegeneinander gedreht, das „ZU" liegt als weiße
                 Plakette dazwischen. */
      }
      <div class="s-magazine__type" data-reveal="up">
        <span class="s-magazine__bar">Mund</span>
        <span class="s-magazine__chip">zu</span>
        <span class="s-magazine__bar s-magazine__bar--lower">Mund</span>
      </div>

      <div class="s-magazine__intro">
        <h2 class="s-magazine__title" data-split="lines">{title}</h2>
        <p data-reveal="up" data-reveal-delay="0.08">{text}</p>
      </div>
    </div>

    <div class="s-magazine__track" data-magazine-track>
      {
        posts.map((p, i) => (
          <PostCard
            post={p}
            sizes="24vw"
            parallax="9"
            withButton
            data-magazine-item
          />
        ))
      }
    </div>

    <div class="s-magazine__nav">
      <div class="s-magazine__arrows">
        <button
          class="s-gallery__arrow"
          data-magazine-prev
          type="button"
          aria-label="Vorheriger Beitrag"
        >
          <svg aria-hidden="true"><use href="#i-arrow"></use></svg>
        </button>
        <button
          class="s-gallery__arrow"
          data-magazine-next
          type="button"
          aria-label="Nächster Beitrag"
        >
          <svg aria-hidden="true"><use href="#i-arrow"></use></svg>
        </button>
      </div>
      <div
        class="s-gallery__dots"
        data-magazine-dots
        role="tablist"
        aria-label="Beiträge"
      >
      </div>
      <Button label="Alle Beiträge" href="/magazin" variant="dark" />
    </div>
  </div>
</section>

<style>
  /* Wortmarke auf zwei Markerbalken, daneben der Einstiegstext, darunter ein
     Karussell. Die Karten bestehen aus Bild und einer weißen Karte, die es
     nach rechts unten versetzt überlappt — im Entwurf sitzt das Bild bei
     x=81 (326 breit), die Karte bei x=319 (316 breit).
     Pfeile und Punkte liegen in shared.css — die Standorte nutzen dieselben. */
  .s-magazine {
    padding-block: var(--section-space-lg);
    overflow: hidden;
  }

  /* Die erste Spur ist so breit wie der Schriftzug und nicht breiter. Als
     `1fr` nahm sie allen übrigen Platz und drückte den Einstieg an den
     rechten Rand — gemessen lagen rund 800px leer dazwischen, und die beiden
     lasen sich wie zwei Sachen statt wie eine.

     Die Fuge steht eigens da und nicht auf der Rinne des Seitenrasters: Die
     Balken sind gedreht, ihre rechte Kante steht dadurch etwas über, und mit
     32px stieße der Text beinahe daran. */
  .s-magazine__head {
    display: grid;
    grid-template-columns: max-content 316px;
    gap: var(--sp-10) clamp(var(--sp-6), 5vw, 96px);
    align-items: start;
    margin-top: var(--sp-10);
    margin-bottom: clamp(64px, 8vw, 140px);
  }

  /* Die Balken sind Flächen hinter der Schrift, keine Textfarbe. */
  .s-magazine__type {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(4px, 0.9vw, 16px);
  }

  /* Rechts mehr Polster als links, und das ist kein Versehen: `letter-spacing`
     wirkt auch hinter dem letzten Buchstaben und schluckt negativ gesetzt
     (-0.03em) rund 5px hinter dem D. Mit gleichem Polster auf beiden Seiten
     sah der Balken rechts angeschnitten aus, obwohl er rechnerisch symmetrisch
     war. 0.11em gleicht die 5px aus und lässt beidseitig etwa gleich viel
     Luft stehen; 0.16em kippte sichtbar zur anderen Seite. */
  .s-magazine__bar {
    display: inline-block;
    padding: 0.06em 0.11em 0.14em 0.06em;
    border-radius: var(--r-sm);
    background: var(--c-brand);
    color: var(--c-dark);
    font-family: var(--f-sans);
    font-weight: var(--fw-medium);
    font-size: var(--fs-display-lg);
    line-height: 0.86;
    letter-spacing: var(--tracking-tighter);
    text-transform: uppercase;
    white-space: nowrap;
    rotate: 1.8deg;
  }

  .s-magazine__bar--lower {
    margin-left: clamp(12px, 3.2vw, 56px);
    rotate: -1.4deg;
  }

  /* Liegt als weiße Plakette zwischen den Balken, waagerecht wie senkrecht
     mittig. Vorher stand die linke Kante auf `clamp(120px, 27vw, 460px)` —
     ein Wert, der bei einer Fenstergröße passte und bei jeder anderen
     danebenlag, weil die Balken mit dem Schriftgrad wachsen und die Plakette
     mit ihrem eigenen. */
  .s-magazine__chip {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    z-index: 2;
    padding: 0.1em 0.42em 0.16em;
    border-radius: var(--r-md);
    background: var(--c-white);
    color: var(--c-dark);
    font-family: var(--f-sans);
    font-weight: var(--fw-medium);
    font-size: var(--fs-display-sm);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    rotate: -3deg;
  }

  .s-magazine__intro {
    padding-top: clamp(24px, 4vw, 72px);
  }

  .s-magazine__title {
    margin-bottom: var(--sp-4);
    font: var(--font-section-title);
    letter-spacing: var(--tracking-section-title);
    text-transform: uppercase;
  }

  .s-magazine__intro p {
    font-size: var(--fs-text-small);
    line-height: var(--lh-body);
    color: var(--c-text-muted);
  }

  /* --- Karussell --------------------------------------------------------- */

  .s-magazine__track {
    display: flex;
    gap: clamp(40px, 5.5vw, 96px);
    will-change: transform;
  }

  .s-magazine__nav {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    margin-top: var(--sp-8);
  }

  .s-magazine__arrows {
    display: flex;
    gap: var(--sp-4);
  }

  /* Die Punkte in die Mitte, der Button ganz nach rechts. */
  .s-magazine__nav .s-gallery__dots {
    margin-inline: auto;
  }

  /* Die Karte selbst steht in `ui/PostCard.astro` — die Übersicht unter
     /magazin zeigt dieselbe. Von hier kommt nur ihre Breite: Die Spur
     scrollt waagerecht, also ist sie fest und nicht die der Zelle. */
  .s-magazine__track {
    --post-width: clamp(420px, 36vw, 554px);
  }

  @media (max-width: 900px) {
    .s-magazine__head {
      grid-template-columns: 1fr;
    }

    .s-magazine__track {
      --post-width: min(78vw, 420px);
    }
  }

  @media (max-width: 700px) {
    .s-magazine__track {
      --post-width: min(84vw, 380px);
    }

    /* Umbrechend: Pfeile, Punkte und Button brauchen zusammen mehr als die
       358px Satzbreite — der Button lief rechts aus dem Bild. */
    .s-magazine__nav {
      flex-wrap: wrap;
      gap: var(--sp-4);
      margin-top: var(--sp-6);
    }

    .s-magazine__nav .s-gallery__dots {
      margin-inline: 0 auto;
    }
  }
</style>
