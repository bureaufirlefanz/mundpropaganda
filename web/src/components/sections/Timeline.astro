---
/**
 * Zeitstrahl — ein Ablauf als waagerechte Bahn, an der sich beim Scrollen
 * eine Linie entlangzieht und die Marken nacheinander anspringen.
 *
 * Bewusst kein Kartenraster: Ein Ablauf hat eine Richtung, und die soll man
 * sehen. Die vier Schritte stehen deshalb an einer durchgehenden Linie und
 * nicht in vier gleichwertigen Kästen nebeneinander.
 *
 * Unter 900px kippt die Bahn in die Senkrechte — dort ist Scrollen die
 * natürliche Richtung, und vier Spalten auf einem Telefon sind keine.
 *
 * Die Linie füllt sich über einen Scroll-Fortschritt (siehe
 * modules/timeline.js). Ohne JavaScript und ohne Bewegung steht sie
 * vollständig da: Der gefüllte Teil ist die Voreinstellung, nicht der leere.
 */

export interface Stage {
  title: string;
  text: string;
}

interface Props {
  headline: string;
  stages: Stage[];
}
const { headline, stages } = Astro.props;
---

<section class="s-timeline container" data-timeline>
  <div class="s-timeline__head">
    <h2 class="s-timeline__title" data-split="lines">{headline}</h2>
  </div>

  <ol class="s-timeline__track" data-reveal-stagger="0.1">
    {
      /* Die Bahn selbst: eine blasse Linie über die volle Breite, darüber die
        farbige, die mitwächst. Zwei Elemente statt eines Verlaufs — ein
        Verlauf ließe sich nicht sauber auf einen Fortschritt abbilden. */
    }
    <div class="s-timeline__rail" aria-hidden="true">
      <span class="s-timeline__progress" data-timeline-fill></span>
    </div>

    {
      stages.map((e, i) => (
        <li class="s-timeline__stage" data-reveal-child>
          <span class="s-timeline__dot" aria-hidden="true" />
          <h3 class="s-timeline__stage-title">
            {/* Die Nummer gehört zur Gestaltung, nicht zum Text — für
              Vorlesegeräte ergibt die Reihenfolge sich aus der Liste. */}
            <span class="c-number s-timeline__number" aria-hidden="true">
              {i + 1}
            </span>
            {e.title}
          </h3>
          <p class="s-timeline__text">{e.text}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .s-timeline {
    padding-block: var(--section-space);
  }

  .s-timeline__head {
    max-width: 34ch;
    margin-bottom: var(--sp-10);
  }

  .s-timeline__title {
    font: var(--font-section-title);
    letter-spacing: var(--tracking-section-title);
  }

  .s-timeline__track {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--site-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Das Gleis liegt auf Höhe der Punkte, nicht am oberen Rand: Die Punkte
     sitzen mittig auf ihm, deshalb dieselbe Rechnung an beiden Stellen
     (halbe Punktgröße). */
  .s-timeline__rail {
    position: absolute;
    top: 7px;
    right: 0;
    left: 0;
    height: 2px;
    background: var(--c-line);
  }

  .s-timeline__progress {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--c-brand);
    transform-origin: 0 50%;
    /* Voreinstellung ist VOLL. Ohne JavaScript bleibt sie so — eine leere
       Bahn wäre eine falsche Aussage über den Ablauf. modules/timeline.js
       setzt sie zurück und zieht sie beim Scrollen wieder auf. */
    transform: scaleX(1);
  }

  .s-timeline__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: var(--sp-6);
  }

  .s-timeline__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 16px;
    height: 16px;
    border-radius: var(--r-round);
    background: var(--c-bg);
    border: 2px solid var(--c-line);
    transition:
      background var(--d-base) var(--e-out),
      border-color var(--d-base) var(--e-out);
  }

  /* Erreichte Marke: gefüllt. Das Attribut setzt timeline.js. */
  .s-timeline__stage[data-reached] .s-timeline__dot {
    background: var(--c-brand);
    border-color: var(--c-brand);
  }

  /* Ohne `margin-top`: Über dem Titel stand die Zeitmarke („Tag 0",
     „Woche 2–3"), von der er hier abgesetzt werden musste. Die Marken sind
     entfallen — der Titel beginnt jetzt direkt unter dem Punkt, und ein
     Rest-Abstand ließe die Etappen ohne Grund tiefer sitzen. */
  .s-timeline__stage-title {
    font: var(--font-card-title);
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    letter-spacing: var(--tracking-card-title);
    text-wrap: balance;
  }

  /* Brauner Kreis mit heller Ziffer — dieselbe Form wie die Ziffernkreise
     im Benefits-Band und die Symbolkreise der Leistungstabelle. Grau auf
     Braun misst 8.65:1.

     Keine Konturschrift mehr: Die ist ein Schaueffekt und zog Aufmerksamkeit
     auf die Zahl, obwohl die Zahl nur die Reihenfolge angibt und der Titel
     die Aussage trägt. Der Kreis ordnet, ohne zu schreien.

     `align-self: center` statt der Grundlinie des Titels: Ein Kreis hat
     keine Grundlinie, an der man ihn ausrichten könnte — er säße sonst
     sichtbar zu tief. */
  /* Stand als Einziger umgekehrt da: dunkler Kreis, helle Ziffer. Jetzt wie
     überall pink mit brauner Ziffer, siehe `.c-number` in shared.css.

     Die Größe bleibt in `em`, weil der Kreis hier an der Schriftgröße seiner
     Bahn hängt und nicht an einem festen Maß. */
  .s-timeline__number {
    --number-size: 1.7em;
    --number-font: 0.62em;

    flex: 0 0 auto;
    align-self: center;
  }

  .s-timeline__text {
    font: var(--font-body);
    max-width: var(--measure-narrow);
    margin-top: var(--sp-3);
    color: var(--c-text-muted);
  }

  /* Senkrecht ab hier: Das Gleis wandert nach links, die Etappen stapeln. */
  @media (max-width: 900px) {
    .s-timeline__track {
      grid-auto-flow: row;
      gap: var(--sp-8);
      padding-left: var(--sp-6);
    }

    .s-timeline__rail {
      top: 7px;
      bottom: 7px;
      right: auto;
      left: 7px;
      width: 2px;
      height: auto;
    }

    .s-timeline__progress {
      transform-origin: 50% 0;
    }

    .s-timeline__stage {
      padding-top: 0;
      padding-left: var(--sp-6);
    }

    .s-timeline__dot {
      left: calc(-1 * var(--sp-6));
    }

    .s-timeline__text {
      max-width: var(--measure-medium);
    }
  }
</style>
