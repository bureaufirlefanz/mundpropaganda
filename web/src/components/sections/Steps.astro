---
/**
 * Nummerierte Karten: der Ablauf einer Behandlung in wenigen Schritten.
 */
import type { Step } from "../../lib/shapes";

interface Props {
  /** Wahlfrei — siehe `ui/SectionHeading.astro`. */
  title?: string;
  steps: Step[];
}

const { title, steps } = Astro.props;
---

<section class="s-steps">
  <div class="container">
    {
      title && (
        <h2 class="s-steps__title" data-split="lines">
          {title}
        </h2>
      )
    }

    <div class="s-steps__grid" data-reveal-stagger="0.08">
      {
        steps.map((s, i) => (
          <article class="c-step" data-reveal-child>
            <span class="c-number c-step__num">{i + 1}</span>
            <h3 class="c-step__title">{s.title}</h3>
            <p class="c-step__text">{s.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .s-steps {
    padding-block: var(--section-space);
  }

  .s-steps__title {
    text-align: center;
    max-width: 16ch;
    margin: 0 auto var(--sp-10);
    font-size: var(--fs-h1-sm);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: var(--tracking-tight);
  }

  .s-steps__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--site-gutter);
  }

  @media (max-width: 1000px) {
    .s-steps__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .s-steps__grid {
      grid-template-columns: 1fr;
    }
  }

  /* --- Schritt-Karte ----------------------------------------------------- */

  .c-step {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    min-height: 479px;
    padding: var(--sp-4);
    border-radius: var(--r-md);
    background: var(--c-neutral-200);
    color: var(--c-neutral-800);
  }

  /* Farbe, Form und Schnitt kommen aus `.c-number` in shared.css. Hier
     steht nur, was diesen Kreis von den übrigen unterscheidet: seine Größe.
     Dieser Baustein war die Vorlage für die gemeinsame Regel. */
  .c-step__num {
    --number-size: 40px;
    --number-font: var(--fs-text-main);
  }

  .c-step__title {
    font-size: var(--fs-h4);
    font-weight: 400;
    line-height: var(--lh-title);
    letter-spacing: var(--tracking-snug);
  }

  /* `margin-top: auto` schiebt den Text an die Unterkante — dadurch setzen
     alle vier Karten ihn auf derselben Höhe an, egal wie lang der Titel ist. */
  .c-step__text {
    margin-top: auto;
    font-size: var(--fs-text-main);
    line-height: var(--lh-text);
    color: color-mix(in srgb, var(--c-neutral-800) 80%, transparent);
  }
</style>
