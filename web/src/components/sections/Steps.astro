---
/**
 * Nummerierte Karten: der Ablauf einer Behandlung in wenigen Schritten.
 */
import type { Step } from "../../lib/shapes";

interface Props {
  /** Wahlfrei — siehe `ui/SectionHeading.astro`. */
  title?: string;
  steps: Step[];
}

const { title, steps } = Astro.props;

/* The duration as a figure: "ca. 90 Minuten pro Sitzung" becomes "90 Min.",
   "30 bis 60 Minuten" becomes "30 bis 60 Min.", "1,5 Stunden" becomes
   "1,5 Std.". The editors type a sentence in the Studio; the card shows the
   number next to a clock. Text without a recognisable unit stays as typed,
   so nothing silently disappears. */
function shortDuration(text: string): string {
  const m = text.match(
    /(\d+(?:[,.]\d+)?(?:\s*(?:bis|-|–)\s*\d+(?:[,.]\d+)?)?)\s*(min\w*|std\w*|stunde\w*)/i,
  );
  if (!m) return text;
  const unit = /^min/i.test(m[2]!) ? "Min." : "Std.";
  return `${m[1]!.replace(/\s*(-|–)\s*/, " bis ")} ${unit}`;
}
---

<section class="s-steps">
  <div class="container">
    {
      title && (
        <h2 class="s-steps__title" data-split="lines">
          {title}
        </h2>
      )
    }

    <div class="s-steps__grid" data-reveal-stagger="0.08">
      {
        steps.map((s, i) => (
          <article class="c-step" data-surface="card" data-reveal-child>
            <span class="c-number c-step__num">{i + 1}</span>
            <h3 class="c-step__title">{s.title}</h3>
            <p class="c-step__text">{s.text}</p>
            {s.duration && (
              <p class="c-step__duration">
                <svg aria-hidden="true">
                  <use href="#i-clock" />
                </svg>
                <span class="sr-only">Dauer</span>
                {shortDuration(s.duration)}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .s-steps {
    padding-block: var(--section-space);
  }

  .s-steps__title {
    text-align: center;
    max-width: 16ch;
    margin: 0 auto var(--sp-10);
    font-size: var(--fs-title-xl);
    font-weight: var(--fw-medium);
    line-height: var(--lh-headline);
    letter-spacing: var(--tracking-tight);
  }

  /* Four columns, but as `auto-fit` tracks of a fixed quarter width and
     centred: a treatment with two or three steps then sits in the middle of
     the page instead of hugging the left edge with empty columns beside it.
     The card width is the same as with four steps, so nothing else moves. */
  .s-steps__grid {
    --step-columns: 4;
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(
        0,
        calc(
          (100% - (var(--step-columns) - 1) * var(--site-gutter)) /
            var(--step-columns)
        )
      )
    );
    justify-content: center;
    gap: var(--site-gutter);
  }

  @media (max-width: 1000px) {
    .s-steps__grid {
      --step-columns: 2;
    }
  }

  @media (max-width: 600px) {
    .s-steps__grid {
      grid-template-columns: 1fr;
    }
  }

  /* --- Schritt-Karte ----------------------------------------------------- */

  .c-step {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    min-height: 479px;
    padding: var(--sp-4);
    border-radius: var(--r-md);
    background: var(--c-neutral-200);
    color: var(--c-text);
  }

  /* 479px is the height of the row of four on a wide screen. In two columns
     and in one it only added empty space: the text is pushed to the bottom
     edge (see `.c-step__text`), and between title and text stood up to 200px
     of nothing — measured at 820px and 375px. The cards of a row still end
     level, because grid items stretch to the tallest one; what stays between
     title and text is the card's own gap. */
  @media (max-width: 1000px) {
    .c-step {
      min-height: 0;
    }
  }

  /* Farbe, Form und Schnitt kommen aus `.c-number` in shared.css. Hier
     steht nur, was diesen Kreis von den übrigen unterscheidet: seine Größe.
     Dieser Baustein war die Vorlage für die gemeinsame Regel. */
  .c-step__num {
    --number-size: 40px;
    --number-font: var(--fs-text-main);
  }

  .c-step__title {
    font: var(--font-card-title);
    letter-spacing: var(--tracking-card-title);
  }

  /* `margin-top: auto` schiebt den Text an die Unterkante — dadurch setzen
     alle vier Karten ihn auf derselben Höhe an, egal wie lang der Titel ist. */
  .c-step__text {
    font: var(--font-body);
    margin-top: auto;
    color: var(--c-text-muted);
  }

  /* Die Dauer gehört zum Text darüber und nicht als eigener Block daneben —
     der Abstand der Karte (`gap: var(--sp-6)`, 40px) trennte sie zu weit und
     ließe sie wie eine zweite Angabe aussehen. Der negative Rand nimmt den
     Abstand zurück und setzt ihn auf `--sp-3`; beide Werte kommen aus den
     Tokens, gerechnet wird nur die Differenz.

     Since 2026-10-14 a clock stands in for the word "Dauer"; the word stays
     for screen readers (`.sr-only`). The figure comes from `shortDuration()`
     in the frontmatter. */
  .c-step__duration {
    margin-top: calc(var(--sp-3) - var(--sp-6));
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    font-family: var(--f-mono);
    font-size: var(--fs-text-small);
    line-height: var(--lh-text);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    /* The card surface's muted text (72 %): 60 % measured 4.29:1, just below
       AA. It now shares the colour of the step text above; the mono cut and
       the capitals keep the two apart. */
    color: var(--c-text-muted);
  }

  .c-step__duration svg {
    flex: 0 0 auto;
    width: 1.1em;
    height: 1.1em;
  }

  /* Das Wort trug hier kurzzeitig eine hellere Farbe als die Angabe. Das kam
     auf 2.77:1 und damit unter AA — `npm run web:check` hat es gemeldet.
     Beides steht jetzt in derselben Farbe; unterschieden wird über die
     Reihenfolge, nicht über den Kontrast. */
</style>
