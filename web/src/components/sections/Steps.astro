---
/**
 * Nummerierte Karten: der Ablauf einer Behandlung in wenigen Schritten.
 */
import type { Schritt } from "../../lib/fixtures";

interface Props {
  titel: string;
  schritte: Schritt[];
}

const { titel, schritte } = Astro.props;
---

<section class="s-steps">
  <div class="container">
    <h2 class="s-steps__title" data-split="lines">{titel}</h2>

    <div class="s-steps__grid" data-reveal-stagger="0.08">
      {schritte.map((s, i) => (
        <article class="c-step" data-reveal-child>
          <span class="c-step__num">{i + 1}</span>
          <h3 class="c-step__title">{s.titel}</h3>
          <p class="c-step__text">{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .s-steps {
    padding-block: var(--section-space);
  }

  .s-steps__title {
    text-align: center;
    max-width: 16ch;
    margin: 0 auto var(--sp-10);
    font-size: clamp(2rem, 3.7vw, 4rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .s-steps__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--site-gutter);
  }

  @media (max-width: 1000px) {
    .s-steps__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .s-steps__grid {
      grid-template-columns: 1fr;
    }
  }

  /* --- Schritt-Karte ----------------------------------------------------- */

  .c-step {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    min-height: 479px;
    padding: var(--sp-4);
    border-radius: var(--r-md);
    background: var(--c-neutral-200);
    color: var(--c-neutral-800);
  }

  .c-step__num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-round);
    background: var(--c-brand);
    color: var(--c-dark);
    font-family: var(--f-sans);
    font-size: var(--fs-text-main);
  }

  .c-step__title {
    font-size: clamp(1.5rem, 1.85vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  /* `margin-top: auto` schiebt den Text an die Unterkante — dadurch setzen
     alle vier Karten ihn auf derselben Höhe an, egal wie lang der Titel ist. */
  .c-step__text {
    margin-top: auto;
    font-size: var(--fs-text-main);
    line-height: 1.45;
    color: color-mix(in srgb, var(--c-neutral-800) 80%, transparent);
  }
</style>
