---
/**
 * Preisraster. Jede Karte trägt eine Bezeichnung und eine Preis-Pille, die
 * bündig unten sitzt — dadurch stehen die Pillen aller Karten auf einer Linie.
 */
import type { Preis } from "../../lib/formen";

interface Props {
  titel?: string;
  preise: Preis[];
}

const { titel = "Kosten", preise } = Astro.props;
---

<section class="s-prices container" id="kosten">
  <h2 class="s-prices__title" data-split="lines">{titel}</h2>
  <div class="s-prices__grid" data-reveal-stagger="0.08">
    {preise.map((p) => (
      <article class="c-price" data-reveal-child>
        <h3 class="c-price__name">{p.name}</h3>
        <span class="c-price__tag">{p.preis}</span>
      </article>
    ))}
  </div>
</section>

<style>
  .s-prices {
    padding-block: var(--section-space);
  }

  .s-prices__title {
    text-align: center;
    margin-bottom: var(--sp-10);
    font-size: clamp(2rem, 3.7vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .s-prices__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--site-gutter);
  }

  @media (max-width: 1000px) {
    .s-prices__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .s-prices__grid {
      grid-template-columns: 1fr;
    }
  }

  /* --- Preis-Karte -------------------------------------------------------
     Figma 29:3849: Name oben, rosa Preis-Pille unten über die volle
     Kartenbreite. 12px Innenabstand, Pille 50px hoch.

     316px standen im Entwurf, ließen aber zwischen Name und Pille eine große
     Leerfläche. Die Karte trägt nur zwei Zeilen; 210px reichen, damit alle
     gleich hoch bleiben und die Pille unten sitzt. */
  .c-price {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    min-height: 210px;
    padding: 12px;
    border-radius: var(--r-md);
    background: var(--c-neutral-200);
    color: var(--c-neutral-800);
  }

  .c-price__name {
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* `margin-top: auto` schiebt die Pille an die Unterkante — bei ein- und
     zweizeiligen Namen sitzt sie dadurch immer auf derselben Höhe. */
  .c-price__tag {
    display: grid;
    place-items: center;
    margin-top: auto;
    min-height: 50px;
    padding-inline: var(--sp-2);
    border-radius: var(--r-round);
    background: var(--c-brand);
    color: var(--c-dark);
    font-family: var(--f-mono);
    font-weight: 300;
    font-size: var(--fs-text-main);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
  }
</style>
