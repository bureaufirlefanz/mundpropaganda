---
/**
 * Preisraster. Jede Karte trägt eine Bezeichnung und eine Preis-Pille, die
 * bündig unten sitzt — dadurch stehen die Pillen aller Karten auf einer Linie.
 *
 * ── Die Zusätze für die Pillar Pages ─────────────────────────────────────
 *
 * `from`, `reduction`, `durability`, `note` und `disclaimer` sind wahlfrei
 * und **rein additiv**: Ohne sie entsteht exakt dasselbe Markup wie zuvor.
 * Das ist kein Zufall, sondern die Bedingung — die zwölf Leistungsseiten
 * pflegen fertige Beträge, und ein „ab", das sich von selbst davorsetzt,
 * hätte sie alle auf einmal umgeschrieben.
 *
 * Deshalb steht die reiche Fassung der Pille in einem eigenen Zweig, statt
 * die schlichte um zwei Spans zu erweitern. Ein Baustein, zwei Ausprägungen,
 * eine Gestaltung.
 *
 *   - **„ab" kommt aus einem Schalter, nicht aus dem getippten Wert.**
 *     Zahnärztliche Leistungen werden nach GOZ abgerechnet, ein Festpreis
 *     ist nicht zulässig. Stünde das Wort in den Daten, vergäße es jemand in
 *     einer Zeile.
 *   - **Der Abrechnungshinweis ist Pflicht, sobald Preise dastehen**
 *     (Briefing §8). Ohne ihn wirken die Beträge endgültig, und das sind sie
 *     nie.
 */
import type { Price } from "../../lib/shapes";

interface Props {
  /** Wahlfrei — siehe `ui/SectionHeading.astro`. Voreinstellung „Kosten“
      bleibt für die Leistungsseiten. */
  title?: string;
  pricing: Price[];
  /** Sprungmarke. Ohne Angabe bleibt es bei „kosten" wie bisher. */
  id?: string;
  /** Der Sonderfall, der in keine Zeile passt. */
  note?: string;
  /** Pflicht, sobald Preise dastehen — siehe Kopf. */
  disclaimer?: string;
}

const {
  title = "Kosten",
  pricing,
  id = "kosten",
  note,
  disclaimer,
} = Astro.props;

/* Ein gemeinsamer Schalter: Trägt irgendeine Zeile eine Zusatzangabe,
   halten alle Karten den Platz frei. Sonst endeten Karten derselben Reihe
   auf verschiedenen Höhen. */
const hasFacts = pricing.some((p) => p.reduction || p.durability);

/* So viele Spalten, wie es Karten gibt — auf dem Schirm stehen sie damit in
   EINER Reihe.

   Vorher waren es feste vier. Das ging, solange jede Preistabelle vier Zeilen
   hatte; mit der fünften Zeile der Veneers-Seite (Mock-up kam dazu) rutschte
   eine Karte allein in eine zweite Reihe und stand dort neben drei leeren
   Feldern.

   Ein fester Wert 5 wäre die falsche Antwort gewesen: Die Pillar Page führt
   vier Zeilen und bekäme dann ihrerseits eine Lücke. Die Zahl gehört an die
   Daten, nicht in die Gestaltung.

   Gedeckelt bei fünf, weil sechs Karten in einer Reihe schmäler werden als
   der längste Name („Non-Prep-Veneers") ihn tragen kann. Sechs und mehr
   laufen deshalb wieder in zwei Reihen zu je vier. */
/* Up to four cards in one row, more are split into rows of equal size
   (five become 3 + 2), the same rule as the steps. Each card is a quarter
   of the row wide whatever the count, so two cards stand centred at card
   width instead of stretching across the page. */
const rows = Math.ceil(pricing.length / 4);
const columns = Math.min(4, Math.ceil(pricing.length / rows));
---

<section class="s-prices container" id={id} data-toc-target={id}>
  {
    title && (
      <h2 class="s-prices__title" data-split="lines">
        {title}
      </h2>
    )
  }
  <div
    class="s-prices__grid"
    style={`--columns-wide: ${columns}`}
    data-reveal-stagger="0.08"
  >
    {
      pricing.map((p) => (
        <article class="c-price" data-surface="card" data-reveal-child>
          <h3 class="c-price__name">{p.name}</h3>

          {hasFacts && (
            <dl class="c-price__facts">
              {p.reduction && (
                <div class="c-price__fact">
                  <dt>Zahnabtrag</dt>
                  <dd>{p.reduction}</dd>
                </div>
              )}
              {p.durability && (
                <div class="c-price__fact">
                  <dt>Haltbarkeit</dt>
                  <dd>{p.durability}</dd>
                </div>
              )}
            </dl>
          )}

          {p.from || p.unit ? (
            /* Dreiteilig wie im Entwurf (Figma 177:2029): „AB" klein links, der
             Betrag groß in der Mitte, die Einheit klein rechts. Die beiden
             kleinen Teile stehen in eigenen Spans, damit sie im Lesefluss
             bleiben, während der Betrag Tabellenziffern bekommt. */
            <span class="c-price__tag c-price__tag--split">
              <span class="c-price__from">{p.from ? "ab" : ""}</span>
              <span class="c-price__amount">{p.price}</span>
              <span class="c-price__unit">{p.unit ?? ""}</span>
            </span>
          ) : (
            <span class="c-price__tag">{p.price}</span>
          )}
        </article>
      ))
    }
  </div>

  {
    note && (
      <p class="s-prices__note" data-reveal="up">
        {note}
      </p>
    )
  }
  {
    disclaimer && (
      <p class="s-prices__disclaimer" data-reveal="up">
        {disclaimer}
      </p>
    )
  }
</section>

<style>
  .s-prices {
    padding-block: var(--section-space);
  }

  .s-prices__title {
    text-align: center;
    margin-bottom: var(--sp-10);
    font-size: var(--fs-title-page);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-tight);
  }

  /* `auto-fit` tracks of a fixed share of the row, centred: a row of two
     stands in the middle at the width a card has in a row of four. Until
     2026-10-14 the tracks were `1fr` and two cards ran across the page. The
     fallback 4 applies if the property is missing. */
  .s-prices__grid {
    /* The count comes in as `--columns-wide` on the element and is copied
       here: an inline custom property would beat the media query below,
       so the query sets this one, not the inline one. */
    --price-columns: var(--columns-wide, 4);
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(
        0,
        calc(
          (100% - (var(--price-columns, 4) - 1) * var(--site-gutter)) /
            var(--price-columns, 4)
        )
      )
    );
    justify-content: center;
    gap: var(--site-gutter);
  }

  @media (max-width: 1000px) {
    .s-prices__grid {
      --price-columns: 2;
    }
  }

  @media (max-width: 600px) {
    .s-prices__grid {
      grid-template-columns: 1fr;
    }
  }

  /* --- Preis-Karte -------------------------------------------------------
     Figma 29:3849: Name oben, rosa Preis-Pille unten über die volle
     Kartenbreite. 12px Innenabstand, Pille 50px hoch.

     316px standen im Entwurf, ließen aber zwischen Name und Pille eine große
     Leerfläche. Die Karte trägt nur zwei Zeilen; 210px reichen, damit alle
     gleich hoch bleiben und die Pille unten sitzt. */
  .c-price {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    min-height: 210px;
    padding: var(--sp-2);
    border-radius: var(--r-md);
    background: var(--c-neutral-200);
    color: var(--c-text);
  }

  /* The 210px keep cards that stand side by side the same height. In one
     column there is no neighbour to match, and the full-width card showed
     a hollow box with the name at the top and the pill at the bottom. What
     separates the two now is the card's gap. */
  @media (max-width: 600px) {
    .c-price {
      min-height: 0;
    }
  }

  .c-price__name {
    font: var(--font-card-title);
    letter-spacing: var(--tracking-card-title);
    text-wrap: balance;
  }

  /* `margin-top: auto` schiebt die Pille an die Unterkante — bei ein- und
     zweizeiligen Namen sitzt sie dadurch immer auf derselben Höhe. */
  .c-price__tag {
    display: grid;
    place-items: center;
    margin-top: auto;
    min-height: 50px;
    padding-inline: var(--sp-2);
    border-radius: var(--r-round);
    background: var(--c-brand);
    color: var(--c-dark);
    font-family: var(--f-mono);
    font-weight: var(--fw-light);
    font-size: var(--fs-text-main);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: center;
  }

  /* --- Zusätze der Pillar Pages ------------------------------------------
     Alles hierunter greift nur, wenn die entsprechenden Angaben gepflegt
     sind. Die schlichte Karte der Leistungsseiten trifft keine dieser
     Regeln — `npm run web:styles` hält das fest. */

  .c-price__facts {
    display: grid;
    gap: var(--sp-2);
    margin: 0;
    font-size: var(--fs-text-main);
    line-height: var(--lh-text);
  }

  .c-price__fact {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--sp-3);
  }

  .c-price__fact dt {
    color: var(--c-text-muted);
  }

  .c-price__fact dd {
    margin: 0;
  }

  /* Drei Spalten: Die beiden kleinen Teile sind gleich breit, dadurch sitzt
     der Betrag mittig, auch wenn „ab" oder die Einheit fehlt. */
  /* `align-items: baseline` stellt „ab", Betrag und Einheit auf eine
     gemeinsame Schriftlinie — das ist richtig. Es zentriert die Zeile aber
     nicht in der Pille: Bei 76px Höhe saß der Betrag sichtbar zu hoch.
     `align-content: center` rückt die ganze Zeile in die Mitte, die
     gemeinsame Schriftlinie bleibt davon unberührt. */
  .c-price__tag--split {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    align-content: center;
    gap: var(--sp-2);
    /* Der Betrag ist jetzt so hoch wie eine Überschrift — die Pille von 50px
       wäre dafür zu knapp. */
    min-height: 68px;
    padding-inline: var(--sp-4);
  }

  /* „ab" und die Einheit bleiben Label: Monospace, klein, in Versalien —
     dieselbe Auszeichnung wie die Toplines der Seite. */
  .c-price__from,
  .c-price__unit {
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    font-weight: var(--fw-light);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .c-price__from {
    text-align: left;
  }

  .c-price__unit {
    text-align: right;
  }

  /* Der Betrag ist der Inhalt der Pille: Überschriftgrad und die Schrift der
     Seite, nicht die Monospace der Label um ihn herum. Tabellenziffern, damit
     die Beträge über die Karten hinweg auf derselben Stelle stehen. */
  .c-price__amount {
    font-family: var(--f-sans);
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-regular);
    line-height: var(--lh-heading);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-tight);
    text-transform: none;
  }

  .s-prices__note {
    font: var(--font-small);
    font-style: italic;
    max-width: var(--measure-long);
    margin: var(--sp-8) auto 0;
    color: var(--c-text-muted);
    text-align: center;
  }

  /* Kein Kleingedrucktes im abtuenden Sinn: Er ist der Grund, warum oben
     überhaupt „ab“ stehen darf. Gleiche Lesegröße wie die Anmerkung, ohne
     die Kursive, die ihn zur Randnotiz machen würde. */
  .s-prices__disclaimer {
    max-width: var(--measure-long);
    margin: var(--sp-6) auto 0;
    padding-top: var(--sp-6);
    border-top: var(--bw) solid var(--c-line);
    font-size: var(--fs-text-main);
    line-height: var(--lh-loose);
    color: var(--c-text-muted);
  }
</style>
