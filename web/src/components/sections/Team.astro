---
/**
 * Das Team: Überschrift, darunter das Raster aller Personen.
 *
 * **Ohne Porträts, und das ist die Entscheidung, nicht der Zwischenstand.**
 * Vorher standen hier nacheinander ein Kachelraster mit Bildern, ein Streifen
 * aus Gesichtern und ein Masonry aus Teamfotos. Alle drei brauchten von jeder
 * Person ein Foto in derselben Anmutung, und die gibt es nicht: Fotografiert
 * ist die Praxis, nicht die Belegschaft. Ein Raster, in dem drei Gesichter
 * stehen und elf graue Flächen, sieht nicht nach Team aus, sondern nach
 * Lücke — und je mehr Kolleginnen dazukommen, desto größer wird sie.
 *
 * Ohne Bilder trägt der Name. Das Raster kann damit vollständig sein, und
 * vollständig ist hier das Ziel: Wer wissen will, wer ihn behandelt, will
 * alle sehen und nicht die vier mit Foto.
 *
 * Das Porträt bleibt im Studio und erscheint auf der eigenen Seite der
 * Person — dort steht es allein und muss zu keinem zweiten passen.
 *
 * Jede Kachel führt auf `/praxis/<slug>`. Kein Aufklappen an Ort und Stelle:
 * Patienten suchen nach dem Namen ihrer Behandlerin, und eine Adresse, die
 * man teilen und finden kann, ist mehr wert als eine Animation.
 */
import CmsImage from "../ui/CmsImage.astro";
import { isCmsImage, type ImageSource } from "../../lib/images";

interface Member {
  name: string;
  slug: string;
  role: string;
  text?: string;
}

interface Props {
  id?: string;
  topline: string;
  headline: string;
  text?: string;
  photo?: ImageSource;
  members: Member[];
}

const { id, topline, headline, text, photo, members } = Astro.props;
---

<section class="s-team" id={id}>
  {
    /* Das Gruppenbild ist etwas anderes als ein Porträtraster: ein Bild, nicht
      vierzehn, und es zeigt die Praxis mit Menschen darin. Wenn im Studio
      keines hängt, beginnt der Abschnitt mit der Überschrift. */
  }
  {
    isCmsImage(photo) && (
      <div class="s-team__photo" data-reveal="scale">
        <CmsImage
          source={photo}
          alt=""
          widths={[640, 1024, 1600, 2200]}
          sizes="100vw"
        />
      </div>
    )
  }

  <div class="container">
    <div class="s-team__head">
      <span class="c-topline" data-reveal="fade">{topline}</span>
      <h2 class="s-team__title" data-split="lines">{headline}</h2>
      {
        text && (
          <p class="s-team__text" data-reveal="up" data-reveal-delay="0.1">
            {text}
          </p>
        )
      }
    </div>

    <ul class="s-team__list" data-reveal-stagger="0.06">
      {
        members.map((m) => (
          <li class="s-team__item" data-reveal-child>
            <a class="c-member" href={`/praxis/${m.slug}`}>
              <h3 class="c-member__name">{m.name}</h3>
              <p class="c-member__role">{m.role}</p>
              {m.text && <p class="c-member__text">{m.text}</p>}
              <span class="c-member__more">
                Zur Person
                <svg aria-hidden="true">
                  <use href="#i-arrow" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .s-team {
    padding-block: var(--section-space);
  }

  /* Über die volle Fensterbreite, oben gebogen wie die Linien im
     Hintergrund. Unten nur leicht gebrochen — das Foto soll die Section
     tragen und nicht darin schweben. */
  .s-team__photo {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-bottom: var(--flow-xl);
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--c-tint);
  }

  /* :global(img), weil das Bild aus CmsImage.astro kommt. */
  .s-team__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .s-team__head {
    max-width: 46ch;
    margin-bottom: var(--flow-lg);
  }

  .s-team__title {
    max-width: 18ch;
    margin-top: var(--sp-4);
    font-size: var(--fs-title);
    font-weight: var(--fw-regular);
    line-height: var(--lh-title);
    letter-spacing: var(--tracking-snug);
  }

  .s-team__text {
    max-width: 52ch;
    margin-top: var(--sp-5);
    font-size: var(--fs-text-main);
    line-height: 1.55;
    color: var(--c-text-muted);
  }

  /* --- Das Raster ------------------------------------------------------- */

  /* `auto-fill` und nicht `auto-fit`: Bei zwei Personen sollen zwei Kacheln
     in normaler Breite stehen und nicht zwei über die halbe Seite gezogene.
     Die Spaltenzahl hängt damit an der Fensterbreite und nicht an der Anzahl
     der Personen im Studio — dieselbe Seite sieht bei zwei und bei vierzehn
     Kolleginnen gleich aus, nur länger.

     `--member-col` ist die Mindestbreite einer Kachel und damit eine
     Gestaltungsgröße dieses Bausteins, kein Abstand: Unter etwa 15rem
     bräche der längste Rollentext („Zahnmedizinische
     Prophylaxeassistenz“) in vier Zeilen. */
  .s-team__list {
    --member-col: 15rem;

    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--member-col), 1fr));
    gap: var(--flow-sm) var(--site-gutter);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* --- Die Kachel ------------------------------------------------------- */

  /* Eine Linie oben statt eines Kastens. Dieselbe Sprache wie die
     Leistungstabelle, die Stellenliste und die Vorteile: Was zusammengehört,
     steht unter einer gemeinsamen Linie, statt in einem eigenen Rahmen zu
     sitzen. Bei vierzehn Kacheln wären vierzehn Rahmen ein Formular. */
  .c-member {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding-top: var(--sp-4);
    border-top: var(--bw) solid var(--c-line);
    color: inherit;
    text-decoration: none;
  }

  .c-member__name {
    font-size: var(--fs-text-large);
    font-weight: var(--fw-regular);
    line-height: 1.25;
    letter-spacing: var(--tracking-snug);
  }

  .c-member__role {
    margin-top: var(--sp-1);
    font-size: var(--fs-text-small);
    line-height: 1.35;
    color: var(--c-text-muted);
  }

  .c-member__text {
    margin-top: var(--sp-3);
    font-size: var(--fs-text-small);
    line-height: var(--lh-text);
    color: var(--c-text-muted);
  }

  /* `margin-top: auto` schiebt die Zeile an den unteren Rand der Kachel —
     bei ungleich langen Kurzprofilen stehen sie damit trotzdem auf einer
     Linie. */
  .c-member__more {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: auto;
    padding-top: var(--sp-4);
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .c-member__more svg {
    width: 1em;
    height: 1em;
    transition: translate var(--d-base) var(--e-out);
  }

  /* Die Linie ist das Element, das auf den Zeiger reagiert — sie ist über
     die ganze Kachelbreite sichtbar, der Pfeil nur an ihrem Ende. */
  @media (hover: hover) {
    .c-member:hover {
      border-top-color: var(--c-dark);
    }

    .c-member:hover .c-member__more svg {
      translate: 4px 0;
    }
  }

  .c-member:focus-visible {
    outline: 2px solid var(--c-dark);
    outline-offset: 6px;
    border-radius: var(--r-sm);
  }

  @media (max-width: 900px) {
    .s-team {
      padding-block: var(--section-space-sm);
    }

    .s-team__photo {
      aspect-ratio: 4 / 3;
    }
  }
</style>
