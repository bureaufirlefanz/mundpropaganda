---
/**
 * Das Team: Gruppenfoto über die volle Breite, darunter das Raster.
 *
 * Die Reihenfolge ist der Punkt. Erst alle zusammen, dann jede einzeln — wer
 * mit dem Raster beginnt, zeigt eine Personaldatenbank. Das Foto beantwortet
 * die Frage, die niemand stellt und jeder hat: Wie ist es da drin.
 *
 * Jede Kachel führt auf `/praxis/<slug>`. Kein Aufklappen an Ort und Stelle:
 * Patienten suchen nach dem Namen ihrer Behandlerin, und eine Adresse, die
 * man teilen und finden kann, ist mehr wert als eine Animation.
 *
 * Ohne Porträt bleibt die Kachel ein Namensfeld mit Markenfläche. Das ist
 * bewusst so und nicht mit einem Platzhaltergesicht gelöst — ein fremdes
 * Gesicht auf einer Praxisseite ist die teuerste Art von Füllmaterial.
 */
import CmsImage from "../ui/CmsImage.astro";
import Picture from "../ui/Picture.astro";
import { isCmsImage, type ImageSource } from "../../lib/images";

interface Member {
  name: string;
  slug: string;
  role: string;
  text?: string;
  image?: ImageSource;
}

interface Props {
  id?: string;
  topline: string;
  headline: string;
  text?: string;
  photo?: ImageSource;
  members: Member[];
}

const { id, topline, headline, text, photo, members } = Astro.props;




---

<section class="s-team" id={id}>
  {isCmsImage(photo) && (
    <div class="s-team__photo" data-reveal="scale">
      <CmsImage
        source={photo}
        alt=""
        widths={[640, 1024, 1600, 2200]}
        sizes="100vw"
      />
    </div>
  )}

  <div class="container s-team__inner">
    <div class="s-team__head">
      <span class="c-topline" data-reveal="fade">{topline}</span>
      <h2 class="s-team__title" data-split="lines">{headline}</h2>
      {text && <p class="s-team__text" data-reveal="up" data-reveal-delay="0.1">{text}</p>}
    </div>

    {/* Keine Fotos in diesem Abschnitt.

        Hier stand nacheinander ein Raster aus Personenkacheln, ein Streifen
        aus Porträts und zuletzt ein Masonry aus Teamfotos. Alle drei zeigten
        Menschen ohne Namen — und ohne Namen ist ein Gesicht auf einer
        Praxisseite eine Behauptung, keine Auskunft.

        Der Abschnitt trägt jetzt nur seinen Text. Sobald die Personenseiten
        stehen, kommen die Kacheln mit Namen und Verweis zurück; bis dahin ist
        weniger richtiger. Die Fotos liegen weiterhin in der Pipeline und
        heißen `team-*`. */}
  </div>
</section>

<style>
  .s-team {
    padding-block: var(--section-space);
  }

  /* Über die volle Fensterbreite, oben gebogen wie die Linien im
     Hintergrund. Unten nur leicht gebrochen — das Foto soll die Section
     tragen und nicht darin schweben. */
  .s-team__photo {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-bottom: var(--flow-xl);
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--c-dark) 8%, transparent);
  }

  /* :global(img), weil das Bild aus CmsImage.astro kommt. */
  .s-team__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Text links, Gesichter rechts.

     Vorher standen beide untereinander und beide linksbündig: Der Kopf war
     auf 46 Zeichen gedeckelt, der Porträtstreifen auf 260px je Bild — bei
     zwei Personen blieb damit die rechte Hälfte des Abschnitts leer, über
     die ganze Höhe. Nebeneinander tragen sich die beiden gegenseitig.

     `align-items: start`, damit der Text oben steht und nicht auf die Mitte
     eines möglicherweise zweizeiligen Porträtstreifens rutscht. */
  .s-team__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--sp-8), 5vw, 96px);
    align-items: start;
  }

  .s-team__head {
    max-width: 46ch;
  }

  .s-team__title {
    max-width: 18ch;
    margin-top: var(--sp-4);
    font-size: var(--fs-h2);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .s-team__text {
    max-width: 52ch;
    margin-top: var(--sp-5);
    font-size: var(--fs-text-main);
    line-height: 1.55;
    color: var(--c-text-muted);
  }

  /* Ein Streifen aus Gesichtern, kein Kartenraster.

     Flex und nicht Grid mit `auto-fit`: Das Raster verteilte die vorhandenen
     Spalten auf die volle Breite, und bei zwei Personen wurden daraus zwei
     Porträts von je 700px. Der Abschnitt bestand dann aus zwei Gesichtern
     und sonst nichts.

     `flex-basis` mit Obergrenze: Ein Porträt wird nie breiter als 260px,
     egal wie wenige es sind. Kommen mehr dazu, füllen sie die Zeile und
     rutschen erst dann um. Die Größe hängt damit an der Gestaltung und
     nicht an der Anzahl der Personen im Studio. */
  
  
  /* Hochformat wie ein Porträt, oben gerundet wie die übrigen Bildflächen
     der Seite. */
  .s-team__face {
    aspect-ratio: 3 / 4;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--c-dark) 8%, transparent);
  }

  .s-team__face :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  /* --- Die Kachel ------------------------------------------------------- */

  .c-member {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .c-member__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    /* Oben gebogen, unten gebrochen — dieselbe Form wie die großen Bilder
       der Seite, nur kleiner. */
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--c-dark) 8%, transparent);
  }

  .c-member__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--d-slow) var(--e-out);
  }

  .c-member:hover .c-member__media :global(img) {
    transform: scale(1.04);
  }

  /* Ohne Porträt: die Initiale auf Markenfläche. Kein Platzhaltergesicht. */
  .c-member__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--c-brand);
    color: var(--c-dark);
    font-size: var(--fs-display-sm);
    font-weight: 500;
    line-height: 1;
  }

  .c-member__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--sp-1);
    padding-top: var(--sp-4);
  }

  .c-member__name {
    font-size: var(--fs-text-large);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .c-member__role {
    font-size: var(--fs-text-small);
    line-height: 1.35;
    color: var(--c-text-muted);
  }

  .c-member__text {
    margin-top: var(--sp-2);
    font-size: var(--fs-text-small);
    line-height: 1.45;
    color: var(--c-text-muted);
  }

  /* `margin-top: auto` schiebt die Zeile an den unteren Rand der Kachel —
     bei ungleich langen Kurzprofilen stehen sie damit trotzdem auf einer
     Linie. */
  .c-member__more {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: auto;
    padding-top: var(--sp-4);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .c-member__more svg {
    transition: translate var(--d-base) var(--e-out);
  }

  .c-member:hover .c-member__more svg {
    translate: 4px 0;
  }

  .c-member:focus-visible {
    outline: 2px solid var(--c-dark);
    outline-offset: 6px;
    border-radius: var(--r-sm);
  }

  @media (max-width: 900px) {
    /* Untereinander: Zwei Spalten auf einem Telefon wären zwei Schlitze. */
    .s-team__inner {
      grid-template-columns: 1fr;
      gap: var(--flow-sm);
    }

    .s-team {
      padding-block: var(--section-space-sm);
    }

    .s-team__photo {
      aspect-ratio: 4 / 3;
    }
  }
</style>
