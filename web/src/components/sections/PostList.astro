---
/**
 * Die Beiträge als Raster — die Übersicht unter /magazin.
 *
 * Zeigt dieselbe Karte wie das Karussell auf der Startseite. Bis hierher war
 * es eine zweite, flachere: Bild oben, Text darunter. Die Begründung dafür
 * stand hier und war richtig, aber sie zielte auf die falsche Stellschraube.
 * Sie lautete: In einem Raster aus drei Spalten stoßen die Überlappungen
 * aneinander. Das stimmt — die Komposition rechnet in Anteilen ihrer eigenen
 * Breite und braucht rund 420px. Bei drei Spalten hat sie die nicht, bei
 * zwei schon. Also zwei Spalten und eine Karte statt drei Spalten und zwei
 * Karten.
 */
import PostKarte from "../ui/PostCard.astro";
import Filter from "../ui/Filter.astro";
import type { Post } from "../../lib/magazine";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

/* Nur die Kategorien, unter denen wirklich etwas liegt — in der Reihenfolge,
   in der sie zuerst auftauchen, also nach Datum. Eine feste Reihenfolge aus
   dem Schema abzuschreiben wäre die zweite Stelle, an der dieselbe Liste
   steht. */
const categories = [
  ...new Set(posts.map((b) => b.category).filter(Boolean)),
] as string[];
---

<section class="container s-postlist">
  <div class="s-postlist__bar">
    <Filter categories={categories} total={posts.length} />
  </div>

  <div class="s-postlist__grid" data-reveal-stagger="0.06">
    {
      posts.map((p, i) => (
        <PostKarte
          post={p}
          sizes="(max-width: 640px) 94vw, (max-width: 1000px) 47vw, 31vw"
          withButton
          headingLevel="h2"
          variant="card"
          data-reveal-child
        />
      ))
    }
  </div>
</section>

<style>
  .s-postlist {
    padding-block: var(--section-space-sm) var(--section-space);
  }

  /* Die Leiste steht über dem Raster und behält ihre Höhe, auch wenn kein
     Filter gerendert wird (eine einzige Kategorie) — sonst rückte das Raster
     auf manchen Seiten hoch und auf anderen nicht. */
  .s-postlist__bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 44px;
    margin-bottom: var(--sp-8);
  }

  /* Drei Spalten, die klassische Karte (`variant="card"`): eine Fläche mit
     Bild, Text und Button, alles linksbündig. Die versetzte Überlappung des
     Karussells trägt in 400px Spaltenbreite keinen langen Titel samt
     Anriss; seit 2026-10-14 zeigt die Übersicht deshalb die einfache Form.

     Die Zellen dehnen die Karten auf Reihenhöhe; der Button sitzt in der
     Karte unten, also enden alle Karten einer Reihe auf derselben Linie. */
  .s-postlist__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: var(--flow-lg) var(--site-gutter);
  }

  @media (max-width: 1000px) {
    .s-postlist__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .s-postlist__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-10) 0;
    }
  }
</style>
