---
/**
 * Nummerierte Punkte links, ein zahnförmig maskiertes Foto rechts.
 *
 * Überschrift und Punkte sind Pflicht und kommen aus dem CMS — keine Vorgaben
 * mehr im Frontmatter.
 *
 * Die Motive in der Zahnmaske hängen am einzelnen Punkt und kommen aus dem
 * CMS: Zu jedem Punkt gehört ein Bild, und beim Weiterwandern blendet es um.
 * Es gab dafür einmal ein Feld `standardsBild` am Abschnitt — eines für fünf
 * Motive, das deshalb nichts bewirken konnte. Jetzt hängt es richtig.
 *
 * Ohne gepflegtes Bild greift das gestaltete Motiv an derselben Position.
 */
import Button from "../ui/Button.astro";
import Thread from "../ui/Thread.astro";
import ToothRings from "../ui/ToothRings.astro";
import CmsImage from "../ui/CmsImage.astro";
import Picture from "../ui/Picture.astro";
import { isCmsImage, type ImageSource } from "../../lib/images";

interface Props {
  title: string;
  items: { name: string; text?: string; image?: ImageSource }[];
}

const { title, items } = Astro.props;

/* Ein Bild je Aussage, positionsgenau — die fünf Punkte stehen im Studio in
   fester Reihenfolge, und jeder trägt hier das Motiv, das ihn belegt:

     0  Modernste Technik              das 3D-Röntgen
     1  Individuelle Beratung          das Gespräch mit der Patientin
     2  Kompromisslose Qualität        die Arbeit im eigenen Labor
     3  Angenehme Atmosphäre           der Wartebereich am Fenster
     4  Nachhaltig auf allen Ebenen    das Lastenrad der Praxis

   Vorher standen hier Mikroskop, Veneer und Instrumente, verteilt nach
   Position — „Nachhaltigkeit" lag auf einem Tablett mit Sonden. Die
   Reihenfolge ist damit nicht mehr beliebig: Kommt ein sechster Punkt dazu,
   gehört sein Bild hier ergänzt und nicht per modulo geraten. */
const MOTIFS = [
  /* 0  Modernste Technik           das eigene Labor, hochformatig
     1  Individuelle Beratung       die Patientin im Gespräch, senkrecht gebaut
     2  Kompromisslose Qualität     die Arbeit an der Hand, im Labor
     3  Angenehme Atmosphäre        der Diffusor, hochformatig
     4  Nachhaltig auf allen Ebenen das Lastenrad der Praxis

     Vorher stand auf Platz 1 `beratung-hannes`: Hannes quer am Tisch, mit
     einem Ausschnitt von 60/40 aus dem Bild geholt. In der hochformatigen
     Silhouette blieb links Wand und unten Tischplatte übrig. Die Patientin
     ist senkrecht aufgebaut, Kopf oben, Körper darunter, und füllt das
     Format aus der Mitte heraus. */
  "labor-detail",
  "beratung-patientin",
  "labor-hand-implantat",
  "diffusor-atmo",
  "lastenrad-nachhaltig",
];

/* Der Bildausschnitt je Motiv.
 *
 * Die Bühne ist eine Zahnsilhouette im Hochformat (1946 : 2611). Ein
 * Querformat aus der Kamera verliert darin beide Seiten, und was übrig
 * bleibt, entscheidet `object-position`. Ohne Angabe steht die Mitte, und die
 * ist bei einem Gespräch am Tisch selten der Kopf.
 *
 * Nur wo die Mitte falsch liegt — die beiden Hochformate brauchen nichts. */
const AUSSCHNITT: Record<string, string> = {
  /* Weit nach rechts, damit das Bild nach LINKS rückt: `object-position`
     sagt, welcher Teil des Fotos an der Kante des Kastens anliegt. Aus der
     Mitte lag ihr Gesicht genau auf der rechten Kante der Silhouette und
     wurde halbiert.
     
     100% ist der Anschlag: die rechte Kante des Fotos an der rechten Kante
     der Silhouette, weiter nach links geht nicht. Dabei kommt Hannes von
     rechts ganz ins Bild, und aus dem Einzelporträt wird das Gespräch zu
     zweit — was der Punkt „Individuelle Beratung" ohnehin behauptet. Die
     Werte dazwischen sind die schlechteren: Bei 85 bis 92% steht nur ein
     Stück seines Kopfes im Bild, und genau das sah angeschnitten aus. */
  "beratung-patientin": "100% 50%",
  "labor-hand-implantat": "center 45%",
  "lastenrad-nachhaltig": "40% center",
};
---

{
  /* ==================================================================
           WIR SETZEN NEUE STANDARDS
           ================================================================== */
}
<section class="s-standards" data-standards>
  <Thread />

  <div class="s-standards__figure" aria-hidden="true">
    {
      /* Zwei Ebenen mit derselben Zahnmaske: die hintere ist minimal
               größer und liefert dadurch den weichen Rand. Alle Motive
               liegen übereinander, active ist immer genau eines. */
    }
    {
      /* Eines je Punkt, in derselben Reihenfolge — standards.js schaltet
              nach Index um. Als feste Fünferliste konnte das auseinanderlaufen,
              sobald jemand einen sechsten Punkt anlegte. */
    }
    <div class="s-standards__stage" data-standards-stage>
      {
        items.map((e, i) => {
          const motiv = MOTIFS[i % MOTIFS.length];
          const stil = AUSSCHNITT[motiv]
            ? `object-position: ${AUSSCHNITT[motiv]};`
            : undefined;

          /* `Picture` für die lokalen Motive und nicht `CmsImage` mit
                 einem Pfad: Nur das erste liefert AVIF und WebP als <source>
                 samt srcset. Vorher stand hier eine einzelne 1024er WebP —
                 die Bühne misst bei 1440px Fensterbreite rund 576 CSS-Pixel,
                 auf einem 2×-Schirm also 1152. Das Bild wurde hochskaliert
                 ausgeliefert und sah entsprechend weich aus.

                 1600 als größte Stufe deckt das ab; darüber lohnt es nicht,
                 die Maske schneidet ohnehin die Hälfte weg. */
          return isCmsImage(e.image) ? (
            <CmsImage
              source={e.image}
              alt=""
              widths={[640, 1024, 1600]}
              sizes="(max-width: 900px) 70vw, 40vw"
              style={stil}
              data-standards-img
            />
          ) : (
            <Picture
              name={motiv}
              alt=""
              sizes="(max-width: 900px) 70vw, 40vw"
              style={stil}
              data-standards-img
            />
          );
        })
      }
    </div>
    <ToothRings />
  </div>

  <div class="container">
    <h2 class="s-standards__title" data-split="lines">{title}</h2>

    <div class="s-standards__list" data-standards-list>
      {
        items.map((e, i) => (
          <div
            class="s-standards__row"
            data-standards-row
            data-active={i === 0 ? "true" : undefined}
          >
            <span class="s-standards__num">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="s-standards__name">{e.name}</h3>
            <p class="s-standards__text">{e.text}</p>
            <span class="s-standards__bar" data-standards-bar>
              <i />
            </span>
          </div>
        ))
      }
    </div>

    <div class="s-standards__foot">
      <Button label="Termin buchen" href="#kontakt" variant="dark" />
    </div>
  </div>
</section>

<style>
  /* Nummerierte Zeilen; die aktive Zeile ist voll deckend, der Rest gedimmt.
     Aktivierung per ScrollTrigger.

     clip statt hidden, und nur waagerecht: die Zahnfigur läuft rechts aus
     dem Bild und muss beschnitten werden, der Pfad (s-thread) ist aber ein
     Kind dieser Section und reicht bis in die Stories hinunter. Mit
     `overflow: hidden` endete er an der Sectionkante — sichtbar war nur das
     Stück in den Standards.
     `clip` ist hier das richtige Werkzeug: nur es lässt sich mit `visible`
     auf der anderen Achse kombinieren, `hidden` erzwingt dort `auto`. */
  .s-standards {
    position: relative;
    padding-block: var(--section-space);
    overflow-x: clip;
    overflow-y: visible;
  }

  /* Display-2-Grad (125px @1728) auf Zeilenhöhe 1 — im Entwurf ergeben die
     zwei Zeilen exakt 250px. */
  .s-standards__title {
    max-width: 12ch;
    margin-bottom: var(--flow-2xl);
    font-size: var(--fs-display-2);
    font-weight: var(--fw-medium);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tighter);
  }

  /* Zeilenraster 150px: Inhalt max. 124px plus 26px Innenabstand.
     Spalten 88 / 1fr / 1fr entsprechen den Entwurfsbreiten. */
  .s-standards__row {
    position: relative;
    display: grid;
    grid-template-columns: clamp(48px, 5.1vw, 88px) minmax(0, 1fr) minmax(
        0,
        1fr
      );
    gap: var(--site-gutter);
    align-items: start;
    padding-block: clamp(18px, 1.5vw, 26px);
    border-bottom: var(--bw) solid var(--c-line);
    /* 0.75 und nicht 0.42.

       Die inaktiven Zeilen sind kein Beiwerk: Alle fünf Standards stehen
       hier als Text, und wer die Seite ohne Bewegung öffnet („Bewegung
       reduzieren"), sieht sie dauerhaft in diesem Zustand. Gemessen ergab
       0.42 einen Kontrast von 2.14:1 gegen den Grund — WCAG 1.4.3 verlangt
       4.5:1 für Fließtext. 0.75 liegt bei 4.53:1.

       Die Abstufung bleibt: die aktive Zeile steht bei 8.47:1, dazu Balken,
       Ziffer und das wechselnde Bild. Das Gefälle trägt also mehr als die
       Deckkraft allein. */
    opacity: 0.75;
    cursor: default;
    transition: opacity var(--d-base) var(--e-swift);
  }

  .s-standards__row[data-active="true"] {
    opacity: 1;
  }

  /* Fortschrittsbalken auf der Trennlinie der aktiven Zeile. Er ersetzt sie
     optisch, statt eine zweite Linie danebenzusetzen. */
  .s-standards__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    overflow: hidden;
    pointer-events: none;
  }

  .s-standards__bar i {
    display: block;
    height: 100%;
    background: var(--c-brand);
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* Der Balken wird 2px stark, sobald die Zeile active ist — sonst wäre er
     auf der Haarlinie kaum zu sehen. */
  .s-standards__row[data-active="true"] .s-standards__bar {
    height: 2px;
    bottom: -1.5px;
  }

  .s-standards__num {
    font-family: var(--f-mono);
    font-weight: var(--fw-light);
    font-size: var(--fs-title-xs);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-mono);
  }

  /* Die Umbrüche stehen im Markup als <br>: kein Wert für max-width teilt
     alle fünf Namen gleichmäßig auf zwei Zeilen — die kurzen bräuchten eine
     schmale Spalte, die langen eine breite. text-wrap: balance bleibt als
     Rückfall für später ergänzte Einträge. */
  .s-standards__name {
    font-size: var(--fs-title);
    font-weight: var(--fw-regular);
    line-height: var(--lh-headline);
    letter-spacing: var(--tracking-snug);
    max-width: 18ch;
    text-wrap: balance;
  }

  /* Schmaler gesetzt, damit zwischen Textspalte und Zahnmaske rechts Luft
     bleibt. */
  .s-standards__text {
    font-size: var(--fs-text-small);
    line-height: var(--lh-body);
    max-width: 34ch;
  }

  .s-standards__foot {
    margin-top: var(--flow-2xl);
  }

  /* Die Zahn-Silhouette rechts: ein zahnförmig maskiertes Foto, darüber die
     konzentrischen Pink-Konturen (ToothRings.astro). Ragt bewusst über den
     Rand hinaus.
     Im Entwurf reicht die Figur über die gesamte Sectionhöhe — deshalb über
     die Höhe bemaßt, die Breite ergibt sich aus dem Seitenverhältnis. Weit
     nach rechts geschoben und stärker angeschnitten: die Textspalten
     brauchen die Breite, die Figur trägt allein über ihre Silhouette. */
  .s-standards__figure {
    position: absolute;
    right: -21vw;
    top: 7%;
    height: 80%;
    pointer-events: none;
    z-index: 0;
  }

  /* Hinweis zur Maske: tooth-shape.svg ist eine einzige, sich nach innen
     windende Spirale. Gefüllt ergibt sie die Zahnfläche — genau das brauchen
     wir. Gestrichen ergäbe sie dagegen die komplette Spirale, weshalb hier
     bewusst nur mit Flächen und nicht mit Konturen gearbeitet wird. */
  .s-standards__stage {
    position: relative;
    height: 100%;
    aspect-ratio: 1946 / 2611;
    mask-image: url("/svg/tooth-silhouette.png");
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-image: url("/svg/tooth-silhouette.png");
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
  }

  .s-standards__stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    will-change: opacity, transform;
  }

  .s-standards__stage img:first-child {
    opacity: 1;
  }

  /* Der Textblock liegt über der Figur. Die Zeilen enden vorher, damit sie
     nicht in die Zahnkontur hineinlaufen — so ist es auch im Entwurf. */
  .s-standards .container {
    position: relative;
    z-index: 1;
  }

  /* Die Liste endet vor der Zahnfigur — im Entwurf 937px von 1632px
     Containerbreite. */
  .s-standards__list {
    max-width: 66%;
  }

  @media (max-width: 900px) {
    .s-standards__list {
      max-width: none;
    }

    .s-standards__row {
      grid-template-columns: 40px 1fr;
    }

    .s-standards__text {
      grid-column: 2;
    }

    .s-standards__figure {
      display: none;
    }
  }

  /* Gestapelt braucht jede Zeile mehr Luft als nebeneinander. Auf dem großen
     Schirm stehen Titel und Text in zwei Spalten und die Zeile ist zwei bis
     drei Zeilen hoch — 18px oben und unten reichen, um sie zu trennen. Hier
     steht der Text UNTER dem Titel, die Zeile wird fünf bis sechs Zeilen
     hoch, und derselbe Innenabstand lässt die Blöcke aneinanderstoßen: Der
     Abstand innerhalb einer Zeile ist dann größer als der zwischen zweien.
     Genau das führt der Gliederung zuwider. */
  @media (max-width: 700px) {
    .s-standards__row {
      padding-block: var(--sp-6);
      row-gap: var(--sp-3);
    }
  }
</style>
