---
/**
 * Alternierende Bild/Text-Zeilen. Jede zweite Zeile dreht die Reihenfolge um,
 * dadurch wandert das Bild im Wechsel von links nach rechts.
 */
import Picture from "../ui/Picture.astro";
import CmsImage from "../ui/CmsImage.astro";
import { isCmsImage, type ImageSource } from "../../lib/images";

interface FeatureRow {
  topline: string;
  title: string;
  text: string;
  /** Bild aus dem CMS. Fehlt es, greift `motif` oder das Motiv an derselben Position. */
  image?: ImageSource;
  /**
   * Ein bestimmtes Motiv aus der Bildpipeline statt des Rückfalls nach
   * Position.
   *
   * Nötig, seit der Baustein auch außerhalb der Leistungsseiten steht: Dort
   * passt die Reihenfolge in `MOTIFS` zum Entwurf, auf der Praxisseite zeigte
   * die Zeile über das Labor dadurch ein Mikroskop. Wer ein Thema setzt,
   * setzt hier auch das Bild dazu.
   */
  motif?: string;
}

interface Props {
  lines: FeatureRow[];
}

const { lines } = Astro.props;

/* Klasse 3: die gestalteten Motive, in der Reihenfolge des Entwurfs. Über den
   Index und modulo, damit eine vierte Zeile nicht ohne Bild dasteht — und
   damit nicht alle Zeilen dasselbe Motiv tragen. */
/* `veneers-modell` stand hier bis hierher an zweiter Stelle — dasselbe Motiv,
   das die Navigationsempfehlung auf JEDER Seite zeigt. Damit lief es einem
   auf 28 von 29 Seiten zweimal über den Weg. `beratung-modell` ist neu und
   war nirgends verwendet. */
const MOTIFS = [
  "wurzelbehandlung-mikroskop",
  "beratung-modell",
  "labor-hand-implantat",
];
---

<section class="section section--flush">
  <div class="container">
    {
      lines.map((row, i) => (
        <div class:list={["s-feature", i % 2 === 1 && "s-feature--reverse"]}>
          <div class="s-feature__media" data-reveal="scale">
            {isCmsImage(row.image) ? (
              <CmsImage
                source={row.image}
                alt=""
                widths={[640, 1024, 1600, 2200]}
                sizes="(max-width: 900px) 100vw, 50vw"
                data-parallax="8"
              />
            ) : (
              <Picture
                name={row.motif ?? MOTIFS[i % MOTIFS.length]}
                alt=""
                sizes="(max-width: 900px) 100vw, 50vw"
                parallax="8"
              />
            )}
          </div>
          <div class="s-feature__body" data-reveal="up">
            <span class="c-topline">{row.topline}</span>
            <h3 class="s-feature__title" data-split="lines">
              {row.title}
            </h3>
            {/* Leerzeile trennt Absätze.
              Das Studio-Feld ist mehrzeilig (`type: "text"`), gerendert wurde
              aber ein einziges `<p>` — zwei Absätze liefen darin zu einem
              Block zusammen, weil HTML Zeilenumbrüche schluckt. Der Baustein
              war darauf schon eingerichtet: `.s-feature__body` ist eine
              Flex-Spalte mit `gap`, und die Regel darunter greift auf `p`,
              nicht auf ein einzelnes Element. */}
            {row.text.split(/\n{2,}/).map((absatz) => (
              <p>{absatz.trim()}</p>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .s-feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--site-gutter);
    align-items: center;
    padding-block: var(--sp-10);
  }

  .s-feature + .s-feature {
    padding-top: 0;
  }

  .s-feature__media {
    aspect-ratio: 800 / 706;
    border-radius: var(--r-md);
    overflow: hidden;
    /* Eigene Ebene, damit die Rundung bei bewegtem Bild nicht pro Frame neu
       gegen die Bildkante gerechnet wird. */
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  /* :global(img), weil das Bild aus Picture.astro kommt. */
  .s-feature__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }

  .s-feature__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    max-width: 42ch;
    padding-inline: var(--sp-5);
  }

  .s-feature__title {
    font-size: var(--fs-title-md);
    font-weight: var(--fw-medium);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
  }

  .s-feature__body p {
    font-size: var(--fs-text-main);
    color: var(--c-text-muted);
    line-height: var(--lh-text);
  }

  .s-feature--reverse .s-feature__media {
    order: 2;
  }

  @media (max-width: 900px) {
    .s-feature {
      grid-template-columns: 1fr;
    }

    /* Auf einer Spalte steht das Bild immer oben — sonst führte die
       umgekehrte Zeile mit dem Text und der Wechsel ginge verloren. */
    .s-feature--reverse .s-feature__media {
      order: -1;
    }

    .s-feature__body {
      padding-inline: 0;
    }
  }
</style>
