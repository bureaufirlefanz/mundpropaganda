---
/**
 * Dieselbe Section wie im Prototyp — Markup und Klassen unverändert, nur
 * die Inhalte kommen jetzt aus der Datenschicht. Die data-Attribute bleiben
 * erhalten, dadurch greift standards.js ohne Anpassung.
 */
import type { Entry, TextWithLinks } from "../../lib/shapes";
import CmsImage from "../ui/CmsImage.astro";
import Picture from "../ui/Picture.astro";
import { isCmsImage } from "../../lib/images";

interface Props {
  topline: string;
  headline: string;
  items: Entry[];
  /**
   * Der Satz unter der Liste, der weiterführt.
   *
   * Wahlfrei und ohne ihn unverändert: Die Aufzählung erklärt drei Arten
   * kurz, und wer es genauer will, gehört auf die Seite, die es genauer
   * erklärt. Die Ziele stehen im Repository, nicht im Studio — siehe
   * `TextWithLinks` in `lib/shapes.ts`.
   */
  footnote?: TextWithLinks;
}
const { topline, headline, items, footnote } = Astro.props;

/* Klasse 3: die gestalteten Motive, positionsgenau. Sie kamen bis Aufgabe 4
   aus `mitRueckfall` in der Datenschicht — dort waren sie falsch aufgehoben,
   weil die Datenschicht die Motive eines Bausteins nicht kennen muss. Jetzt
   stehen sie neben dem Markup, das sie zeigt.
   Über den Index und modulo: Ohne das trüge jeder Punkt dasselbe Bild, und
   der Wechsel beim Aufklappen wäre nicht zu sehen.

   **Nur Technik und Modell.** Hier standen ein Teamfoto, die Teeküche und
   das Laborteam — also Menschen und Atmosphäre. Der Abschnitt zählt
   Merkmale einer Behandlung auf, und daneben gehört das, worüber er redet:
   die Arbeit am Modell, der Bildschirm im Behandlungszimmer, das gerichtete
   Besteck. Kein Porträt, kein Raum ohne Anlass.

   Alle drei waren bis hierher nirgends verwendet — die Seiten wiederholten
   dieselben zehn Motive. */
const MOTIFS = ["modell-arbeit", "behandlung-bildschirm", "implantat-set"];
---

<section class="s-benefits" data-surface="dark" data-standards>
  <div class="container s-benefits__inner">
    <div class="s-benefits__head">
      <span class="c-topline" data-reveal="fade">{topline}</span>
      <h2 class="s-benefits__title" data-split="lines" data-split-delay="0.1">
        {headline}
      </h2>
    </div>

    <div class="s-benefits__list" data-standards-list>
      {
        items.map((e, i) => (
          <div
            class="s-benefits__row"
            data-standards-row
            data-active={i === 0 ? "true" : undefined}
          >
            <span class="s-benefits__num">{i + 1}</span>
            <div class="s-benefits__body">
              {/* Ein echter Schalter, kein fokussierbares Div.

                  Anders als bei den Standards steht der Text hier nicht da:
                  Er ist auf Höhe null zusammengezogen und wird erst beim
                  Aufklappen sichtbar. Damit ist die Zeile eine Bedienung und
                  kein Absatz — und eine Bedienung braucht eine Rolle, einen
                  Namen und `aria-expanded`. Vorher trug die Zeile nur ein
                  `tabindex="0"`, das `standards.js` per JavaScript setzte:
                  fünf Fokusstopps, die kein Vorlesegerät ankündigen konnte,
                  und auf dem Telefon tat ein Tippen nichts. */}
              <h3 class="s-benefits__name">
                <button
                  type="button"
                  class="s-benefits__trigger"
                  data-standards-trigger
                  aria-expanded={i === 0 ? "true" : "false"}
                  aria-controls={`benefit-${i}-text`}
                >
                  {e.name}
                </button>
              </h3>
              <div
                class="s-benefits__text"
                id={`benefit-${i}-text`}
                data-standards-text
              >
                <p>{e.text}</p>
              </div>
            </div>
            <span class="s-benefits__bar" data-standards-bar>
              <i />
            </span>
          </div>
        ))
      }
    </div>

    {
      footnote && (
        <p class="s-benefits__more" data-reveal="up">
          {footnote.map((teil) =>
            typeof teil === "string" ? (
              teil
            ) : (
              <a href={teil.href}>{teil.label}</a>
            ),
          )}
        </p>
      )
    }

    <div
      class="s-benefits__media"
      data-reveal="right"
      data-reveal-trigger=".s-benefits"
    >
      <div class="s-benefits__stage" data-standards-stage>
        {
          /* Alle Motive liegen übereinander, sichtbar ist immer genau eines —
            das Modul blendet um. Deshalb ohne Alternativtext: die Bühne
            trägt keine eigene Information, der Text steht in der Liste. */
        }
        {
          /* Zwei Wege, weil die Quellen zweierlei sind: Ein Bild aus dem
             Studio ist ein `ImageSource`, ein Rückfall ist ein Motivname.
             Vorher lief beides über `CmsImage` mit einem fest
             ausgeschriebenen Pfad wie `/img/x-1600.webp` — damit lieferte
             der Rückfall an jedes Fenster dieselbe Datei, ohne AVIF und
             ohne srcset. `Picture` kennt die Breiten aus der Pipeline. */
          items.map((e, i) =>
            isCmsImage(e.image) ? (
              <CmsImage
                source={e.image}
                alt=""
                widths={[640, 1024, 1600]}
                sizes="50vw"
                data-standards-img
              />
            ) : (
              <Picture
                name={MOTIFS[i % MOTIFS.length]}
                alt=""
                sizes="50vw"
                data-standards-img
              />
            ),
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Dunkles Vollbreiten-Band mit Auswahlliste links und Bild rechts.
     Verhalten und data-Attribute teilt sie sich mit .s-standards — nur das
     Erscheinungsbild ist ein anderes: keine Zahnmaske, sondern ein
     gerundetes Bildfeld, und Ziffern statt zweistelliger Nummern.

     Randlos über die volle Fensterbreite und ohne Rundung — im Entwurf ein
     durchgehendes Band, das die Seite teilt. Die 50vw-Konstruktion bricht
     aus dem zentrierten Raster aus, ohne dass die Section aus dem Fluss
     genommen werden muss. */
  .s-benefits {
    position: relative;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    /* Unten kein Abstand: das braune Band stößt direkt an das Taupe-Band
       von Vorher/Nachher, die beiden Farbflächen laufen ineinander. */
    margin-block: var(--section-space) 0;
    /* `--section-space` statt eines eigenen, größeren Werts: Das Band trug
       oben und unten bis zu 220px und schob sich dadurch deutlich weiter
       auseinander als jeder andere Abschnitt. Jetzt dasselbe Maß wie überall
       sonst, und die gewonnene Höhe geht ins Bild. */
    padding-block: var(--section-space);
    background: var(--c-dark);
    color: var(--c-text);
  }

  .s-benefits__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--site-gutter);
    align-items: start;
  }

  .s-benefits__head {
    grid-column: 1;
    margin-bottom: var(--flow-xl);
  }

  .s-benefits__title {
    max-width: 14ch;
    margin-top: var(--sp-4);
    font-size: var(--fs-title);
    font-weight: var(--fw-medium);
    line-height: var(--lh-title);
  }

  /* Feste Höhe, nicht Mindesthöhe.
     Die Liste klappt immer genau einen Eintrag auf, und die Texte sind
     verschieden lang — mit `min-height` trug der längste Eintrag die Liste
     über das Maß hinaus und das ganze Band sprang beim Durchlaufen.
     Gemessen waren das 23px auf 390px Breite und 3px auf 1600px; bei 1440px
     fiel es nicht auf, weil die Mindesthöhe dort gerade reichte.

     Die Höhe rechnet `standards.js` aus dem längsten Eintrag aus und setzt
     sie als `--list-height` (alle Zeilen zugeklappt plus der längste Text
     aufgeklappt), bei jeder Breitenänderung neu. Bis zum 18.09.2026 stand
     hier ein gemessener Festwert (23rem, 24rem unter 600px). Der reichte
     genau für den damaligen Text und riss, als die Veneer-Arten nach dem
     fachlichen Feedback um die Hälfte länger wurden: gebraucht wurden 403px
     bei 1600, 468 bei 390 und 514 bei 320 — kein Festwert deckt 375 bis 514
     unter 600px, ohne bei 599 ein Drittel Luft zu lassen. Der Rückfall ohne
     JavaScript ist der alte Wert.

     Abgeschnitten wird nichts, sonst verschwände Inhalt lautlos — er liefe
     stattdessen über. */
  .s-benefits__list {
    grid-column: 1;
    height: var(--list-height, 23rem);
  }

  /* Steht unter der Liste in derselben Spalte, nicht über die ganze Breite:
     rechts daneben liegt das Bildfeld. Der Abstand nach oben ist der der
     Liste zu ihrem letzten Eintrag, damit der Satz zur Liste gehört und
     nicht als eigener Abschnitt beginnt. */
  .s-benefits__more {
    grid-column: 1;
    font: var(--font-body);
    max-width: var(--measure-medium);
    margin-top: var(--sp-5);
    color: var(--c-text-muted);
  }

  /* Unterstrichen, weil der Verweis im Fließtext sonst nur an der Farbe zu
     erkennen wäre — und Farbe allein reicht nicht (WCAG 1.4.1). */
  .s-benefits__more a {
    color: var(--c-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .s-benefits__more a:hover {
    text-decoration-thickness: 2px;
  }

  @media (max-width: 600px) {
    .s-benefits__list {
      height: var(--list-height, 24rem);
    }
  }

  /* Die Trennlinie sitzt unten an jeder Zeile — die erste bekommt zusätzlich
     eine obere, damit der Block oben abschließt. */
  .s-benefits__row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--sp-3);
    padding-block: var(--sp-4);
    border-bottom: var(--bw) solid var(--c-line);
    cursor: default;
  }

  .s-benefits__row:first-child {
    border-top: var(--bw) solid var(--c-line);
  }

  /* Ziffer im Kreis. Der inaktive Zustand ist nur gedimmt, nicht
     ausgeblendet — die Liste soll als Ganzes lesbar bleiben.

     0.65 und nicht 0.55: Gemessen lag 0.55 bei 3.72:1 gegen den dunklen
     Grund, und damit unter den 4.5:1, die WCAG 1.4.3 für Fließtext verlangt.
     „Als Ganzes lesbar" war also der Anspruch und nicht der Zustand. 0.65
     ergibt 4.55:1; die aktive Zeile steht weiterhin bei 12.4:1. */
  .s-benefits__num {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: var(--bw) solid var(--c-line-strong);
    border-radius: var(--r-round);
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    line-height: var(--lh-tight);
    opacity: 0.65;
    transition:
      opacity var(--d-base) var(--e-out),
      border-color var(--d-base) var(--e-out);
  }

  /* Deutlich größer als der Fließtext darunter — im Entwurf trägt der Name
     die Zeile, der Text ordnet sich unter. */
  .s-benefits__name {
    font: var(--font-card-title);
    letter-spacing: var(--tracking-card-title);
    opacity: 0.65;
    transition: opacity var(--d-base) var(--e-out);
  }

  /* Der Schalter erbt alles von der Überschrift; sichtbar ist er nur als
     Text. Ein Button, der wie ein Button aussieht, wäre hier fünfmal ein Kasten
     in einer Liste, die aus Linien besteht. */
  .s-benefits__trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  /* The ring colour comes from base.css (var(--c-focus), light on the dark
     surface); only the offset and the rounding are this block's own. */
  .s-benefits__trigger:focus-visible {
    outline-offset: 4px;
    border-radius: var(--r-sm);
  }

  /* Zusammengeklappt über die Rasterzeile, nicht über display: none —
     sonst gäbe es keinen Übergang. */
  .s-benefits__text {
    font: var(--font-body);
    display: grid;
    grid-template-rows: 0fr;
    margin-top: 0;
    max-width: var(--measure-medium);
    opacity: 0;
    transition:
      grid-template-rows var(--d-slow) var(--e-out),
      opacity var(--d-base) var(--e-out),
      margin-top var(--d-slow) var(--e-out);
  }

  /* Der Inhalt braucht ein eigenes, überlaufverstecktes Element — reiner
     Text im Absatz wird zu einem anonymen Rasterelement, das sich weder
     ansprechen noch auf Null zusammenziehen lässt (blieb bei 46 px stehen).
     Deshalb steht im Markup ein <p> innerhalb des Wrappers. */
  .s-benefits__text > * {
    overflow: hidden;
    margin: 0;
  }

  .s-benefits__row[data-active="true"] .s-benefits__num {
    opacity: 1;
    border-color: var(--c-brand);
  }

  .s-benefits__row[data-active="true"] .s-benefits__name {
    opacity: 1;
  }

  .s-benefits__row[data-active="true"] .s-benefits__text {
    grid-template-rows: 1fr;
    margin-top: var(--sp-2);
    opacity: 0.75;
  }

  /* Fortschritt der aktiven Zeile — liegt auf der unteren Trennlinie. */
  .s-benefits__bar {
    position: absolute;
    right: 0;
    bottom: calc(-1 * var(--bw));
    left: 0;
    height: var(--bw);
    overflow: hidden;
  }

  .s-benefits__bar i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--c-brand);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /* Das Bildfeld läuft über die volle Höhe der rechten Spalte und beginnt
     auf Höhe der Headline. */
  .s-benefits__media {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: stretch;
  }

  .s-benefits__stage {
    position: relative;
    height: 100%;
    /* Höher als vorher (360/560): Das Band ist oben und unten knapper
       geworden, und ein Bild, das nur die Liste begleitet, statt sie zu
       überragen, wirkt in der rechten Spalte verloren. */
    min-height: clamp(420px, 47vw, 680px);
    overflow: hidden;
    border-radius: var(--r-md);
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  /* Alle Motive liegen übereinander, sichtbar ist immer genau eines. Das
     Modul blendet über Deckkraft und einen leichten Zoom um. */
  .s-benefits__stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .s-benefits__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .s-benefits__head,
    .s-benefits__list,
    .s-benefits__media {
      grid-column: 1;
    }

    .s-benefits__media {
      grid-row: auto;
      margin-top: var(--sp-6);
    }
  }
</style>
