---
/**
 * Unsere Standorte. Zwei Darstellungen derselben Motive:
 *
 *   "reihe" — die Bildreihe läuft beim Scrollen waagerecht durch (Bestand)
 *   "ring"  — die Motive sitzen auf einem Zylinder, der um den Betrachter
 *             kreist und sich ziehen lässt
 *
 * Umschalten heißt: das Attribut an <Gallery /> in der Seite ändern. Der
 * Textteil darunter bleibt in beiden Fällen derselbe.
 */
import Picture from "../ui/Picture.astro";
import BildRing from "../ui/ImageRing.astro";
import { loadSettings } from "../../lib/settings";
import type { RingImage } from "../ui/ImageRing.astro";
import type { ImageSource } from "../../lib/images";

interface Props {
  variant?: "reihe" | "ring";
  title: string;
  /** Die Motive auf dem Ring, aus dem CMS. */
  images?: { image: ImageSource; caption?: string }[];
}

/* Keine Vorgabe für den Titel: Pflichtfeld im Schema, die Seite reicht ihn
   durch. `variant` ist dagegen eine Gestaltungsentscheidung der Seite und
   kein Inhalt — sie behält ihre Vorgabe. */
const { variant = "reihe", title, images } = Astro.props;

/* Die Standorte stehen in den Einstellungen — dieselbe Quelle wie im Fuß. */
const { locations } = await loadSettings();

/* Klasse 3: die gestalteten Motive, solange im Studio keine hochgeladen sind.
   Drei beschriftete Praxisaufnahmen und zwei Abstraktionen dazwischen — auf
   dem Zylinder haben alle Karten dasselbe Maß.

   `locationsImages` gab es im Schema schon einmal und es erreichte nie ein
   Markup. Statt es zu entfernen, liest der Ring jetzt daraus: Wer eigene
   Standortfotos hochlädt, sieht sie hier. */
/* Zehn Karten, gemischt: Räume, Details und Stimmungen im Wechsel.
 *
 * Vorher waren es fünf, und vier davon zeigten einen Raum mit einem Stuhl
 * darin. Auf dem Zylinder sieht man drei bis vier Karten gleichzeitig — bei
 * lauter Räumen las sich das als dieselbe Aufnahme in Varianten, und der Ring
 * drehte sich, ohne dass sich etwas änderte.
 *
 * **Bewusst keine Behandlung.** Der Abschnitt heißt „Standorte" und
 * beantwortet die Frage, wo man landet, nicht was dort mit einem geschieht.
 * Ein Mundspiegel zwischen Empfang und Blumenvase wäre eine andere Frage.
 * Einzige Ausnahme ist das Röntgengerät: Es ist Teil des Hauses und zeigt
 * einen Raum, keinen Eingriff.
 *
 * Die Reihenfolge wechselt Nähe und Weite ab — Raum, Detail, Raum, Stimmung.
 * Zwei Detailaufnahmen nebeneinander verlieren ihren Maßstab.
 *
 * ZWANZIG Karten, und die Zahl ist gerechnet, nicht gegriffen. Der Ring füllt
 * auf ein VIELFACHES der Motivzahl auf, mindestens auf 20 (siehe
 * `ImageRing`):
 *
 *     5 Motive  → ceil(20/5)  × 5  = 20 Karten
 *    18 Motive  → ceil(20/18) × 18 = 36 Karten
 *    20 Motive  → ceil(20/20) × 20 = 20 Karten
 *
 * Bei 18 hätte der Ring also 36 Bilder gleichzeitig im Dokument gehabt, fast
 * doppelt so viele wie vorher — gemessen an einem Prüflauf, der dreimal
 * hintereinander mit „Execution context was destroyed" abbrach, weil dem
 * Renderer der Speicher ausging. Bei genau 20 gibt es keine Wiederholung und
 * keine Karte zu viel.
 *
 * Das Röntgengerät stand hier und ist wieder raus: Es war der einzige
 * Apparat zwischen lauter Räumen und Details, und genau das fiel auf. */
const MOTIFS: RingImage[] = [
  {
    name: "empfang-p25",
    alt: "Empfang mit dem geschwungenen Bogen",
    caption: "Prenzlauer Allee",
  },
  { name: "zahnleuchte", alt: "Leuchte in Form eines Zahns über dem Empfang" },
  { name: "wartebereich", alt: "Wartebereich mit Holzbank am Fenster" },
  { name: "blumen", alt: "Blumenstrauß auf der Ablage" },
  { name: "behandlungszimmer-rot", alt: "Behandlungszimmer mit Tageslicht" },
  { name: "waschbecken", alt: "Waschbecken mit Armatur in Messing" },
  { name: "flur-rot", alt: "Flur mit roter Wand" },
  {
    name: "empfang-c37",
    alt: "Empfang der zweiten Praxis",
    caption: "Christburger Straße",
  },
  { name: "spiegel-detail", alt: "Handspiegel auf der Ablage" },
  { name: "flur-bilder", alt: "Flur mit gerahmten Bildern und Sitzbank" },
  { name: "tee-kueche", alt: "Teeküche mit Messingarmatur" },
  {
    name: "behandlungszimmer-holz",
    alt: "Behandlungszimmer mit Blick ins Grüne",
  },
  { name: "logo-glas", alt: "Der gezeichnete Zahn auf der Glastür" },
  { name: "holzbank", alt: "Die geschwungene Holzbank im Wartebereich" },
  { name: "waschbecken-blau", alt: "Waschbecken vor blauen Fliesen" },
  { name: "flur-tueren", alt: "Flur mit den Türen zu den Behandlungszimmern" },
  { name: "stern-detail", alt: "Das Zeichen der Praxis an der Wand" },
  { name: "lichtfleck", alt: "Sonnenlicht auf der roten Wand" },
  { name: "schild-kottbussertor", alt: "Das Schild im Eingang" },
  { name: "fassade-p25", alt: "Die Fassade von der Straße aus" },
];

/* Gepflegte Bilder gewinnen als GANZE Liste, nicht Karte für Karte: Der Ring
   ist eine Komposition, und drei eigene Fotos zwischen zwei geliehenen
   Abstraktionen sähen aus wie ein Fehler. */
const ringImages: RingImage[] = images?.length
  ? images.map((b) => ({
      image: b.image,
      alt: b.caption ?? "",
      caption: b.caption,
    }))
  : MOTIFS;
---

{
  /* ==================================================================
           UNSERE STANDORTE — horizontal laufende Bildreihe
           ================================================================== */
}
<section class="s-gallery" id="standorte" data-gallery>
  <h2 class="s-gallery__title" data-split="lines">{title}</h2>

  {
    variant === "ring" ? (
      <BildRing images={ringImages} label="Unsere Standorte" />
    ) : (
      <Fragment>
        <div class="s-gallery__track" data-gallery-track>
          <figure class="s-gallery__item s-gallery__item--sm">
            <Picture name="zahnleuchte" alt="" sizes="10vw" parallax="9" />
          </figure>
          <figure class="s-gallery__item s-gallery__item--md">
            <Picture
              name="empfang-p25"
              alt="Empfang mit dem geschwungenen Bogen"
              sizes="20vw"
              parallax="9"
            />
          </figure>
          <figure class="s-gallery__item s-gallery__item--lg">
            <Picture
              name="behandlungszimmer-rot"
              alt="Behandlungszimmer mit Tageslicht"
              sizes="45vw"
              parallax="9"
            />
            <figcaption class="s-gallery__caption">Prenzlauer Allee</figcaption>
          </figure>
          <figure class="s-gallery__item s-gallery__item--md">
            <Picture
              name="wartebereich"
              alt="Wartebereich mit Holzbank am Fenster"
              sizes="20vw"
              parallax="9"
            />
            <figcaption class="s-gallery__caption">
              Christburger Straße
            </figcaption>
          </figure>
          <figure class="s-gallery__item s-gallery__item--sm">
            <Picture name="waschbecken" alt="" sizes="10vw" parallax="9" />
          </figure>
        </div>

        {/* Slider-Steuerung: Pfeile links, Punkte rechts — wie im Entwurf. */}
        <div class="container s-gallery__nav" data-reveal="fade">
          <div class="s-gallery__arrows">
            <button
              class="s-gallery__arrow"
              data-gallery-prev
              type="button"
              aria-label="Vorheriger Standort"
            >
              <svg aria-hidden="true">
                <use href="#i-arrow" />
              </svg>
            </button>
            <button
              class="s-gallery__arrow"
              data-gallery-next
              type="button"
              aria-label="Nächster Standort"
            >
              <svg aria-hidden="true">
                <use href="#i-arrow" />
              </svg>
            </button>
          </div>
          <div
            class="s-gallery__dots"
            data-gallery-dots
            role="tablist"
            aria-label="Standorte"
          />
        </div>
      </Fragment>
    )
  }

  <div class="container s-cols">
    {
      locations.map((o, i) => (
        <div class="s-cols__item">
          {/* Konturzahl: rein grafisch, deshalb für Vorlesegeräte
                  ausgeblendet — die Anschrift steht darunter im Klartext. */}
          <p
            class="s-cols__display"
            data-reveal="up"
            data-reveal-delay={i * 0.08}
            aria-hidden="true"
          >
            {o.shortCode}
          </p>
          <h3
            data-reveal="up"
            data-reveal-delay={0.06 + i * 0.08}
            data-reveal-trigger=".s-experts"
          >
            {o.name}
          </h3>
          {/* <address> statt <p>: das ist die Anschrift der Praxis, und
                  Vorlesegeräte kündigen sie als solche an. */}
          <address
            class="s-cols__address"
            data-reveal="up"
            data-reveal-delay={0.1 + i * 0.08}
            data-reveal-trigger=".s-experts"
          >
            {o.street}
            <br />
            {o.city}
          </address>
          <p
            data-reveal="up"
            data-reveal-delay={0.14 + i * 0.08}
            data-reveal-trigger=".s-experts"
          >
            {o.description}
          </p>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Horizontale Bildreihe, die beim Scrollen seitwärts läuft. Das mittlere
     Panel ist breit, die äußeren sind schmale Teaser.
     Pfeile und Punkte liegen in shared.css — das Magazin nutzt dieselben. */
  .s-gallery {
    position: relative;
    padding-block: var(--section-space);
    overflow: hidden;
  }

  .s-gallery__title {
    text-align: center;
    margin-bottom: var(--sp-6);
    font-size: var(--fs-h1-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
  }

  .s-gallery__track {
    display: flex;
    gap: var(--sp-1);
    padding-inline: var(--site-margin);
    will-change: transform;
  }

  .s-gallery__item {
    position: relative;
    flex: 0 0 auto;
    height: clamp(320px, 42vw, 620px);
    border-radius: var(--r-md);
    overflow: hidden;
  }

  /* :global(img), weil die Bilder aus Picture.astro kommen. */
  .s-gallery__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .s-gallery__item--sm {
    width: clamp(80px, 8vw, 130px);
  }

  .s-gallery__item--md {
    width: clamp(160px, 17vw, 290px);
  }

  .s-gallery__item--lg {
    width: clamp(300px, 44vw, 760px);
  }

  .s-gallery__caption {
    position: absolute;
    left: var(--sp-4);
    bottom: var(--sp-4);
    padding: 6px 12px;
    border-radius: var(--r-round);
    background: color-mix(in srgb, var(--c-white) 80%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--c-dark);
  }

  /* --- Slider-Steuerung: nur die Hülle, die es hier allein gibt ---------- */

  .s-gallery__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    margin-top: var(--sp-6);
  }

  .s-gallery__arrows {
    display: flex;
    gap: var(--sp-4);
  }

  /* --- Zweispalten-Textblock (Standort-Details) -------------------------- */

  /* Der obere Innenabstand trennt die Standort-Blöcke von den Pfeilen
     darüber. 112px waren dafür zu viel — die Section zerfiel dadurch in
     Galerie und Text, statt eins zu sein. */
  .s-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-10) var(--site-gutter);
    padding-block: var(--sp-8) var(--sp-10);
  }

  /* Der Standortname als Outline-Typo — im Entwurf 284px, transparent mit
     Kontur, sehr eng gesetzt. Selektor bewusst mit Elternklasse: sonst
     gewinnt `.s-cols__item p` bei Schriftgrad und Farbe.
     Zeilenhöhe 1 plus negative Außenabstände statt einer gestauchten
     Zeilenhöhe: der Entwurf setzt 168px auf 284px Grad (0.59), dabei ragen
     die Buchstaben oben und unten aus ihrer Zeilenbox heraus und wurden vom
     überlaufversteckten Rahmen der Section beschnitten. So bleibt der enge
     Satz erhalten, ohne dass etwas aus der Box läuft. */
  /* Die Anschrift trägt die Zeile über der Beschreibung: gleicher Grad,
     aber in der Auszeichnungsschrift und etwas kräftiger, damit sie sich
     vom Fließtext löst, ohne eine eigene Überschrift zu sein.
     `font-style: normal`, weil <address> vom Browser kursiv gesetzt wird. */
  .s-cols__address {
    margin-bottom: var(--sp-3);
    font-family: var(--f-mono);
    font-style: normal;
    font-size: var(--fs-text-small);
    line-height: var(--lh-body);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .s-cols__item .s-cols__display {
    margin-top: -0.205em;
    margin-bottom: calc(var(--sp-8) - 0.205em);
    font-family: var(--f-sans);
    font-weight: 500;
    font-size: var(--fs-display-xl);
    line-height: var(--lh-tight);
    letter-spacing: -0.019em;
    color: transparent;
    -webkit-text-stroke: 0.6px var(--c-dark);
    white-space: nowrap;
  }

  .s-cols__item h3 {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-h2);
    font-weight: 400;
    line-height: var(--lh-title);
    letter-spacing: var(--tracking-snug);
  }

  .s-cols__item p {
    max-width: 44ch;
    font-size: var(--fs-text-main);
    color: var(--c-text-muted);
    line-height: var(--lh-text);
  }

  /* Auf breiten Fenstern laufen die beiden Spalten zum jeweils äußeren
     Rand — der zweite Standort steht deshalb rechtsbündig. Untereinander
     gestapelt ergibt das keinen Sinn mehr: dort stünde eine Adresse links
     und die nächste rechts. */
  @media (min-width: 701px) {
    .s-cols__item:last-child {
      text-align: right;
    }

    .s-cols__item:last-child p {
      margin-left: auto;
    }
  }

  @media (max-width: 700px) {
    /* Die Abstände waren aus der breiten Fassung übernommen und dort auf
       Spalten nebeneinander berechnet: 80px unter der Überschrift, 112px
       über dem ersten Standort. Untereinander gestapelt fällt die Section
       damit in vier weit auseinanderliegende Teile, zwischen denen jeweils
       eine halbe Bildschirmhöhe leer bleibt. */
    .s-gallery__title {
      margin-bottom: var(--sp-5);
    }

    .s-cols {
      grid-template-columns: 1fr;
      gap: var(--sp-8);
      padding-block: var(--sp-8);
    }

    /* Eigene Rampe statt --fs-display-xl: Auf einer Spalte soll die
       Konturschrift die Breite ausnutzen, nicht der Leiter folgen. 24vw ist
       daran gemessen, nicht daran, wo die Stufe läge. */
    .s-cols__item .s-cols__display {
      font-size: clamp(3.5rem, 24vw, 8rem);
    }
  }
</style>
