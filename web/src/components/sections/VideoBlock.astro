---
/**
 * Ein YouTube-Video, das erst auf Klick lädt.
 *
 * **Warum nicht einfach ein <iframe>:** Ein eingebettetes YouTube-Video
 * kontaktiert Googles Server, sobald die Seite lädt, und setzt dabei
 * Kennungen — auch dann, wenn niemand auf Abspielen drückt. Für eine
 * Zahnarztpraxis in Deutschland heißt das: Es bräuchte ein
 * Einwilligungsbanner, und die Seite hat keines. Dieselbe Überlegung wie bei
 * Plausible in den Einstellungen.
 *
 * Deshalb liegt hier zunächst nur ein Standbild mit einem Abspielbutton. Erst
 * der Klick tauscht es gegen das iframe. Bis dahin geht keine einzige
 * Anfrage nach außen.
 *
 * `youtube-nocookie.com` als Domain: Sie setzt keine Werbe-Kennungen. Das
 * ersetzt die Einwilligung nicht, aber nach dem Klick hat der Besucher
 * bewusst gehandelt, und die sparsamere Domain ist dann das Mindeste.
 *
 * Das Standbild kommt aus dem CMS, wenn eines gepflegt ist. Sonst von
 * YouTube — das lädt dann doch von einem Google-Server, weshalb das Feld im
 * Studio ausdrücklich zum eigenen Bild rät.
 */
import CmsImage from "../ui/CmsImage.astro";
import { isCmsImage, type ImageSource } from "../../lib/images";

interface Props {
  url: string;
  title?: string;
  poster?: ImageSource;
  /**
   * Name eines Motivs aus der lokalen Pipeline, solange im Studio kein
   * Standbild hängt. Ohne Angabe bleibt die Fläche leer — dann steht dort
   * der Abspielpfeil auf ruhigem Grund und sonst nichts.
   */
  fallback?: string;
}

const { url, title, poster, fallback } = Astro.props;

/**
 * Die Kennung aus jeder der drei Adressformen, die YouTube ausgibt:
 * `watch?v=…`, `youtu.be/…` und `embed/…`. Ohne Kennung rendert der
 * Baustein nichts — eine Adresse, die wir nicht lesen können, soll keinen
 * kaputten Rahmen erzeugen.
 */
function videoId(url: string): string | null {
  try {
    const u = new URL(url);
    if (u.hostname.endsWith("youtu.be")) return u.pathname.slice(1) || null;
    if (u.searchParams.has("v")) return u.searchParams.get("v");
    const match = u.pathname.match(/\/embed\/([^/?]+)/);
    return match ? match[1] : null;
  } catch {
    return null;
  }
}

const id = videoId(url);

/* `rel=0` hält die Vorschläge am Ende bei diesem Kanal, `autoplay=1` startet
   sofort — der Klick auf den Button war schon die Aufforderung, ein zweiter
   auf den Abspielpfeil im iframe wäre einer zu viel. */
const embedUrl = id
  ? `https://www.youtube-nocookie.com/embed/${id}?rel=0&autoplay=1`
  : null;

/* **Kein Vorschaubild von YouTube mehr.**

   Hier stand `https://i.ytimg.com/vi/<id>/hqdefault.jpg` als Rückfall, wenn
   im Studio kein Poster hängt. Damit lud jede Karriereseite ein Bild von
   einem Google-Server, sobald sie aufgerufen wurde — YouTube sah die
   IP-Adresse jeder Besucherin, bevor irgendjemand auf Abspielen geklickt
   hatte. Gemessen war es die einzige Fremdanfrage der ganzen Website.

   Das ist genau das, was dieser Baustein verhindern soll (siehe
   `modules/embed.js`): Vor dem Klick geht nichts hinaus, deshalb braucht es
   kein Einwilligungsbanner. Ein Rückfall, der diese Zusage still bricht, ist
   schlimmer als kein Rückfall.

   An seiner Stelle steht ein gestaltetes Motiv aus der eigenen Pipeline —
   dasselbe Muster, mit dem der Kopf der Praxisseite arbeitet. Es liegt auf
   demselben Server wie die Seite, und ein Video ohne jedes Bild wäre eine
   graue Fläche von 16:9 mit einem Pfeil darin. Wer ein bestimmtes Standbild
   will, pflegt eines im Studio. */
---

{
  embedUrl && (
    <section class="s-video container">
      {title && (
        <h2 class="s-video__title" data-split="lines">
          {title}
        </h2>
      )}

      {/*
      Ein <button> und kein <div> mit Klickfänger: Das Ding tut etwas, also
      muss es mit der Tastatur erreichbar sein und sich als Schaltfläche
      ansagen. Das Attribut trägt die Adresse — das Skript baut daraus das
      iframe, damit die Adresse nicht doppelt im Markup steht.
    */}
      <button
        class="s-video__frame"
        type="button"
        data-embed={embedUrl}
        aria-label={title ? `Video abspielen: ${title}` : "Video abspielen"}
        data-reveal="scale"
      >
        {isCmsImage(poster) ? (
          <CmsImage
            source={poster}
            alt=""
            widths={[640, 1024, 1600]}
            sizes="(max-width: 900px) 92vw, 80vw"
          />
        ) : fallback ? (
          <CmsImage
            source={fallback}
            alt=""
            widths={[640, 1024, 1600]}
            sizes="(max-width: 900px) 92vw, 80vw"
          />
        ) : null}

        <span class="s-video__play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28">
            <path d="M8 5v14l11-7z" fill="currentColor" />
          </svg>
        </span>
      </button>

      {/* Wer kein JavaScript hat, bekommt wenigstens den Weg zum Video. */}
      <noscript>
        <a class="s-video__external" href={url} rel="noopener">
          Video bei YouTube ansehen
        </a>
      </noscript>
    </section>
  )
}

<style>
  .s-video {
    padding-block: var(--section-space);
  }

  .s-video__title {
    max-width: 24ch;
    margin-bottom: var(--sp-8);
    font-size: var(--fs-h2);
    font-weight: 400;
    line-height: var(--lh-title);
    letter-spacing: var(--tracking-snug);
  }

  /* Ein Button, der wie eine Fläche aussieht: Der Browser gibt <button> einen
     eigenen Rahmen, eine Grundfarbe und mittigen Text — alles drei muss hier
     weg, sonst sitzt das Bild in einem grauen Kasten. */
  .s-video__frame {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--c-tint);
    aspect-ratio: 16 / 9;
    cursor: pointer;
  }

  /* :global(img), weil das Bild aus CmsImage.astro kommt und das
     Scope-Attribut dieser Datei nicht trägt. */
  .s-video__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--d-slow) var(--e-out);
  }

  .s-video__frame:hover :global(img) {
    transform: scale(1.02);
  }

  /* Der Abspielbutton. Markenfarbe auf Dunkel misst über 8:1 — er muss auf
     jedem Standbild lesbar bleiben, auch auf einem hellen. */
  .s-video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: clamp(56px, 7vw, 88px);
    height: clamp(56px, 7vw, 88px);
    padding-left: 4px;
    border-radius: var(--r-round);
    background: var(--c-brand);
    color: var(--c-dark);
    transition: scale var(--d-base) var(--e-out);
  }

  .s-video__frame:hover .s-video__play {
    scale: 1.08;
  }

  .s-video__frame:focus-visible {
    outline: 2px solid var(--c-dark);
    outline-offset: 4px;
  }

  /* Das eingesetzte iframe füllt denselben Rahmen. */
  .s-video__frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .s-video__external {
    display: inline-block;
    margin-top: var(--sp-4);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
