---
/**
 * Zwei bis vier Blöcke, die je eine Frage beantworten, die vor einer
 * Bewerbung wirklich gestellt wird: Wie komme ich hin, mit wem arbeite ich,
 * wo sitze ich.
 *
 * Nummeriert und nicht bebildert. Ein Motiv je Block hieße drei Bilder
 * nebeneinander, die um Aufmerksamkeit konkurrieren, während der Text die
 * Antwort trägt; die Ziffer ordnet, ohne etwas zu behaupten. Dieselben
 * Ziffernkreise wie im Ablauf und in der Leistungstabelle.
 */
interface Reason {
  title: string;
  text: string;
}

interface Props {
  topline: string;
  headline: string;
  items: Reason[];
}

const { topline, headline, items } = Astro.props;
---

<section class="s-reasons container">
  <div class="s-reasons__head">
    <span class="c-topline" data-reveal="fade">{topline}</span>
    <h2 class="s-reasons__title" data-split="lines">{headline}</h2>
  </div>

  <ol class="s-reasons__list" data-reveal-stagger="0.08">
    {items.map((g, i) => (
      <li class="s-reasons__block" data-reveal-child>
        <span class="s-reasons__number" aria-hidden="true">{i + 1}</span>
        <h3 class="s-reasons__block-title">{g.title}</h3>
        <p class="s-reasons__text">{g.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .s-reasons {
    padding-block: var(--section-space);
  }

  .s-reasons__head {
    max-width: 34ch;
    margin-bottom: var(--sp-10);
  }

  .s-reasons__title {
    margin-top: var(--sp-4);
    font-size: var(--fs-h2);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  /* `auto-fit` mit einer Mindestbreite statt einer festen Spaltenzahl: Der
     Abschnitt trägt zwei bis vier Blöcke, und bei drei soll er nicht so
     aussehen, als fehle einer. */
  .s-reasons__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--sp-10) var(--site-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .s-reasons__block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: var(--sp-5);
    border-top: 1px solid var(--c-line);
  }

  /* Brauner Kreis mit heller Ziffer — dieselbe Form wie im Ablauf und im
     Benefits-Band. Grau auf Braun misst 8.65:1. */
  .s-reasons__number {
    display: grid;
    place-items: center;
    width: 2.1em;
    height: 2.1em;
    margin-bottom: var(--sp-4);
    border-radius: var(--r-round);
    background: var(--c-dark);
    color: var(--c-grey);
    font-size: var(--fs-text-small);
    line-height: 1;
  }

  .s-reasons__block-title {
    margin-bottom: var(--sp-3);
    font-size: clamp(1.125rem, 1.5vw, 1.5rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .s-reasons__text {
    max-width: 40ch;
    font-size: var(--fs-text-main);
    line-height: 1.5;
    color: var(--c-text-muted);
  }
</style>
