---
/**
 * Vergleichstabelle — zwei Spalten nebeneinander, Zeile für Zeile.
 *
 * Aufbau übernommen aus der Osmo-Vorlage „Comparison Table (Basic)":
 * dieselben Klassennamen, dieselben ARIA-Rollen, dieselbe Mechanik. Die
 * ganze Breitenaufteilung hängt an einer einzigen Custom Property:
 *
 *   --columns-in-view: 2
 *
 * Jede Zeile teilt sich in einen Namensteil und die Zellen im Verhältnis
 * 1 : n. Ändert man die Zahl, richten sich Kopf und Zellen automatisch neu
 * aus — es gibt keine Breite, die man von Hand nachziehen müsste.
 *
 * Zwei bewusste Abweichungen von der Vorlage:
 *
 * 1. Gestaltung. Die Vorlage kommt in Stripe-Optik (Haffer, Indigo #635bff,
 *    weiße Fläche). Hier stehen unsere Tokens — sonst stünde die Tabelle
 *    neben dem Rest der Seite wie ein Fremdkörper.
 *
 * 2. Überschriftenebene. Die Vorlage setzt <h4> in die Zeilen. Da diese
 *    Section mit einer <h2> beginnt, wäre das ein übersprungener Rang —
 *    WCAG 1.3.1. Es sind <h3> geworden; der Klassenname blieb.
 */

export interface CompareColumn {
  name: string;
  /** Hebt eine Spalte hervor — hier die eigene. */
  emphasised?: boolean;
}

/**
 * Ein Wert je Zelle: Text, ja/nein als Zeichen, oder eine Pille für etwas,
 * das noch nicht gilt.
 */
/**
 * Ein Zellenwert. Vier Darstellungen, ausgeschrieben statt aus dem Typ
 * geraten: Vorher war es `string | boolean | { pille: string }` — im Code
 * kompakt, im Studio aber nicht abbildbar. Ein Redakteur kann keinen
 * TypeScript-Union eingeben; er wählt eine Darstellung aus vier.
 */
export interface CompareValue {
  kind: "text" | "ja" | "nein" | "pille";
  text?: string;
}

export interface CompareRow {
  name: string;
  values: CompareValue[];
}

interface Props {
  topline?: string;
  /** Wahlfrei — siehe `ui/SectionHeading.astro`. */
  headline?: string;
  columns: CompareColumn[];
  lines: CompareRow[];
  /** Kleingedrucktes unter der Tabelle. */
  note?: string;
}

const { topline, headline, columns, lines, note } = Astro.props;

const caption = (w: CompareValue) =>
  w.kind === "ja" ? "enthalten" : w.kind === "nein" ? "nicht enthalten" : undefined;
---

<section class="s-compare container">
  <div class="s-compare__head">
    {topline && <span class="c-topline" data-reveal="fade">{topline}</span>}
    {headline && <h2 class="s-compare__title" data-split="lines">{headline}</h2>}
  </div>

  <div
    aria-label={headline}
    role="table"
    class="comparison-wrap"
    style={`--columns-in-view: ${columns.length}`}
    data-reveal="up"
  >
    <div role="row" class="comparison-header">
      <div aria-hidden="true" class="comparison-header__corner"></div>
      <div class="comparison-header__inner">
        <div class="comparison-header__list">
          {columns.map((s) => (
            <div role="columnheader" class:list={["comparison-header__col", s.emphasised && "is-emphasised"]}>
              <p class="comparison-header__name">{s.name}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="comparison-body">
      {lines.map((z) => (
        <div role="row" class="comparison-row">
          <div role="rowheader" class="comparison-row__name">
            <h3 class="comparison-row__h">{z.name}</h3>
          </div>
          <div class="comparison-row__cells">
            {z.values.map((w, i) => (
              <div
                role="cell"
                aria-label={caption(w)}
                class:list={["comparison-row__cell", columns[i]?.emphasised && "is-emphasised"]}
              >
                {w.kind === "ja" || w.kind === "nein" ? (
                  /* Die Zeichen tragen keine eigene Bedeutung — die steht im
                     aria-label der Zelle. Deshalb aria-hidden, sonst hörte
                     man die Angabe zweimal. */
                  <svg
                    class="comparison-row__icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    {w.kind === "ja" ? <polyline points="5 12 10 17 19 7" /> : <line x1="6" y1="12" x2="18" y2="12" />}
                  </svg>
                ) : (
                  <p class="comparison-row__label">{w.text}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  {note && <p class="s-compare__note">{note}</p>}
</section>

<style>
  .s-compare {
    padding-block: var(--section-space);
  }

  /* Ohne Topline und Überschrift ist der Kopf leer — dann sammelt sich über
     der Tabelle der Abstand der Section, der des Kopfes und der der
     nummerierten Überschrift darüber. `:has()` fängt genau diesen Fall. */
  .s-compare:not(:has(.s-compare__title)):not(:has(.c-topline)) {
    padding-top: var(--sp-6);
  }

  .s-compare:not(:has(.s-compare__title)):not(:has(.c-topline)) .s-compare__head {
    margin-bottom: 0;
  }

  .s-compare__head {
    max-width: 34ch;
    margin-bottom: var(--sp-8);
  }

  .s-compare__head .c-topline {
    margin-bottom: var(--sp-4);
  }

  .s-compare__title {
    font-size: var(--fs-h2);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  /* Fließtext, also die Grundschrift — Mono ist der Auszeichnung
     vorbehalten: Toplines, Werte, Beschriftungen. Ein ganzer Absatz darin
     liest sich zäh. */
  .s-compare__note {
    max-width: 76ch;
    margin-top: var(--sp-4);
    font-size: var(--fs-text-small);
    line-height: 1.55;
    color: var(--c-text-muted);
  }

  /* --- Ab hier die Vorlage, umgefärbt --------------------------------- */

  /* Kein `overflow: hidden` und kein Rahmen um das Ganze.
     `overflow: hidden` machte den Wrapper selbst zum Scroll-Container —
     `position: sticky` im Kopf klebte dann an IHM statt am Fenster, und
     `top` wurde zu einem festen Versatz von 93px, der als leeres Band über
     dem Kopf stehenblieb. Gemessen: der Kopf lief beim Scrollen einfach mit
     weg, statt oben zu bleiben.

     Ohne Kasten passt es ohnehin besser zur Seite: Leistungstabelle und
     Stellenliste kommen auch mit reinen Linien aus. */
  .comparison-wrap {
    width: 100%;
    position: relative;
  }

  /* Bleibt beim Scrollen unter der Navigationsleiste stehen, damit immer
     erkennbar ist, welche Spalte welche ist. Der Grund ist deckend — sonst
     schöben sich die Zeilen sichtbar darunter durch. */
  /* Im Kopf bleibt genau eine Linie: die unter ihm. Sie trennt die Namen der
     Varianten von den Werten und ist damit die einzige, die etwas sagt.

     Weg sind die Linie über dem Kopf und die senkrechten zwischen den Namen —
     die haben das Raster der Zeilen darunter nur verdoppelt und die Tabelle
     nach Formular aussehen lassen.

     Der Kopf klebt nicht beim Scrollen: Ohne Fläche wäre er, sobald die ersten
     Zeilen darunter durchliefen, nicht mehr zu lesen. */
  .comparison-header {
    border-bottom: var(--bw) solid var(--c-line);
    display: flex;
  }

  /* Senkrechte Linien zwischen den Varianten — nur in den Zeilen, nicht im
     Kopf. Sie trennen, was verglichen wird, ohne eine Spalte durch eine
     Fläche hervorzuheben. Die erste Spalte bekommt keine, sonst stünde eine
     Linie direkt neben dem Zeilennamen. */
  .comparison-row__cell + .comparison-row__cell {
    border-left: var(--bw) solid var(--c-line);
  }

  /* Auch zwischen Merkmalsspalte und erstem Wert. */
  .comparison-row__cells {
    border-left: var(--bw) solid var(--c-line);
  }

  .comparison-header__corner {
    min-width: 0;
    max-width: calc(100% / (var(--columns-in-view) + 1));
    flex: 1;
  }

  .comparison-header__inner {
    flex: var(--columns-in-view);
    min-width: 0;
    max-width: calc(var(--columns-in-view) * 100% / (var(--columns-in-view) + 1));
  }

  .comparison-header__list {
    display: flex;
  }

  .comparison-header__col {
    gap: 0.4em;
    text-align: center;
    min-width: 0;
    max-width: calc(100% / var(--columns-in-view));
    flex-flow: column;
    flex: 1;
    justify-content: center;
    align-items: center;
    padding-block: var(--sp-5);
    display: flex;
  }

  .comparison-header__name {
    font-size: var(--fs-h5);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .comparison-row {
    border-bottom: var(--bw) solid var(--c-line);
    display: flex;
  }

  /* Die letzte Zeile behält ihre Linie: Sie schließt die Tabelle nach unten
     ab. Ohne sie hörte das Raster einfach auf, statt zu enden — im Kopf steht
     eine Linie, unten stand keine. */

  /* Wechselnde Zeilen: hilft dem Auge, waagerecht in der Spur zu bleiben —
     und ersetzt den mitlaufenden Kopf, den die Tabelle nicht mehr hat. */
  .comparison-row:nth-of-type(even) {
    background: color-mix(in srgb, var(--c-dark) 4%, transparent);
  }

  .comparison-row__name {
    max-width: calc(100% / (var(--columns-in-view) + 1));
    flex: 1;
    justify-content: flex-start;
    align-items: center;
    padding-inline: var(--sp-4);
    display: flex;
  }

  .comparison-row__cells {
    flex: var(--columns-in-view);
    max-width: calc(var(--columns-in-view) * 100% / (var(--columns-in-view) + 1));
    display: flex;
  }

  .comparison-row__h {
    margin: 0;
    font-size: var(--fs-text-main);
    font-weight: 400;
    line-height: 1.3;
  }

  .comparison-row__cell {
    text-align: center;
    min-width: 0;
    max-width: calc(100% / var(--columns-in-view));
    flex-flow: column;
    flex: 1;
    justify-content: center;
    align-items: center;
    padding: var(--sp-4) var(--sp-3);
    display: flex;
  }

  /* Volle Schriftfarbe, nicht gedimmt. Die Vorlage setzt hier `opacity: .6`
     — übernommen ergab das 4.36:1 auf den Zebra-Zeilen und 4.17:1 in der
     betonten Spalte, beides unter den 4.5:1 für Fließtext. Und es war auch
     inhaltlich falsch: Die Werte SIND der Inhalt dieser Tabelle, nicht ihr
     Beiwerk. Die Abstufung zum Zeilennamen trägt die Schriftart, nicht die
     Deckkraft. Schlechtester Fall jetzt 7.41:1. */
  .comparison-row__label {
    font-weight: 300;
    font-size: var(--fs-text-small);
    line-height: 1.3;
    letter-spacing: 0.03em;
    color: var(--c-text);
  }


  .comparison-row__icon {
    aspect-ratio: 1;
    width: 1.4em;
    color: var(--c-text);
  }

  /* Das Fehlen wird blasser gezeichnet — aber nicht so blass, dass es
     verschwindet: 3.4:1 gegen den Grund, WCAG 1.4.11 verlangt 3:1 für
     bedeutungstragende Grafik. Was es bedeutet, steht ohnehin im
     aria-label der Zelle. */
  .comparison-row__cell[aria-label="nicht enthalten"] .comparison-row__icon {
    color: color-mix(in srgb, var(--c-dark) 55%, transparent);
  }

  /* Die eigene Spalte durchgehend hinterlegt — eine senkrechte Bahn, die
     über alle Zeilen läuft. Deshalb an Kopf UND Zellen, nicht am Kopf
     allein. */
  .comparison-header__col.is-emphasised,
  .comparison-row__cell.is-emphasised {
    background: color-mix(in srgb, var(--c-brand) 16%, transparent);
  }

  .comparison-header__col.is-emphasised .comparison-header__meta {
    color: var(--c-text);
  }

  .comparison-row__cell.is-emphasised .comparison-row__icon {
    color: var(--c-dark);
  }

  /* Unter 768px klappt jede Zeile: Name oben, die Zellen nebeneinander
     darunter. Die Ecke im Kopf entfällt, damit die Spaltennamen direkt über
     ihren Zellen stehen. */
  @media screen and (max-width: 767px) {
    .comparison-header__corner {
      display: none;
    }

    .comparison-header__inner {
      max-width: none;
    }

    .comparison-row {
      flex-flow: column;
      justify-content: flex-start;
      align-items: stretch;
    }

    .comparison-row__name {
      max-width: none;
      padding-block: var(--sp-3) var(--sp-2);
    }

    .comparison-row__cells {
      max-width: none;
    }

    .comparison-row__cell {
      padding-block: var(--sp-2) var(--sp-4);
    }
  }
</style>
