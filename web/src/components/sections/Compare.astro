---
/**
 * Vergleichstabelle — zwei Spalten nebeneinander, Zeile für Zeile.
 *
 * Aufbau übernommen aus der Osmo-Vorlage „Comparison Table (Basic)":
 * dieselben Klassennamen, dieselben ARIA-Rollen, dieselbe Mechanik. Die
 * ganze Breitenaufteilung hängt an einer einzigen Custom Property:
 *
 *   --columns-in-view: 2
 *
 * Jede Zeile teilt sich in einen Namensteil und die Zellen im Verhältnis
 * 1 : n. Ändert man die Zahl, richten sich Kopf und Zellen automatisch neu
 * aus — es gibt keine Breite, die man von Hand nachziehen müsste.
 *
 * Zwei bewusste Abweichungen von der Vorlage:
 *
 * 1. Gestaltung. Die Vorlage kommt in Stripe-Optik (Haffer, Indigo #635bff,
 *    weiße Fläche). Hier stehen unsere Tokens — sonst stünde die Tabelle
 *    neben dem Rest der Seite wie ein Fremdkörper.
 *
 * 2. Überschriftenebene. Die Vorlage setzt <h4> in die Zeilen. Da diese
 *    Section mit einer <h2> beginnt, wäre das ein übersprungener Rang —
 *    WCAG 1.3.1. Es sind <h3> geworden; der Klassenname blieb.
 */

export interface CompareColumn {
  name: string;
  /** Hebt eine Spalte hervor — hier die eigene. */
  emphasised?: boolean;
}

/**
 * Ein Wert je Zelle: Text, ja/nein als Zeichen, oder eine Pille für etwas,
 * das noch nicht gilt.
 */
/**
 * Ein Zellenwert. Vier Darstellungen, ausgeschrieben statt aus dem Typ
 * geraten: Vorher war es `string | boolean | { pille: string }` — im Code
 * kompakt, im Studio aber nicht abbildbar. Ein Redakteur kann keinen
 * TypeScript-Union eingeben; er wählt eine Darstellung aus vier.
 */
export interface CompareValue {
  kind: "text" | "ja" | "nein" | "pille";
  text?: string;
}

export interface CompareRow {
  name: string;
  values: CompareValue[];
}

interface Props {
  topline?: string;
  /** Wahlfrei — siehe `ui/SectionHeading.astro`. */
  headline?: string;
  columns: CompareColumn[];
  lines: CompareRow[];
  /** Kleingedrucktes unter der Tabelle. */
  note?: string;
}

const { topline, headline, columns, lines, note } = Astro.props;

const caption = (w: CompareValue) =>
  w.kind === "ja"
    ? "enthalten"
    : w.kind === "nein"
      ? "nicht enthalten"
      : undefined;
---

<section class="s-compare container">
  <div class="s-compare__head">
    {
      topline && (
        <span class="c-topline" data-reveal="fade">
          {topline}
        </span>
      )
    }
    {
      headline && (
        <h2 class="s-compare__title" data-split="lines">
          {headline}
        </h2>
      )
    }
  </div>

  <div
    aria-label={headline}
    role="table"
    class="s-compare__table"
    data-reveal="up"
  >
    <div role="row" class="s-compare__headrow">
      <div aria-hidden="true" class="s-compare__corner"></div>
      {
        columns.map((s) => (
          <div
            role="columnheader"
            class:list={[
              "s-compare__col",
              s.emphasised && "s-compare__col--emphasised",
            ]}
          >
            <p class="s-compare__colname">{s.name}</p>
          </div>
        ))
      }
    </div>

    <div role="rowgroup" class="s-compare__body">
      {
        lines.map((z) => (
          <div role="row" class="s-compare__row">
            <div role="rowheader" class="s-compare__rowname">
              <h3 class="s-compare__rowtitle">{z.name}</h3>
            </div>
            {z.values.map((w, i) => (
              <div
                role="cell"
                aria-label={caption(w)}
                class:list={[
                  "s-compare__cell",
                  columns[i]?.emphasised && "s-compare__cell--emphasised",
                ]}
              >
                {w.kind === "ja" || w.kind === "nein" ? (
                  /* Die Zeichen tragen keine eigene Bedeutung — die steht im
                   aria-label der Zelle. Deshalb aria-hidden, sonst hörte
                   man die Angabe zweimal. */
                  <svg
                    class="s-compare__icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    {w.kind === "ja" ? (
                      <polyline points="5 12 10 17 19 7" />
                    ) : (
                      <line x1="6" y1="12" x2="18" y2="12" />
                    )}
                  </svg>
                ) : (
                  <p class="s-compare__value">{w.text}</p>
                )}
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  {note && <p class="s-compare__note">{note}</p>}
</section>

<style>
  .s-compare {
    padding-block: var(--section-space);
  }

  /* Ohne Topline und Überschrift ist der Kopf leer — dann sammelt sich über
     der Tabelle der Abstand der Section, der des Kopfes und der der
     nummerierten Überschrift darüber. `:has()` fängt genau diesen Fall. */
  .s-compare:not(:has(.s-compare__title)):not(:has(.c-topline)) {
    padding-top: var(--sp-6);
  }

  .s-compare:not(:has(.s-compare__title)):not(:has(.c-topline))
    .s-compare__head {
    margin-bottom: 0;
  }

  .s-compare__head {
    max-width: 34ch;
    margin-bottom: var(--sp-8);
  }

  .s-compare__head .c-topline {
    margin-bottom: var(--sp-4);
  }

  .s-compare__title {
    font: var(--font-section-title);
    letter-spacing: var(--tracking-section-title);
  }

  /* Fließtext, also die Grundschrift — Mono ist der Auszeichnung
     vorbehalten: Toplines, Werte, Beschriftungen. Ein ganzer Absatz darin
     liest sich zäh. */
  .s-compare__note {
    font: var(--font-small);
    max-width: var(--measure-long);
    margin-top: var(--sp-4);
    color: var(--c-text-muted);
  }

  /* --- Die Tabelle ----------------------------------------------------- */

  /* **Ein Raster für Kopf und Zeilen, nicht zwei.**
     Vorher rechneten beide ihre Spalten getrennt aus, jede mit `flex` und
     eigenen `max-width`-Formeln. Das ging so lange gut, wie alle Zeilennamen
     gleich lang waren: Ein Flex-Element schrumpft nicht unter seinen Inhalt
     (`min-width: auto`), also drückte „Zeit für Hospitation und Fälle" die
     Namensspalte breiter und die Werte daneben schmaler. Gemessen auf
     1440px: Die Wertespalten waren je nach Zeile 54, 86, 115 oder 187px
     breit, und die beiden Spaltennamen im Kopf standen mit 66px daneben —
     sie überlappten einander und passten zu keiner Zeile darunter.

     Mit einem gemeinsamen `grid-template-columns` gibt es nichts mehr
     auszurechnen: Der Kopf und jede Zeile teilen dieselbe Vorlage, und
     `minmax(0, 1fr)` erlaubt jeder Spalte, unter ihren Inhalt zu schrumpfen. */
  .s-compare__table {
    width: 100%;
    position: relative;
  }

  /* Die erste Spalte trägt das Merkmal, jede weitere eine Variante — und alle
     sind gleich breit. Geschrieben ohne zu wissen, wie viele es sind:
     `grid-template-columns` legt nur die erste fest, `grid-auto-flow: column`
     stellt die übrigen daneben, und `grid-auto-columns` gibt ihnen dasselbe
     Maß.

     **`repeat(var(--columns-in-view), …)` geht nicht.** Die Anzahl in
     `repeat()` muss beim Parsen feststehen; eine Custom Property dort macht
     die ganze Deklaration ungültig. Gemessen sah man es sofort: Kopf und
     Zellen lagen alle auf derselben Stelle, 1360px breit, übereinander. Die
     Variable ist damit ganz entfallen — sie stand als Inline-Style am Element
     und wurde nur noch für diese eine Rechnung gebraucht.

     `minmax(0, 1fr)` statt `1fr`: Sonst schrumpft keine Spalte unter ihren
     Inhalt, und ein langer Zeilenname drückt die Werte daneben schmal. Genau
     das war vorher der Fehler, nur mit `flex` geschrieben — die Wertespalten
     waren je nach Zeile 54, 86, 115 oder 187px breit, und die Spaltennamen im
     Kopf standen mit 66px daneben und überlappten einander. */
  .s-compare__headrow,
  .s-compare__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
  }

  /* Im Kopf bleibt genau eine Linie: die unter ihm. Sie trennt die Namen der
     Varianten von den Werten und ist damit die einzige, die etwas sagt.

     Weg sind die Linie über dem Kopf und die senkrechten zwischen den Namen —
     die haben das Raster der Zeilen darunter nur verdoppelt und die Tabelle
     nach Formular aussehen lassen.

     Der Kopf klebt nicht beim Scrollen: Ohne Fläche wäre er, sobald die ersten
     Zeilen darunter durchliefen, nicht mehr zu lesen. */
  .s-compare__headrow {
    border-bottom: var(--bw) solid var(--c-line);
  }

  .s-compare__col {
    display: flex;
    flex-flow: column;
    gap: 0.4em;
    justify-content: center;
    align-items: center;
    padding-block: var(--sp-5);
    text-align: center;
  }

  .s-compare__colname {
    font-size: var(--fs-title-xs);
    font-weight: var(--fw-medium);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
  }

  .s-compare__row {
    border-bottom: var(--bw) solid var(--c-line);
  }

  /* Die letzte Zeile behält ihre Linie: Sie schließt die Tabelle nach unten
     ab. Ohne sie hörte das Raster einfach auf, statt zu enden — im Kopf steht
     eine Linie, unten stand keine. */

  /* Wechselnde Zeilen: hilft dem Auge, waagerecht in der Spur zu bleiben —
     und ersetzt den mitlaufenden Kopf, den die Tabelle nicht mehr hat. */
  .s-compare__row:nth-of-type(even) {
    background: var(--c-tint);
  }

  .s-compare__rowname {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-inline: var(--sp-4);
  }

  .s-compare__rowtitle {
    margin: 0;
    font-size: var(--fs-text-main);
    font-weight: var(--fw-regular);
    line-height: var(--lh-text);
  }

  .s-compare__cell {
    display: flex;
    flex-flow: column;
    justify-content: center;
    align-items: center;
    padding: var(--sp-4) var(--sp-3);
    text-align: center;
    /* Senkrechte Linien nur in den Zeilen, nicht im Kopf. Sie trennen, was
       verglichen wird, ohne eine Spalte durch eine Fläche hervorzuheben. Die
       erste liegt zwischen Merkmal und erstem Wert. */
    border-left: var(--bw) solid var(--c-line);
  }

  /* Volle Schriftfarbe, nicht gedimmt. Die Vorlage setzt hier `opacity: .6`
     — übernommen ergab das 4.36:1 auf den Zebra-Zeilen und 4.17:1 in der
     betonten Spalte, beides unter den 4.5:1 für Fließtext. Und es war auch
     inhaltlich falsch: Die Werte SIND der Inhalt dieser Tabelle, nicht ihr
     Beiwerk. Die Abstufung zum Zeilennamen trägt die Schriftart, nicht die
     Deckkraft. Schlechtester Fall jetzt 7.41:1. */
  .s-compare__value {
    font-weight: var(--fw-light);
    font-size: var(--fs-text-main);
    line-height: var(--lh-text);
    letter-spacing: var(--tracking-mono);
    color: var(--c-text);
  }

  .s-compare__icon {
    aspect-ratio: 1;
    width: 1.4em;
    color: var(--c-text);
  }

  /* Absence is drawn paler, but not so pale that it disappears:
     --c-line-strong is the role for marks that must be seen (3.3:1, WCAG
     1.4.11 asks 3:1 for meaningful graphics; the 55 % used before measured
     2.82:1). What it means is in the cell's aria-label anyway. */
  .s-compare__cell[aria-label="nicht enthalten"] .s-compare__icon {
    color: var(--c-line-strong);
  }

  /* Die eigene Spalte durchgehend hinterlegt — eine senkrechte Bahn, die
     über alle Zeilen läuft. Deshalb an Kopf UND Zellen, nicht am Kopf
     allein. */
  .s-compare__col--emphasised,
  .s-compare__cell--emphasised {
    background: var(--c-tint-brand);
  }

  .s-compare__cell--emphasised .s-compare__icon {
    color: var(--c-dark);
  }

  /* Unter 700px klappt jede Zeile: Name oben über die volle Breite, die
     Werte nebeneinander darunter. Die Ecke im Kopf entfällt, damit die
     Spaltennamen direkt über ihren Werten stehen.

     700px und nicht die 767px der Vorlage: Das ist die Stufe, die die
     übrigen Bausteine der Seite benutzen. */
  @media (max-width: 700px) {
    /* Flex statt Grid: Auf dem Telefon soll der Name umbrechen und die Werte
       darunter nebeneinander stehen. Ein Grid, dessen Spaltenzahl niemand
       kennt, kann das nicht — `flex-wrap` schon. */
    .s-compare__headrow,
    .s-compare__row {
      display: flex;
      flex-wrap: wrap;
    }

    .s-compare__corner {
      display: none;
    }

    .s-compare__col,
    .s-compare__cell {
      flex: 1 1 0;
      min-width: 0;
    }

    .s-compare__rowname {
      flex: 0 0 100%;
      padding-inline: 0;
      padding-block: var(--sp-3) var(--sp-2);
    }

    /* Three or four values share one phone width, about 110 and 85px each.
       With 16px on both sides "Hochleistungskeramik" had 77px and ran into
       the neighbouring column at 360px. A step smaller on the sides, and
       long compounds may break — the document is `lang="de"`, so the browser
       splits at syllables: "Hochleistungs-keramik". Only words of ten letters
       and more, with four on either side of the break: without the limit the
       browser also split "dün-ne" and "mi-nimaler". */
    .s-compare__cell {
      padding: var(--sp-2) var(--sp-1) var(--sp-4);
    }

    .s-compare__value {
      hyphens: auto;
      hyphenate-limit-chars: 10 4 4;
    }

    /* Der erste Wert einer Zeile steht links außen — dort wäre die Linie ein
       Strich am Rand des Textes und nicht zwischen zwei Werten. */
    .s-compare__cell:nth-child(2) {
      border-left: 0;
    }
  }
</style>
