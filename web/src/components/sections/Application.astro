---
/**
 * Das Bewerbungsformular: mehrere Schritte, je nach Rolle andere Fragen.
 *
 * ── Wie es zusammenhängt ─────────────────────────────────────────────────
 *
 * Schritt 1  Rolle wählen. Bestimmt alles Weitere: die Fragen in Schritt 3
 *            und die Adresse, an die es geht.
 * Schritt 2  Name, E-Mail, Telefon. Bei jeder Rolle gleich.
 * Schritt 3  Die Fragen, die im Studio an DIESER Stelle hängen. Hat eine
 *            Stelle keine, entfällt der Schritt für sie — nicht für alle.
 * Schritt 4  Freier Text, dann abschicken.
 *
 * ── Warum die Fragen aller Rollen im Markup stehen ───────────────────────
 *
 * Die Seite ist statisch. Es gibt keinen Server, der auf die Wahl in
 * Schritt 1 hin Schritt 3 nachliefern könnte. Also steht alles da, und das
 * Skript blendet aus, was nicht zur Wahl gehört. Ausgeblendete Felder
 * bekommen `disabled` — sonst prüft der Browser Pflichtfelder mit, die
 * niemand sehen kann, und das Formular ließe sich nicht abschicken, ohne
 * dass irgendwo etwas rot wird.
 *
 * ── Wohin es geht ────────────────────────────────────────────────────────
 *
 * Vorerst in eine vorbereitete E-Mail (`mailto:`) an die Adresse, die an der
 * Stelle hinterlegt ist. Das ist bewusst der kleine Schritt: Es funktioniert
 * sofort, speichert nichts bei Dritten und wirft keine Datenschutzfragen
 * auf. Es kann dafür keine Anhänge — Lebenslauf und Zeugnisse hängt die
 * Bewerberin selbst an die geöffnete Mail.
 *
 * Der richtige Versand mit Datei-Upload steht als Aufgabe 17 in
 * `CMS-UMBAU.md`. Bis dahin gilt: Dieses Formular verliert nichts, weil es
 * nichts selbst verschickt. Das Kontaktformular geht seit dem Umbau an
 * Netlify Forms; hier ginge das auch, kostet aber die Anhänge — Netlify nimmt
 * pro Einsendung Dateien entgegen, Lebenslauf UND Zeugnisse sind aber
 * regelmäßig mehr, als ein Formularfeld trägt.
 *
 * ── Fehlermeldungen ──────────────────────────────────────────────────────
 *
 * Jedes Feld trägt eine leere `.c-field__message` mit eigener ID. Das Modul
 * schreibt den Grund hinein und verknüpft ihn über `aria-describedby` mit dem
 * Feld. Vorher gab es nur `aria-invalid` und einen Fokussprung: Ein
 * Vorlesegerät sagte „ungültig" und nicht, was fehlt (WCAG 3.3.3).
 */
import Panel from "../ui/Panel.astro";
import Button from "../ui/Button.astro";
import type { Job } from "../../lib/careers";

interface Props {
  id?: string;
  topline: string;
  headline: string;
  text?: string;
  jobs: Job[];
  /** Adresse für Stellen, an denen keine eigene hinterlegt ist. */
  fallbackEmail?: string;
}

const { id, topline, headline, text, jobs, fallbackEmail } = Astro.props;

/* Nur Stellen, die überhaupt eine Adresse haben — eigene oder allgemeine.
   Eine Rolle zur Wahl zu stellen, deren Bewerbung nirgends ankommt, ist
   schlimmer, als sie wegzulassen. */
const selectable = jobs.filter((j) => j.applicationEmail || fallbackEmail);

const STEPS = ["Stelle", "Kontakt", "Fragen", "Nachricht"];
---

{
  selectable.length > 0 && (
    <Panel id={id} topline={topline} title={headline} text={text}>
      <form class="c-apply" data-apply novalidate>
        {/* Der Fortschritt. `aria-hidden`, weil jede Legende die Schrittzahl
          als sr-only-Zusatz trägt („Schritt 2 von 4") — dieselbe Auskunft
          zweimal vorgelesen hilft niemandem. */}
        <ol class="c-apply__progress" aria-hidden="true">
          {STEPS.map((name, i) => (
            <li class="c-apply__marker" data-apply-marker={i}>
              <span class="c-apply__marker-number">{i + 1}</span>
              <span class="c-apply__marker-label">{name}</span>
            </li>
          ))}
        </ol>

        {/* ── Schritt 1: Rolle ─────────────────────────────────────────── */}
        <fieldset class="c-apply__step" data-apply-step="0">
          <legend class="c-apply__legend">
            <span class="sr-only">Schritt 1 von 4: </span>Ich bewerbe mich auf
            die Anstellung als
          </legend>

          <div class="c-apply__roles">
            {selectable.map((j, i) => (
              <label class="c-apply__role">
                <input
                  type="radio"
                  name="role"
                  value={j.title}
                  data-apply-role={j.handle}
                  data-apply-mail={j.applicationEmail || fallbackEmail}
                  required={i === 0}
                />
                <span class="c-apply__role-text">
                  <span class="c-apply__role-title">{j.title}</span>
                  {(j.kind || j.location) && (
                    <span class="c-apply__role-meta">
                      {[j.kind, j.location].filter(Boolean).join(" · ")}
                    </span>
                  )}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* ── Schritt 2: Kontakt ───────────────────────────────────────── */}
        <fieldset class="c-apply__step" data-apply-step="1" hidden>
          <legend class="c-apply__legend">
            <span class="sr-only">Schritt 2 von 4: </span>Wie erreichen wir
            dich?
          </legend>

          <div class="c-field" data-field>
            <label class="c-field__label" for="a-name">
              Name <span>*</span>
            </label>
            <div class="c-field__control">
              <input
                id="a-name"
                name="name"
                type="text"
                autocomplete="name"
                required
              />
              <span class="c-field__error" aria-hidden="true">
                !
              </span>
            </div>
            <p class="c-field__message" id="a-name-message" hidden />
          </div>

          <div class="c-field" data-field>
            <label class="c-field__label" for="a-mail">
              E-Mail-Adresse <span>*</span>
            </label>
            <div class="c-field__control">
              <input
                id="a-mail"
                name="email"
                type="email"
                autocomplete="email"
                required
              />
              <span class="c-field__error" aria-hidden="true">
                !
              </span>
            </div>
            <p class="c-field__message" id="a-mail-message" hidden />
          </div>

          <div class="c-field" data-field>
            <label class="c-field__label" for="a-tel">
              Telefon
            </label>
            <div class="c-field__control">
              <input id="a-tel" name="phone" type="tel" autocomplete="tel" />
            </div>
            <p class="c-field__message" id="a-tel-message" hidden />
          </div>
        </fieldset>

        {/* ── Schritt 3: Fragen je Rolle ───────────────────────────────── */}
        <fieldset class="c-apply__step" data-apply-step="2" hidden>
          <legend class="c-apply__legend">
            <span class="sr-only">Schritt 3 von 4: </span>Zwei Fragen zur Stelle
          </legend>

          {selectable.map((j) => (
            <div
              class="c-apply__questions"
              data-apply-questions={j.handle}
              hidden
            >
              {(j.applicationQuestions ?? []).map((f, i) => {
                const fieldId = `a-${j.handle}-${i}`;
                return (
                  <div class="c-field" data-field>
                    <label class="c-field__label" for={fieldId}>
                      {f.label} {f.required && <span>*</span>}
                    </label>
                    <div class="c-field__control">
                      {f.kind === "long" ? (
                        <textarea
                          id={fieldId}
                          name={f.label}
                          rows="4"
                          required={f.required}
                          disabled
                        />
                      ) : f.kind === "choice" ? (
                        <select
                          id={fieldId}
                          name={f.label}
                          required={f.required}
                          disabled
                        >
                          <option value="">Bitte wählen</option>
                          {(f.choices ?? []).map((w) => (
                            <option value={w}>{w}</option>
                          ))}
                        </select>
                      ) : (
                        <input
                          id={fieldId}
                          name={f.label}
                          type="text"
                          required={f.required}
                          disabled
                        />
                      )}
                      <span class="c-field__error" aria-hidden="true">
                        !
                      </span>
                    </div>
                    <p
                      class="c-field__message"
                      id={`${fieldId}-message`}
                      hidden
                    />
                  </div>
                );
              })}
            </div>
          ))}
        </fieldset>

        {/* ── Schritt 4: Nachricht ─────────────────────────────────────── */}
        <fieldset class="c-apply__step" data-apply-step="3" hidden>
          <legend class="c-apply__legend">
            <span class="sr-only">Schritt 4 von 4: </span>Willst du uns noch
            etwas sagen?
          </legend>

          <div class="c-field" data-field>
            <label class="c-field__label" for="a-text">
              Nachricht
            </label>
            <div class="c-field__control">
              <textarea id="a-text" name="message" rows="5" />
            </div>
            <p class="c-field__message" id="a-text-message" hidden />
          </div>

          {/* Ehrlich sein, statt zu überraschen: Der Knopf öffnet das
            E-Mail-Programm. Wer das nicht erwartet, hält es für einen
            Fehler und bewirbt sich nicht. */}
          <p class="c-apply__note">
            Der Knopf öffnet dein E-Mail-Programm mit allem, was du hier
            eingetragen hast. Lebenslauf und Zeugnisse hängst du dort an und
            schickst die Mail ab.
          </p>
        </fieldset>

        {/* ── Steuerung ────────────────────────────────────────────────── */}
        <div class="c-apply__controls">
          <button class="c-apply__back" type="button" data-apply-back hidden>
            Zurück
          </button>
          {/* Die Hülle trägt das Steuer-Attribut, der Knopf kommt aus der
            Komponente. Ein von Hand geschriebenes `class="c-btn"` bliebe
            nackt: Die Optik liegt scoped in Button.astro, und dieses Markup
            bekäme eine andere Scope-Kennung. Klicks steigen zur Hülle auf,
            `hidden` an ihr versteckt den Knopf mit. */}
          <span class="c-apply__next" data-apply-next>
            <Button label="Weiter" type="button" />
          </span>
          <span class="c-apply__submit" data-apply-submit hidden>
            <Button label="Bewerbung schreiben" href="#" />
          </span>
        </div>

        {/* WCAG 2.2, 4.1.3. Dieselbe Rolle wie im Kontaktformular: Der
          Schrittwechsel und die Zahl der offenen Felder sind Auskünfte, keine
          Störungen. Die Region steht von Anfang an im Dokument und bleibt
          leer — eine erst beim Fehler eingefügte wird von manchen
          Vorlesegeräten nicht beobachtet. */}
        <p
          class="c-apply__status"
          data-apply-status
          role="status"
          aria-live="polite"
        />
      </form>
    </Panel>
  )
}

<style>
  .c-apply {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
    max-width: 58ch;
  }

  /* Leer und ohne Rand, solange nichts zu sagen ist: `:empty` verhindert,
     dass ein Abstand entsteht, wo noch kein Satz steht. */
  .c-apply__status:not(:empty) {
    margin-top: var(--sp-4);
    font-size: var(--fs-text-small);
    line-height: 1.45;
    color: var(--c-text-muted);
  }

  /* --- Fortschritt ------------------------------------------------------ */

  .c-apply__progress {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .c-apply__marker {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-label);
    /* Die gedämpfte Schriftfarbe trägt das Zurücktreten allein.

       Vorher lag zusätzlich `opacity: 0.5` darauf. Beides zusammen ergab eine
       wirksame Deckkraft von 0.375 und gemessen 2.34:1 gegen den Grund — die
       Namen der kommenden Schritte waren damit kaum lesbar, und sie sind das
       Einzige, was verrät, was noch kommt. `--c-text-muted` allein liegt bei
       4.53:1. */
    color: var(--c-text-muted);
    transition: color var(--d-base) var(--e-out);
  }

  /* Der aktuelle Schritt und alle davor stehen in voller Schriftfarbe — man
     soll sehen, wie weit man ist, nicht nur wo. Das Attribut setzt
     application.js. */
  .c-apply__marker[data-reached] {
    color: var(--c-text);
  }

  .c-apply__marker-number {
    display: grid;
    place-items: center;
    width: 1.8em;
    height: 1.8em;
    border-radius: var(--r-round);
    border: var(--bw) solid var(--c-line);
    /* Bewusst em statt Token: Der Kreis ist 1.8em breit und hoch, Ziffer und
       Kreis skalieren zusammen mit dem Kontext. Ein fester Grad würde die
       Geometrie von der Schrift entkoppeln. */
    font-size: 0.9em;
    line-height: 1;
  }

  .c-apply__marker[data-active] .c-apply__marker-number {
    background: var(--c-brand);
    border-color: var(--c-brand);
    color: var(--c-dark);
  }

  /* --- Schritte --------------------------------------------------------- */

  /* `border: 0` und `padding: 0`: Der Browser gibt <fieldset> einen eigenen
     Rahmen und Innenabstand, die hier nur stören. Das Element bleibt, weil
     es die Felder für Vorlesegeräte zu einer Gruppe zusammenfasst. */
  .c-apply__step {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .c-apply__legend {
    padding: 0;
    margin-bottom: var(--sp-2);
    font-size: var(--fs-text-large);
    line-height: 1.3;
  }

  /* --- Rollenwahl ------------------------------------------------------- */

  .c-apply__roles {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .c-apply__role {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border: var(--bw) solid var(--c-line);
    border-radius: var(--r-md);
    cursor: pointer;
    transition:
      border-color var(--d-base) var(--e-out),
      background var(--d-base) var(--e-out);
  }

  .c-apply__role:hover {
    border-color: var(--c-dark);
  }

  /* `:has()` statt einer Klasse vom Skript: Der Zustand steht schon im
     Formular, ein zweiter im DOM liefe auseinander. */
  .c-apply__role:has(input:checked) {
    border-color: var(--c-dark);
    background: color-mix(in srgb, var(--c-brand) 14%, transparent);
  }

  .c-apply__role:has(input:focus-visible) {
    outline: 2px solid var(--c-dark);
    outline-offset: 2px;
  }

  .c-apply__role input {
    flex: 0 0 auto;
    margin-top: 0.2em;
    accent-color: var(--c-dark);
  }

  .c-apply__role-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .c-apply__role-title {
    font-size: var(--fs-text-main);
    line-height: 1.3;
  }

  .c-apply__role-meta {
    font-size: var(--fs-text-small);
    color: var(--c-text-muted);
  }

  /* --- Hinweis und Steuerung -------------------------------------------- */

  .c-apply__note {
    font-size: var(--fs-text-small);
    line-height: 1.5;
    color: var(--c-text-muted);
  }

  .c-apply__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
  }

  .c-apply__back {
    padding: 0;
    border: 0;
    background: none;
    color: var(--c-text-muted);
    font-family: inherit;
    font-size: var(--fs-text-small);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .c-apply__back:hover {
    color: var(--c-dark);
  }

  /* Der Weiter-Knopf steht rechts vom Zurück-Link, aber vor dem Absenden —
     `margin-inline-start: auto` schiebt beide ans Ende der Reihe. */
  .c-apply__next,
  .c-apply__submit {
    margin-inline-start: auto;
  }
</style>
