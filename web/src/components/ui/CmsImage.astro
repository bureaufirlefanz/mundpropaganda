---
/**
 * Ein Bild, das aus dem CMS kommen kann — oder aus public/img, solange im
 * Studio keines gepflegt ist. Beide Fälle sehen im Markup gleich aus, damit
 * die Sections keine Fallunterscheidung tragen müssen.
 *
 * Gegenstück zu Picture.astro: das bedient die feste Bildpipeline des
 * Prototyps, dieses hier das CDN.
 */
import {
  isCmsImage,
  imageUrl,
  imageSrcset,
  imageSize,
  hotspotPosition,
  type ImageSource,
} from "../../lib/images";
import WIDTHS from "../../lib/image-widths.json";
import type { CmsImageValue } from "../../lib/images";

interface Props {
  source: ImageSource | undefined | null;
  alt?: string;
  /** Breiten für das srcset. Voreinstellung deckt Karten bis Vollpicture ab. */
  widths?: number[];
  /**
   * The width the image has to COVER, not the width of its box. Under
   * `object-fit: cover` a landscape photo in a portrait box shows only its
   * middle: a 3:2 image in a 3:4 box needs twice the box width, so the right
   * value there is `200vw`, not `100vw`. Too small a value makes the browser
   * pick a file that is then stretched: the magazine cards declared `24vw`
   * while being 84vw wide on a phone, and came out soft. Derive it from the
   * component's CSS at each of its breakpoints; values above 100vw or in vh
   * are correct.
   */
  sizes?: string;
  /** Nur für das LCP-Bild einer Seite setzen. */
  eager?: boolean;
  /**
   * Seitenverhältnis (Breite/Höhe). Nur setzen, wenn serverseitig
   * beschnitten werden soll — dann wirkt auch der Bildmittelpunkt aus dem
   * Studio. Ohne Angabe beschneidet CSS über `object-fit: cover`.
   */
  ratio?: number;
  /**
   * Alles Übrige geht unverändert an das <img>. Die Module greifen über
   * data-Attribute zu (`data-standards-img`, `data-parallax`) — würde die
   * Komponente sie verschlucken, fände das Modul sein Markup nicht mehr.
   */
  [key: string]: unknown;
}

const {
  source,
  alt = "",
  widths = [640, 1024, 1600, 2200],
  sizes = "100vw",
  eager = false,
  ratio,
  ...rest
} = Astro.props;

const cms = isCmsImage(source);

/* Der Alternativtext steht am Bild im Studio. Ein ausgeschriebenes alt am
   Aufrufort gewinnt trotzdem — dekorative Bilder brauchen ein leeres. */
const description = alt || (cms ? ((source as any).alt ?? "") : "");

/* Platzhalter, bis das Bild da ist. Anders als die lokalen Motive liegen
   CMS-Bilder auf einem fremden Host — ohne das bleibt der Rahmen bis dahin
   leer. Als Hintergrund am Bild selbst, damit nichts zusätzlich im DOM steht. */
const lqip = cms ? (source as any).asset?.metadata?.lqip : undefined;

/* Eine Zeichenkette kann zweierlei sein: ein fertiger Pfad („/img/x-800.webp",
   so übergibt es `ServiceHero`) oder der bloße Name eines Motivs aus der
   lokalen Pipeline („teeth-macro"). Bis hierher landete der Name ungeprüft im
   `src`, und der Browser lud eine Adresse, die es nicht gibt — auf der Pillar
   Page waren das vier tote Bilder. Ein Name ohne Schrägstrich wird deshalb
   jetzt aufgelöst, mit allen Breiten, die die Pipeline erzeugt hat.

   Lauter Abbruch bei unbekanntem Namen, dieselbe Begründung wie in
   `Picture.astro`: Ein Tippfehler soll den Build anhalten und nicht erst auf
   der fertigen Seite auffallen. */
const motif =
  !cms && typeof source === "string" && !source.includes("/") ? source : null;
const motifWidths = motif
  ? (WIDTHS as Record<string, number[]>)[motif]
  : undefined;

if (motif && !motifWidths?.length) {
  throw new Error(
    `CmsImage: Motiv „${motif}" steht nicht in image-widths.json. ` +
      `Entweder ist der Name falsch geschrieben, oder es fehlt ein Lauf von ` +
      `\`npm run images\`.`,
  );
}

const motifSrcset = (ext: string) =>
  motifWidths!.map((w) => `/img/${motif}-${w}.${ext} ${w}w`).join(", ");

/* Maße und Bildmittelpunkt gelten nur für Bilder aus dem CMS: Die lokale
   Pipeline schreibt ihre Höhen nicht auf, und einen Hotspot hat sie nicht. */
const largest = widths[widths.length - 1];
const size = cms
  ? imageSize(source as CmsImageValue, largest, ratio)
  : undefined;

/* Ohne `ratio` schneidet CSS, und dann muss der Punkt hier hin. Mit `ratio`
   hat das CDN bereits um ihn herum beschnitten — ein zweites Mal wäre
   doppelt. */
const position =
  cms && !ratio ? hotspotPosition(source as CmsImageValue) : undefined;

const style =
  [
    lqip &&
      `background-image:url(${lqip});background-size:cover;background-position:center`,
    position && `object-position:${position}`,
  ]
    .filter(Boolean)
    .join(";") || undefined;
---

{
  source == null ? null : cms ? (
    <img
      {...rest}
      src={imageUrl(source as any, widths[widths.length - 1], ratio)}
      srcset={imageSrcset(source as any, widths, ratio)}
      sizes={sizes}
      alt={description}
      width={size?.width}
      height={size?.height}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding={eager ? undefined : "async"}
      style={style}
    />
  ) : motif ? (
    /* AVIF zuerst, WebP als Rückfall — dieselbe Reihenfolge wie in
       `Picture.astro`, damit ein Motiv überall gleich ausgeliefert wird. */
    <picture>
      <source type="image/avif" srcset={motifSrcset("avif")} sizes={sizes} />
      <source type="image/webp" srcset={motifSrcset("webp")} sizes={sizes} />
      <img
        {...rest}
        src={`/img/${motif}-${motifWidths![0]}.webp`}
        alt={description}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
        decoding={eager ? undefined : "async"}
      />
    </picture>
  ) : (
    <img
      {...rest}
      src={source as string}
      alt={description}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding={eager ? undefined : "async"}
    />
  )
}
