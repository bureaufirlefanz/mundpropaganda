---
/**
 * Ein Bild, das aus dem CMS kommen kann — oder aus public/img, solange im
 * Studio keines gepflegt ist. Beide Fälle sehen im Markup gleich aus, damit
 * die Sections keine Fallunterscheidung tragen müssen.
 *
 * Gegenstück zu Picture.astro: das bedient die feste Bildpipeline des
 * Prototyps, dieses hier das CDN.
 */
import { isCmsImage, imageUrl, imageSrcset, type ImageSource } from "../../lib/images";

interface Props {
  source: ImageSource | undefined | null;
  alt?: string;
  /** Breiten für das srcset. Voreinstellung deckt Karten bis Vollpicture ab. */
  widths?: number[];
  sizes?: string;
  /** Nur für das LCP-Bild einer Seite setzen. */
  eager?: boolean;
  /**
   * Seitenverhältnis (Breite/Höhe). Nur setzen, wenn serverseitig
   * beschnitten werden soll — dann wirkt auch der Bildmittelpunkt aus dem
   * Studio. Ohne Angabe beschneidet CSS über `object-fit: cover`.
   */
  ratio?: number;
  /**
   * Alles Übrige geht unverändert an das <img>. Die Module greifen über
   * data-Attribute zu (`data-standards-img`, `data-parallax`) — würde die
   * Komponente sie verschlucken, fände das Modul sein Markup nicht mehr.
   */
  [key: string]: unknown;
}

const {
  source,
  alt = "",
  widths = [640, 1024, 1600, 2200],
  sizes = "100vw",
  eager = false,
  ratio,
  ...rest
} = Astro.props;

const cms = isCmsImage(source);

/* Der Alternativtext steht am Bild im Studio. Ein ausgeschriebenes alt am
   Aufrufort gewinnt trotzdem — dekorative Bilder brauchen ein leeres. */
const description = alt || (cms ? (source as any).alt ?? "" : "");

/* Platzhalter, bis das Bild da ist. Anders als die lokalen Motive liegen
   CMS-Bilder auf einem fremden Host — ohne das bleibt der Rahmen bis dahin
   leer. Als Hintergrund am Bild selbst, damit nichts zusätzlich im DOM steht. */
const lqip = cms ? (source as any).asset?.metadata?.lqip : undefined;
---

{
  source == null ? null : cms ? (
    <img
      {...rest}
      src={imageUrl(source as any, widths[widths.length - 1], ratio)}
      srcset={imageSrcset(source as any, widths, ratio)}
      sizes={sizes}
      alt={description}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding={eager ? undefined : "async"}
      style={lqip
        ? `background-image:url(${lqip});background-size:cover;background-position:center`
        : undefined}
    />
  ) : (
    <img
      {...rest}
      src={source as string}
      alt={description}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding={eager ? undefined : "async"}
    />
  )
}
