---
/**
 * Ein Bild im Fließtext eines Beitrags.
 *
 * Drei Breiten, und der Unterschied zwischen ihnen ist der eigentliche Punkt
 * dieses Bausteins: Die Textspalte ist auf 68 Zeichen begrenzt, weil das die
 * Grenze ist, ab der das Auge die nächste Zeile nicht mehr sicher findet.
 * Rechts daneben liegen dadurch rund 350px brach. Ein Bild, das dort
 * hineinragt, nutzt sie — und setzt zugleich einen Rhythmus, den eine Spalte
 * aus lauter gleich breiten Absätzen nicht hat.
 *
 *   column   bleibt in der Textspalte
 *   wide     reicht bis an den rechten Rand des Satzspiegels
 *   full     bricht aus dem Rahmen aus, über die volle Seitenbreite
 *
 * Die Breite entscheidet die Redaktion im Studio, nicht dieser Baustein. Sie
 * sieht das Bild, wir sehen nur seine Maße.
 */
import CmsImage from "./CmsImage.astro";
import { isCmsImage, type ImageSource } from "../../lib/images";

interface Props {
  node: {
    image?: ImageSource;
    width?: "column" | "wide" | "full";
    caption?: string;
  };
}

const { node } = Astro.props;
const width = node.width ?? "wide";

/* Was der Browser laden soll, hängt an der Breite — ein Bild in der
   Textspalte braucht nie 2200px. Ohne diese Unterscheidung lieferte die
   Seite für ein 640px breites Motiv dieselbe Datei aus wie für ein
   randbreites. */
const SIZES = {
  column: "(max-width: 1000px) 100vw, 68ch",
  /* Since 2026-09-27 a wide image really spans the column plus the margin
     track (see Post.astro): about 74vw beside the contents, 94vw without. */
  wide: "(max-width: 1000px) 100vw, 90vw",
  full: "100vw",
} as const;
---

{
  isCmsImage(node.image) && (
    <figure class="c-postimage" data-width={width}>
      <CmsImage
        source={node.image}
        alt=""
        widths={[640, 1024, 1600, 2200]}
        sizes={SIZES[width]}
      />
      {node.caption && (
        <figcaption class="c-postimage__caption">{node.caption}</figcaption>
      )}
    </figure>
  )
}

<style>
  .c-postimage {
    margin-block: var(--sp-10);
  }

  /* :global(img), weil das Bild aus CmsImage.astro kommt und das
     Scope-Attribut dieser Datei nicht trägt. */
  .c-postimage :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--r-md);
  }

  /* Über die volle Seitenbreite. Der Rahmen ist auf `--site-max` gedeckelt
     und zentriert; `100vw` plus die Hälfte der Differenz nach links holt das
     Bild wieder an den Fensterrand. `calc` statt eines festen Werts, weil der
     Rahmen mit dem Fenster wächst.

     `border-radius: 0`: Eine Rundung an einer Kante, die am Fensterrand
     endet, sieht aus wie ein Fehler beim Zuschneiden. */
  .c-postimage[data-width="full"] {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  .c-postimage[data-width="full"] :global(img) {
    border-radius: 0;
  }

  .c-postimage__caption {
    margin-top: var(--sp-3);
    font-family: var(--f-mono);
    font-weight: var(--fw-light);
    font-size: var(--fs-label);
    line-height: var(--lh-text);
    letter-spacing: var(--tracking-mono);
    color: var(--c-text-muted);
  }

  /* Bei voller Breite hängt die Bildunterschrift sonst am Fensterrand. */
  .c-postimage[data-width="full"] .c-postimage__caption {
    max-width: var(--site-max);
    margin-inline: auto;
    padding-inline: var(--site-margin);
  }
</style>
