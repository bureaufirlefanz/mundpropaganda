---
/**
 * Die Leistungsspalten im Menü kommen aus der Collection — dieselbe Quelle wie
 * Services-Tabelle und Footer. Alles Übrige (Hauptmenü, Zusatzspalten, der
 * Button) steht seit Aufgabe 8 im Dokument „Navigation".
 *
 * Desktop und Telefon zeigen jetzt dieselben Zusatzspalten. Vorher waren es
 * zwei verschiedene Sätze — „Direkt" am Schreibtisch, „Praxis" am Telefon —
 * ohne dass ein Grund dafür erkennbar wäre; es war schlicht zweimal getipptes
 * Markup.
 *
 * Die vierte Spalte trägt jetzt das Werbefeld (`ui/NavPromo.astro`) statt
 * einer weiteren Linkliste. `menuColumns` aus dem Studio wird deshalb nicht
 * mehr gerendert — siehe die Notiz am Aufrufort weiter unten.
 */
import Button from "./Button.astro";
import NavPromo from "./NavPromo.astro";
import { navPromo } from "../../content/nav-promo";
import {
  loadServiceList,
  forGroup,
  servicePath,
  GROUPS,
} from "../../lib/service-list";
import { loadNavigation, resolved } from "../../lib/navigation";

const list = await loadServiceList();
const serviceColumns = GROUPS.map((g) => ({
  title: g.title,
  items: forGroup(list, g.value),
}));

const nav = await loadNavigation();
const here = Astro.url.pathname;

const mainMenu = await resolved(nav?.mainMenu, here);
const action = (await resolved([nav?.action ?? null], here))[0];

/* Drei Leistungsgruppen plus Werbefeld ergeben die vier Spalten des Rasters.
   `menuColumns` aus dem Studio wird hier bewusst nicht mehr gelesen:

   Das Feld trug genau eine Spalte („Direkt") mit vier Verweisen, die alle
   schon im Hauptmenü oder im Fuß stehen. Ein zweiter Weg zu denselben vier
   Seiten ist kein Gewinn, die Stelle ist die auffälligste im Menü — dort
   steht jetzt der Verweis auf die Pillar Page.

   **Das Feld gehört damit aus dem Schema.** Solange es im Studio steht und
   hier niemand es liest, verspricht die Oberfläche eine Wirkung, die es nicht
   gibt — genau die Sorte Lüge, die Stufe 2 des Umbaus beseitigt hat. Das
   Schema anzufassen ist aber nicht Teil dieser Aufgabe (Briefing §4). */
---

<header class="c-nav" data-nav data-hidden="false" data-scrolled="false">
  <div class="c-nav__inner">
    <a
      class="c-nav__logo"
      href="/"
      aria-label="Mundpropaganda - zur Startseite"
    >
      <svg aria-hidden="true"><use href="#i-logo"></use></svg>
      <span>Mundpropaganda</span>
    </a>

    {
      /* Der ERSTE Eintrag öffnet das große Menü — daran hängt nav.js über
        `data-nav-item="services"`. Das ist eine Eigenschaft des Aufbaus,
        keine des Inhalts: Die Leistungen sind der einzige Punkt mit
        Unterpunkten.

        Die übrigen tragen einen LEEREN Wert, nicht `true`: nav.js liest
        `dataset.navItem` und sucht damit ein Panel. Bei "true" suchte es
        nach `[data-megamenu="true"]` — findet nichts, schadet nichts,
        behauptet aber einen Namen, den es nicht gibt. */
    }
    <nav class="c-nav__menu" aria-label="Hauptnavigation">
      {
        mainMenu.map((entry, i) => (
          <div
            class="c-nav__item"
            data-nav-item={i === 0 ? "services" : ""}
            data-open={i === 0 ? "false" : undefined}
          >
            <a class="c-nav__link" href={entry.href}>
              {entry.text}
            </a>
          </div>
        ))
      }
    </nav>

    <div class="c-nav__actions">
      {action && <Button label={action.text} href={action.href} />}

      {
        /* `aria-controls` nennt das Panel, das der Button öffnet, und die
          Aufschrift wechselt mit dem Zustand — beides setzt `nav.js`. Ohne
          das sagte ein Vorlesegerät dauerhaft „Menü öffnen", auch wenn das
          Menü offen war, und nannte nie, was da eigentlich aufgeht. */
      }
      <button
        class="c-nav__burger"
        data-burger
        type="button"
        aria-expanded="false"
        aria-controls="nav-mobile"
        aria-label="Menü öffnen"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="c-megamenu" data-megamenu="services">
    <div class="c-megamenu__inner">
      {
        serviceColumns.map((column) => (
          <div data-megamenu-item>
            <p class="c-megamenu__col-title">{column.title}</p>
            {column.items.map((l) => (
              <a class="c-megamenu__link" href={servicePath(l)}>
                {l.name}
              </a>
            ))}
          </div>
        ))
      }

      <div class="c-megamenu__promo" data-megamenu-item>
        <NavPromo {...navPromo} />
      </div>
    </div>
  </div>

  <div class="c-megamenu" id="nav-mobile" data-mobile-menu>
    <div class="c-megamenu__inner">
      {
        /* Alle Gruppen, nicht nur die erste. Vorher stand hier `columns[0]` —
          das Menü zeigte damit vier von elf Leistungen, und welche vier war
          reine Folge der Sortierung. Wer über das Telefon kommt, sieht jetzt
          dieselbe Auswahl wie am Schreibtisch. */
      }
      {
        serviceColumns.map((column) => (
          <div data-megamenu-item>
            <p class="c-megamenu__col-title">{column.title}</p>
            {column.items.map((l) => (
              <a class="c-megamenu__link" href={servicePath(l)}>
                {l.name}
              </a>
            ))}
          </div>
        ))
      }
      <div class="c-megamenu__promo" data-megamenu-item>
        <NavPromo {...navPromo} />
      </div>
    </div>
  </div>
</header>

<style>
  /* Fixed, mischt sich in den Hintergrund. Blendet beim Runterscrollen aus
     und beim Hochscrollen wieder ein (Steuerung in js/modules/nav.js).

     Schwebende Leiste statt vollflächigem Balken: sie sitzt mit Abstand vom
     Rand und ist gerundet wie die übrigen Flächen der Seite. Position, Größe
     und Milchglas-Grund sind über die ganze Seite hinweg konstant. */
  .c-nav {
    /* Die Leiste steht auf beiden Seiten etwas weiter außen als der Inhalt
       darunter. Vorher lag sie exakt auf derselben Kante (bei 1440px beide
       bei x=40), und dadurch las sie sich als erste Zeile des Inhalts statt
       als etwas, das darüber liegt.

       Der Überstand ist ein Wert und keine zwei: Er wird vom Außenabstand
       abgezogen UND zur Innenbreite addiert, sonst verschöbe sich nur eine
       der beiden Kanten. */
    --nav-overhang: clamp(8px, 1vw, 20px);

    /* Kante und Breite stehen als eigene Werte da, weil zwei Dinge sie
       brauchen: die Leiste und das Aufklappmenü darunter. Vorher rechnete
       jedes für sich (`left: var(--site-margin)` gegen `padding: …`), und als
       die Leiste nach außen rückte, blieb das Menü stehen — beide sollen aber
       als eine Fläche gelesen werden. */
    --nav-edge: max(8px, calc(var(--site-margin) - var(--nav-overhang)));
    --nav-width: calc(
      var(--site-max) - 2 * var(--site-margin) + 2 * var(--nav-overhang)
    );

    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    padding: var(--sp-4) var(--nav-edge);
    color: var(--c-dark);
    pointer-events: none;
  }

  .c-nav > * {
    pointer-events: auto;
  }

  /* Die eigentliche Fläche. Als eigenes Element, damit sie unabhängig vom
     Außenabstand gerundet und gefärbt werden kann. */
  .c-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    /* Nicht `--site-max`: Das ist die Breite des Rahmens SAMT Außenabstand.
       Verglichen wird die Leiste aber mit dem, was man sieht — der Spalte
       innerhalb des Rahmens. Ohne diese Rechnung wüchse der Überstand mit
       dem Fenster: bei 1440px wären es 14px, bei 2000px schon 68. */
    max-width: var(--nav-width);
    margin-inline: auto;
    padding: var(--sp-2) var(--sp-2) var(--sp-2) var(--sp-4);
    border-radius: var(--r-round);

    /* Milchglas: deckend genug, dass die Wortmarke darunter nicht stört,
       aber durchlässig genug, dass die Seite in Bewegung bleibt. Nur
       Unschärfe und Fläche — Glaskanten und Innenlicht standen hier schon
       und trugen zu dick auf. */
    background: color-mix(in srgb, var(--c-white) 72%, transparent);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    box-shadow: var(--shadow-bar);
  }

  /* Die Leiste fährt als Teil der Hero-Choreografie von oben herein
     (modules/hero.js). Ihren Startzustand setzt GSAP erst, wenn die Module
     laufen — das ist nach dem ersten Bild. Bis dahin stand sie fertig da und
     sprang dann nach oben weg. Deshalb hier verbergen und in hero.js
     freigeben, sobald der Startwert gesetzt ist.

     Nur `visibility`: Versatz und Deckkraft bleiben in GSAPs Hand, damit
     Startwert und Animation an einer Stelle stehen. */
  html.js .c-nav__inner {
    visibility: hidden;
  }

  /* Ohne Bewegung gibt es keinen Auftritt, der freigeben würde. */
  @media (prefers-reduced-motion: reduce) {
    html.js .c-nav__inner {
      visibility: visible;
    }
  }

  .c-nav__logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--f-mono);
    font-weight: 300;
    font-size: var(--fs-text-small);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
  }

  .c-nav__logo svg {
    width: 22px;
    height: 30px;
    flex: 0 0 auto;
  }

  .c-nav__menu {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .c-nav__link {
    position: relative;
    padding: 7px 10px;
    font-family: var(--f-mono);
    font-weight: 300;
    font-size: var(--fs-label-md);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    border-radius: var(--r-sm);
    transition: color var(--d-fast) var(--e-swift);
  }

  /* Gleiche Wischbewegung wie bei .c-link — ein Verhalten für alle Links. */
  .c-nav__link::after {
    content: "";
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 3px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform var(--d-base) var(--e-out);
  }

  @media (hover: hover) {
    .c-nav__link:hover::after,
    .c-nav__item[data-open="true"] .c-nav__link::after {
      transform: scaleX(1);
      transform-origin: left center;
    }
  }

  .c-nav__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  /* --- Mega-Menu ------------------------------------------------------- */

  /* Schwebendes Panel unter der Leiste, auf derselben Breite und mit
     derselben Rundung — kein durchgehender Balken.

     Liegt als Geschwister der Leiste, nicht darin: ein backdrop-filter
     erzeugt einen eigenen Backdrop-Root, und ein Panel innerhalb der Leiste
     hätte nur deren bereits gefilterte Fläche abgetastet statt der Seite.
     Bezugschrome ist damit .c-nav — der Seitenrand muss hier wieder
     ausgeschrieben werden. */
  .c-megamenu {
    position: absolute;
    top: calc(100% - var(--sp-2));
    left: var(--nav-edge);
    right: var(--nav-edge);
    max-width: var(--nav-width);
    margin-inline: auto;
    /* Dasselbe Milchglas wie die Leiste darüber — beide sollen als eine
       Fläche gelesen werden. */
    background: color-mix(in srgb, var(--c-white) 72%, transparent);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-panel);
    overflow: hidden;
    visibility: hidden;
    height: 0;
  }

  /* Das Mobile-Panel hängt direkt an .c-nav, nicht an der Leiste — dort ist
     der Seitenrand noch nicht abgezogen. */
  [data-mobile-menu] {
    left: var(--site-margin);
    right: var(--site-margin);
    top: calc(100% - var(--sp-2));
    /* Vier Gruppen passen nicht mehr sicher auf jedes Telefon — deshalb
       darf das Panel scrollen statt über den unteren Rand zu laufen. Die
       Höhe lässt Platz für Leiste und Sicherheitsabstände. */
    max-height: calc(100svh - 7rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .c-megamenu[data-open="true"] {
    visibility: visible;
  }

  /* Die Innenabstände stehen als eigene Werte, weil das Werbefeld sie
     zurückrechnet — es soll am Rand des Panels sitzen, nicht auf der Flucht
     der Textspalten. Fest verdrahtet ließen sich die drei Zahlen nur an zwei
     Stellen gleichzeitig ändern. */
  .c-megamenu__inner {
    --menu-pad-x: clamp(24px, 3vw, 48px);
    --menu-pad-top: var(--sp-6);
    --menu-pad-bottom: var(--sp-8);
    --menu-promo-inset: var(--sp-1);

    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--site-gutter);
    padding: var(--menu-pad-top) var(--menu-pad-x) var(--menu-pad-bottom);
  }

  /* Nach außen bis auf `--menu-promo-inset` an die Panelkante, nach innen
     bleibt die Rasterlücke stehen. Dadurch ist das Feld höher als die
     Linkspalten daneben und liest sich als eigene Fläche, nicht als vierte
     Spalte mit Bild. */
  .c-megamenu__promo {
    margin-top: calc(var(--menu-promo-inset) - var(--menu-pad-top));
    margin-right: calc(var(--menu-promo-inset) - var(--menu-pad-x));
    margin-bottom: calc(var(--menu-promo-inset) - var(--menu-pad-bottom));
  }

  .c-megamenu__col-title {
    margin-bottom: var(--sp-4);
    font-family: var(--f-mono);
    font-weight: 300;
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .c-megamenu__link {
    display: block;
    padding-block: var(--sp-2);
    border-bottom: var(--bw) solid var(--c-line);
    font-size: var(--fs-text-main);
    transition:
      padding-left var(--d-base) var(--e-out),
      color var(--d-fast) var(--e-swift);
  }

  @media (hover: hover) {
    .c-megamenu__link:hover {
      padding-left: var(--sp-2);
      color: var(--c-brand);
    }
  }

  /* --- Mobile-Menu ----------------------------------------------------- */

  .c-nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 32px;
    padding: 0 8px;
  }

  .c-nav__burger span {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition:
      transform var(--d-base) var(--e-out),
      opacity var(--d-fast) var(--e-swift);
  }

  .c-nav__burger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .c-nav__burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .c-nav__burger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  @media (max-width: 1024px) {
    .c-nav__menu,
    /* Der Button kommt aus Button.astro und trägt deshalb nicht das
       Scope-Attribut dieser Datei — ohne :global() ginge die Regel ins
       Leere und die Pille stünde neben dem Burger. */
    .c-nav__actions :global(.c-btn) {
      display: none;
    }

    .c-nav__burger {
      display: flex;
    }

    .c-megamenu__inner {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }

    /* Einspaltig sitzt das Feld unten in der Liste. Zöge es dort nach oben,
       liefe es in die letzte Leistungsgruppe hinein. */
    .c-megamenu__promo {
      margin-top: 0;
      margin-left: calc(var(--menu-promo-inset) - var(--menu-pad-x));
      margin-right: calc(var(--menu-promo-inset) - var(--menu-pad-x));
    }
  }
</style>
