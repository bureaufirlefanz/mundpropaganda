---
/**
 * Klick-zum-Bearbeiten in der Vorschau.
 *
 * Bewusst OHNE Rahmenwerk. Die übliche Einbindung von `@sanity/visual-editing`
 * ist eine React-Komponente; die brächte React, ReactDOM und die
 * Astro-Integration mit — für eine Seite, die in `astro.config.mjs` damit
 * wirbt, null Framework-JavaScript auszuliefern.
 *
 * `enable-visual-editing` ist der chromefreie Einstieg: eine Funktion, die
 * sich an das Dokument hängt und die Stega-Markierungen im Text auswertet.
 *
 * Das Skript steht nur auf der Vorschau-Route. Auf den ausgelieferten Seiten
 * gibt es weder Markierungen noch dieses Bündel.
 */
---

<script>
  import { enableVisualEditing } from "@sanity/visual-editing/enable-visual-editing";

  /* In der Vorschau bleiben.
   *
   * Die Bausteine rendern die echten Pfade — `/leistungen/veneers`, nicht
   * `/preview/leistungen/veneers`. Das ist richtig so: Sie wissen nichts von
   * der Vorschau, und sie sollen es auch nicht. Ein Klick auf einen Link
   * führte damit aber aus der Vorschau heraus auf die veröffentlichte Seite,
   * mitten im Bearbeiten.
   *
   * Deshalb hier, an der einen Stelle, die es nur in der Vorschau gibt: Ein
   * Klick auf einen seiteninternen Link bekommt das Präfix vorgesetzt.
   * Sprungmarken (#kontakt) und fremde Ziele bleiben unangetastet. */
  const PREFIX = "/preview";

  document.addEventListener(
    "click",
    (e) => {
      const a = (e.target as HTMLElement)?.closest?.("a");
      if (!a) return;

      const target = a.getAttribute("href");
      if (
        !target?.startsWith("/") ||
        target.startsWith(PREFIX + "/") ||
        target === PREFIX
      )
        return;

      e.preventDefault();
      /* Über den Astro-Router, damit die Module nicht neu anlaufen müssen. */
      window.location.assign(PREFIX + target);
    },
    /* In der Capture-Phase: Der Router von Astro hängt selbst am Klick, und
       wer später kommt, sieht das Ereignis nicht mehr. */
    true,
  );

  /* `history` verbindet die Klicks im Studio mit dem Router der Seite: Ein
     Sprung im Studio soll hier navigieren, statt das Fenster neu zu laden —
     sonst ginge bei jedem Klick die Auftrittschoreografie von vorn los. */
  enableVisualEditing({
    history: {
      subscribe: (navigate) => {
        const notify = () =>
          navigate({ type: "push", url: location.pathname + location.search });
        document.addEventListener("astro:page-load", notify);
        return () => document.removeEventListener("astro:page-load", notify);
      },
      update: (update) => {
        if (update.type === "push" || update.type === "replace") {
          /* Über den Astro-Router, nicht über location.href. */
          window.history[update.type === "push" ? "pushState" : "replaceState"](
            {},
            "",
            update.url,
          );
          window.dispatchEvent(new PopStateEvent("popstate"));
        } else if (update.type === "pop") {
          window.history.back();
        }
      },
    },
  });
</script>
