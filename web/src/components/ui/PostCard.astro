---
/**
 * Die Beitragskarte: Bild, darauf versetzt eine weiße Fläche.
 *
 * Stand bis hierher nur im Karussell, und die Übersicht unter `/magazin`
 * baute daneben eine zweite, flachere Karte. Der Kommentar dort nannte den
 * Grund: In einem Raster aus drei Spalten stoßen die Überlappungen
 * aneinander. Das stimmte für drei Spalten — die Komposition rechnet in
 * Anteilen ihrer eigenen Breite und braucht rund 420px, damit die weiße
 * Fläche den Text trägt. Die Antwort ist also die Spaltenzahl, nicht eine
 * zweite Karte. Die Übersicht steht jetzt auf zwei Spalten und zeigt
 * dieselbe.
 *
 * Die Breite kommt von außen, über `--post-breite`: Im Karussell ist sie
 * fest (die Spur scrollt waagerecht), im Raster füllt sie die Zelle. Alles
 * andere ist an beiden Stellen gleich und steht deshalb nur hier.
 */
import Button from "./Button.astro";
import Picture from "./Picture.astro";
import CmsImage from "./CmsImage.astro";
import { isCmsImage } from "../../lib/images";
import {
  categoryLabel,
  postPath,
  motifFor,
  type Post,
} from "../../lib/magazine";

interface Props {
  post: Post;
  sizes: string;
  /** Tiefe des Parallax auf dem Bild. Ohne Wert steht es still. */
  parallax?: string;
  /** Der Button trägt das Karussell, nicht die Übersicht. */
  withButton?: boolean;
  /**
   * Die Ebene der Überschrift.
   *
   * Nicht fest verdrahtet, weil sie von der Seite abhängt: Im Karussell steht
   * darüber ein h2 („Mund zu Mund"), also ist h3 richtig. Auf /magazin ist der
   * Seitentitel das h1 und es gibt kein h2 dazwischen — dort wäre h3 eine
   * übersprungene Ebene. Der Test in `web:check` hat genau das gemeldet:
   * „h1 → h3 bei Zahngesundheit & Fitness".
   */
  headingLevel?: "h2" | "h3";
  /**
   * The composition.
   *
   * `overlap` is the card of the carousel: portrait image, the white surface
   * set over its lower right. It needs around 420px of width and takes only
   * so much text. `card` is the classic form for the overview under
   * /magazin: one white card with padding, image on top (4:3), category,
   * title, lead and button below it, everything left aligned. It takes any
   * amount of text. (A `stacked` form with the surface shifted over the
   * image edge lived here for a day on 2026-10-14; the overview wanted the
   * plain card.) Below 460px the overlapping card stacks by itself, see the
   * container query.
   */
  variant?: "overlap" | "card";
}

const {
  post: p,
  sizes,
  parallax,
  withButton = false,
  headingLevel: Titel = "h3",
  variant = "overlap",
  ...rest
} = Astro.props;

/* Klasse 3: das gestaltete Ersatzmotiv, solange kein Vorschaubild hängt.
   Es hängt am Beitrag und nicht an seiner Position in dieser Liste — sonst
   zeigte derselbe Beitrag im Raster, im Karussell und auf seiner eigenen
   Seite drei verschiedene Bilder (siehe `motivFuer` in lib/magazin.ts).

   Über `Picture` und nicht über `CmsImage`: Nur das erste liefert AVIF und
   WebP als <source> samt srcset. CmsImage kann das für lokale Pfade nicht —
   es kennt nur die eine Datei, die im Pfad steht, und lieferte damit jedem
   Telefon das Bild in voller Breite aus. */
const motif = motifFor(p.slug);
---

{
  /* `data-category` trägt den Rohwert, nicht den Klartext: Der Filter
     vergleicht ihn mit dem Wert aus dem Schema, und „Material & Technik"
     gegen „technik" zu prüfen hieße, die Zuordnung ein zweites Mal zu
     pflegen. */
}
<a
  class:list={["c-post", variant === "card" && "c-post--card"]}
  href={postPath(p.slug)}
  data-surface={variant === "card" ? "card" : undefined}
  data-category={p.category ?? ""}
  {...rest}
>
  <div class="c-post__media">
    {
      isCmsImage(p.previewImage) ? (
        <CmsImage
          source={p.previewImage}
          alt=""
          widths={[640, 1024]}
          sizes={sizes}
          data-parallax={parallax}
        />
      ) : (
        <Picture name={motif} alt="" sizes={sizes} parallax={parallax} />
      )
    }
  </div>

  <div class="c-post__surface">
    {p.category && <span class="c-post__tag">{categoryLabel(p.category)}</span>}

    <Titel class="c-post__title">{p.title}</Titel>

    {p.lead && <p class="c-post__text">{p.lead}</p>}
  </div>

  {withButton && <Button label="Beitrag lesen" static />}
</a>

<style>
  /* Im Entwurf sitzt das Bild bei x=81 (326 breit), die weiße Karte bei
     x=319 (316 breit) — daher die Anteile 59 % und 57 %. Zusammen 116 %, die
     Überlappung ist also 16 % der Kartenbreite und bleibt innerhalb davon.
     Nichts ragt aus dem Kasten heraus; die Karte ist im Raster so brauchbar
     wie in der Spur. */
  .c-post {
    /* Die ganze Karte ist der Verweis — Bild, weiße Fläche und Button.

       Vorher trug den Link der Titel, und eine Überlagerung
       (`.c-post__link::after`, inset 0) sollte ihn über die Karte ziehen.
       Das konnte nicht aufgehen: Die Überlagerung richtet sich am nächsten
       positionierten Vorfahren aus, und das ist `.c-post__surface` mit
       `position: absolute`, nicht die Karte. Gemessen im Browser lag die
       Klickfläche deshalb genau auf der weißen Fläche — Bild und Button
       waren tot.

       Dasselbe Muster wie in `NavPromo.astro`: Der Button darin ist keiner,
       er steht auf `static` und rendert ein <span>. Ein <a> in einem <a>
       lässt der Parser nicht zu, er schlösse das äußere vorzeitig.

       Kein <article> mehr. Die Auszeichnung wäre nur zu halten, indem ein
       Wrapper mit `display: contents` darum steht — und der nähme der Karte
       genau die Eigenschaften (Breite, `container-type`), an denen die
       Container-Abfrage weiter unten hängt. */
    text-decoration: none;
    color: inherit;

    position: relative;
    /* Die Karte ist ihr eigener Bezug: Welche der beiden Kompositionen unten
       greift, hängt an IHRER Breite, nicht an der des Fensters. Vorher stand
       dort `max-width: 700px` — das traf das Telefon und verfehlte die 420px
       schmale Karte in einer Rasterspalte, obwohl beide dasselbe Problem
       haben. */
    container-type: inline-size;
    flex: 0 0 auto;
    width: var(--post-width, 100%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .c-post__media {
    width: 59%;
    aspect-ratio: 326 / 431;
    border-radius: var(--r-md);
    overflow: hidden;
  }

  /* :global(img), weil das Bild aus Picture.astro bzw. CmsImage.astro kommt
     und das Scope-Attribut nicht trägt. */
  .c-post__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale var(--d-slow) var(--e-out);
  }

  @media (hover: hover) {
    .c-post:hover .c-post__media :global(img) {
      scale: 1.04;
    }
  }

  /* Überlappt das Bild nach rechts unten — die Versetzung ist der Kern der
     Komposition.

     `bottom: 0` statt `min-height: 62%`: Mit der Mindesthöhe endete die
     Fläche dort, wo ihr Inhalt aufhörte, gemessen 50px über der Unterkante
     des Buttons und damit zufällig fast bündig mit dem Bild. Die untere
     Kante der Karte ist aber die Linie, an der die Komposition steht — sie
     soll mit dem Button abschließen, nicht mit dem Text darin. */
  .c-post__surface {
    position: absolute;
    /* Anchored at the bottom (flush with the button), the top is free: the
       surface is at least 73 % of the card, as in the design, and grows
       upward over the image when the text needs more. Until 2026-10-14 the
       top was fixed at 27 %, and the first post with a long title and lead
       ran out of the surface. `max-height: 100%` is the ceiling, the clamp
       on the lead below is what keeps it from being reached. */
    top: auto;
    bottom: 0;
    min-height: 73%;
    max-height: 100%;
    right: 0;
    width: 57%;
    display: flex;
    flex-direction: column;
    padding: var(--sp-4);
    border-radius: var(--r-md);
    background: var(--c-white);
    color: var(--c-neutral-800);
  }

  /* Die Kategorie als Zeile, nicht als Pille. Sie steht in der weißen
     Fläche über dem Titel und ist dort schon durch Schnitt und Laufweite
     abgesetzt; eine gefüllte Form daneben nähme dem Titel den Vorrang und
     machte aus dem Hinweis einen Button, der keiner ist. */
  .c-post__tag {
    align-self: flex-start;
    color: var(--c-dark);
    font-family: var(--f-mono);
    font-weight: var(--fw-light);
    font-size: var(--fs-label);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .c-post__title {
    margin-top: var(--sp-2);
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-regular);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
  }

  .c-post__text {
    margin-top: auto;
    padding-top: var(--sp-4);
    font-size: var(--fs-text-small);
    line-height: var(--lh-text);
    color: var(--c-on-card-muted);
    /* Four lines at most in the overlapping surface. A lead is a teaser,
       the full text is one click away; what is cut here is better cut than
       pushed over the image's top edge. The classic card lifts the clamp. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }

  /* :global(.c-btn), weil der Button aus Button.astro kommt. */
  .c-post :global(.c-btn) {
    margin-top: var(--sp-4);
  }

  /* Der Button reagiert mit, egal wo auf der Karte der Zeiger steht.
     Er kann es nicht selbst: Über ihm liegt die Klickfläche des Titellinks
     (`.c-post__link::after`, inset 0), er bekommt also nie einen eigenen
     Hover. Und da er in dieser Karte ein <span> ist und kein <a>, wäre das
     auch kein zweites Ziel, sondern ein Anzeigeelement, das stillstand,
     während offensichtlich etwas anklickbar war. */
  @media (hover: hover) {
    .c-post:hover :global(.c-btn__icon) {
      transform: translateX(5px);
    }
  }

  /* --- Klassische Karte ---------------------------------------------------
     Eine Fläche, alles darin, alles linksbündig: Bild, Rubrik, Titel, Anriss,
     Button. Die Fläche ist die Karte selbst, `.c-post__surface` wird darin
     zum einfachen Textblock. Der Button sitzt per `margin-top: auto` unten,
     damit die Karten einer Reihe auf derselben Linie enden, wenn das Raster
     sie auf eine Höhe dehnt.

     Das Bild läuft bis an die Kanten der Fläche, die Rundung der Karte
     beschneidet es (`overflow: hidden`). Text und Button rücken mit
     `--inset` ein; ein Rahmen um das Bild (10px wie im Menü) stand hier
     kurz und war noch zu viel. */
  .c-post--card {
    --inset: var(--sp-5);
    align-items: stretch;
    padding: 0;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--c-white);
  }

  .c-post--card .c-post__media {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 0;
  }

  /* `margin-top: 0` and `align-self` are spelled out because the container
     query below still matches: it measures the content box, and in a 480px
     column that is 432px, under its 460px threshold. Its negative margin
     would pull the text up over the image. */
  .c-post--card .c-post__surface {
    position: relative;
    inset: auto;
    min-height: 0;
    max-height: none;
    align-self: stretch;
    width: 100%;
    margin-top: 0;
    padding: var(--inset) var(--inset) var(--sp-5);
    border-radius: 0;
    background: none;
  }

  .c-post--card .c-post__text {
    margin-top: 0;
    padding-top: var(--sp-3);
    display: block;
    -webkit-line-clamp: none;
  }

  .c-post--card :global(.c-btn) {
    margin: auto 0 var(--inset) var(--inset);
  }

  /* --- Schmale Karte ----------------------------------------------------
     Die versetzte Überlappung ist unter etwa 460px nicht zu retten. Sie
     rechnet in Anteilen der Kartenbreite: Bild 59 %, weiße Fläche 57 % — auf
     554px sind das 327 und 316px, auf 420px noch 248 und 239, auf 304px nur
     180 und 173. In 173px Breite braucht derselbe Text die dreifache Höhe,
     die Fläche wächst über ihren Rahmen hinaus und verdeckt, was darunter
     liegt.

     Also gestapelt statt überlappt — aber nicht als schlichte Reihe: Das
     Bild nimmt die volle Breite, die Fläche sitzt etwas schmaler rechts und
     zieht sich über die Bildkante herauf. Der Versatz bleibt damit als Idee
     erhalten, ohne dass etwas gegeneinander gedrückt wird.

     Der Schwellwert steht auf der Karte, nicht auf dem Fenster: Dieselbe
     Komposition trägt damit das Telefon UND die schmale Spalte im Raster
     unter /magazin, ohne dass eine der beiden Stellen von der anderen weiß.
     -------------------------------------------------------------------- */
  @container (max-width: 460px) {
    /* Breiter und flacher: Hochformat auf voller Breite nähme allein zwei
       Drittel der Bildschirmhöhe, bevor der Text beginnt. */
    .c-post__media {
      width: 100%;
      aspect-ratio: 4 / 3;
    }

    /* `position: relative` mit z-index, nicht `static`: Das Bild trägt einen
       Parallax-Transform, und ein transformiertes Element wird über allen
       nicht positionierten Kästen gezeichnet — unabhängig von der Reihenfolge
       im Markup. Die Karte lag dadurch UNTER dem Bild, und ihre obersten
       64px (Kicker und die erste Titelzeile) waren verdeckt. */
    .c-post__surface {
      position: relative;
      z-index: 1;
      /* `inset: auto` MUSS mit: `top: 27%` und `right: 0` aus der Regel für
         breite Fenster gelten bei `relative` weiter — nur eben als
         Verschiebung statt als Lage. Gemessen schob das die Karte um 120px
         nach unten und aus ihrem Beitrag heraus. */
      inset: auto;
      min-height: 0;
      max-height: none;
      align-self: flex-end;
      width: 92%;
      margin-top: calc(-1 * var(--sp-8));
    }

    /* `margin-top: auto` schob den Text in der absolut gesetzten Karte an
       deren Unterkante. Ohne feste Höhe gibt es nichts mehr zu schieben —
       der Abstand steht jetzt einfach da. */
    .c-post__text {
      margin-top: 0;
      padding-top: var(--sp-3);
      display: block;
      -webkit-line-clamp: none;
    }
  }
</style>
