---
/**
 * Panel-Rahmen: schmaler Kopf links, der beim Scrollen stehen bleibt, breiter
 * Inhalt rechts. Was rechts steht, gibt der Aufrufer über den Slot mit — das
 * FAQ ein Akkordeon, der Kontaktbereich ein Formular.
 *
 * Eigener Baustein, weil zwei Sections denselben Rahmen ausschreiben. Läge er
 * in einer von beiden, wäre die abgegrenzte Regel für die andere wirkungslos.
 */
interface Props {
  id?: string;
  topline: string;
  /** Wahlfrei — auf Pillar Pages steht die Überschrift nummeriert darüber
      (`ui/SectionHeading.astro`). */
  title?: string;
  /** Zusatzzeile unter der Headline. Nicht jedes Panel hat eine. */
  text?: string;
}

const { id, topline, title, text } = Astro.props;
---

<section class="container s-panel" id={id}>
  <div class="s-panel__head">
    <span class="c-topline">{topline}</span>
    {title && <h2 class="s-panel__title" data-split="lines">{title}</h2>}
    {text && <p class="s-panel__text t-body t-muted">{text}</p>}
  </div>

  <slot />
</section>

<style>
  .s-panel {
    display: grid;
    grid-template-columns: 1fr 1.8fr;
    gap: var(--sp-8) var(--site-gutter);
    padding-block: var(--section-space);
    align-items: start;
  }

  /* Der Kopf bleibt stehen, während der Inhalt daneben durchläuft. */
  .s-panel__head {
    position: sticky;
    top: 120px;
  }

  /* Die Leseweite gehört an den Fließtext, nicht an den ganzen Kopf.

     Vorher stand `max-width: 24ch` am Kopf — und `ch` rechnet in der
     Schriftgröße des Elements, hier also der des Fließtexts. Ergebnis waren
     246px, die auch für die Überschrift galten. Die ist aber mehr als doppelt
     so groß: „Unverbindliches" braucht bei 40px rund 268px, passte nicht, und
     die Zeilenmaske von SplitText hat das Wort abgeschnitten statt umbrechen
     zu lassen. Auf jeder Seite mit einem Panel, sobald ein langes Wort in der
     Überschrift stand.

     Die Überschrift nutzt jetzt ihre Rasterspalte; der Fließtext behält seine
     Leseweite. */
  .s-panel__text {
    max-width: 24ch;
  }

  .s-panel__head .c-topline {
    margin-bottom: var(--sp-4);
  }

  .s-panel__title {
    margin-bottom: var(--sp-5);
    font-size: var(--fs-h2-lg);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  @media (max-width: 900px) {
    .s-panel {
      grid-template-columns: 1fr;
    }

    /* Einspaltig gibt es nichts, woran der Kopf haften könnte. */
    .s-panel__head {
      position: static;
    }
  }
</style>
