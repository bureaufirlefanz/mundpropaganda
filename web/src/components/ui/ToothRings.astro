<style>
  /* Kontur-Overlay über der Zahnmaske in den Standards. Dieselbe Zeichnung,
     aus der auch die Maske stammt — beide Grafiken haben dasselbe
     Seitenverhältnis, dadurch liegt die Linienzeichnung deckungsgleich auf
     dem maskierten Bild. */
  .tooth-rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .tooth-ring {
    fill: none;
    stroke: var(--c-brand);
    stroke-width: 1.1;
    opacity: 0.75;
    vector-effect: non-scaling-stroke;
  }
</style>

