---
import Button from "./Button.astro";
import { loadServiceList, forTable, servicePath } from "../../lib/service-list";
import { loadSettings, telLink } from "../../lib/settings";
import { loadFooter, resolved } from "../../lib/navigation";

// Dieselbe Quelle wie Services-Tabelle und Menü. Gezeigt werden die
// Hauptservices; die Zusatzlinks der Startseite bleiben dort.
interface Props {
  /**
   * Sprungziel. Trägt `kontakt`, wenn die Seite keinen eigenen
   * Kontaktabschnitt hat — siehe `contactSection` in `layouts/Base.astro`.
   */
  id?: string;
}

const { id } = Astro.props;

const services = forTable(await loadServiceList());
const e = await loadSettings();

// Nur Netzwerke zeigen, die gepflegt sind — ein Symbol ohne Ziel führt nirgends
// hin und sieht trotzdem nach Angebot aus.
//
// „#" gilt dabei NICHT als gepflegt. Der Prototyp trug die vier Profile als
// Platzhalter mit genau diesem Wert, und der Seed hat ihn übernommen: Damit
// standen auf jeder Seite vier Symbole, die den Browser nach oben springen
// ließen. Ein Platzhalter, der die Prüfung besteht, ist schlimmer als ein
// leeres Feld.
const PROFILES = [
  { key: "facebook", title: "Facebook", symbol: "#i-facebook" },
  { key: "instagram", title: "Instagram", symbol: "#i-instagram" },
  { key: "linkedin", title: "LinkedIn", symbol: "#i-linkedin" },
  { key: "youtube", title: "YouTube", symbol: "#i-youtube" },
] as const;
const profiles = PROFILES.map((p) => ({ ...p, url: e.social[p.key] })).filter(
  (p) => p.url && p.url !== "#"
);

// Jahreszahl zur Bauzeit — die Seite ist statisch, ein Skript dafür wäre
// unnötiges Gewicht. Sie steht bewusst NICHT im CMS: Eine getippte
// Jahreszahl ist am 1. Januar falsch, und niemand denkt daran.
const year = new Date().getFullYear();

/* Spalten, Knopf und Rechtliches seit Aufgabe 8 aus dem CMS. Die vier
   Rechtstext-Links standen vorher auf `href="#"` — sie sahen aus wie ein
   Angebot und führten nirgendwohin. Jetzt zeigen sie auf Rechtstext-
   Dokumente, und solange es die nicht gibt, steht die Zeile leer. */
const f = await loadFooter();
const here = Astro.url.pathname;

const action = (await resolved([f?.action ?? null], here))[0];
const legalLinks = await resolved(f?.legalLinks, here);

const columns = (
  await Promise.all(
    (f?.columns ?? []).map(async (col) => ({
      title: col?.title ?? "",
      links: await resolved(col?.links, here),
    }))
  )
).filter((col) => col.title && col.links.length > 0);
---

<footer class="c-footer" id={id}>
  <div class="c-footer__inner">
    {/* Die Wortmarke füllt die Breite des Panels und bildet den Abschluss
         der Seite. */}
    <a class="c-footer__wordmark" href="/" data-reveal="up">Mundpropaganda</a>

    <div class="c-footer__top">
      <div class="c-footer__contact">
        <div class="c-footer__social">
          {profiles.map((p) => (
            <a href={p.url} aria-label={p.title}><svg><use href={p.symbol} /></svg></a>
          ))}
        </div>

        {/* Je Zeile geprüft: Ein `tel:`-Link ohne Nummer ist kein leerer Text,
            sondern ein Link, der beim Antippen die Wählmaske mit nichts darin
            öffnet. Was fehlt, steht deshalb gar nicht erst da. */}
        <div class="c-footer__lines">
          {e.phone && <a class="c-link" href={telLink(e.phone)}>{e.phone}</a>}
          {e.email && <a class="c-link" href={`mailto:${e.email}`}>{e.email}</a>}
        </div>

        {action && <Button label={action.text} href={action.href} />}

        {/* Die beiden Praxen stehen unter dem Kontakt, nicht in einer eigenen
            Spalte: Eine Anschrift gehört zum Kontakt, und die Kontaktspalte ist
            breit genug für zwei nebeneinander. Quelle sind dieselben
            Einstellungen wie in der Standorte-Section. */}
        <div class="c-footer__locations">
          {e.locations.map((o) => (
            <div>
              {/* Im Fuß nur das Kürzel, nicht der volle Name: darunter steht
                  ohnehin die Straße, und „Praxis Prenzlauer Allee /
                  Prenzlauer Allee 25“ wäre dieselbe Angabe zweimal.
                  Halbgeviertstrich wie sonst auch auf der Seite. */}
              <p class="c-footer__location-name">Praxis – {o.shortCode}</p>
              {/* <address> statt <p>: Vorlesegeräte kündigen die Anschrift als
                  solche an. Der Browser setzt das Element kursiv, das wird
                  unten zurückgenommen. */}
              <address>{o.street}<br />{o.city}</address>

              {/* Nur wenn Zeiten gepflegt sind. Ein Block mit der Überschrift
                  „Öffnungszeiten" und nichts darunter wäre schlimmer als
                  keiner: Wer davorsteht, hält es für einen Fehler und ruft an.

                  <dl> und nicht <p>: Tage und Zeit sind Begriff und Erklärung,
                  und Vorlesegeräte lesen das Paar dann zusammen vor. */}
              {o.hours && o.hours.length > 0 && (
                <dl class="c-footer__hours">
                  {o.hours.map((z) => (
                    <>
                      <dt>{z.days}</dt>
                      <dd>{z.time}</dd>
                    </>
                  ))}
                </dl>
              )}
            </div>
          ))}
        </div>
      </div>

      <nav class="c-footer__nav" aria-label={f?.servicesHeading ?? "Leistungen"}>
        <p class="c-footer__nav-title">{f?.servicesHeading}</p>
        {services.map((l) => (
          <a class="c-link" href={servicePath(l)}>{l.name}</a>
        ))}
      </nav>

      {/* Überschrift wie bei den Nachbarn. Ohne sie begann diese Spalte eine
          Zeile höher als die anderen — drei Spalten, von denen eine ohne
          Anlass aus der Reihe fällt. */}
      {columns.map((column) => (
        <nav class="c-footer__nav" aria-label={column.title}>
          <p class="c-footer__nav-title">{column.title}</p>
          {column.links.map((l) => (
            <a class="c-link" href={l.href}>{l.text}</a>
          ))}
        </nav>
      ))}
    </div>

    <div class="c-footer__bottom">
      <p>© {year}{f?.copyright ? ` ${f.copyright}` : ""}</p>
      {legalLinks.length > 0 && (
        <div class="c-footer__legal">
          {legalLinks.map((l) => (
            <a class="c-link" href={l.href}>{l.text}</a>
          ))}
        </div>
      )}
    </div>
  </div>
</footer>

<style>
  /* Wortmarke über die volle Panelbreite, darunter drei Spalten, unten die
     Rechtszeile. Maße aus dem Entwurf (Panel 1693 von 1728 Seitenbreite).

     **Zwei Ebenen, seit die Fläche bis an die Ränder läuft.** Die braune
     Fläche nimmt die ganze Fensterbreite abzüglich der Außenfuge; der Inhalt
     darin bleibt auf --site-max gedeckelt und zentriert. Vorher war beides
     dasselbe Element, und auf Schirmen über 1728px stand der Fuß als
     abgesetzter Block in der Mitte, während der Rest der Seite bis nach
     außen ging.

     Unterhalb von --site-max ändert sich dadurch nichts: Der Innencontainer
     ist dort 100 % breit, und die gerechneten Maße bleiben Zeile für Zeile
     dieselben.

     z-index wie bei main im Rahmen: der Footer liegt über den
     Hintergrundebenen. */
  .c-footer {
    --footer-gap: clamp(12px, 1.04vw, 18px);

    position: relative;
    z-index: 1;
    width: calc(100% - var(--footer-gap) * 2);
    margin: 0 auto var(--footer-gap);
    border-radius: var(--r-md);
    background: var(--c-dark);
    color: var(--c-grey);
    overflow: hidden;
  }

  /* Der Satzspiegel. Er trägt den Innenabstand, nicht die Fläche darum —
     dadurch bleibt der Inhaltskasten exakt so breit wie vorher (bei 1728px:
     1728 - 2 × 48 = 1632px), und die in `cqw` gerechnete Wortmarke behält
     ihren Grad auf das Pixel genau.

     Bezugsgröße für die Wortmarke ist deshalb dieser Kasten und nicht die
     braune Fläche: Sie soll den Satzspiegel ausfüllen, und der ist weder das
     Fenster noch die Fläche. Innenabstand und Außenfuge nehmen bei 1728px
     zusammen 7 % der Fensterbreite, bei 390px aber 18,5 %. Eine in vw
     gerechnete Schrift muss dabei überlaufen. */
  .c-footer__inner {
    container-type: inline-size;
    width: min(var(--site-max), 100%);
    margin-inline: auto;
    padding: clamp(24px, 2.4vw, 42px) clamp(24px, 2.8vw, 48px) 0;
  }

  /* GT Pressura Mono wie im Entwurf, und der Grad ist gerechnet, nicht
     geschätzt: Ein Zeichen dieser Schrift misst 0.5398 em (gemessen, in drei
     Fenstergrößen gleich), „Mundpropaganda" hat 14 davon, macht 7.557 em für
     das ganze Wort. Der Satzspiegel ist 100cqw — also 100 / 7.557 = 13.23cqw
     je Zeichenbreite. 13.2 lässt ein Haar Luft.

     `cqw` statt `vw`: Die Einheit bezieht sich auf den Inhaltskasten des
     Fußes, nicht auf das Fenster. Mit 12.22vw stand die Wortmarke bei 1728px
     genau im Satzspiegel, lief bei 900px schon 5px über und bei 390px 42px —
     dort schnitt sie der Rahmen ab, und aus MUNDPROPAGANDA wurde
     MUNDPROPAGAND.

     Kein clamp mehr: Der Satzspiegel (.c-footer__inner) ist auf --site-max
     gedeckelt, damit auch die Bezugsgröße — der Grad kann gar nicht über den
     Entwurfswert hinaus wachsen. Dass die braune Fläche darum inzwischen
     weiter läuft, ändert daran nichts: `cqw` misst den Innencontainer. */
  .c-footer__wordmark {
    display: block;
    font-family: var(--f-mono);
    font-weight: 300;
    font-size: 13.2cqw;
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--c-grey);
  }

  /* Kontakt links, die beiden Linkspalten am rechten Rand.

     Die Linkspalten sind schmal und liegen rechts: Der Kontakt bekommt mit
     `1fr` alles, was übrig bleibt, und drückt sie dorthin. Als gleich große
     Anteile maßen sie 464px für Wörter von höchstens 172px und schoben sich
     dadurch in die Mitte, statt rechts abzuschließen.

     12rem als Untergrenze, damit sie nicht auf ihre Tinte schrumpfen — mit
     reinem `fit-content` maß „Praxis" nur 77px und stand als schmaler
     Streifen neben der doppelt so breiten Nachbarin. So sind beide 192px
     breit und gleich.

     `max-content` und nicht `fit-content()` als Obergrenze: `fit-content()`
     ist innerhalb von `minmax()` nicht zulässig. Die Zeile war damit
     ungültig, das ganze `grid-template-columns` fiel weg und alle drei
     Spalten standen über die volle Breite untereinander. */
  .c-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) repeat(2, minmax(12rem, max-content));
    /* Eigener Wert für die Fugen zwischen den Spalten, nicht die Rinne des
       Seitenrasters: Zwei schmale Linkspalten in 32px Abstand lesen sich als
       ein Block mit einem Knick darin. Mit 72px sind es zwei Spalten. Die
       Kontaktspalte gibt den Platz her — sie ist `1fr`. */
    column-gap: clamp(var(--sp-6), 4vw, 72px);
    row-gap: var(--site-gutter);
    padding-top: clamp(56px, 6.5vw, 112px);
    padding-bottom: clamp(56px, 6.5vw, 112px);
  }

  .c-footer__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-6);
  }

  .c-footer__social {
    display: flex;
    gap: var(--sp-3);
  }

  .c-footer__social a {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    transition: color var(--d-fast) var(--e-swift),
      transform var(--d-base) var(--e-out);
  }

  .c-footer__social svg {
    width: 100%;
    height: 100%;
  }

  @media (hover: hover) {
    .c-footer__social a:hover {
      color: var(--c-brand);
      transform: translateY(-3px);
    }
  }

  .c-footer__lines {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  /* Zwei Anschriften nebeneinander, solange Platz ist. Unter 560px stapeln
     sie — zwei Adressen in halber Spaltenbreite brächen sonst nach jedem
     zweiten Wort um. */
  .c-footer__locations {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4) var(--site-gutter);
    margin-top: var(--sp-6);
  }

  @media (max-width: 560px) {
    .c-footer__locations {
      grid-template-columns: 1fr;
    }
  }

  .c-footer__location-name {
    margin-bottom: var(--sp-1);
    font-family: var(--f-mono);
    font-weight: 300;
    font-size: var(--fs-text-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-grey);
  }

  .c-footer__locations address {
    font-style: normal;
    line-height: 1.5;
  }

  /* Tage links, Zeit rechts. `max-content 1fr` und keine zwei gleichen
     Spalten: „Mo–Do" und „Sa" sind unterschiedlich breit, und bei 1fr 1fr
     stünde die Zeit je nach Zeile an anderer Stelle. So beginnt sie überall
     gleich weit rechts.

     Die Beschriftung „Öffnungszeiten" steht bewusst nicht darüber: Über der
     Anschrift steht bereits das Kürzel, und eine zweite Überschrift in einem
     vierzeiligen Block macht ihn zu einem eigenen Kapitel. Zwei Spalten aus
     Tagen und Uhrzeiten liest ohnehin jeder als Öffnungszeiten. */
  .c-footer__hours {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0 var(--sp-3);
    margin-top: var(--sp-3);
    font-size: var(--fs-text-small);
    line-height: 1.5;
    color: var(--c-text-muted);
  }

  .c-footer__hours dd {
    margin: 0;
  }

  /* 12px statt 24px. Mit dem doppelten Abstand fiel eine Spalte aus sechs
     Links auf 420px Höhe auseinander und las sich als sechs einzelne
     Angaben statt als eine Liste. Mit der Zeilenhöhe zusammen bleibt jeder
     Link über 24px hoch und damit ein brauchbares Tippziel. */
  .c-footer__nav {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .c-footer__nav-title {
    margin-bottom: var(--sp-1);
    font-family: var(--f-mono);
    font-weight: 300;
    font-size: var(--fs-text-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-grey);
  }

  .c-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    padding: var(--sp-5) 0;
    border-top: var(--bw) solid color-mix(in srgb, var(--c-grey) 22%, transparent);
    font-family: var(--f-mono);
    font-weight: 300;
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .c-footer__legal {
    display: flex;
    gap: var(--flow-sm);
  }

  @media (max-width: 900px) {
    .c-footer__top {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-8) var(--site-gutter);
    }

    /* Kontakt über die volle Breite, darunter die beiden Linkspalten
       nebeneinander. Drei schmale Spalten wären hier drei Wörter breit. */
    .c-footer__contact {
      grid-column: 1 / -1;
    }

    .c-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-4);
    }

    .c-footer__legal {
      flex-wrap: wrap;
      gap: var(--sp-4);
    }
  }

  /* --- Textlink ---------------------------------------------------------
     Die Unterstreichung wischt beim Betreten von links herein und beim
     Verlassen nach rechts wieder hinaus. Zwei Transform-Origins, ein
     Pseudo-Element — die Richtung bleibt dadurch immer nachvollziehbar.

     Steht hier, weil .c-link derzeit nur im Footer vorkommt. Kommt er in
     einer zweiten Komponente dazu, gehört er nach shared.css. */
  .c-link {
    position: relative;
    display: inline-block;
    transition: color var(--d-fast) var(--e-swift);
  }

  .c-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15em;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform var(--d-base) var(--e-out);
  }

  @media (hover: hover) {
    .c-link:hover::after {
      transform: scaleX(1);
      transform-origin: left center;
    }
  }
</style>

