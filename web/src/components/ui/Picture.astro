---
/**
 * Responsives Bild aus der lokalen Pipeline.
 *
 * AVIF zuerst, WebP als Rückfall: der Browser nimmt das erste Format, das er
 * versteht. Der src zeigt auf die kleinste Breite, damit alte Browser ohne
 * srcset nicht das größte Bild ziehen.
 *
 * **Die Breiten kommen aus `image-widths.json`, nicht von außen.** Vorher
 * nannte sie jeder Aufrufer selbst, und das ging so lange gut, wie die
 * Pipeline die genannten Stufen auch erzeugt hatte. Sie deckelt aber auf die
 * Breite der Quelle: `treatment-02` ist 1920px breit und hat keine 2200er
 * Fassung. `Features.astro` forderte sie trotzdem an, der Browser wählte auf
 * breiten Schirmen genau diese Kandidatin, bekam 404 und zeigte nichts. Auf
 * der Veneers-Seite war das die erste Bild-Text-Zeile.
 *
 * Dass im Markup längst `widths="640,961"` und `widths="640,1017"` standen,
 * war der Hinweis darauf: Wer Stufen abtippt, tippt irgendwann eine ab, die
 * es nicht gibt. Jetzt kann das Markup keine falsche mehr nennen, weil es
 * gar keine mehr nennt.
 */
import type { HTMLAttributes } from "astro/types";
import BREITEN from "../../lib/image-widths.json";

interface Props extends HTMLAttributes<"img"> {
  name: string;
  alt?: string;
  sizes?: string;
  eager?: boolean;
  parallax?: string;
}

/* Alles Weitere geht ans <img> durch — `style` für einen abweichenden
   Bildausschnitt, `data-*` für die Module. Ohne das musste jede Stelle, die
   ein Attribut braucht, auf `CmsImage` mit festem Pfad ausweichen und verlor
   dabei AVIF und srcset. */
const {
  name,
  alt = "",
  sizes = "100vw",
  eager = false,
  parallax,
  ...rest
} = Astro.props;

const list = (BREITEN as Record<string, number[]>)[name];

/* Lauter Abbruch statt eines leeren Kastens: Ein Motiv, das die Pipeline
   nicht kennt, ist ein Tippfehler im Namen oder ein vergessenes
   `npm run images` — beides soll den Build anhalten und nicht erst auf der
   fertigen Seite auffallen. */
if (!list?.length) {
  throw new Error(
    `Picture: Motiv „${name}" steht nicht in image-widths.json. ` +
      `Entweder ist der Name falsch geschrieben, oder es fehlt ein Lauf von ` +
      `\`npm run images\` (bzw. \`node scripts/image-widths.mjs\`).`,
  );
}

const srcset = (ext: string) =>
  list.map((w) => `/img/${name}-${w}.${ext} ${w}w`).join(", ");
const fallback = `/img/${name}-${list[0]}.webp`;
---

<picture>
  <source type="image/avif" srcset={srcset("avif")} sizes={sizes} />
  <source type="image/webp" srcset={srcset("webp")} sizes={sizes} />
  <img
    src={fallback}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    decoding={eager ? undefined : "async"}
    data-parallax={parallax}
    {...rest}
  />
</picture>
