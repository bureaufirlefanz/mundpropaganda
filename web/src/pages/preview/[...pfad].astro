---
/**
 * Die Vorschau. Zeigt dieselben Seiten wie die Website, nur mit Entwürfen.
 *
 * **Die einzige Route der Seite, die nicht vorgerendert wird.** Alles andere
 * bleibt statisch — `output: "static"` gilt weiter, und `prerender = false`
 * ist hier die Ausnahme. Die Alternative wäre, die ganze Seite auf SSR zu
 * stellen; das kostete Auslieferungsgeschwindigkeit, Cache und die
 * Eigenschaft, dass die Site auch ohne laufenden Server steht. Für eine
 * Praxis-Website ist das ein schlechter Tausch.
 *
 * Gerendert wird über dieselben Zusammenbauten aus `seiten/` wie die echten
 * Routen. Das ist der Grund, warum Aufgabe 5 vor dieser hier stand: Zwei
 * Zusammenbauten, die dasselbe zeigen sollen, laufen garantiert auseinander —
 * und zwar unbemerkt, weil man immer nur eine von beiden ansieht.
 *
 * Was die Vorschau NICHT als Entwurf zeigt: den Rahmen. Navigation, Fuß und
 * Einstellungen holen sich ihre Daten selbst über die Ladefunktionen in
 * `lib/`, und die hängen am veröffentlichten Client. Für die Seite, die man
 * gerade bearbeitet, stimmt die Vorschau; ein Entwurf der Navigation ist
 * darin noch nicht zu sehen. Das aufzulösen hieße, jede Ladefunktion einen
 * Client entgegennehmen zu lassen — ein eigener Schritt.
 */
export const prerender = false;

import Startseite from "../../templates/Home.astro";
import Service from "../../templates/Service.astro";
import Magazin from "../../templates/Magazine.astro";
import Post from "../../templates/Post.astro";
import CareersContent from "../../templates/Careers.astro";
import LegalPage from "../../templates/LegalPage.astro";
import VisualEditing from "../../components/ui/VisualEditing.astro";

import { previewClient, targetFor, PREVIEW_COOKIE } from "../../lib/preview";
import {
  HOMEPAGE_QUERY,
  SERVICE_QUERY,
  POSTS_QUERY,
  POST_QUERY,
  MAGAZINE_INDEX_QUERY,
  CAREERS_QUERY,
  JOBS_QUERY,
  SERVICE_LIST_QUERY,
  LEGAL_PAGE_QUERY,
  RELATED_QUERY,
} from "../../lib/queries";
import { withoutNull } from "../../lib/without-null";
import type { HomepageContent } from "../../lib/homepage";
import type { Service as LeistungDaten } from "../../lib/services";
import type { Post as BeitragKarte, FullPost, MagazineIntro } from "../../lib/magazine";
import type { CareersContent as KarriereDaten, Job } from "../../lib/careers";
import type { ServiceEntry } from "../../lib/service-list";
import type { LegalPage as RechtstextDaten } from "../../lib/legal-pages";

/* Ohne Cookie keine Vorschau. Es wird von `/api/draft-mode/enable` gesetzt,
   und zwar erst, nachdem das Geheimnis aus der URL gegen den Datensatz
   geprüft wurde. Ohne diese Sperre wären sämtliche Entwürfe für jeden
   lesbar, der die Adresse errät — `/preview/` ist nicht geheim. */
if (Astro.cookies.get(PREVIEW_COOKIE)?.value !== "an") {
  return new Response(
    "Vorschau nicht freigeschaltet. Sie wird aus dem Studio heraus geöffnet.",
    { status: 401, headers: { "content-type": "text/plain; charset=utf-8" } }
  );
}

const client = previewClient();
if (!client) {
  return new Response(
    "SANITY_API_READ_TOKEN fehlt. Ohne Token gibt die API keine Entwürfe heraus.",
    { status: 500, headers: { "content-type": "text/plain; charset=utf-8" } }
  );
}

const target = targetFor(Astro.params.pfad ?? "");
if (!target) return new Response("Für diesen Pfad gibt es keine Seite.", { status: 404 });

/* Kein Zwischenspeichern wie in den Ladefunktionen unter `lib/`: Die Vorschau
   läuft je Aufruf frisch, das ist ihr Zweck. */
async function hole<T>(abfrage: string, params: Record<string, unknown> = {}) {
  return withoutNull(await client!.fetch<T>(abfrage, params));
}

/* Je Seitenart genau die Abfragen, die ihr Zusammenbau braucht — und jede nur
   einmal. */
let inhalt: {
  startseite?: HomepageContent;
  service?: LeistungDaten;
  magazinKopf?: MagazineIntro;
  beitrag?: FullPost;
  karriere?: KarriereDaten;
  rechtstext?: RechtstextDaten;
  posts: BeitragKarte[];
  jobs: Job[];
  title: string;
} = { posts: [], jobs: [], title: "" };

if (target.kind === "homepage") {
  const [data, posts] = await Promise.all([
    hole<HomepageContent>(HOMEPAGE_QUERY),
    hole<BeitragKarte[]>(POSTS_QUERY, { service: null }),
  ]);
  inhalt = { ...inhalt, startseite: data, posts: posts ?? [] };
} else if (target.kind === "service") {
  const [data, liste, start, posts] = await Promise.all([
    hole<LeistungDaten>(SERVICE_QUERY, { slug: target.slug }),
    hole<ServiceEntry[]>(SERVICE_LIST_QUERY),
    hole<HomepageContent>(HOMEPAGE_QUERY),
    hole<BeitragKarte[]>(POSTS_QUERY, { service: target.slug }),
  ]);
  inhalt = {
    ...inhalt,
    service: data,
    posts: posts ?? [],
    title: data?.title || (liste ?? []).find((l) => l.slug === target.slug)?.name || "",
    startseite: start,
  };
} else if (target.kind === "magazineIndex") {
  const [kopf, posts] = await Promise.all([
    hole<MagazineIntro>(MAGAZINE_INDEX_QUERY),
    hole<BeitragKarte[]>(POSTS_QUERY, { service: null }),
  ]);
  inhalt = { ...inhalt, magazinKopf: kopf, posts: posts ?? [] };
} else if (target.kind === "post") {
  const data = await hole<FullPost>(POST_QUERY, { slug: target.slug });
  /* Erst nach dem Beitrag, nicht parallel: Die Kategorie steht in ihm, und
     ohne sie gibt es nichts Ähnliches zu holen. */
  const related = data?.category
    ? ((await hole<BeitragKarte[]>(RELATED_QUERY, {
        category: data.category,
        slug: target.slug,
      })) ?? [])
    : [];
  inhalt = { ...inhalt, beitrag: data, title: data?.title ?? "", posts: related };
} else if (target.kind === "legalPage") {
  const data = await hole<RechtstextDaten>(LEGAL_PAGE_QUERY, { slug: target.slug });
  /* `zielVon` liest jeden einteiligen Pfad als Rechtstext — er kann nicht
     wissen, welche Slugs es gibt. Ohne Dokument ist es keine Seite. */
  if (!data) return new Response("Für diesen Pfad gibt es keine Seite.", { status: 404 });
  inhalt = { ...inhalt, rechtstext: data, title: data.title ?? "" };
} else {
  const [data, jobs] = await Promise.all([
    hole<KarriereDaten>(CAREERS_QUERY),
    hole<Job[]>(JOBS_QUERY),
  ]);
  inhalt = { ...inhalt, karriere: data, jobs: jobs ?? [] };
}
---

{target.kind === "homepage" && inhalt.startseite && (
  <Startseite data={inhalt.startseite} posts={inhalt.posts} />
)}

{target.kind === "service" && (
  <Service
    data={inhalt.service}
    title={inhalt.title}
    stories={inhalt.startseite?.storiesItems ?? []}
    posts={inhalt.posts}
  />
)}

{target.kind === "magazineIndex" && (
  <Magazin kopf={inhalt.magazinKopf} posts={inhalt.posts} />
)}

{target.kind === "post" && (
  <Post data={inhalt.beitrag} title={inhalt.title} related={inhalt.posts} />
)}

{target.kind === "careers" && <CareersContent data={inhalt.karriere} jobs={inhalt.jobs} />}

{target.kind === "legalPage" && (
  <LegalPage data={inhalt.rechtstext} title={inhalt.title} />
)}

<VisualEditing />
