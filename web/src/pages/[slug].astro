---
/**
 * Die oberste Ebene: /impressum, /datenschutz, /barrierefreiheit.
 *
 * Diese Route ist die einzige mit einem Platzhalter direkt unter der Wurzel,
 * und das ist der Grund, warum `slugFrei()` im Schema steht: Ein Rechtstext
 * mit dem Slug „magazine" oder „careers" träte hier gegen eine bestehende
 * Seite an. Astro entscheidet solche Fälle zugunsten der spezifischeren
 * Route, aber verlassen sollte man sich darauf nicht — das Studio lässt den
 * Slug erst gar nicht zu.
 */
import LegalPage from "../templates/LegalPage.astro";
import { loadLegalPage, loadLegalPages } from "../lib/legal-pages";

// Muss die Ladefunktion importieren, nicht auf Frontmatter-Konstanten
// zugreifen: Astro hebt getStaticPaths in einen eigenen Modulkontext.
export async function getStaticPaths() {
  const pages = await loadLegalPages();
  return pages.map((t) => ({
    params: { slug: t.slug },
    props: { title: t.title },
  }));
}

const { slug } = Astro.params;
const { title } = Astro.props;
const data = await loadLegalPage(slug!);
---

<LegalPage data={data} title={data?.title || title || ""} />
