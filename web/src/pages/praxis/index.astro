---
/**
 * Die Route. Daten laden, Renderer aufrufen.
 *
 * Drei Quellen, weil die Seite drei Dinge zeigt, die anderswo gepflegt
 * werden: das Dokument selbst, die Personen-Sammlung und die Standorte aus
 * den Einstellungen. Zusammenlegen hieße doppelt pflegen.
 */
import PracticeContent from "../../templates/Practice.astro";
import { loadPractice, loadTeam } from "../../lib/practice";
import { loadSettings } from "../../lib/settings";

const data = await loadPractice();
const team = await loadTeam();
const { locations } = await loadSettings();
---

<PracticeContent data={data} team={team} locations={locations} />
