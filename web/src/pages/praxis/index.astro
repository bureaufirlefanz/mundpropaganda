---
/**
 * Die Route. Daten laden, Renderer aufrufen.
 *
 * Two sources: the document itself and the locations from the settings.
 * The team is shown as photos (sections/TeamPhotos.astro), not as people.
 */
import PracticeContent from "../../templates/Practice.astro";
import { loadPractice } from "../../lib/practice";
import { loadSettings } from "../../lib/settings";

const data = await loadPractice();
const { locations } = await loadSettings();
---

<PracticeContent data={data} locations={locations} />
