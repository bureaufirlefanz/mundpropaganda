---
/**
 * Eine Person des Teams unter `/praxis/<slug>`.
 *
 * `getStaticPaths` baut je Person eine Seite. Die Liste kommt aus derselben
 * Abfrage wie das Raster auf `/praxis` — damit kann es keine Kachel geben,
 * die auf eine Seite zeigt, die nicht gebaut wurde.
 *
 * Die vollständigen Daten holt die Seite trotzdem einzeln: Das Raster
 * braucht fünf Felder, die Detailseite zwölf, und die Rasterabfrage soll
 * nicht die Lebensläufe aller Personen mitschleppen.
 */
import PersonContent from "../../templates/Person.astro";
import { loadTeam, loadPerson } from "../../lib/practice";

/**
 * Vorerst abgeschaltet.
 *
 * Der Team-Abschnitt der Praxisseite zeigt seit dem Umbau nur noch Porträts,
 * ohne Namen und ohne Verweis — so entschieden, bis die Personenseiten
 * inhaltlich stehen. Damit war jede Seite hier von nirgends mehr erreichbar:
 * gebaut, ausgeliefert, indexierbar, aber ohne einen einzigen Link.
 *
 * Die Routen-Deckung in `web:check` hat genau das gemeldet, und der Befund
 * war richtig. Statt ihn zu übergehen bauen wir die Seiten nicht: Eine leere
 * Liste in `getStaticPaths` erzeugt keine Datei.
 *
 * **Zurückholen** heißt: `AKTIV` auf true, und in `Team.astro` die Kacheln
 * mit Name und Verweis wiederherstellen (der Kommentar dort sagt, wie).
 * Beides gehört zusammen — die Seite ohne den Verweis wäre wieder verwaist,
 * der Verweis ohne die Seite führte ins Leere.
 */
export async function getStaticPaths() {
  /* Der Schalter steht INNERHALB der Funktion.
     Astro zieht `getStaticPaths` beim Bauen heraus und ruft es in einem
     eigenen Modulzusammenhang auf — eine Konstante daneben im Frontmatter
     existiert dort nicht, der Build brach mit „AKTIV is not defined" ab.
     `astro check` sah das nicht: Für TypeScript ist der Zugriff gültig. */
  const AKTIV = false;
  if (!AKTIV) return [];
  const team = await loadTeam();
  return team.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const person = await loadPerson(slug!);

/* Kann eigentlich nicht eintreten — die Pfade kommen aus derselben Quelle.
   Falls doch, ist eine 404 die ehrliche Antwort und keine leere Seite. */
if (!person) return Astro.rewrite("/404");
---

<PersonContent person={person} />
