---
/**
 * Komponenten — jeder Baustein der Seite mit Beschreibung, Quellpfad und,
 * wo es geht, lebendem Beispiel.
 *
 * Bewusst OHNE Farben, Typografie und Bewegungswerte: die stehen im
 * Styleguide. Was hier steht, sind die zusammengesetzten Teile.
 *
 * Die Beispiele laufen mit echten Daten aus dem CMS, nicht mit erfundenen:
 * die Startseiten-Bausteine mit dem Startseiten-Dokument, die
 * Leistungsbausteine mit Veneers, die Praxis- und Karriere-Bausteine mit
 * ihren Seiten, die Pillar-Bausteine mit `/veneers-berlin`. Damit ist
 * ausgeschlossen, dass diese Seite etwas zeigt, das es so nirgends gibt — und
 * sie ist zugleich die Probe, ob ein Baustein ohne seine Daten heil bleibt.
 *
 * Drei Ausnahmen, jede an ihrer Stelle als Beispieldaten gekennzeichnet:
 * `PAGE_HEADINGS` (die Kapitel dieser Seite — nur so springen die
 * Verzeichnisbausteine wirklich irgendwohin), `HEADING_NODE` (ein
 * Portable-Text-Knoten für TextHeading) und das Prüfdatum der Autorenbox.
 *
 * Nicht eingebettet sind die Bausteine, die den Seitenchrome bilden
 * (Navigation, Fuß, Übergangsschicht, Hintergrundebenen) und die beiden
 * Heroes. Sie sind auf ihre Seite als Ganzes bezogen: die Navigation ist
 * fixiert und läge über jedem Beispiel, die Heroes füllen ein ganzes Fenster
 * und bringen eine Auftrittschoreografie mit, die genau einmal je Dokument
 * laufen kann. Ein Beispiel davon wäre kein Beispiel, sondern ein zweiter,
 * kaputter Seitenkopf. Sie stehen deshalb mit Beschreibung und Verweis da.
 */
import Design from "../../layouts/Design.astro";
import { loadHomepage } from "../../lib/homepage";
import { loadService } from "../../lib/services";
import { loadPosts } from "../../lib/magazine";
import { loadCareers, loadJobs } from "../../lib/careers";
import { loadPractice, loadTeam } from "../../lib/practice";
import { loadSettings, telLink } from "../../lib/settings";
import { veneersPillar } from "../../content/veneers-pillar";
import type { PillarSection } from "../../lib/pillar-sections";
import type { Heading } from "../../lib/table-of-contents";
import type { Block } from "astro-portabletext/types";

import Button from "../../components/ui/Button.astro";
import Accordion from "../../components/ui/Accordion.astro";
import Panel from "../../components/ui/Panel.astro";
import Reviews from "../../components/ui/Reviews.astro";
import Picture from "../../components/ui/Picture.astro";
import ImageRing from "../../components/ui/ImageRing.astro";
import ToothRings from "../../components/ui/ToothRings.astro";
import Filter from "../../components/ui/Filter.astro";
import PostCard from "../../components/ui/PostCard.astro";
import PostImage from "../../components/ui/PostImage.astro";
import TableOfContents from "../../components/ui/TableOfContents.astro";
import SectionDock from "../../components/ui/SectionDock.astro";
import TextHeading from "../../components/ui/TextHeading.astro";
import AuthorNote from "../../components/ui/AuthorNote.astro";
import SourceNote from "../../components/ui/SourceNote.astro";

import Intro from "../../components/sections/Intro.astro";
import Statement from "../../components/sections/Statement.astro";
import Benefits from "../../components/sections/Benefits.astro";
import BeforeAfter from "../../components/sections/BeforeAfter.astro";
import Steps from "../../components/sections/Steps.astro";
import Prices from "../../components/sections/Prices.astro";
import Features from "../../components/sections/Features.astro";
import Faq from "../../components/sections/Faq.astro";
import Contact from "../../components/sections/Contact.astro";
import Split from "../../components/sections/Split.astro";
import Services from "../../components/sections/Services.astro";
import Standards from "../../components/sections/Standards.astro";
import Gallery from "../../components/sections/Gallery.astro";
import Experts from "../../components/sections/Experts.astro";
import Stories from "../../components/sections/Stories.astro";
import Magazine from "../../components/sections/Magazine.astro";
import Facts from "../../components/sections/Facts.astro";
import Jobs from "../../components/sections/Jobs.astro";
import Compare from "../../components/sections/Compare.astro";
import NavPromo from "../../components/ui/NavPromo.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import Timeline from "../../components/sections/Timeline.astro";
import Voices from "../../components/sections/Voices.astro";
import QuickFacts from "../../components/sections/QuickFacts.astro";
import Contents from "../../components/sections/Contents.astro";
import Prose from "../../components/sections/Prose.astro";
import CtaBand from "../../components/sections/CtaBand.astro";
import Story from "../../components/sections/Story.astro";
import Values from "../../components/sections/Values.astro";
import Team from "../../components/sections/Team.astro";
import Locations from "../../components/sections/Locations.astro";
import Perks from "../../components/sections/Perks.astro";
import Reasons from "../../components/sections/Reasons.astro";
import VideoBlock from "../../components/sections/VideoBlock.astro";
import PostList from "../../components/sections/PostList.astro";
import Application from "../../components/sections/Application.astro";

/* Die Startseiten-Bausteine bekommen ihre Inhalte aus dem CMS — dieselbe
   Quelle wie die Startseite selbst.

   Bis Aufgabe 4 standen sie hier ganz ohne Props da und lebten von den
   Vorgaben in ihrem Frontmatter. Die Vorgaben sind weg, und eigens erfundene
   Beispieldaten wären der falsche Ersatz: Diese Seite soll zeigen, was es
   wirklich gibt, nicht etwas, das so nirgends steht. */
const content = await loadHomepage();

/* Die Leistungsbausteine am Beispiel Veneers — der einzigen voll gepflegten
   Leistung. Bis Aufgabe 4 kamen sie aus `beispielLeistung` in fixtures.ts;
   die Datei hat damit ihre letzte Aufgabe verloren und ist entfallen. */
const service = await loadService("veneers");
const posts = await loadPosts();

/* Die Karriere-Bausteine mit den echten Inhalten der Karriereseite. Bis zum
   Umzug ins CMS kamen sie aus Konstanten in lib/karriere.ts; die Datei trägt
   jetzt nur noch den Datenzugriff. */
const careers = await loadCareers();
const jobs = await loadJobs();

/* Die Praxis-Bausteine mit den echten Inhalten der Praxisseite. Team und
   Standorte kommen aus ihren eigenen Quellen - genau wie in `Practice.astro`,
   damit hier nichts zusammengesetzt wird, was es so nirgends gibt. */
const practice = await loadPractice();
const team = await loadTeam();
const settings = await loadSettings();

/* Die Pillar-Bausteine am Beispiel `/veneers-berlin`, der einzigen Pillar
   Page. Ihr Inhalt liegt heute im Repository und nicht im CMS; das ändert
   nichts daran, dass es der Inhalt ist, den die Seite wirklich zeigt. */
function pillarSection<T extends PillarSection["_type"]>(type: T) {
  return veneersPillar.sections.find(
    (s): s is Extract<PillarSection, { _type: T }> => s._type === type,
  );
}

const ctaBand = pillarSection("ctaBand");

/* „Auf einen Blick" steht derzeit in keinem gepflegten Inhalt - die Pillar
   Page trägt den Abschnitt nicht mehr. Statt erfundener Angaben zur
   Behandlung hier Begriff und Wert aus den Einstellungen: Es ist dieselbe
   Form (Begriff links, Antwort rechts), und jede Zeile stimmt. */
const QUICK_FACTS = [
  { label: "Telefon", value: settings.phone },
  { label: "E-Mail", value: settings.email },
  ...settings.locations.map((o) => ({
    label: o.name,
    value: `${o.street}, ${o.city}`,
  })),
];

/* Der Textabschnitt mit Beleg - er trägt Bild, Fließtext UND den abgesetzten
   Kasten, zeigt also alle drei Teile des Bausteins auf einmal. */
const prose = veneersPillar.sections.find(
  (s): s is Extract<PillarSection, { _type: "prose" }> =>
    s._type === "prose" && Boolean(s.note),
);

/* Die Kategorien, unter denen wirklich etwas liegt - dieselbe Ableitung wie
   in `PostList.astro`, weil der Filter hier ohne sein Raster steht. */
const POST_CATEGORIES = [
  ...new Set(posts.map((p) => p.category).filter(Boolean)),
] as string[];

/**
 * Beispieldaten: die Kapitel dieser Katalogseite selbst.
 *
 * `Contents`, `TableOfContents` und `SectionDock` arbeiten alle drei mit
 * derselben `Heading[]`-Liste. Die Liste der Pillar Page zu übernehmen wäre
 * naheliegend gewesen und hätte drei Verzeichnisse voller toter Sprungmarken
 * ergeben: Deren Ziele stehen auf `/veneers-berlin`, nicht hier. Die Kapitel
 * dieser Seite gibt es dagegen wirklich - jedes `<section class="d-section">`
 * unten trägt die passende `id`. Damit springen die Beispiele tatsächlich,
 * und `SectionDock` findet die Abschnitte, ohne die es sich gar nicht erst
 * einblendet.
 */
const PAGE_HEADINGS: Heading[] = [
  { key: "controls", id: "bedienelemente", text: "Bedienelemente", level: 2 },
  {
    key: "surfaces",
    id: "flaechen",
    text: "Flächen, Bilder, Zierrat",
    level: 2,
  },
  { key: "sections", id: "sections", text: "Sections", level: 2 },
  {
    key: "reading",
    id: "lesehilfen",
    text: "Verzeichnis und Belege",
    level: 2,
  },
  { key: "chrome", id: "rahmen", text: "Seitenrahmen", level: 2 },
];

/* Beispieldaten: ein Portable-Text-Block, wie ihn `withHeadingIds()` an
   `TextHeading` durchreicht. Von Hand gebaut, weil der Baustein einen Knoten
   erwartet und nicht eine Zeichenkette - und weil die Kennung im Knoten steht
   und nicht berechnet wird. */
const HEADING_NODE: Block & { _tocId: string } = {
  _type: "block",
  _key: "text-heading-sample",
  style: "h2",
  markDefs: [],
  children: [
    {
      _type: "span",
      _key: "text-heading-sample-0",
      text: "Ein Zwischentitel im Fließtext",
      marks: [],
    },
  ],
  _tocId: "beispiel-zwischentitel",
};

/* Beispieldaten für die Autorenbox: zwei Personen aus dem Team und die
   Quelle, die auf der Pillar Page unter dem Haltbarkeits-Abschnitt steht.
   Erfunden ist allein das Prüfdatum - ohne eines fiele die Zeile weg, und
   das Beispiel zeigte den halben Baustein. */
const REVIEW_DATE = "2026-06-30";

/* Bausteine, die sich nicht einbetten lassen — mit dem Grund, warum nicht.
   Der Grund gehört dazu: ohne ihn liest es sich wie eine Lücke. */
const CHROME = [
  {
    name: "Hero",
    path: "components/sections/Hero.astro",
    text: "Der Seitenkopf der Startseite: Wortmarke über zwei Zeilen, der Zahn dazwischen - „MUND“ liegt dahinter, „PROPAGANDA“ davor. Die Wortmarke ist zugleich die h1 der Seite. Trägt die Auftrittschoreografie: Maske über der Schrift, Nav von oben, Bewertungsleiste und Scroll-Knopf zuletzt.",
    reason: "Füllt ein ganzes Fenster und läuft genau einmal je Dokument an.",
    viewAt: "/",
  },
  {
    name: "ServiceHero",
    path: "components/sections/ServiceHero.astro",
    text: "Derselbe Auftritt für die Leistungsseiten, aber mit Titel statt Wortmarke und einem Bild rechts. Hängt an denselben data-Attributen wie der große Hero, deshalb greift dieselbe Choreografie ohne eigenen Code.",
    reason: "Wie oben - ein zweiter Seitenkopf im Dokument.",
    viewAt: "/leistungen/veneers",
  },
  {
    name: "Nav",
    path: "components/ui/Nav.astro",
    text: "Die fixierte Leiste samt Menü. Überlebt Seitenwechsel über transition:persist, damit sie beim Wechsel nicht neu einfliegt.",
    reason: "Fixiert - läge über jedem Beispiel auf dieser Seite.",
    viewAt: "/",
  },
  {
    name: "Footer",
    path: "components/ui/Footer.astro",
    text: "Der Seitenfuß: Kontakt, beide Praxen mit Anschrift, Leistungen und Rechtliches. Die Leistungsliste kommt aus derselben Quelle wie Menü und Services-Tabelle - drei Aufzählungen, eine Wahrheit.",
    reason: "Schließt eine Seite ab; mitten im Dokument ergäbe er keinen Sinn.",
    viewAt: "/",
  },
  {
    name: "Backdrop / Transition",
    path: "components/ui/Backdrop.astro · Transition.astro",
    text: "Zwei Ebenen hinter und über allem: der körnige Hintergrund und die Schicht, die beim Seitenwechsel überblendet.",
    reason: "Ganzflächig und unsichtbar, solange nichts passiert.",
    viewAt: "jeder Seitenwechsel",
  },
  {
    name: "Thread",
    path: "components/ui/Thread.astro",
    text: "Der durchlaufende Faden, der sich beim Scrollen über die ganze Seite zeichnet. Misst seinen Pfad einmal aus und liest die Transformationsmatrix dabei nur ein einziges Mal - die frühere Fassung tat das je Messpunkt und blockierte den Hauptstrang über eine Sekunde.",
    reason: "Bezieht sich auf die Höhe des gesamten Dokuments.",
    viewAt: "/",
  },
  {
    name: "Icons",
    path: "components/ui/Icons.astro",
    text: "Das SVG-Sprite, einmal je Dokument. Alle Symbole liegen darin und werden per <use> aufgerufen.",
    reason: "Unsichtbar - es ist die Quelle, nicht die Darstellung.",
    viewAt: "/design/styleguide",
  },
  {
    name: "CmsImage",
    path: "components/ui/CmsImage.astro",
    text: "Bild aus Sanity: baut srcset, respektiert den im Studio gesetzten Bildausschnitt und zeigt eine unscharfe Vorschau, bis das Motiv da ist. Fällt auf ein lokales Bild zurück, solange im CMS nichts liegt.",
    reason:
      "Braucht ein Bildobjekt aus dem CMS; das lokale Gegenstück ist Picture.",
    viewAt: "/leistungen/veneers",
  },
];

const SHORT_QUESTIONS = (service?.faq ?? []).slice(0, 3);

const RING_IMAGES = [
  {
    name: "praxis-03",
    widths: "640,1024",
    alt: "Behandlungsräume mit Tageslicht",
    caption: "Prenzlauer Allee",
  },
  { name: "praxis-01", widths: "640", alt: "Empfangsbereich" },
  {
    name: "praxis-02",
    widths: "640",
    alt: "Wartebereich",
    caption: "Christburger Straße",
  },
  { name: "abstract-01", widths: "640,1024" },
  { name: "abstract-02", widths: "640,1024" },
];
---

<Design title="Komponenten" active="komponenten">
  <section class="d-section">
    <div class="d-section__header">
      <span class="d-section__number">00</span>
      <h1 class="d-section__title">Komponenten</h1>
      <p class="d-section__text">
        Jeder Baustein der Seite mit Beschreibung, Quellpfad und lebendem
        Beispiel. Farben, Typografie und Bewegungswerte stehen nicht hier,
        sondern im <a class="c-link" href="/design/styleguide">Styleguide</a> - zweimal
        dieselbe Sache zu zeigen heißt, sie zweimal pflegen zu müssen.
      </p>
      <p class="d-section__text">
        Die Beispiele laufen mit denselben Beispieldaten, die auch die
        Leistungsseiten versorgen, solange im CMS nichts gepflegt ist. Ändert
        sich eine Komponente, ändert sich diese Seite mit - sie zeigt die echten
        Bausteine, keine Nachbauten.
      </p>
    </div>
  </section>

  {/* ================= Bedienelemente ================= */}
  {
    /* Die `id` an jedem Kapitel ist das Ziel der Verzeichnis-Beispiele weiter
      unten; `data-toc-target` ist zusätzlich das, woran `toc.js` erkennt, in
      welchem Kapitel gerade gelesen wird. Beides steht hier, damit die drei
      Verzeichnisbausteine mit echten Sprungmarken laufen. */
  }
  <section
    class="d-section"
    id="bedienelemente"
    data-toc-target="bedienelemente"
  >
    <div class="d-section__header">
      <span class="d-section__number">01</span>
      <h2 class="d-section__title">Bedienelemente</h2>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Button</span>
        <span class="d-sample__path">components/ui/Button.astro</span>
      </div>
      <p class="d-sample__text">
        Zweiteilig: Pille mit Beschriftung, daneben abgesetzt der runde Pfeil.
        Rendert je nach Zweck <code>&lt;a&gt;</code>, <code>&lt;button&gt;</code
        >
        oder <code>&lt;span&gt;</code> - Letzteres, wo er innerhalb eines bereits
        verlinkten Bereichs sitzt, weil verschachtelte Links der Parser nicht zulässt
        und das Layout dabei zerfällt.
      </p>
      <div class="d-stage d-stage--row">
        <Button label="Termin buchen" href="#" />
        <Button label="Dunkel" href="#" variant="dark" />
        <Button label="Absenden" type="submit" />
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Accordion</span>
        <span class="d-sample__path">components/ui/Accordion.astro</span>
      </div>
      <p class="d-sample__text">
        Immer nur ein Eintrag offen. Klappt über die Rasterzeile auf statt über
        <code>display</code>, damit ein Übergang möglich ist. Sinkt beim Klick
        als einziges Bedienelement nicht ein - eine ganze Zeile, die beim
        Aufklappen zusammenzuckt, wirkt wie ein Ruckeln.
      </p>
      <div class="d-stage">
        <Accordion questions={SHORT_QUESTIONS} />
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Reviews</span>
        <span class="d-sample__path">components/ui/Reviews.astro</span>
      </div>
      <p class="d-sample__text">
        Die Bewertungsleiste: Quelle, Sterne, Schnitt und Anzahl. Alle vier
        Angaben kommen aus den Einstellungen im Studio, nichts davon steht im
        Markup.
      </p>
      <div class="d-stage">
        <Reviews />
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Filter</span>
        <span class="d-sample__path">components/ui/Filter.astro</span>
      </div>
      <p class="d-sample__text">
        Der Kategoriefilter des Magazins: ein Knopf, der die belegten Kategorien
        ausklappt. Ohne JavaScript ist er unsichtbar - er blendet Karten aus,
        statt eine Liste zu bauen, und ein Knopf, der ohne Skript nichts tut,
        wäre schlechter als keiner.
      </p>
      <p class="d-sample__text">
        Er zeigt sich nur zusammen mit einem Beitragsraster. Auf dieser Seite
        greift er deshalb über <em>alle</em> Beitragskarten hinweg - Karussell, Einzelkarte
        und das Raster im nächsten Kapitel -, während er im Einsatz genau ein Raster
        vor sich hat. Und das Modul verdrahtet je Dokument den ersten Filter (<code
          >querySelector</code
        >, Einzahl): Dieser hier ist der lebende, der zweite steckt in <code
          >PostList</code
        > und bleibt auf dieser Seite untätig.
      </p>
      <div class="d-stage">
        {
          POST_CATEGORIES.length ? (
            <Filter categories={POST_CATEGORIES} total={posts.length} />
          ) : null
        }
      </div>
    </div>
  </section>

  {/* ================= Flächen und Bilder ================= */}
  <section class="d-section" id="flaechen" data-toc-target="flaechen">
    <div class="d-section__header">
      <span class="d-section__number">02</span>
      <h2 class="d-section__title">Flächen, Bilder, Zierrat</h2>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Panel</span>
        <span class="d-sample__path">components/ui/Panel.astro</span>
      </div>
      <p class="d-sample__text">
        Der gerundete Kasten mit Topline, Überschrift und freiem Inhalt. Trägt
        FAQ und Kontaktformular; alles, was als abgesetzte Fläche auf der Seite
        steht, steckt darin.
      </p>
      <div class="d-stage d-stage--borderless">
        <Panel
          topline="Beispiel"
          title="Ein Panel"
          text="Die Zusatzzeile ist wahlfrei."
        >
          <p style="max-width: 60ch">Beliebiger Inhalt im Schlitz.</p>
        </Panel>
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Picture</span>
        <span class="d-sample__path">components/ui/Picture.astro</span>
      </div>
      <p class="d-sample__text">
        Responsives Bild aus der lokalen Bildpipeline. AVIF zuerst, WebP als
        Rückfall; der <code>src</code> zeigt auf die kleinste Breite, damit alte Browser
        ohne <code>srcset</code> nicht das größte Bild ziehen. Nimmt wahlweise einen
        Parallax-Wert entgegen.
      </p>
      <div class="d-stage" style="max-width: 520px">
        <Picture
          name="praxis-01"
          alt="Empfangsbereich Prenzlauer Allee"
          sizes="480px"
        />
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">ImageRing</span>
        <span class="d-sample__path">components/ui/ImageRing.astro</span>
      </div>
      <p class="d-sample__text">
        Die Motive sitzen auf einem Zylinder, der Betrachter steht innen: die
        Wölbung geht nach innen, die Karten laufen an den Rändern über das Bild
        hinaus. Läuft langsam von selbst, rollt sanft aus, sobald der Zeiger
        darauf steht, und lässt sich ziehen - ein Pixel Zeigerweg entspricht
        einem Pixel Kartenweg. Radius und Perspektive rechnet das Modul aus der
        gemessenen Kartenbreite, damit die Krümmung bei jeder Fenstergröße
        dieselbe ist. Über die beiden Knöpfe und die Pfeiltasten auch ohne Maus
        bedienbar.
      </p>
      <div class="d-stage d-stage--borderless">
        <ImageRing images={RING_IMAGES} label="Beispielring" />
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">ToothRings</span>
        <span class="d-sample__path">components/ui/ToothRings.astro</span>
      </div>
      <p class="d-sample__text">
        Der Zierring aus konzentrischen Kreisen. Rein dekorativ und deshalb für
        Vorlesegeräte ausgeblendet. Das Gegenstück <code>ToothLines</code> legt dieselbe
        Handschrift als offene Linien hinter den Hero.
      </p>
      <div
        class="d-stage d-stage--dark"
        style="position: relative; min-height: 280px; overflow: hidden"
      >
        <ToothRings />
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">PostCard</span>
        <span class="d-sample__path">components/ui/PostCard.astro</span>
      </div>
      <p class="d-sample__text">
        Die Beitragskarte: Bild, darauf versetzt eine weiße Fläche. Dieselbe
        Karte im Karussell und im Raster - die Breite kommt von außen über
        <code>--post-width</code>, alles andere steht nur an dieser einen
        Stelle. Unter etwa 420px trägt die weiße Fläche den Text nicht mehr,
        deshalb stapelt sie dort.
      </p>
      <div class="d-stage" style="max-width: 560px">
        {
          posts.length ? (
            <PostCard post={posts[0]!} sizes="500px" withButton />
          ) : null
        }
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">PostImage</span>
        <span class="d-sample__path">components/ui/PostImage.astro</span>
      </div>
      <p class="d-sample__text">
        Ein Bild im Fließtext eines Beitrags, in drei Breiten:
        <code>column</code> bleibt in der Textspalte, <code>wide</code> reicht bis
        an den rechten Rand des Satzspiegels, <code>full</code> bricht über die volle
        Fensterbreite aus. Sie unterscheiden sich erst im Satzspiegel eines Beitrags;
        hier stünde <code>wide</code> auf der Bühne, damit das Beispiel den Kasten
        nicht sprengt. Was der Browser lädt, hängt an der Breite - ein Bild in der
        Textspalte fordert nie 2.200px an.
      </p>
      {
        content.splitImage ? (
          <div class="d-stage">
            <PostImage
              node={{
                image: content.splitImage,
                width: "wide",
                caption:
                  "Bildunterschrift, wahlfrei - hier als Beispiel gesetzt.",
              }}
            />
          </div>
        ) : (
          /* Kein leerer Kasten, sondern der Grund: Der Baustein prüft mit
           `isCmsImage()` und zeigt nur Bilder aus dem CMS - ein Motivname aus
           der lokalen Pipeline geht durch diese Prüfung nicht, obwohl
           `CmsImage` ihn auflösen könnte. Im Datenbestand liegt derzeit kein
           gepflegtes Bild, also gibt es hier nichts zu zeigen. Sobald eines
           im Studio hängt, steht das Beispiel von selbst da. */
          <div class="d-note">
            <p>
              <strong>Kein lebendes Beispiel:</strong> Der Baustein zeigt
              ausschließlich Bilder aus dem CMS - ein Motivname aus der lokalen
              Bildpipeline kommt an seiner Prüfung nicht vorbei. Im Datenbestand
              ist derzeit kein Bild gepflegt, also rendert er nichts. Sobald im
              Studio eines hängt, steht das Beispiel hier von selbst.
            </p>
          </div>
        )
      }
    </div>
  </section>

