  | "tracking"
  | "radius"
  | "shadow"
  | "icon"
  | "line"
  | "focus"
  | "curve"
  | "duration"
  | "none";

type Row = {
  name: string;
  value: string;
  size: string;
  purpose: string;
  probe: Probe;
};

const rows = (names: string[], probe: Probe | ((name: string) => Probe)) =>
  names.map((name): Row => ({
    name,
    value: readable(ROOT.get(name) ?? ""),
    /* "112px" needs no "112 px" underneath. */
    size:
      sizeOf(name).replace(/\s/g, "") ===
      (ROOT.get(name) ?? "").replace(/\s/g, "")
        ? ""
        : sizeOf(name),
    purpose: purpose(name),
    probe: typeof probe === "function" ? probe(name) : probe,
  }));

type Chapter = {
