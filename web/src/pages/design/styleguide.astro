const textStyles = textStyleNames.map((name) => {
  const value = ROOT.get(name) ?? "";
  const refs = [...value.matchAll(/var\((--[\w-]+)\)/g)].map((m) => m[1]!);
  const size = refs.find((r) => r.startsWith("--fs-"));
  const tracking = trackingFor(name.slice("--font-".length));
  return {
    name,
    value: readable(value),
    tracking,
    mono: refs.includes("--f-mono"),
    sizeAt: size ? px(`var(${size})`) : null,
    purpose: purpose(name),
    specimen: STYLE_SPECIMEN[name] ?? "Mundpropaganda",
  };
});

/* Where a colour role is read, and what kind of contrast it owes. */
const ROLE_GROUND: Record<string, string> = {
  "--c-on-dark": "--c-dark",
  "--c-on-dark-muted": "--c-dark",
  "--c-on-dark-line": "--c-dark",
  "--c-on-dark-line-strong": "--c-dark",
