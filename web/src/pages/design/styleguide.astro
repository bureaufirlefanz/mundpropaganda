/* --- Roles --------------------------------------------------------------- */

const TRACKING_FOR: Record<string, string> = {
  /* shared.css pairs the topline with the label tracking. */
  topline: "--tracking-label",
};
function trackingFor(key: string) {
  if (TRACKING_FOR[key]) return TRACKING_FOR[key];
  const segments = key.split("-");
  while (segments.length) {
    const candidate = `--tracking-${segments.join("-")}`;
    if (ROOT.has(candidate)) return candidate;
    segments.pop();
  }
  return undefined;
}

const STYLE_SPECIMEN: Record<string, string> = {
  "--font-title-page": "Veneers in Berlin",
