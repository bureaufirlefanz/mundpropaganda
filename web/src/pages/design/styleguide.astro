const covered = new Set<string>();
const take = (list: string[], test: (t: string) => boolean) => {
  const picked = list.filter(test);
  picked.forEach((t) => covered.add(t));
  return picked;
};

const baseColours = take(BASE, starts("--c-"));
const fonts = take(BASE, starts("--f-", "--fw-"));
