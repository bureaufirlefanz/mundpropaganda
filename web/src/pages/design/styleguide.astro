  const scope = s.attr ? SURFACE_DECLS.get(s.attr) : undefined;
  const measure = (role: string, kind: Kind) => {
    const v = roleContrast(role, s.ground, scope);
    return v == null ? null : { value: v, rating: rating(v, kind) };
  };
  return {
    ...s,
    ratios: [
      { label: "Schrift", ...measure("--c-text", "text") },
      { label: "Nebentext", ...measure("--c-text-muted", "text") },
      { label: "Starke Linie", ...measure("--c-line-strong", "control") },
      { label: "Fokusring", ...measure("--c-focus", "control") },
    ],
    overrides: [...(scope?.keys() ?? [])],
    used: s.attr ? usageHtml(s.attr, surfaceUses, []) : "",
  };
});
