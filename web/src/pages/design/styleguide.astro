---
/**
 * Styleguide — die Grundlagen: Farben, Typografie, Abstände, Radien,
 * Bewegung und die kleinen Bausteine, aus denen alles Übrige besteht.
 *
 * Alle Werte kommen aus tokens.css und werden hier NICHT wiederholt, sondern
 * über die Custom Property gezogen. Eine Seite, die Farben als Hex-Werte
 * abschreibt, ist nach der ersten Änderung eine Lüge.
 *
 * Die Kontrastwerte daneben sind gerechnet, nicht abgetippt: dieselbe Formel
 * wie in scripts/lib/wcag.mjs, damit hier nichts als „AA“ dasteht, was der
 * Prüflauf beanstanden würde.
 */
import Design from "../../layouts/Design.astro";
import Button from "../../components/ui/Button.astro";
import Accordion from "../../components/ui/Accordion.astro";

/* --- Kontrast ---------------------------------------------------------
   Zur Bauzeit gerechnet. Die Farben stehen hier als Hex, weil sich clamp()
   und color-mix() nicht in Node auswerten lassen — sie sind aus tokens.css
   übernommen, nicht frei gewählt.

   Abgesichert ist das seit dem 15.08.2026 durch `checkStyleguideColours()`
   in `scripts/check-web.mjs`: Die Prüfung vergleicht jeden Wert hier mit dem
   zugehörigen `--c-*` in tokens.css. Vorher stand an dieser Stelle, das sei
   „über den Prüflauf abgesichert" — das war es nicht, kein Skript hat die
   beiden Listen je verglichen. Ein geänderter Farbton in tokens.css hätte
   die Tafel lautlos falsch werden lassen. */
const HEX = {
  brand: "#ff84c8",
  dark: "#403229",
  taupe: "#d0bec3",
  grey: "#d6d6d6",
  "neutral-800": "#201d1d",
  "neutral-200": "#f4f4f4",
  white: "#ffffff",
  black: "#000000",
} as const;

const channels = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));

function luminance(hex: string) {
  const k = channels(hex).map((v) => {
    const s = v / 255;
    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * k[0] + 0.7152 * k[1] + 0.0722 * k[2];
}

function contrast(a: string, b: string) {
  const [x, y] = [luminance(a), luminance(b)];
  return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
}

/* Jede Farbe gegen den Grund, auf dem sie tatsächlich vorkommt. */
const COLORS = [
  { name: "--c-brand", hex: HEX.brand, role: "Akzent: Marker, Fortschritt, gefüllte Symbolkreise", against: HEX.dark, againstName: "--c-dark" },
  { name: "--c-dark", hex: HEX.dark, role: "Schrift, dunkle Bänder, Knopffüllung", against: HEX.grey, againstName: "--c-grey" },
  { name: "--c-taupe", hex: HEX.taupe, role: "Grund der Leistungs- und Geschichten-Section", against: HEX.dark, againstName: "--c-dark" },
  { name: "--c-grey", hex: HEX.grey, role: "Seitengrund", against: HEX.dark, againstName: "--c-dark" },
  { name: "--c-neutral-800", hex: HEX["neutral-800"], role: "Schrift auf hellen Flächen (Formular, Magazin)", against: HEX["neutral-200"], againstName: "--c-neutral-200" },
  { name: "--c-neutral-200", hex: HEX["neutral-200"], role: "Flächen: Karten, Eingabefelder", against: HEX["neutral-800"], againstName: "--c-neutral-800" },
];

/* Abgeleitete Töne.

   Die Kontrastwerte hier waren bis zum 02.09.2026 feste Zahlen im Quelltext,
   obwohl der Seitenkopf verspricht, sie seien gerechnet. Genau das ging schief:
   Der Taupe-Wert stand auf 4,55:1, weil das Token einmal auf 81 % gestanden
   hatte. Bei den heutigen 82 % sind es 4,68:1. Jetzt rechnet dieselbe Formel
   wie oben, und die Deckung steht nur noch an einer Stelle. */
const mix = (fg: string, bg: string, p: number) => {
  const [F, B] = [channels(fg), channels(bg)];
  return "#" + [0, 1, 2].map((i) => Math.round(F[i] * p + B[i] * (1 - p)).toString(16).padStart(2, "0")).join("");
};

const DERIVED = [
  { name: "--c-text-muted", cover: 0.75, on: HEX.grey, onName: "--c-grey", ink: HEX.dark, purpose: "Nebentext auf Grau" },
  { name: "--c-text-muted (Taupe)", cover: 0.82, on: HEX.taupe, onName: "--c-taupe", ink: HEX.dark, purpose: "Nebentext auf Taupe" },
  { name: "--c-text-muted (dunkel)", cover: 0.65, on: HEX.dark, onName: "--c-dark", ink: HEX.grey, purpose: "Nebentext auf Braun" },
  { name: "--c-line", cover: 0.28, on: HEX.grey, onName: "--c-grey", ink: HEX.dark, purpose: "Trennlinien - Schmuck, kein Bedienelement", decoration: true },
].map((a) => ({ ...a, value: contrast(mix(a.ink, a.on, a.cover), a.on) }));

/* Die vollständige Leiter, lückenlos von 283 px bis 11 px. Bis zum 02.09.2026
   standen hier neun Stufen, während die Seiten 26 verschiedene Grade
   rendersten - 16 davon auf keiner Skala, verteilt auf 48 eigene
   font-size-Regeln. Die Zwischenstufen sind nicht neu erfunden: Jede
   übernimmt den Wert, den die Homepage an dieser Stelle schon hatte. */
const SIZES = [
  { token: "--fs-display-xl", figma: "283 px", purpose: "Konturschrift im Standort-Ring", text: "Berlin" },
  { token: "--fs-display", figma: "250 px", purpose: "Wortmarke im Hero", text: "Mund" },
  { token: "--fs-display-lg", figma: "200 px", purpose: "Wortmarke des Magazins", text: "Magazin" },
  { token: "--fs-display-md", figma: "144 px", purpose: "Geschichten, Personenseite", text: "Anna" },
  { token: "--fs-display-2", figma: "125 px", purpose: "Konturzahlen der Standorte", text: "P25" },
  { token: "--fs-display-sm", figma: "90 px", purpose: "Magazinkopf, Team, Praxis, Kennzahlen", text: "24" },
  { token: "--fs-h1", figma: "70 px", purpose: "Seitentitel der Leistungsseiten", text: "Veneers" },
  { token: "--fs-h1-sm", figma: "64 px", purpose: "Experten, Preise, Ablauf", text: "Unsere Experten" },
  { token: "--fs-h1-xs", figma: "55 px", purpose: "Galeriekopf, Geschichte", text: "Unsere Standorte" },
  { token: "--fs-h2-lg", figma: "48 px", purpose: "Panel, Merkmale", text: "Vier Tage Woche" },
  { token: "--fs-h2", figma: "40 px", purpose: "Überschrift einer Section", text: "Unsere Standorte" },
  { token: "--fs-h2-sm", figma: "36 px", purpose: "Einleitung, Statement", text: "Eine volle Stunde" },
  { token: "--fs-h4", figma: "32 px", purpose: "Inhaltsverzeichnis, Stellen, Preise", text: "Zahnreinigung" },
  { token: "--fs-h4-sm", figma: "28 px", purpose: "Vorteile, Zeitleiste, Werte", text: "Eigenes Meisterlabor" },
  { token: "--fs-h5", figma: "24 px", purpose: "Meta-Zeilen im Hero", text: "Zahnarzt Prenzlauer Berg" },
  { token: "--fs-text-large", figma: "20 px", purpose: "Einleitungstexte", text: "Wir nehmen uns eine volle Stunde." },
  { token: "--fs-text-main", figma: "18 px", purpose: "Fließtext", text: "Sechs Behandlungsräume, eigenes Meisterlabor im Haus." },
  { token: "--fs-text-small", figma: "16 px", purpose: "Toplines, Beschriftungen", text: "Prenzlauer Berg" },
  { token: "--fs-label-lg", figma: "14 px", purpose: "Knopfbeschriftung", text: "Termin buchen" },
  { token: "--fs-label-md", figma: "13 px", purpose: "Navigation, Meta-Zeilen", text: "Leistungen" },
  { token: "--fs-label", figma: "12 px", purpose: "Kleinstbeschriftungen", text: "Ab 690 € je Zahn" },
  { token: "--fs-micro", figma: "11 px", purpose: "Fehlerzeichen, Badge auf Schmalgerät", text: "4,9 von 5" },
];

/* `--fs-h3` ist ein Alias auf `--fs-h2` und steht deshalb nicht als eigene
   Stufe in der Leiter. */

const LINE_HEIGHTS = [
  { token: "--lh-display", value: "0.92", purpose: "Wortmarken - die Zeilen sollen sich berühren" },
  { token: "--lh-tight", value: "1", purpose: "Einzeilige Konturzahlen" },
  { token: "--lh-heading", value: "1.1", purpose: "Überschriften" },
  { token: "--lh-body", value: "1.5", purpose: "Fließtext" },
];

const TRACKING = [
  { token: "--tracking-display", value: "-0.02em", purpose: "Große Grade laufen enger, sonst zerfallen sie" },
  { token: "--tracking-mono", value: "0.04em", purpose: "Gesperrte Mono-Beschriftungen" },
];

const SPACING = ["--sp-1", "--sp-2", "--sp-3", "--sp-4", "--sp-5", "--sp-6", "--sp-8", "--sp-10", "--sp-12", "--sp-16"];
const FLOW = [
  { token: "--flow-sm", value: "24 - 56 px", purpose: "Enge Reihen, Fußzeilen" },
  { token: "--flow-md", value: "32 - 72 px", purpose: "Spalten nebeneinander" },
  { token: "--flow-lg", value: "40 - 96 px", purpose: "Kartenraster" },
  { token: "--flow-xl", value: "56 - 120 px", purpose: "Kopf einer Section zum Inhalt" },
  { token: "--flow-2xl", value: "64 - 150 px", purpose: "Der große Absatz innerhalb einer Section" },
];

const LAYOUT = [
  { token: "--site-margin", value: "16 - 48 px", purpose: "Seitenrand links und rechts" },
  { token: "--site-gutter", value: "16 - 32 px", purpose: "Spaltenabstand im Raster" },
  { token: "--site-max", value: "1728 px", purpose: "Größte Satzbreite, danach wächst nichts mehr" },
  { token: "--grid-cols", value: "12", purpose: "Spalten des Rasters" },
  { token: "--mw-wide", value: "1100 px", purpose: "Breite Medienblöcke: Vorher/Nachher, Bühne" },
  { token: "--mw-panel", value: "353 px", purpose: "Textmaß in der dunklen Panel-Spalte" },
];

const SHADOWS = [
  { token: "--shadow-bar", purpose: "Die schwebende Leiste" },
  { token: "--shadow-panel", purpose: "Panel über der Seite" },
  { token: "--shadow-card", purpose: "Karten im Raster" },
  { token: "--shadow-handle", purpose: "Griff im Vorher/Nachher-Regler" },
  { token: "--shadow-handle-active", purpose: "Derselbe Griff, angefasst" },
];

const LAYERS = [
  { token: "--z-base", value: "1", purpose: "Grundebene" },
  { token: "--z-sticky", value: "50", purpose: "Mitlaufende Elemente" },
  { token: "--z-nav", value: "100", purpose: "Navigation" },
  { token: "--z-overlay", value: "200", purpose: "Menü, Overlays" },
  { token: "--z-cursor", value: "300", purpose: "Zeiger" },
  { token: "--z-skiplink", value: "400", purpose: "Sprung zum Inhalt - muss über allem liegen" },
];

const RADII = ["--r-sm", "--r-md", "--r-lg", "--r-xl", "--r-dock", "--r-round"];
const CURVES = [
  { token: "--e-out", purpose: "Standard. Schnell los, lange auslaufend." },
  { token: "--e-swift", purpose: "Kurze Zustandswechsel: Farbe, Deckkraft." },
  { token: "--e-ambient", purpose: "Endlose Dauerschleife - Faden, Zahnlinien." },
];
const DURATIONS = [
  { token: "--d-fast", value: "0.25 s", purpose: "Farbwechsel beim Überfahren" },
  { token: "--d-base", value: "0.45 s", purpose: "Standard für Bewegung" },
  { token: "--d-slow", value: "0.8 s", purpose: "Aufklappen, Umblenden" },
];

const SYMBOLS = ["i-arrow", "i-chevron", "i-filter", "i-star", "i-upload", "i-instagram", "i-facebook", "i-linkedin", "i-youtube", "i-x", "i-logo"];

const SAMPLE_QUESTIONS = [
  { question: "Wie bekomme ich einen Termin?", answer: "Über das Formular, telefonisch oder per Mail. Für Erstberatungen planen wir eine volle Stunde ein." },
  { question: "Behandeln Sie gesetzlich Versicherte?", answer: "Ja. Die Regelleistungen rechnen wir über die Kasse ab." },
];

const formatNumber = (n: number) => n.toLocaleString("de-DE", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
---

<Design title="Styleguide" active="styleguide">
  <section class="d-section">
    <div class="d-section__header">
      <span class="d-section__number">00</span>
      <h1 class="d-section__title">Styleguide</h1>
      <p class="d-section__text">
        Die Grundlagen der Seite: Farben, Typografie, Abstände, Radien und
        Bewegung - dazu die kleinen Bausteine, aus denen alles Übrige
        zusammengesetzt ist. Jeder Wert kommt aus <code>src/styles/tokens.css</code>
        und wird hier gezogen, nicht abgeschrieben. Die zusammengesetzten
        Bausteine stehen auf der <a class="c-link" href="/design/komponenten">Komponenten-Seite</a>.
      </p>
    </div>
  </section>

  {/* ---------------------------------------------------------------- */}
  <section class="d-section">
    <div class="d-section__header">
      <span class="d-section__number">01</span>
      <h2 class="d-section__title">Farben</h2>
      <p class="d-section__text">
        Sechs Farben tragen die Gestaltung; dazu kommen Weiß und Schwarz als
        Werkzeug, für Eingabefelder und Verläufe. Daneben steht das gemessene
        Kontrastverhältnis gegen den Grund, auf dem die Farbe tatsächlich
        vorkommt - WCAG&nbsp;AA verlangt 4,5:1 für Fließtext, 3:1 für große
        Schrift und für Bedienelemente.
      </p>
    </div>

    <div class="d-sample">
      <div class="d-grid">
        {COLORS.map((f) => {
          const v = contrast(f.hex, f.against);
          return (
            <div class="d-color">
              <div class="d-color__swatch" style={`background: ${f.hex}`}></div>
              <p class="d-color__name">{f.name}</p>
              <p class="d-color__hex">{f.hex}</p>
              <p class="d-color__role">{f.role}</p>
              <p class="d-color__value">
                {formatNumber(v)}:1 auf <code>{f.againstName}</code>
                {" "}
                <span class={v >= 4.5 ? "d-marker d-marker--good" : v >= 3 ? "d-marker d-marker--partial" : "d-marker d-marker--weak"}>
                  {v >= 4.5 ? "Fließtext" : v >= 3 ? "nur groß" : "nur Fläche"}
                </span>
              </p>
            </div>
          );
        })}
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Abgeleitete Töne</span>
        <span class="d-sample__path">src/styles/tokens.css</span>
      </div>
      <p class="d-sample__text">
        Nebentext entsteht nicht aus einer eigenen Farbe, sondern aus der
        Schriftfarbe mit verringerter Deckung. Die Deckungswerte sind gerechnet:
        Taupe ist dunkler als Grau und braucht deshalb mehr.
      </p>
      <table class="d-table">
        <thead>
          <tr><th>Token</th><th>Regel</th><th>Zweck</th><th>Kontrast</th></tr>
        </thead>
        <tbody>
          {DERIVED.map((a) => (
            <tr>
              <td><code>{a.name}</code></td>
              <td>
                <code>{a.ink === HEX.grey ? "--c-grey" : "--c-dark"}</code>
                {` auf ${Math.round(a.cover * 100)} %`}
              </td>
              <td>{a.purpose}</td>
              <td>
                {formatNumber(a.value)}:1
                {" "}
                <span class={a.decoration ? "d-marker d-marker--weak" : a.value >= 4.5 ? "d-marker d-marker--good" : "d-marker d-marker--partial"}>
                  {a.decoration ? "Schmuck" : a.value >= 4.5 ? "Fließtext" : "nur groß"}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {/* ---------------------------------------------------------------- */}
  <section class="d-section">
    <div class="d-section__header">
      <span class="d-section__number">02</span>
      <h2 class="d-section__title">Typografie</h2>
      <p class="d-section__text">
        Zwei Schriften. PP Neue Montreal trägt alles Gesetzte, GT Pressura Mono
        alles Beschriftende - Toplines, Preise, Kleinstangaben. Die Skala ist
        fluid: die Figma-Werte gelten bei 1728&nbsp;px Fensterbreite, darunter
        und darüber rechnet <code>clamp()</code> weiter.
      </p>
    </div>

    <div class="d-sample">
      <div class="d-sample__header"><span class="d-sample__name">Schriften</span></div>
      <div class="d-grid">
        <div class="d-stage">
          <p class="d-font-name">--f-sans · PP Neue Montreal</p>
          <p class="d-font-sample" style="font-family: var(--f-sans)">AaBbCc 0123</p>
          <p class="d-font-sample" style="font-family: var(--f-sans); font-weight: 500">Medium 500</p>
        </div>
        <div class="d-stage">
          <p class="d-font-name">--f-mono · GT Pressura Mono</p>
          <p class="d-font-sample" style="font-family: var(--f-mono); font-weight: 300">AaBbCc 0123</p>
          <p class="d-font-sample" style="font-family: var(--f-mono); font-weight: 300; text-transform: uppercase; letter-spacing: 0.08em">Light 300 gesperrt</p>
        </div>
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header"><span class="d-sample__name">Zeilenhöhe und Laufweite</span></div>
      <p class="d-sample__text">
        Beide gehören zur Skala und standen bis zum 02.09.2026 nicht auf dieser
        Seite. Bei der Laufweite ist das nicht folgenlos geblieben: Neben den
        zwei Token stehen im Bestand zwölf ausgeschriebene Werte an 115 Stellen,
        27 davon schreiben genau den Wert aus, den ein Token schon hält.
      </p>
      <table class="d-table">
        <thead><tr><th>Token</th><th>Wert</th><th>Zweck</th></tr></thead>
        <tbody>
          {[...LINE_HEIGHTS, ...TRACKING].map((a) => (
            <tr><td><code>{a.token}</code></td><td>{a.value}</td><td>{a.purpose}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="d-sample">
      <div class="d-sample__header"><span class="d-sample__name">Skala</span></div>
      {SIZES.map((g) => (
        <div class="d-size">
          <div class="d-size__meta">
            <code>{g.token}</code>
            <span>{g.figma}</span>
            <span class="d-size__purpose">{g.purpose}</span>
          </div>
          <p class="d-size__sample" style={`font-size: var(${g.token})`}>{g.text}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ---------------------------------------------------------------- */}
  <section class="d-section">
    <div class="d-section__header">
      <span class="d-section__number">03</span>
      <h2 class="d-section__title">Abstände, Radien, Rahmen</h2>
      <p class="d-section__text">
        Die Abstandsskala wächst nicht linear - unten in Achterschritten, oben
        in Sprüngen. Abstände zwischen Sections haben eigene Token, weil sie
        mit der Fensterbreite mitwachsen müssen.
      </p>
    </div>

    <div class="d-sample">
      <div class="d-sample__header"><span class="d-sample__name">Abstände</span></div>
      {SPACING.map((t) => (
        <div class="d-space">
          <code class="d-space__name">{t}</code>
          <div class="d-space__bar" style={`width: var(${t})`}></div>
        </div>
      ))}
      <p class="d-sample__text" style="margin-top: var(--sp-4)">
        Dazu drei fluide Werte für den Abstand zwischen Sections:
        <code>--section-space</code> als Regelfall,
        <code>--section-space-sm</code> wenn direkt darunter eine Farbfläche
        anschließt, und <code>--section-space-lg</code> für den großen Absatz.
      </p>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Fluide Abstände innerhalb einer Section</span>
        <span class="d-sample__path">--flow-*</span>
      </div>
      <p class="d-sample__text">
        Eine Ebene unter <code>--section-space</code>. Die feste Skala oben kann
        das nicht leisten - sie ist bewusst starr, diese Abstände sollen mit dem
        Fenster wachsen. Bis zum 02.09.2026 brachte fast jeder Baustein dafür
        seine eigene <code>clamp()</code>-Rampe mit, rund 78 Stück: sieben
        endeten auf 96&nbsp;px, vier auf 72, vier auf 56, jeweils mit anderem
        Startwert, ohne dass der Unterschied etwas bedeutet hätte.
      </p>
      <table class="d-table">
        <thead><tr><th>Token</th><th>Wert</th><th>Zweck</th></tr></thead>
        <tbody>
          {FLOW.map((a) => (
            <tr><td><code>{a.token}</code></td><td>{a.value}</td><td>{a.purpose}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="d-sample">
      <div class="d-sample__header"><span class="d-sample__name">Layout</span></div>
      <p class="d-sample__text">
        Die Maße der Seite selbst. <code>--site-margin</code> und
        <code>--site-gutter</code> sind die meistbenutzten Token des Projekts
        und standen bis zum 02.09.2026 auf keiner Tafel.
      </p>
      <table class="d-table">
        <thead><tr><th>Token</th><th>Wert</th><th>Zweck</th></tr></thead>
        <tbody>
          {LAYOUT.map((a) => (
            <tr><td><code>{a.token}</code></td><td>{a.value}</td><td>{a.purpose}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="d-sample">
      <div class="d-sample__header"><span class="d-sample__name">Radien</span></div>
      <div class="d-stage d-stage--row">
        {RADII.map((r) => (
          <div class="d-radius">
            <div class="d-radius__field" style={`border-radius: var(${r})`}></div>
            <code>{r}</code>
          </div>
        ))}
      </div>
      <p class="d-sample__text" style="margin-top: var(--sp-4)">
        Rahmenstärke ist <code>--bw</code> (1&nbsp;px), überall bis auf fünf
        Stellen. Die sind Gestaltung und kein Versehen: 10&nbsp;px um die
        Promokachel der Navigation, 2&nbsp;px als Markierung an Zeitleiste,
        Stellenliste und Personenzitat, 1,5&nbsp;px an der Auswahl im Formular.
        Bis zum 02.09.2026 stand hier, es gebe „keine zweite" - dabei waren es
        schon damals vier verschiedene, und acht weitere Stellen schrieben
        <code>1px</code> aus, statt das Token zu nehmen. Wer eine sechste
        einführt, sollte sie hier eintragen können. Sonst ist es keine.
      </p>
    </div>
  </section>

  {/* ---------------------------------------------------------------- */}
  <section class="d-section">
    <div class="d-section__header">
      <span class="d-section__number">04</span>
      <h2 class="d-section__title">Bewegung</h2>
      <p class="d-section__text">
        Eine gemeinsame Sprache für CSS und GSAP. Die Kurven laufen lang aus
        und federn nie zurück. Zum Ausprobieren die Felder überfahren.
      </p>
    </div>

    <div class="d-sample">
      <div class="d-sample__header"><span class="d-sample__name">Kurven</span></div>
      {CURVES.map((k) => (
        <div class="d-curve">
          <div class="d-curve__meta">
            <code>{k.token}</code>
            <span class="d-size__purpose">{k.purpose}</span>
          </div>
          <div class="d-curve__track">
            <span class="d-curve__ball" style={`transition-timing-function: var(${k.token})`}></span>
          </div>
        </div>
      ))}
    </div>

    <div class="d-sample">
      <div class="d-sample__header"><span class="d-sample__name">Dauern</span></div>
      <table class="d-table">
        <thead><tr><th>Token</th><th>Wert</th><th>Zweck</th></tr></thead>
        <tbody>
          {DURATIONS.map((d) => (
            <tr><td><code>{d.token}</code></td><td>{d.value}</td><td>{d.purpose}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {/* ---------------------------------------------------------------- */}
  <section class="d-section">
    <div class="d-section__header">
      <span class="d-section__number">05</span>
      <h2 class="d-section__title">Knöpfe und Links</h2>
      <p class="d-section__text">
        Der Knopf ist zweiteilig: Pille mit Beschriftung, abgesetzt daneben der
        runde Pfeil. Beim Überfahren rückt der Pfeil nach rechts ab - der Knopf
        öffnet sich in Leserichtung. Das ist die einzige Rückmeldung, und zwar
        mit Absicht: Vorher kippte zusätzlich die Farbe um, und der Farbsprung
        übertönte das feinere Signal. Beim Klick sinken Bedienelemente leicht
        ein, mit einer Ausnahme - Akkordeons tun es nicht, eine ganze Zeile, die
        beim Aufklappen zusammenzuckt, wirkt wie ein Ruckeln.
      </p>
      <p class="d-section__text">
        Bis zum 02.09.2026 stand hier, beim Überfahren kehrten „beide Teile ihre
        Farben um". Das war seit dem Umbau des Knopfs nicht mehr wahr.
      </p>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Varianten</span>
        <span class="d-sample__path">components/ui/Button.astro</span>
      </div>
      <div class="d-stage d-stage--row">
        <Button label="Termin buchen" href="#" />
        <Button label="Dunkel" href="#" variant="dark" />
        <Button label="Absenden" type="submit" />
      </div>
      <div class="d-stage d-stage--dark" style="margin-top: var(--sp-4)">
        <div class="d-stage--row" style="display:flex; flex-wrap:wrap; gap: var(--sp-4)">
          <Button label="Auf dunklem Grund" href="#" />
          <Button label="Block" href="#" variant="block" />
        </div>
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header"><span class="d-sample__name">Textlink und Topline</span></div>
      <div class="d-stage">
        <p style="margin-bottom: var(--sp-4)"><a class="c-link" href="#">Ein Textlink</a> im Fließtext.</p>
        <span class="c-topline">Vorher &amp; Nachher</span>
      </div>
      <p class="d-sample__text" style="margin-top: var(--sp-4)">
        Die Topline erbt ihre Farbe von der Section, sie setzt keine eigene -
        sonst stünde sie auf dem braunen Band dunkel auf dunkel.
      </p>
    </div>
  </section>

  {/* ---------------------------------------------------------------- */}
  <section class="d-section">
    <div class="d-section__header">
      <span class="d-section__number">06</span>
      <h2 class="d-section__title">Flächen und Formularelemente</h2>
      <p class="d-section__text">
        Alles, was Inhalt trägt oder Eingaben entgegennimmt.
      </p>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Akkordeon</span>
        <span class="d-sample__path">components/ui/Accordion.astro</span>
      </div>
      <div class="d-stage">
        <Accordion questions={SAMPLE_QUESTIONS} />
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header"><span class="d-sample__name">Eingabefelder</span></div>
      <div class="d-stage d-form">
        <div class="c-field">
          <label class="c-field__label" for="sg-name">Name <span>*</span></label>
          <div class="c-field__control">
            <input id="sg-name" type="text" placeholder="Ihr Name" autocomplete="name" />
          </div>
        </div>
        <div class="c-field">
          <label class="c-field__label" for="sg-mail">E-Mail-Adresse <span>*</span></label>
          <div class="c-field__control">
            <input id="sg-mail" type="email" placeholder="name@beispiel.de" autocomplete="email" />
          </div>
        </div>
        <div class="c-field c-field--tall">
          <label class="c-field__label" for="sg-msg">Nachricht</label>
          <div class="c-field__control">
            <textarea id="sg-msg" rows="4" placeholder="Worum geht es?"></textarea>
          </div>
        </div>
      </div>
      <p class="d-sample__text" style="margin-top: var(--sp-4)">
        Die Beschriftung steht über dem Feld und ist über <code>for</code> mit
        ihm verbunden - ein Platzhalter allein ist keine Beschriftung, er
        verschwindet beim Tippen.
      </p>
    </div>
  </section>

  {/* ---------------------------------------------------------------- */}
  <section class="d-section">
    <div class="d-section__header">
      <span class="d-section__number">07</span>
      <h2 class="d-section__title">Symbole</h2>
      <p class="d-section__text">
        Ein einziges SVG-Sprite, einmal im Dokument, überall per
        <code>&lt;use href="#i-…"&gt;</code> aufgerufen. Die Symbole erben
        <code>currentColor</code>, sie tragen keine eigene Farbe.
      </p>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Sprite</span>
        <span class="d-sample__path">components/ui/Icons.astro</span>
      </div>
      <div class="d-grid">
        {SYMBOLS.map((s) => (
          <div class="d-symbol">
            <svg aria-hidden="true"><use href={`#${s}`} /></svg>
            <code>{s}</code>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- */}
  <section class="d-section">
    <div class="d-section__header">
      <span class="d-section__number">08</span>
      <h2 class="d-section__title">Schatten, Körnung, Ebenen</h2>
      <p class="d-section__text">
        Der Rest des Systems. Diese drei Gruppen standen bis zum 02.09.2026 auf
        keiner Tafel, obwohl sie an 19 Stellen im Einsatz sind - ein Styleguide,
        der ein Drittel seiner eigenen Token nicht kennt, beschreibt nicht die
        Seite, sondern einen Ausschnitt davon.
      </p>
    </div>

    <div class="d-sample">
      <div class="d-sample__header"><span class="d-sample__name">Schatten</span></div>
      <p class="d-sample__text">
        Die einzigen Stellen, an denen etwas eine Fläche über einer anderen
        wirft. Die Farbe ist immer <code>--c-dark</code>, nie reines Schwarz.
      </p>
      <div class="d-stage d-stage--row" style="flex-wrap: wrap; gap: var(--sp-6)">
        {SHADOWS.map((s) => (
          <div class="d-radius">
            <div class="d-shadow-probe" style={`box-shadow: var(${s.token})`}></div>
            <code>{s.token}</code>
            <p class="d-size__purpose" style="margin-top: var(--sp-1)">{s.purpose}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header"><span class="d-sample__name">Körnung</span></div>
      <p class="d-sample__text">
        Die Papierstruktur, die <code>ui/Backdrop.astro</code> über die Seite
        legt. Zwei Deckkraftwerte, weil eine Fläche mit eigenem deckenden Grund
        die Körnung anders trifft als der Seitengrund:
        <code>--grain-opacity</code> (0,34) für die Auflage,
        <code>--grain-opacity-surface</code> (0,17) für Flächen, die sie selbst
        mitbringen müssen. Das Bild steht als <code>--grain-image</code> bereit.
      </p>
      <div class="d-stage d-stage--row">
        <div class="d-grain d-grain--page"><span>Seitengrund</span></div>
        <div class="d-grain d-grain--surface"><span>Eigene Fläche</span></div>
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header"><span class="d-sample__name">Ebenen</span></div>
      <table class="d-table">
        <thead><tr><th>Token</th><th>Wert</th><th>Zweck</th></tr></thead>
        <tbody>
          {LAYERS.map((a) => (
            <tr><td><code>{a.token}</code></td><td>{a.value}</td><td>{a.purpose}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="d-sample__text" style="margin-top: var(--sp-4)">
        Der Sprung zum Inhalt liegt bewusst über der Navigation. Bei Gleichstand
        gewinnt das später gezeichnete Element - er stand einmal auf derselben
        Ebene wie die Leiste und war dadurch halb verdeckt.
      </p>
    </div>
  </section>

  <style is:global>
    /* --- Farbkacheln --- */
    .d-color__swatch {
      height: 96px;
      margin-bottom: var(--sp-3);
      border: var(--bw) solid var(--c-line);
      border-radius: var(--r-sm);
    }

    .d-color__name {
      font-family: var(--f-mono);
      font-size: var(--fs-text-small);
    }

    .d-color__hex,
    .d-color__role,
    .d-color__value {
      font-size: var(--fs-text-small);
      line-height: 1.45;
      color: var(--c-text-muted);
    }

    .d-color__role {
      margin-block: var(--sp-1);
    }

    /* Nicht nur farbig, sondern beschriftet: eine Ampel allein sagt denen
       nichts, die die Farbe nicht unterscheiden (WCAG 1.4.1). */
    .d-marker {
      display: inline-block;
      padding: 0.1em 0.5em;
      border-radius: var(--r-sm);
      font-family: var(--f-mono);
      font-size: var(--fs-label);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .d-marker--good { background: var(--c-dark); color: var(--c-grey); }
    .d-marker--partial { background: var(--c-brand); color: var(--c-dark); }
    .d-marker--weak { background: transparent; border: var(--bw) solid var(--c-line); color: var(--c-text); }

    /* --- Tabellen --- */
    .d-table {
      width: 100%;
      border-collapse: collapse;
      font-size: var(--fs-text-small);
      text-align: left;
    }

    .d-table th,
    .d-table td {
      padding: var(--sp-2) var(--sp-3) var(--sp-2) 0;
      border-bottom: var(--bw) solid var(--c-line);
      vertical-align: top;
    }

    .d-table th {
      font-family: var(--f-mono);
      font-weight: 300;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .d-table td:not(:first-child) {
      color: var(--c-text-muted);
    }

    /* --- Schrift- und Gradproben --- */
    .d-font-name {
      margin-bottom: var(--sp-3);
      font-family: var(--f-mono);
      font-size: var(--fs-label);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--c-text-muted);
    }

    .d-font-sample {
      font-size: var(--fs-h2);
      line-height: 1.2;
    }

    .d-size {
      padding-block: var(--sp-4);
      border-top: var(--bw) solid var(--c-line);
    }

    .d-size__meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2) var(--sp-4);
      margin-bottom: var(--sp-2);
      font-family: var(--f-mono);
      font-size: var(--fs-label);
      letter-spacing: 0.04em;
      color: var(--c-text-muted);
    }

    .d-size__purpose {
      text-transform: none;
    }

    /* Überlauf erlaubt: die großen Grade sind breiter als das Fenster, und
       genau das sollen sie zeigen. Abgeschnitten wären sie eine Lüge über
       ihre Größe — deshalb scrollt die Zeile für sich. */
    .d-size__sample {
      overflow-x: auto;
      font-weight: 500;
      line-height: 1.05;
      white-space: nowrap;
    }

    /* --- Abstände und Radien --- */
    .d-space {
      display: flex;
      align-items: center;
      gap: var(--sp-4);
      padding-block: var(--sp-1);
    }

    .d-space__name {
      flex: 0 0 7ch;
      font-size: var(--fs-label);
      color: var(--c-text-muted);
    }

    .d-space__bar {
      height: 14px;
      border-radius: var(--r-sm);
      background: var(--c-dark);
    }

    .d-radius {
      text-align: center;
      font-size: var(--fs-label);
    }

    .d-radius__field {
      width: 88px;
      height: 88px;
      margin-bottom: var(--sp-2);
      border: var(--bw) solid var(--c-line);
      background: var(--c-dark);
    }

    /* --- Bewegungskurven --- */
    .d-curve {
      padding-block: var(--sp-4);
      border-top: var(--bw) solid var(--c-line);
    }

    .d-curve__meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2) var(--sp-4);
      margin-bottom: var(--sp-3);
      font-family: var(--f-mono);
      font-size: var(--fs-label);
      color: var(--c-text-muted);
    }

    .d-curve__track {
      position: relative;
      height: 32px;
      border-radius: var(--r-round);
      background: var(--c-tint);
    }

    .d-curve__ball {
      position: absolute;
      top: 4px;
      left: 4px;
      width: 24px;
      height: 24px;
      border-radius: var(--r-round);
      background: var(--c-brand);
      transition-property: translate;
      transition-duration: var(--d-slow);
    }

    .d-curve:hover .d-curve__ball,
    .d-curve:focus-within .d-curve__ball {
      translate: calc(100cqw - 32px) 0;
    }

    .d-curve__track {
      container-type: inline-size;
    }

    @media (prefers-reduced-motion: reduce) {
      .d-curve__ball {
        transition-duration: 0s;
      }
    }

    /* --- Formular --- */
    .d-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-4);
    }

    @media (max-width: 700px) {
      .d-form {
        grid-template-columns: 1fr;
      }
    }

    /* Die Feldregeln liegen in Contact.astro und sind dort abgegrenzt — auf
       dieser Seite gibt es sie nicht. Hier stehen deshalb nur die nötigsten,
       bewusst als Nachbau gekennzeichnet. */
    .d-form .c-field__label {
      display: block;
      margin-bottom: var(--sp-1);
      font-family: var(--f-mono);
      font-weight: 300;
      font-size: var(--fs-text-small);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--c-neutral-800);
    }

    /* Wie in Contact.astro: der Pflichtstern trägt die Farbe der
       Beschriftung. Pink erreicht bei dieser Größe auf hellem Grund keine
       4.5:1 und wäre als Text unzulässig. */
    .d-form .c-field__label span {
      color: inherit;
    }

    .d-form input,
    .d-form textarea {
      width: 100%;
      padding: var(--sp-3) var(--sp-4);
      border: var(--bw) solid var(--c-line);
      border-radius: var(--r-sm);
      background: var(--c-white);
      font-family: var(--f-sans);
      font-size: var(--fs-text-main);
      color: var(--c-neutral-800);
    }

    .d-form .c-field--tall {
      grid-column: 1 / -1;
    }

    /* --- Schatten und Körnung --- */
    .d-shadow-probe {
      width: 120px;
      height: 72px;
      margin-bottom: var(--sp-2);
      border-radius: var(--r-md);
      background: var(--c-neutral-200);
    }

    .d-grain {
      position: relative;
      display: grid;
      place-items: center;
      width: 180px;
      height: 96px;
      border-radius: var(--r-md);
      background: var(--c-dark);
      color: var(--c-grey);
      font-family: var(--f-mono);
      font-size: var(--fs-label);
      overflow: hidden;
    }

    .d-grain::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image: var(--grain-image);
      pointer-events: none;
    }

    .d-grain--page::after { opacity: var(--grain-opacity); }
    .d-grain--surface::after { opacity: var(--grain-opacity-surface); }

    .d-grain span { position: relative; z-index: 1; }

    /* --- Symbole --- */
    .d-symbol {
      display: flex;
      align-items: center;
      gap: var(--sp-3);
      padding: var(--sp-3);
      border: var(--bw) solid var(--c-line);
      border-radius: var(--r-sm);
      font-size: var(--fs-label);
    }

    .d-symbol svg {
      width: 24px;
      height: 24px;
      flex: 0 0 auto;
    }
  </style>
</Design>
