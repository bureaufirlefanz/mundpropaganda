<Design title="Styleguide" active="styleguide">
  <section class="d-section">
    <div class="d-section__header">
      <span class="d-section__number">00</span>
      <h1 class="d-section__title">Styleguide</h1>
      <p class="d-section__text">
        Die Grundlagen der Seite in drei Schichten, genau wie in <code
          >src/styles/tokens.css</code
        >: <strong>Grundwerte</strong>, woraus die Gestaltung besteht. <strong
          >Rollen</strong
        >, wofür ein Wert da ist. <strong>Flächen</strong>, ein Attribut, das
        die Farbrollen für alles darin umstellt. Bausteine greifen zu Rollen;
        die Grundwerte stehen hier, damit man sieht, woraus die Rollen gemacht
        sind. Die zusammengesetzten Bausteine stehen auf der <a
          href="/design/komponenten">Komponenten-Seite</a
        >.
      </p>
      <p class="d-section__text">
        Nichts auf dieser Seite ist abgeschrieben. Sie liest tokens.css beim
        Bauen: Werte, Rollen, Flächen und die Kontraste daraus. Auch „Verwendet
        in" ist gezählt und nicht gepflegt, über {scannedFiles} Quelldateien unter
        <code>web/src</code>, ohne die Design-Seiten selbst. „Steckt in" nennt
        die Rollen und Flächen, die einen Grundwert weitertragen.
      </p>
    </div>

    <div class="d-sample">
      <nav class="d-contents" aria-label="Inhalt des Styleguides">
        {
          CONTENTS.map((part, i) => (
            <div class="d-contents__part">
              <a class="d-contents__head" href={`#${part.id}`}>
                {i + 1} · {part.title}
              </a>
              <ul class="d-contents__list">
                {part.children.map((c) => (
                  <li>
                    <a href={`#${c.id}`}>{c.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    {
      unused.length || uncovered.length ? (
        <div class="d-sample">
          {unused.length ? (
            <div class="d-note">
              <p>
                <strong>
                  {unused.length === 1
                    ? "Ein Token wird"
                    : `${unused.length} Token werden`}{" "}
                  nirgends verwendet:
                </strong>{" "}
                {unused.map((t, i) => (
                  <>
                    {i > 0 && ", "}
                    <code>{t}</code>
                  </>
                ))}
                . Weder ein Baustein noch eine Rolle greift darauf zu.
              </p>
            </div>
          ) : null}
          {uncovered.length ? (
            <div class="d-note">
              <p>
                <strong>Auf dieser Seite nicht einsortiert:</strong>{" "}
                {uncovered.map((t, i) => (
                  <>
                    {i > 0 && ", "}
                    <code>{t}</code>
                  </>
                ))}
                . Der Name passt in keine Gruppe; entweder die Gruppe in
                <code>pages/design/styleguide.astro</code> ergänzen oder den
                Namen prüfen.
              </p>
            </div>
          ) : null}
        </div>
      ) : null
    }
  </section>

  {/* ================= 1. Base values ================= */}
  <section class="d-section d-part" id="grundwerte" data-surface="dark">
    <div class="d-section__header">
      <span class="d-section__number">Teil 1</span>
      <h2 class="d-section__title">Grundwerte</h2>
      <p class="d-section__text">
        Woraus die Gestaltung besteht: Farben, Schriftgrade, Abstände, Radien,
        Bewegung. Diese Werte ändern sich selten, und ein Baustein greift
        möglichst nicht direkt zu ihnen, sondern zu einer Rolle.
      </p>
    </div>
  </section>

  {
    BASE_CHAPTERS.map((chapter) => (
      <section class="d-section" id={chapter.id}>
        <div class="d-section__header">
          <span class="d-section__number">{chapter.number}</span>
          <h3 class="d-section__title">{chapter.title}</h3>
          <p class="d-section__text" set:html={chapter.text} />
        </div>

        {chapter.special === "colours" && (
          <div class="d-sample">
            <div class="d-grid">
              {COLORS.map((f) => (
                <div class="d-color">
                  <div
                    class="d-color__swatch"
                    style={`background: var(${f.name})`}
                  />
                  <p class="d-color__name">{f.name}</p>
                  <p class="d-color__hex">{f.hex}</p>
                  <p class="d-color__role">{f.role}</p>
                  <p class="d-color__value">
                    {ratio(f.value)} auf <code>{f.againstName}</code>{" "}
                    <span class={`d-marker d-marker--${f.rating.cls}`}>
                      {f.rating.cls === "weak" ? "nur Fläche" : f.rating.label}
                    </span>
                  </p>
                  <div class="d-usage" set:html={usageHtml(f.name)} />
                </div>
              ))}
            </div>
            {missingColours.length ? (
              <p class="d-sample__text d-gap-top">
                In tokens.css, aber noch ohne Kachel:{" "}
                {missingColours.join(", ")}. Den Wert in <code>HEX</code> und{" "}
                <code>COLORS</code> nachtragen.
              </p>
            ) : null}
          </div>
        )}

        {chapter.special === "fonts" && (
          <div class="d-sample">
            <div class="d-sample__header">
              <span class="d-sample__name">Schriften</span>
            </div>
            <div class="d-grid">
              <div class="d-stage">
                <p class="d-font-name">--f-sans · PP Neue Montreal</p>
                <p class="d-font-sample d-font-sample--sans">AaBbCc 0123</p>
                <p class="d-font-sample d-font-sample--sans d-font-sample--medium">
                  Medium 500
                </p>
              </div>
              <div class="d-stage">
                <p class="d-font-name">--f-mono · GT Pressura Mono</p>
                <p class="d-font-sample d-font-sample--mono">AaBbCc 0123</p>
                <p class="d-font-sample d-font-sample--mono d-font-sample--caps">
                  Light 300 gesperrt
                </p>
              </div>
            </div>
          </div>
        )}

        {chapter.special === "ladder" && (
          <>
            {typeGroups.map((group) => (
              <div class="d-sample">
                <div class="d-sample__header">
                  <span class="d-sample__name">{group.name}</span>
                  <span class="d-sample__path">{group.text}</span>
                </div>
                {group.tokens.map((t) => (
                  <div class="d-size">
                    <div class="d-size__meta">
                      <code>{t}</code>
                      <span>{sizeOf(t)}</span>
                      <span class="d-size__purpose">{purpose(t)}</span>
                    </div>
                    <p
                      class={`d-size__sample${group.name === "Display" || group.name === "Title" ? " d-size__sample--heavy" : ""}`}
                      style={`font-size: var(${t})`}
                    >
                      {SPECIMEN[t] ?? "Mundpropaganda"}
                    </p>
                    <div class="d-usage" set:html={usageHtml(t)} />
                  </div>
                ))}
              </div>
            ))}
            {legacy.length ? (
              <div class="d-sample">
                <div class="d-note">
                  <p>
                    <strong>Altlast, nur für den Prototyp.</strong> Die früheren
                    Namen stehen noch am Ende von tokens.css, weil der
                    archivierte Prototyp unter <code>prototypen/vite</code> sie
                    liest. Sie gehören nicht zur Leiter, und{" "}
                    <code>npm run check:css</code> lehnt sie in{" "}
                    <code>web/</code> ab.
                  </p>
                  <p class="d-legacy">
                    {legacy.map(([name, value]) => (
                      <span>
                        <code>{name}</code> → <code>{readable(value)}</code>
                      </span>
                    ))}
                  </p>
                </div>
              </div>
            ) : null}
          </>
        )}

        {chapter.samples.map((sample) => (
          <div class="d-sample">
            <div class="d-sample__header">
              <span class="d-sample__name">{sample.name}</span>
              <span class="d-sample__path">src/styles/tokens.css</span>
            </div>
            {sample.text && <p class="d-sample__text" set:html={sample.text} />}
            <table class="d-table">
              <thead>
                <tr>
                  <th scope="col">Token</th>
                  <th scope="col">Wert</th>
                  <th scope="col">Probe</th>
                  <th scope="col">Zweck</th>
                  <th scope="col">Verwendung</th>
                </tr>
              </thead>
              <tbody>
                {sample.rows.map((row) => (
                  <tr
                    class={
                      row.probe === "curve" || row.probe === "duration"
                        ? "d-motion-row"
                        : undefined
                    }
                  >
                    <td>
                      <code>{row.name}</code>
                    </td>
                    <td>
                      <code class="d-table__value">{row.value}</code>
                      {row.size && row.size !== row.value && (
                        <span class="d-table__size">{row.size}</span>
                      )}
                    </td>
                    <td class="d-table__probe">
                      {row.probe === "bar" && (
                        <span
                          class="d-probe-bar"
                          style={`width: var(${row.name})`}
                        />
                      )}
                      {row.probe === "lh" && (
                        <span
                          class="d-probe-lh"
                          style={`line-height: var(${row.name})`}
                        >
                          Zwei Zeilen
                          <br />
                          übereinander
                        </span>
                      )}
                      {row.probe === "tracking" && (
                        <span
                          class={`d-probe-tracking${row.name.includes("mono") || row.name.includes("wide") ? " d-probe-tracking--mono" : ""}`}
                          style={`letter-spacing: var(${row.name})`}
                        >
                          Mundpropaganda
                        </span>
                      )}
                      {row.probe === "radius" && (
                        <span
                          class="d-probe-radius"
                          style={`border-radius: var(${row.name})`}
                        />
                      )}
                      {row.probe === "shadow" && (
                        <span
                          class="d-probe-shadow"
                          style={`box-shadow: var(${row.name})`}
                        />
                      )}
                      {row.probe === "icon" && (
                        <span
                          class="d-probe-icon"
                          style={`width: var(${row.name}); height: var(${row.name})`}
                        >
                          <svg aria-hidden="true">
                            <use href="#i-arrow" />
                          </svg>
                        </span>
                      )}
                      {row.probe === "line" && <span class="d-probe-line" />}
                      {row.probe === "focus" && <span class="d-probe-focus" />}
                      {(row.probe === "curve" || row.probe === "duration") && (
                        <span class="d-curve__track">
                          <span
                            class="d-curve__ball"
                            style={
                              row.probe === "curve"
                                ? `transition-timing-function: var(${row.name})`
                                : `transition-duration: var(${row.name})`
                            }
                          />
                        </span>
                      )}
                    </td>
                    <td>{row.purpose}</td>
                    <td>
                      <div class="d-usage" set:html={usageHtml(row.name)} />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}

        {chapter.special === "measures" && (
          <div class="d-sample">
            <div class="d-sample__header">
              <span class="d-sample__name">Textmaße im Fließtext</span>
            </div>
            {measures.map((m) => (
              <div class="d-measure">
                <code>{m}</code>
                <p class="d-measure__text" style={`max-width: var(${m})`}>
                  Wir nehmen uns für jede Erstberatung eine volle Stunde. Du
                  siehst, was wir sehen, und entscheidest danach in Ruhe, ob und
                  wie behandelt wird.
                </p>
              </div>
            ))}
          </div>
        )}

        {chapter.special === "grain" && (
          <div class="d-sample">
            <div class="d-sample__header">
              <span class="d-sample__name">Körnung im Vergleich</span>
            </div>
            <p class="d-sample__text">
              Zwei Deckkraftwerte, weil eine Fläche mit eigenem deckendem Grund
              die Körnung anders trifft als der Seitengrund: Backdrop legt sie
              über eine durchsichtige Ebene und landet schwächer als dieselbe
              Deckkraft auf einer vollen Farbe.
            </p>
            <div class="d-stage d-stage--row">
              <div class="d-grain d-grain--page" data-surface="dark">
                <span>--grain-opacity</span>
              </div>
              <div class="d-grain d-grain--surface" data-surface="dark">
                <span>--grain-opacity-surface</span>
              </div>
            </div>
          </div>
        )}

        {chapter.special === "motion" && (
          <div class="d-sample">
            <div class="d-sample__header">
              <span class="d-sample__name">Bewegung im Markup</span>
              <span class="d-sample__path">src/js/modules</span>
            </div>
            <p class="d-sample__text">
              Die Module finden ihr Markup über <code>data-</code>-Attribute.
              Verbindlich ist, welches Attribut wofür steht:
            </p>
            <ul class="d-list">
              <li>
                <code>data-split="lines"</code>: nur Überschriften und
                Display-Schrift
              </li>
              <li>
                <code>data-reveal="up"</code>: Fließtext, Karten, Listen
              </li>
              <li>
                <code>data-reveal="left|right"</code>: nur Flächen und Bilder
              </li>
              <li>
                <code>data-highlight-marker-reveal</code>: die Meta-Zeilen im
                Hero, sonst nichts
              </li>
            </ul>
          </div>
        )}
      </section>
    ))
  }

  {/* ================= 2. Roles ================= */}
  <section class="d-section d-part" id="rollen" data-surface="dark">
    <div class="d-section__header">
      <span class="d-section__number">Teil 2</span>
      <h2 class="d-section__title">Rollen</h2>
      <p class="d-section__text">
        Wofür ein Wert da ist: Nebentext, der Titel einer Section, der Abstand
        unter der Navigation. Eine neue Section wird auf die vorhandenen Rollen
        gesetzt. Passt keine, kommt eine neue in tokens.css dazu, mit einem
        Namen, der sagt, was sie tut, und nicht, wo sie steht.
      </p>
    </div>
  </section>

  <section class="d-section" id="textstile">
    <div class="d-section__header">
      <span class="d-section__number">2.1</span>
      <h3 class="d-section__title">Textstile</h3>
      <p class="d-section__text">
        Eine ganze Satzeinstellung in einem Wert, für <code>font:</code>. Die
        Laufweite gehört nicht zur Kurzschreibweise und hat deshalb ihr eigenes
        Token daneben. <code>font:</code> gehört an den Anfang einer Regel: Die Kurzschreibweise
        setzt <code>font-variant</code> und Verwandte zurück, was darüber steht, geht
        verloren. Mono-Stile stehen in Versalien, <code
          >text-transform: uppercase</code
        > kommt von Hand dazu.
      </p>
    </div>

    <div class="d-sample">
      <pre
        class="d-code">font: var(--font-section-title);
letter-spacing: var(--tracking-section-title);</pre>
    </div>

    <div class="d-sample">
      {
        textStyles.map((s) => (
          <div class="d-style">
            <div class="d-style__meta">
              <code>{s.name}</code>
              {s.tracking ? (
                <code>+ {s.tracking}</code>
              ) : (
                <span>ohne eigene Laufweite</span>
              )}
              <span class="d-size__purpose">{s.purpose}</span>
            </div>
            <p
              class={`d-style__sample${s.mono ? " d-style__sample--caps" : ""}`}
              style={`font: var(${s.name});${s.tracking ? ` letter-spacing: var(${s.tracking});` : ""}`}
            >
              {s.specimen}
            </p>
            <p class="d-style__parts">
              <code>{s.value}</code>
              {s.sizeAt != null && <span>{fmt(s.sizeAt)} px bei 1728</span>}
            </p>
            <div
              class="d-usage"
              set:html={usageHtml(s.name, uses, [], s.name)}
            />
            {s.tracking && (
              <div
                class="d-usage"
                set:html={usageHtml(s.tracking, uses, [], s.tracking)}
              />
            )}
          </div>
        ))
      }
      {
        roleTrackings.filter((t) => !textStyles.some((s) => s.tracking === t))
          .length ? (
          <p class="d-sample__text d-gap-top">
            Laufweiten ohne Textstil:{" "}
            {roleTrackings
              .filter((t) => !textStyles.some((s) => s.tracking === t))
              .join(", ")}
            .
          </p>
        ) : null
      }
    </div>
  </section>

  <section class="d-section" id="farbrollen">
    <div class="d-section__header">
      <span class="d-section__number">2.2</span>
      <h3 class="d-section__title">Farbrollen</h3>
      <p class="d-section__text">
        Was Bausteine statt der Grundfarben benutzen. Die Rollen ohne <code
          >on-</code
        > gelten auf dem Seitengrund und werden von den <a href="#flaechen"
          >Flächen</a
        > umgestellt. Die <code>on-</code>-Rollen sind für die Fälle, in denen
        ein Zustand dunkel wird und nicht ein ganzer Block, etwa ein gedrückter
        Filter oder der dunkle Button. Der Kontrast ist gegen den Grund
        gerechnet, auf dem die Rolle gilt.
      </p>
    </div>

    <div class="d-sample">
      <table class="d-table">
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col">Muster</th>
            <th scope="col">Regel</th>
            <th scope="col">Zweck</th>
            <th scope="col">Kontrast</th>
            <th scope="col">Verwendung</th>
          </tr>
        </thead>
        <tbody>
          {
            colourRoleRows.map((r) => (
              <tr>
                <td>
                  <code>{r.name}</code>
                </td>
                <td class="d-table__probe">
                  <span
                    class="d-role-chip"
                    style={`background: var(${r.ground})`}
                  >
                    <span style={`background: var(${r.name})`} />
                  </span>
                </td>
                <td>
                  <code>{r.rule}</code>
                </td>
                <td>{r.purpose}</td>
                <td>
                  {r.value != null && r.rating ? (
                    <>
                      {ratio(r.value)} auf <code>{r.ground}</code>{" "}
                      <span class={`d-marker d-marker--${r.rating.cls}`}>
                        {r.rating.label}
                      </span>
                    </>
                  ) : (
                    "Fläche"
                  )}
                </td>
                <td>
                  <div class="d-usage" set:html={usageHtml(r.name)} />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="d-section" id="abstandsrollen">
    <div class="d-section__header">
      <span class="d-section__number">2.3</span>
      <h3 class="d-section__title">Abstandsrollen</h3>
      <p class="d-section__text">
        Abstände mit festem Zweck, zusammengesetzt aus den Grundwerten.
      </p>
    </div>

    <div class="d-sample">
      <table class="d-table">
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col">Wert</th>
            <th scope="col">Zweck</th>
            <th scope="col">Verwendung</th>
          </tr>
        </thead>
        <tbody>
          {
            rows(spacingRoles, "none").map((row) => (
              <tr>
                <td>
                  <code>{row.name}</code>
                </td>
                <td>
                  <code class="d-table__value">{row.value}</code>
                  {row.size && <span class="d-table__size">{row.size}</span>}
                </td>
                <td>{row.purpose}</td>
                <td>
                  <div class="d-usage" set:html={usageHtml(row.name)} />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  {/* ================= 3. Surfaces ================= */}
  <section class="d-section d-part" id="teil-flaechen" data-surface="dark">
    <div class="d-section__header">
      <span class="d-section__number">Teil 3</span>
      <h2 class="d-section__title">Flächen</h2>
      <p class="d-section__text">
        Ein Attribut, <code>data-surface</code>, an dem Element, das den Grund
        malt. Alles darin bekommt lesbare Schrift, Nebentext, Linien und einen
        sichtbaren Fokusring, ohne dass der Baustein davon wissen muss.
      </p>
    </div>
  </section>

  <section class="d-section" id="flaechen">
    <div class="d-section__header">
      <span class="d-section__number">3.1</span>
      <h3 class="d-section__title">Die fünf Gründe</h3>
      <p class="d-section__text">
        Jede Kachel trägt das echte Attribut und malt ihren Grund selbst, wie
        ein Baustein es tut: Die Fläche stellt Farben um, den Grund malt sie
        nicht. Schrift, Nebentext, Linien und Fokusring kommen allein aus den
        Rollen. Link und Button zeigen ihren Fokusring hier dauerhaft; mit der
        Tabulatortaste bekommst du denselben Ring am echten Element.
      </p>
      <p class="d-section__text">
        Die Kontraste sind aus tokens.css gerechnet: die Farbe der Rolle, bei
        Deckung unter 100&nbsp;% auf den Grund gemischt. Über der Körnung liegt
        der Nebentext auf dem Seitengrund etwas darunter, gemessen rund 4,4:1.
      </p>
    </div>

    <div class="d-sample">
      <div class="d-surfaces">
        {
          surfaces.map((s) => (
            <div
              class="d-surface"
              data-surface={s.attr}
              style={`background: var(${s.ground})`}
            >
              <p class="d-surface__name">
                {s.name} ·{" "}
                <code>
                  {s.attr ? `data-surface="${s.attr}"` : "ohne Attribut"}
                </code>
              </p>
              <p class="d-surface__text">
                Schrift in <code>--c-text</code> auf <code>{s.ground}</code>.
              </p>
              <p class="d-surface__muted">
                Nebentext in <code>--c-text-muted</code>. {s.text}
              </p>
              <hr class="d-surface__line" />
              <hr class="d-surface__line d-surface__line--strong" />
              <p class="d-surface__controls">
                <a class="d-surface__link d-focus-static" href="#flaechen">
                  Ein Textlink
                </a>
                <button type="button" class="d-surface__button d-focus-static">
                  Ein Button
                </button>
              </p>
              <dl class="d-surface__ratios">
                {s.ratios.map((r) => (
                  <div>
                    <dt>{r.label}</dt>
                    <dd>
                      {r.value != null && r.rating ? (
                        <>
                          {ratio(r.value)}{" "}
                          <span class={`d-marker d-marker--${r.rating.cls}`}>
                            {r.rating.label}
                          </span>
                        </>
                      ) : (
                        "nicht rechenbar"
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
              <p class="d-surface__overrides">
                {s.overrides.length ? (
                  <>
                    Stellt um:{" "}
                    {s.overrides.map((o, i) => (
                      <>
                        {i > 0 && ", "}
                        <code>{o}</code>
                      </>
                    ))}
                  </>
                ) : (
                  "Stellt nichts um: die Rollen des Seitengrunds."
                )}
              </p>
              {s.attr ? (
                <div class="d-usage" set:html={s.used} />
              ) : (
                <div class="d-usage">
                  <span class="d-usage__line">
                    <span class="d-usage__label">Verwendet</span> überall, wo
                    kein Attribut steht
                  </span>
                </div>
              )}
            </div>
          ))
        }
      </div>
      {
        unlistedSurfaces.length ? (
          <p class="d-sample__text d-gap-top">
            In tokens.css, aber noch ohne Kachel:{" "}
            {unlistedSurfaces.map((k) => `data-surface="${k}"`).join(", ")}.
          </p>
        ) : null
      }
    </div>
  </section>

  {/* ================= 4. Small building blocks ================= */}
  <section class="d-section d-part" id="bausteine" data-surface="dark">
    <div class="d-section__header">
      <span class="d-section__number">Teil 4</span>
      <h2 class="d-section__title">Kleine Bausteine</h2>
      <p class="d-section__text">
        Die kleinen Teile, aus denen alles Übrige zusammengesetzt ist. Die
        großen stehen auf der <a href="/design/komponenten">Komponenten-Seite</a
        >.
      </p>
    </div>
  </section>

  <section class="d-section" id="buttons">
    <div class="d-section__header">
      <span class="d-section__number">4.1</span>
      <h3 class="d-section__title">Buttons und Links</h3>
      <p class="d-section__text">
        Der Button ist zweiteilig: Pille mit Beschriftung, abgesetzt daneben der
        runde Pfeil. Beim Überfahren rückt der Pfeil nach rechts ab, der Button
        öffnet sich in Leserichtung. Das ist die einzige Rückmeldung, und zwar
        mit Absicht: Ein zusätzlicher Farbsprung übertönte das feinere Signal.
        Beim Klick sinken Bedienelemente leicht ein, mit einer Ausnahme:
        Akkordeons tun es nicht, eine ganze Zeile, die beim Aufklappen
        zusammenzuckt, wirkt wie ein Ruckeln.
      </p>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Varianten</span>
        <span class="d-sample__path">components/ui/Button.astro</span>
      </div>
      <div class="d-stage d-stage--row">
        <Button label="Termin buchen" href="#" />
        <Button label="Dunkel" href="#" variant="dark" />
        <Button label="Absenden" type="submit" />
      </div>
      <div
        class="d-stage d-stage--dark d-stage--row d-gap-top"
        data-surface="dark"
      >
        <Button label="Auf dunklem Grund" href="#" />
        <Button label="Block" href="#" variant="block" />
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Textlink und Topline</span>
      </div>
      <div class="d-stage">
        <p class="d-gap-bottom">
          <a class="c-link" href="#">Ein Textlink</a> im Fließtext.
        </p>
        <span class="c-topline">Vorher &amp; Nachher</span>
      </div>
      <p class="d-sample__text d-gap-top">
        Die Topline erbt ihre Farbe von der Section und setzt keine eigene,
        sonst stünde sie auf dem braunen Band dunkel auf dunkel.
      </p>
    </div>
  </section>

  <section class="d-section" id="formular">
    <div class="d-section__header">
      <span class="d-section__number">4.2</span>
      <h3 class="d-section__title">Akkordeon und Eingabefelder</h3>
      <p class="d-section__text">
        Alles, was Inhalt aufklappt oder Eingaben entgegennimmt.
      </p>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Akkordeon</span>
        <span class="d-sample__path">components/ui/Accordion.astro</span>
      </div>
      <div class="d-stage">
        <Accordion questions={SAMPLE_QUESTIONS} />
      </div>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Eingabefelder</span>
      </div>
      <div class="d-stage d-form">
        <div class="c-field">
          <label class="c-field__label" for="sg-name">Name <span>*</span></label
          >
          <div class="c-field__control">
            <input
              id="sg-name"
              type="text"
              placeholder="Dein Name"
              autocomplete="name"
            />
          </div>
        </div>
        <div class="c-field">
          <label class="c-field__label" for="sg-mail"
            >E-Mail-Adresse <span>*</span></label
          >
          <div class="c-field__control">
            <input
              id="sg-mail"
              type="email"
              placeholder="name@beispiel.de"
              autocomplete="email"
            />
          </div>
        </div>
        <div class="c-field c-field--tall">
          <label class="c-field__label" for="sg-msg">Nachricht</label>
          <div class="c-field__control">
            <textarea id="sg-msg" rows="4" placeholder="Worum geht es?"
            ></textarea>
          </div>
        </div>
      </div>
      <p class="d-sample__text d-gap-top">
        Die Beschriftung steht über dem Feld und ist über <code>for</code> mit ihm
        verbunden. Ein Platzhalter allein ist keine Beschriftung, er verschwindet
        beim Tippen.
      </p>
    </div>
  </section>

  <section class="d-section" id="symbole">
    <div class="d-section__header">
      <span class="d-section__number">4.3</span>
      <h3 class="d-section__title">Symbole</h3>
      <p class="d-section__text">
        Ein einziges SVG-Sprite, einmal im Dokument, überall per
        <code>&lt;use href="#i-…"&gt;</code> aufgerufen. Die Symbole erben
        <code>currentColor</code>, sie tragen keine eigene Farbe. Die Liste ist
        aus dem Sprite gelesen.
      </p>
    </div>

    <div class="d-sample">
      <div class="d-sample__header">
        <span class="d-sample__name">Sprite</span>
        <span class="d-sample__path">components/ui/Icons.astro</span>
      </div>
      <div class="d-grid">
        {
          SYMBOLS.map((s) => (
            <div class="d-symbol">
              <svg aria-hidden="true">
                <use href={`#${s}`} />
              </svg>
              <code>{s}</code>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <style is:global>
    /* Everything here carries the `d-` prefix and styles the documentation
       only. Values come from tokens.css; the few fixed sizes below are the
       dimensions of a probe, not of the site. */

    /* --- Part headers: a dark band, set through the real surface --- */
    .d-part {
      background: var(--c-dark);
    }

    .d-part .d-section__header {
      margin-bottom: 0;
    }

    /* --- Contents --- */
    .d-contents {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: var(--sp-4);
    }

    .d-contents__head {
      display: block;
      margin-bottom: var(--sp-2);
      font: var(--font-topline);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }

    .d-contents__list {
      padding: 0;
      list-style: none;
      font: var(--font-small);
      color: var(--c-text-muted);
    }

    .d-contents a {
      text-decoration: underline;
      text-decoration-thickness: var(--bw);
      text-underline-offset: 3px;
    }

    .d-contents a:hover {
      color: var(--c-text);
      text-decoration-color: var(--c-brand);
    }

    .d-gap-top {
      margin-top: var(--sp-4);
    }

    .d-gap-bottom {
      margin-bottom: var(--sp-4);
    }

    /* --- Usage lines --- */
    .d-usage {
      margin-top: var(--sp-1);
      font: var(--font-label);
      letter-spacing: var(--tracking-mono);
      color: var(--c-text-muted);
    }

    .d-usage__line {
      display: block;
    }

    .d-usage__label {
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
    }

    .d-usage__more {
      display: inline;
    }

    .d-usage__more summary {
      display: inline;
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    /* Unused is marked by a frame and a word, not by colour alone
       (WCAG 1.4.1). */
    .d-usage__none {
      display: inline-block;
      padding: 0.1em 0.5em;
      border: var(--bw) dashed var(--c-line-strong);
      border-radius: var(--r-sm);
      color: var(--c-text);
      text-transform: uppercase;
      letter-spacing: var(--tracking-label);
    }

    /* --- Colour tiles --- */
    .d-color__swatch {
      height: 96px;
      margin-bottom: var(--sp-3);
      border: var(--bw) solid var(--c-line);
      border-radius: var(--r-sm);
    }

    .d-color__name {
      font-family: var(--f-mono);
      font-size: var(--fs-text-main);
    }

    .d-color__hex,
    .d-color__role,
    .d-color__value {
      font: var(--font-small);
      color: var(--c-text-muted);
    }

    .d-color__role {
      margin-block: var(--sp-1);
    }

    .d-marker {
      display: inline-block;
      padding: 0.1em 0.5em;
      border: var(--bw) solid transparent;
      border-radius: var(--r-sm);
      font: var(--font-label);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
    }

    .d-marker--good {
      background: var(--c-dark);
      color: var(--c-grey);
    }
    .d-marker--partial {
      background: var(--c-brand);
      color: var(--c-dark);
    }
    .d-marker--weak {
      background: transparent;
      border-color: var(--c-line-strong);
      color: var(--c-text);
    }

    /* On a surface the markers follow its roles; a dark pill on a dark
       ground would be a hole, not a label. */
    .d-surface .d-marker {
      background: transparent;
      border-color: var(--c-line-strong);
      color: var(--c-text);
    }

    /* --- Tables --- */
    .d-table {
      width: 100%;
      border-collapse: collapse;
      font: var(--font-small);
      text-align: left;
    }

    .d-table th,
    .d-table td {
      padding: var(--sp-2) var(--sp-3) var(--sp-2) 0;
      border-bottom: var(--bw) solid var(--c-line);
      vertical-align: top;
    }

    .d-table th {
      font: var(--font-label);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
    }

    .d-table td:not(:first-child) {
      color: var(--c-text-muted);
    }

    .d-table td:first-child code {
      white-space: nowrap;
    }

    .d-table__value {
      word-break: break-word;
    }

    .d-table__size {
      display: block;
      margin-top: var(--sp-1);
      font: var(--font-label);
      letter-spacing: var(--tracking-mono);
    }

    .d-table__probe {
      width: 30%;
    }

    /* Narrow windows: each row becomes a small card instead of a table
       that scrolls sideways. */
    @media (max-width: 700px) {
      .d-table thead {
        display: none;
      }
      .d-table tr {
        display: block;
        padding-block: var(--sp-2);
        border-bottom: var(--bw) solid var(--c-line);
      }
      .d-table td {
        display: block;
        width: auto;
        padding: var(--sp-1) 0;
        border: 0;
      }
    }

    /* --- Probes --- */
    .d-probe-bar {
      display: block;
      max-width: 100%;
      height: var(--sp-2);
      border-radius: var(--r-sm);
      background: var(--c-text);
    }

    .d-probe-lh {
      display: inline-block;
      padding-inline: var(--sp-1);
      background: var(--c-tint);
      color: var(--c-text);
      font-size: var(--fs-text-main);
    }

    .d-probe-tracking {
      font-size: var(--fs-text-large);
      color: var(--c-text);
    }

    .d-probe-tracking--mono {
      font: var(--font-label);
      font-size: var(--fs-text-main);
      text-transform: uppercase;
    }

    .d-probe-radius {
      display: block;
      width: var(--sp-10);
      height: var(--sp-8);
      background: var(--c-dark);
    }

    .d-probe-shadow {
      display: block;
      width: var(--sp-12);
      height: var(--sp-8);
      border-radius: var(--r-md);
      background: var(--c-surface);
    }

    .d-probe-icon {
      display: inline-grid;
      place-items: center;
      border-radius: var(--r-round);
      color: var(--c-text);
      outline: var(--bw) dashed var(--c-line);
    }

    .d-probe-icon svg {
      width: 100%;
      height: 100%;
    }

    .d-probe-line {
      display: block;
      width: var(--sp-12);
      border-top: var(--bw) solid var(--c-text);
    }

    .d-probe-focus {
      display: block;
      width: var(--sp-10);
      height: var(--sp-5);
      border-radius: var(--r-sm);
      background: var(--c-surface);
      outline: var(--focus-width) solid var(--c-focus);
      outline-offset: var(--focus-offset);
    }

    .d-role-chip {
      display: flex;
      padding: var(--sp-1);
      width: var(--sp-12);
      border: var(--bw) solid var(--c-line);
      border-radius: var(--r-sm);
    }

    .d-role-chip span {
      display: block;
      width: 100%;
      height: var(--sp-5);
      border-radius: var(--r-sm);
    }

    /* --- Fonts and the ladder --- */
    .d-font-name {
      margin-bottom: var(--sp-3);
      font: var(--font-label);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      color: var(--c-text-muted);
    }

    .d-font-sample {
      font-size: var(--fs-title);
      line-height: var(--lh-heading);
    }

    .d-font-sample--sans {
      font-family: var(--f-sans);
    }

    .d-font-sample--medium {
      font-weight: var(--fw-medium);
    }

    .d-font-sample--mono {
      font-family: var(--f-mono);
      font-weight: var(--fw-light);
    }

    .d-font-sample--caps {
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
    }

    .d-size,
    .d-style {
      padding-block: var(--sp-4);
      border-top: var(--bw) solid var(--c-line);
    }

    .d-size__meta,
    .d-style__meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2) var(--sp-4);
      margin-bottom: var(--sp-2);
      font: var(--font-label);
      letter-spacing: var(--tracking-mono);
      color: var(--c-text-muted);
    }

    .d-size__purpose {
      text-transform: none;
    }

    /* Overflow allowed: the large steps are wider than the window, and that
       is what they are meant to show. Cut off they would lie about their
       size, so the line scrolls on its own. */
    .d-size__sample {
      overflow-x: auto;
      line-height: var(--lh-heading);
      white-space: nowrap;
    }

    .d-size__sample--heavy {
      font-weight: var(--fw-medium);
    }

    .d-style__sample {
      max-width: var(--measure-long);
    }

    .d-style__sample--caps {
      text-transform: uppercase;
    }

    .d-style__parts {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-1) var(--sp-4);
      margin-top: var(--sp-2);
      font: var(--font-label);
      letter-spacing: var(--tracking-mono);
      color: var(--c-text-muted);
    }

    .d-code {
      padding: var(--sp-4);
      border-radius: var(--r-md);
      background: var(--c-tint);
      font-family: var(--f-mono);
      font-size: var(--fs-text-main);
      line-height: var(--lh-text);
      white-space: pre-wrap;
    }

    .d-legacy {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-1) var(--sp-4);
      margin-top: var(--sp-2);
      font-size: var(--fs-label);
    }

    .d-list {
      padding-left: var(--sp-4);
      font: var(--font-body);
      color: var(--c-text-muted);
    }

    /* --- Measures --- */
    .d-measure {
      padding-block: var(--sp-3);
      border-top: var(--bw) solid var(--c-line);
      font: var(--font-label);
      color: var(--c-text-muted);
    }

    .d-measure__text {
      margin-top: var(--sp-1);
      padding: var(--sp-2);
      background: var(--c-tint);
      font: var(--font-body);
      color: var(--c-text);
    }

    /* --- Motion --- */
    .d-curve__track {
      position: relative;
      display: block;
      height: var(--sp-5);
      border-radius: var(--r-round);
      background: var(--c-tint);
      container-type: inline-size;
    }

    .d-curve__ball {
      position: absolute;
      top: 4px;
      left: 4px;
      width: var(--sp-4);
      height: var(--sp-4);
      border-radius: var(--r-round);
      background: var(--c-dark);
      transition-property: translate;
      transition-duration: var(--d-slow);
      transition-timing-function: var(--e-out);
    }

    .d-motion-row:hover .d-curve__ball {
      translate: calc(100cqw - var(--sp-5)) 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .d-curve__ball {
        transition-duration: 0s !important;
      }
    }

    /* --- Grain --- */
    .d-grain {
      position: relative;
      display: grid;
      place-items: center;
      width: 220px;
      height: 96px;
      border-radius: var(--r-md);
      background: var(--c-dark);
      font: var(--font-label);
      overflow: hidden;
    }

    .d-grain::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image: var(--grain-image);
      pointer-events: none;
    }

    .d-grain--page::after {
      opacity: var(--grain-opacity);
    }
    .d-grain--surface::after {
      opacity: var(--grain-opacity-surface);
    }

    .d-grain span {
      position: relative;
      z-index: 1;
    }

    /* --- Surfaces --- */
    .d-surfaces {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--sp-4);
    }

    .d-surface {
      display: flex;
      flex-direction: column;
      gap: var(--sp-3);
      padding: var(--sp-5);
      border: var(--bw) solid var(--c-line);
      border-radius: var(--r-md);
      color: var(--c-text);
    }

    .d-surface__name {
      font: var(--font-topline);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }

    .d-surface__name code {
      text-transform: none;
      letter-spacing: 0;
    }

    .d-surface__text {
      font: var(--font-body);
    }

    .d-surface__muted {
      font: var(--font-body);
      color: var(--c-text-muted);
    }

    .d-surface__line {
      margin: 0;
      border: 0;
      border-top: var(--bw) solid var(--c-line);
    }

    .d-surface__line--strong {
      border-top-color: var(--c-line-strong);
    }

    .d-surface__controls {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--sp-4);
      padding-block: var(--sp-1);
    }

    .d-surface__link {
      color: var(--c-text);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .d-surface__button {
      min-height: var(--icon-lg);
      padding: var(--sp-1) var(--sp-3);
      border: var(--bw) solid var(--c-line-strong);
      border-radius: var(--r-round);
      background: transparent;
      font: var(--font-small);
      color: var(--c-text);
      cursor: pointer;
    }

    /* The ring as :focus-visible draws it (base.css), shown for good. */
    .d-focus-static {
      outline: var(--focus-width) solid var(--c-focus);
      outline-offset: var(--focus-offset);
    }

    .d-surface__ratios {
      display: grid;
      gap: var(--sp-1);
      font: var(--font-small);
    }

    .d-surface__ratios div {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--sp-2);
    }

    .d-surface__overrides {
      font: var(--font-label);
      letter-spacing: var(--tracking-mono);
      color: var(--c-text-muted);
    }

    /* --- Form (a stand-in: the field rules live scoped in Contact.astro
       and do not exist on this page) --- */
    .d-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-4);
    }

    @media (max-width: 700px) {
      .d-form {
        grid-template-columns: 1fr;
      }
    }

    .d-form .c-field__label {
      display: block;
      margin-bottom: var(--sp-1);
      font: var(--font-topline);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      color: var(--c-on-card);
    }

    /* As in Contact.astro: the required star takes the label colour. Pink
       does not reach 4.5:1 on a light ground at this size. */
    .d-form .c-field__label span {
      color: inherit;
    }

    .d-form input,
    .d-form textarea {
      width: 100%;
      padding: var(--sp-3) var(--sp-4);
      border: var(--bw) solid var(--c-line-strong);
      border-radius: var(--r-sm);
      background: var(--c-white);
      font: var(--font-body);
      color: var(--c-on-card);
    }

    .d-form ::placeholder {
      color: var(--c-placeholder);
    }

    .d-form .c-field--tall {
      grid-column: 1 / -1;
    }

    /* --- Symbols --- */
    .d-symbol {
      display: flex;
      align-items: center;
      gap: var(--sp-3);
      padding: var(--sp-3);
      border: var(--bw) solid var(--c-line);
      border-radius: var(--r-sm);
      font-size: var(--fs-label);
    }

    .d-symbol svg {
      width: var(--icon-lg);
      height: var(--icon-lg);
      flex: 0 0 auto;
    }
  </style>
</Design>
