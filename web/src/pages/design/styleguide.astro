---
/**
 * Styleguide: the foundations of the site in the three layers of
 * `src/styles/tokens.css` (base values, roles, surfaces), followed by the
 * small building blocks everything else is made of.
 *
 * Nothing on this page is copied from tokens.css by hand. The frontmatter
 * reads the file at build time: which tokens exist, their raw values, what
 * the roles and surfaces are made of, and from that the contrast ratios and
 * the pixel values at 1728px. A token added there shows up here; a token
 * removed there disappears. The German purpose next to each token is the only
 * hand-kept text, and a token without one says so.
 *
 * "Used in" is generated as well. The frontmatter scans the source files
 * under web/src (components, templates, layouts, pages, styles, js; not the
 * design pages and not tokens.css itself) and counts, per token, which file
 * references it and how often. It replaced hand-written notes such as
 * "Galeriekopf, Geschichte", which went stale the moment a block moved to
 * another step of the scale. A token nothing references is marked.
 *
 * The one hand-kept list of values is `HEX` below: the swatches show the
 * literal colours, and `checkStyleguideColours()` in scripts/check-web.mjs
 * compares every entry with its `--c-*` in tokens.css.
 */
import { existsSync, readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import Design from "../../layouts/Design.astro";
import Button from "../../components/ui/Button.astro";
import Accordion from "../../components/ui/Accordion.astro";

/* --- Source -------------------------------------------------------------
   `npm run web` runs Astro inside web/, so the working directory is web/.
   The second candidate covers a run started from the project root. */
const SRC = [
  join(process.cwd(), "src"),
  join(process.cwd(), "web", "src"),
].find((dir) => existsSync(join(dir, "styles", "tokens.css")));
if (!SRC) {
  throw new Error(`Styleguide: tokens.css not found from ${process.cwd()}`);
}
const TOKENS_FILE = readFileSync(join(SRC, "styles", "tokens.css"), "utf8");

/* --- Base colours, checked against tokens.css by check-web.mjs ----------- */
const HEX = {
  brand: "#ff84c8",
  dark: "#403229",
  taupe: "#d0bec3",
  grey: "#d6d6d6",
  "neutral-800": "#201d1d",
  "neutral-200": "#f4f4f4",
  white: "#ffffff",
} as const;

/* --- Parsing tokens.css -------------------------------------------------- */

type Decls = Map<string, string>;

const withoutComments = (css: string) => css.replace(/\/\*[\s\S]*?\*\//g, "");

const blocks = [
  ...withoutComments(TOKENS_FILE).matchAll(/([^{}]+)\{([^{}]*)\}/g),
].map((match) => ({
  selector: (match[1] ?? "").trim(),
  decls: new Map(
    [...(match[2] ?? "").matchAll(/(--[\w-]+)\s*:\s*([^;]+);/g)].map(
      (d) =>
        [
          d[1] ?? "",
          /* Prettier breaks long color-mix() calls over lines; one line,
             without padding inside the parentheses, keeps the readers below
             simple. */
          (d[2] ?? "")
            .replace(/\s+/g, " ")
            .replace(/\(\s/g, "(")
            .replace(/\s\)/g, ")")
            .trim(),
        ] as const,
    ),
  ) as Decls,
}));

/* The first `:root` holds base values and roles; a later `:root` holds the
   legacy aliases for the archived prototype. */
const rootBlocks = blocks.filter((b) => b.selector === ":root");
const ROOT: Decls = rootBlocks[0]?.decls ?? new Map();
const LEGACY: Decls = new Map(rootBlocks.slice(1).flatMap((b) => [...b.decls]));

const SURFACE_DECLS = new Map<string, Decls>();
for (const b of blocks) {
  const m = b.selector.match(/^\[data-surface="([\w-]+)"\]$/);
  if (m?.[1]) SURFACE_DECLS.set(m[1], b.decls);
}

/* Base values and roles live in the same block; the "2. ROLES" banner
   divides them: the line that says nothing else, because the file header
   also starts a line with "2. ROLES". Definitions are matched at the start of a line so a token
   mentioned inside a comment does not count as its definition. */
const rolesStart = TOKENS_FILE.search(/^\s*2\. ROLES\s*$/m);
const definedAt = (name: string) =>
  TOKENS_FILE.search(new RegExp(`^\\s*${name}\\s*:`, "m"));
const isRole = (name: string) =>
  rolesStart >= 0 && definedAt(name) > rolesStart;

const TOKENS = [...ROOT.keys()];
const BASE = TOKENS.filter((t) => !isRole(t));
const ROLES = TOKENS.filter(isRole);

/* --- Colour maths (same formula as scripts/lib/wcag.mjs) ----------------- */

type Rgb = [number, number, number];
type Colour = { rgb: Rgb; alpha: number };

const channels = (hex: string): Rgb =>
  [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)) as Rgb;

function luminance(rgb: Rgb) {
  const k = rgb.map((v) => {
    const s = v / 255;
    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * k[0]! + 0.7152 * k[1]! + 0.0722 * k[2]!;
}

function contrast(a: Rgb, b: Rgb) {
  const [x, y] = [luminance(a), luminance(b)];
  return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
}

/** A colour with coverage below 100 %, painted onto its ground. */
const over = (fg: Colour, ground: Rgb): Rgb =>
  fg.rgb.map((v, i) => v * fg.alpha + ground[i]! * (1 - fg.alpha)) as Rgb;

/**
 * Resolves a colour expression from tokens.css: a hex value, `var()` and
 * `color-mix(in srgb, X N%, transparent)`. `scope` holds the declarations of
 * a surface; they win over :root, as they do in the browser. A value that
 * comes from :root is resolved in :root, because a custom property is
 * computed where it is declared.
 */
function colour(expr: string, scope?: Decls, depth = 0): Colour | null {
  const e = expr.trim();
  if (depth > 12) return null;
  if (/^#[0-9a-f]{6}$/i.test(e)) return { rgb: channels(e), alpha: 1 };

  const ref = e.match(/^var\(\s*(--[\w-]+)\s*\)$/);
  if (ref?.[1]) {
    const local = scope?.get(ref[1]);
    if (local !== undefined) return colour(local, scope, depth + 1);
    const global = ROOT.get(ref[1]);
    return global === undefined ? null : colour(global, undefined, depth + 1);
  }

  const mix = e.match(
    /^color-mix\(\s*in srgb\s*,\s*(.+?)\s+([\d.]+)%\s*,\s*transparent\s*\)$/,
  );
  if (mix?.[1] && mix[2]) {
    const c = colour(mix[1], scope, depth + 1);
    return c && { rgb: c.rgb, alpha: (c.alpha * Number(mix[2])) / 100 };
  }
  return null;
}

const tokenColour = (name: string, scope?: Decls) =>
  colour(`var(${name})`, scope);

/** Contrast of a colour role against a ground role, both from tokens.css. */
function roleContrast(role: string, ground: string, scope?: Decls) {
  const g = tokenColour(ground);
  const c = tokenColour(role, scope);
  return g && c ? contrast(over(c, g.rgb), g.rgb) : null;
}

/** "--c-dark · 75 %" for a color-mix, the referenced token for a var(). */
function describeColour(value: string) {
  const mix = value.match(/var\((--[\w-]+)\)\s+([\d.]+)%/);
  if (mix) return `${mix[1]} · ${mix[2]} %`;
  const ref = value.match(/^var\((--[\w-]+)\)$/);
  return ref?.[1] ?? value;
}

type Kind = "text" | "control" | "decoration";

/* Labelled, not only coloured: a traffic light alone says nothing to someone
   who cannot tell the colours apart (WCAG 1.4.1). */
function rating(v: number, kind: Kind) {
  if (kind === "decoration") return { cls: "weak", label: "Schmuck" };
  if (kind === "control") {
    return v >= 3
      ? { cls: "good", label: "Bedienelement" }
      : { cls: "weak", label: "zu schwach" };
  }
  return v >= 4.5
    ? { cls: "good", label: "Fließtext" }
    : v >= 3
      ? { cls: "partial", label: "nur groß" }
      : { cls: "weak", label: "zu schwach" };
}

/* --- Lengths ------------------------------------------------------------- */

/** The viewport the Figma values are drawn at. */
const VIEWPORT = 1728;

function splitArgs(s: string) {
  const out: string[] = [];
  let depth = 0;
  let current = "";
  for (const ch of s) {
    if (ch === "(") depth++;
    if (ch === ")") depth--;
    if (ch === "," && depth === 0) {
      out.push(current.trim());
      current = "";
    } else current += ch;
  }
  out.push(current.trim());
  return out;
}

/** px at the given viewport width, or null where it cannot be known (vh, calc). */
function px(expr: string, vw = VIEWPORT, depth = 0): number | null {
  const e = expr.trim();
  if (depth > 12) return null;

  const ref = e.match(/^var\(\s*(--[\w-]+)\s*\)$/);
  if (ref?.[1]) {
    const v = ROOT.get(ref[1]);
    return v === undefined ? null : px(v, vw, depth + 1);
  }

  const unit = e.match(/^(-?[\d.]+)(px|rem|vw)?$/);
  if (unit) {
    const n = Number(unit[1]);
    if (unit[2] === "rem") return n * 16;
    if (unit[2] === "vw") return (n * vw) / 100;
    return unit[2] === "px" || n === 0 ? n : null;
  }

  const clamp = e.match(/^clamp\((.*)\)$/);
  if (clamp?.[1]) {
    const [a, b, c] = splitArgs(clamp[1]).map((p) => px(p, vw, depth + 1));
    if (a == null || b == null || c == null) return null;
    return Math.min(Math.max(a, b), c);
  }
  return null;
}

function pxRange(expr: string): [number, number] | null {
  const clamp = expr.trim().match(/^clamp\((.*)\)$/);
  if (!clamp?.[1]) return null;
  const args = splitArgs(clamp[1]);
  const lo = args[0] ? px(args[0]) : null;
  const hi = args[2] ? px(args[2]) : null;
  return lo == null || hi == null ? null : [lo, hi];
}

const fmt = (n: number, digits = 0) =>
  n.toLocaleString("de-DE", {
    minimumFractionDigits: digits,
    maximumFractionDigits: digits,
  });
/* Cut, not rounded: 2.995 is below 3:1 and must not read "3,00". */
const ratio = (n: number) => `${fmt(Math.floor(n * 100) / 100, 2)}:1`;

/** "16–48 px, 48 px bei 1728" for a clamp, "24 px" for a fixed length. */
function sizeOf(name: string) {
  const value = ROOT.get(name) ?? "";
  const range = pxRange(value);
  const at = px(value);
  if (range) {
    const span = `${fmt(range[0])}–${fmt(range[1])} px`;
    return at == null ? span : `${span}, ${fmt(at)} px bei 1728`;
  }
  return at == null ? "" : `${fmt(at)} px`;
}

/** The raw value as written, with `var(` noise removed for reading. Long
    values (the grain image is a whole SVG) are cut; tokens.css has them. */
const readable = (value: string) => {
  const v = value.replace(/var\((--[\w-]+)\)/g, "$1").replace(/\s+/g, " ");
  return v.length > 72 ? `${v.slice(0, 71)}…` : v;
};

/* --- Usage: where each token is referenced ------------------------------- */

const SCAN_DIRS = [
  "components",
  "templates",
  "layouts",
  "pages",
  "styles",
  "js",
];
/* The design pages and their frame document the tokens; counting them would
   make every token look used. tokens.css is the definition, see `via`. */
const SKIP = new Set([
  join("pages", "design"),
  join("layouts", "Design.astro"),
  join("styles", "tokens.css"),
]);

/** Short label for a source file: the component name, or kind plus name. */
function labelFor(path: string) {
  const [dir = "", ...rest] = path.split(/[\\/]/);
  const file = rest.join("/");
  const name = file.replace(/\.(astro|ts|js|mjs)$/, "");
  switch (dir) {
    case "components":
      return name.split("/").pop() ?? name;
    case "templates":
      return `Vorlage ${name}`;
    case "layouts":
      return `Layout ${name}`;
    case "pages":
      return `Seite /${name.replace(/(^|\/)index$/, "")}`;
    default:
      return file.split("/").pop() ?? file;
  }
}

/* Comments are stripped before counting: base.css mentions tokens in its
   prose, and a sentence about a token is not a use of it. The `//` rule
   leaves URLs alone (a colon or quote in front). */
const stripComments = (text: string) =>
  text
    .replace(/<!--[\s\S]*?-->/g, "")
    .replace(/\/\*[\s\S]*?\*\//g, "")
    .replace(/(^|[^:"'`\\])\/\/[^\n]*/g, "$1");

/* A reference, not a definition: `var(--x)` or "--x" in a script, never
   `--x:`. The look-behind keeps BEM modifiers (`c-btn--dark`) out. */
const REFERENCE = /(?<![\w-])--[a-z][a-z0-9-]*(?![\w-])(?!\s*:)/g;

const uses = new Map<string, Map<string, number>>();
const surfaceUses = new Map<string, Map<string, number>>();
const bump = (
  map: Map<string, Map<string, number>>,
  key: string,
  label: string,
) => {
  const inner = map.get(key) ?? new Map<string, number>();
  inner.set(label, (inner.get(label) ?? 0) + 1);
  map.set(key, inner);
};

let scannedFiles = 0;
function walk(dir: string) {
  for (const entry of readdirSync(join(SRC!, dir), { withFileTypes: true })) {
    const path = join(dir, entry.name);
    if (SKIP.has(path)) continue;
    if (entry.isDirectory()) {
      walk(path);
      continue;
    }
    if (!/\.(astro|css|ts|js|mjs)$/.test(entry.name)) continue;
    scannedFiles++;
    const text = stripComments(readFileSync(join(SRC!, path), "utf8"));
    const label = labelFor(path);
    for (const m of text.matchAll(REFERENCE)) {
      if (ROOT.has(m[0]) || LEGACY.has(m[0])) bump(uses, m[0], label);
    }
    for (const m of text.matchAll(/data-surface="([\w-]+)"/g)) {
      if (m[1]) bump(surfaceUses, m[1], label);
    }
  }
}
for (const dir of SCAN_DIRS) if (existsSync(join(SRC, dir))) walk(dir);

/* Inside tokens.css: which role or surface a base value is part of. */
const via = new Map<string, string[]>();
const addVia = (target: string, owner: string) =>
  via.set(target, [...new Set([...(via.get(target) ?? []), owner])]);
for (const [name, value] of ROOT) {
  for (const m of value.matchAll(/var\((--[\w-]+)\)/g)) {
    if (m[1]) addVia(m[1], name);
  }
}
for (const [surface, decls] of SURFACE_DECLS) {
  for (const value of decls.values()) {
    for (const m of value.matchAll(/var\((--[\w-]+)\)/g)) {
      if (m[1]) addVia(m[1], `Fläche ${surface}`);
    }
  }
}

const directUses = (name: string) =>
  [...(uses.get(name) ?? new Map<string, number>())].sort(
    (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "de"),
  );

const isUnused = (name: string) =>
  !directUses(name).length && !(via.get(name) ?? []).length;

const esc = (s: string) =>
  s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");

const SHOWN = 6;
const listFiles = (files: [string, number][]) =>
  files.map(([f, n]) => esc(f) + (n > 1 ? ` (${n})` : "")).join(", ");

/**
 * The compact usage line, as HTML: "Verwendet in Features, Panel (2)".
 * `subject` names the token in the label where two lines stand together.
 */
function usageHtml(
  name: string,
  map = uses,
  owners = via.get(name) ?? [],
  subject = "",
) {
  const lead = subject ? `<code>${esc(subject)}</code> ` : "";
  const files =
    map === uses
      ? directUses(name)
      : [...(map.get(name) ?? new Map<string, number>())].sort(
          (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "de"),
        );
  const lines: string[] = [];
  if (files.length) {
    const rest = files.slice(SHOWN);
    lines.push(
      `${lead}<span class="d-usage__label">Verwendet in</span> ${listFiles(files.slice(0, SHOWN))}` +
        (rest.length
          ? ` <details class="d-usage__more"><summary>und ${rest.length} weitere</summary>${listFiles(rest)}</details>`
          : ""),
    );
  }
  if (owners.length) {
    lines.push(
      `<span class="d-usage__label">Steckt in</span> ${owners
        .map((o) => (o.startsWith("--") ? `<code>${esc(o)}</code>` : esc(o)))
        .join(", ")}`,
    );
  }
  return lines.length
    ? lines.map((l) => `<span class="d-usage__line">${l}</span>`).join("")
    : `${lead}<span class="d-usage__none">Nirgends verwendet</span>`;
}

