  "--c-on-card": "--c-surface",
  "--c-on-card-muted": "--c-surface",
  "--c-placeholder": "--c-surface",
};
const ROLE_KIND: Record<string, Kind | "ground" | "fill"> = {
  "--c-bg": "ground",
  "--c-surface": "ground",
  "--c-line": "decoration",
  "--c-on-dark-line": "decoration",
  "--c-line-strong": "control",
  "--c-on-dark-line-strong": "control",
  "--c-focus": "control",
  "--c-tint": "fill",
  "--c-tint-brand": "fill",
  "--c-glass": "fill",
};

const colourRoleRows = colourRoles.map((name) => {
  const kind = ROLE_KIND[name] ?? "text";
  const ground = ROLE_GROUND[name] ?? "--c-bg";
  const v =
    kind === "ground" || kind === "fill" ? null : roleContrast(name, ground);
  return {
    name,
    rule: describeColour(ROOT.get(name) ?? ""),
    ground,
    purpose: purpose(name),
    value: v,
    rating: v == null ? null : rating(v, kind as Kind),
  };
});

