---
/**
 * Eine Route für alle Leistungsseiten. Daten laden, Renderer aufrufen.
 *
 * Der Zusammenbau liegt in `templates/Service.astro`, damit die Vorschau-Route
 * aus Aufgabe 6 exakt dasselbe rendert.
 */
import Service from "../../templates/Service.astro";
import { loadService, loadSlugs } from "../../lib/services";
import { loadServiceList } from "../../lib/service-list";
import { loadHomepage } from "../../lib/homepage";
import { loadPosts } from "../../lib/magazine";

// Muss die Ladefunktion importieren, nicht auf Frontmatter-Konstanten
// zugreifen: Astro hebt getStaticPaths in einen eigenen Modulkontext.
export async function getStaticPaths() {
  return await loadSlugs();
}

const { slug } = Astro.params;
const data = await loadService(slug!);

/* Der Name aus der Liste trägt die Überschrift, falls das Dokument fehlt —
   sonst stünde über der Seite nichts. Alles Weitere kommt aus dem Dokument
   oder erscheint nicht: Seit Aufgabe 4 füllt kein Beispielinhalt mehr auf. */
const entry = (await loadServiceList()).find((l) => l.slug === slug);
const title = data?.title || entry?.name || "";

/* Die Patientenstimmen sind dieselben wie auf der Startseite — und werden
   deshalb an EINER Stelle gepflegt, im Startseiten-Dokument. Bis Aufgabe 4
   standen sie als Vorgabe im Baustein, sodass jede Seite ihre eigene Kopie
   bekam; wer eine Geschichte änderte, änderte sie nirgends sichtbar. */
const { storiesItems } = await loadHomepage();

/* Nur die Beiträge, die auf diese Leistung verweisen. */
const posts = await loadPosts(slug!);
---

<Service data={data} title={title} slug={slug!} stories={storiesItems} posts={posts} />
