---
/**
 * Eine Route für alle Leistungsseiten. Im Prototyp war jede Seite eine
 * eigene HTML-Datei mit dupliziertem Markup — hier entsteht sie aus den
 * Daten. Das ist der eigentliche Gewinn der Umstellung.
 */
import Base from "../../layouts/Base.astro";
import ServiceHero from "../../components/sections/ServiceHero.astro";
import Intro from "../../components/sections/Intro.astro";
import Statement from "../../components/sections/Statement.astro";
import Prices from "../../components/sections/Prices.astro";
import Benefits from "../../components/sections/Benefits.astro";
import BeforeAfter from "../../components/sections/BeforeAfter.astro";
import Steps from "../../components/sections/Steps.astro";
import Stories from "../../components/sections/Stories.astro";
import Features from "../../components/sections/Features.astro";
import Magazine from "../../components/sections/Magazine.astro";
import Faq from "../../components/sections/Faq.astro";
import Contact from "../../components/sections/Contact.astro";
import { ladeLeistung, ladeSlugs } from "../../lib/leistungen";
import { ladeLeistungsliste } from "../../lib/leistungsliste";
import { ladeStartseite } from "../../lib/startseite";

// Muss die Ladefunktion importieren, nicht auf Frontmatter-Konstanten
// zugreifen: Astro hebt getStaticPaths in einen eigenen Modulkontext.
export async function getStaticPaths() {
  return await ladeSlugs();
}

const { slug } = Astro.params;
const d = await ladeLeistung(slug!);

/* Der Name aus der Liste trägt die Überschrift, falls das Dokument fehlt —
   sonst stünde über der Seite nichts. Alles Weitere kommt aus dem Dokument
   oder erscheint nicht: Seit Aufgabe 4 füllt kein Beispielinhalt mehr auf.
   Ein ungepflegter Abschnitt ist ein fehlender Abschnitt. */
const eintrag = (await ladeLeistungsliste()).find((l) => l.slug === slug);
const titel = d?.titel || eintrag?.name || "";

/* Die Patientenstimmen sind dieselben wie auf der Startseite — und werden
   deshalb an EINER Stelle gepflegt, im Startseiten-Dokument. Bis Aufgabe 4
   standen sie als Vorgabe im Baustein, sodass jede Seite ihre eigene Kopie
   bekam; wer eine Geschichte änderte, änderte sie nirgends sichtbar.
   Ein zweites Feld je Leistung wäre die falsche Antwort: Es liefe auseinander,
   und niemand pflegt zwölf Mal dieselben fünf Zitate. */
const { storiesEintraege } = await ladeStartseite();

/* Ein Abschnitt ist wahlfrei, aber nicht halb.
 *
 * Das Schema verlangt innerhalb von Intro und Benefits alle Felder — wer den
 * Abschnitt anlegt, füllt ihn auch. Die Abfrage kann das nicht zusagen: GROQ
 * liefert jedes Feld für sich, und TypeGen bildet genau das ab. Die Prüfung
 * steht deshalb hier, an einer Stelle, statt in den Bausteinen als vier
 * einzelne `&&`. Fehlt ein Teil, erscheint der Abschnitt gar nicht — eine
 * Überschrift ohne Text wäre die halbe Wahrheit statt keiner. */
const intro =
  d?.intro?.topline && d.intro.headline && d.intro.spalten?.length
    ? { topline: d.intro.topline, headline: d.intro.headline, spalten: d.intro.spalten }
    : undefined;

const benefits =
  d?.benefits?.topline && d.benefits.headline && d.benefits.eintraege?.length
    ? { topline: d.benefits.topline, headline: d.benefits.headline, eintraege: d.benefits.eintraege }
    : undefined;

const statement =
  d?.statement?.topline && d.statement.text
    ? { topline: d.statement.topline, text: d.statement.text }
    : undefined;

const schritte =
  d?.schritte?.titel && d.schritte.eintraege?.length
    ? { titel: d.schritte.titel, eintraege: d.schritte.eintraege }
    : undefined;
---

{/* Jeder Abschnitt hängt an seinen eigenen Daten. Was das Dokument nicht
    trägt, steht nicht da — das ist der ganze Unterschied zu vorher, wo eine
    ungepflegte Leistung die Abschnitte einer anderen zeigte. */}
<Base title={`${titel} - Mundpropaganda`} description={d?.seoBeschreibung ?? d?.hero?.text}>
  <ServiceHero
    topline={d?.topline}
    titel={titel}
    text={d?.hero?.text}
    bild={d?.hero?.bild}
    alt={d?.hero?.bild?.alt ?? ""}
  />

  {intro && <Intro {...intro} />}

  {benefits && <Benefits {...benefits} />}

  {d?.vorherNachher?.topline && (
    <BeforeAfter topline={d.vorherNachher.topline} vorher={d.vorherNachher.vorher} nachher={d.vorherNachher.nachher} />
  )}

  {statement && <Statement {...statement} />}

  {schritte && <Steps titel={schritte.titel} schritte={schritte.eintraege} />}

  <Stories eintraege={storiesEintraege} />

  {d?.preise?.length ? <Prices preise={d.preise} /> : null}

  {d?.features?.length ? <Features zeilen={d.features} /> : null}

  {/* Die Überschrift stand bis Aufgabe 4 fest im Baustein. Sie gehört hierher:
      Auf der Startseite kommt sie aus dem CMS, hier ist sie auf die Leistung
      bezogen und damit Sache der Seite. */}
  <Magazine
    topline="Passend zum Thema"
    titel="Magazin"
    text={`Weiterlesen zu ${titel} und allem, was damit zusammenhängt: Materialien, Haltbarkeit und die Fragen, die uns dazu am häufigsten gestellt werden.`}
  />

  {d?.faq?.length ? <Faq titel={`Häufige Fragen zu ${titel}`} fragen={d.faq} /> : null}

  <Contact leistung={titel} />
</Base>

