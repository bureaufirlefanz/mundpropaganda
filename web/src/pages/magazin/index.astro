---
/**
 * Die Route. Daten laden, Renderer aufrufen.
 *
 * `/magazin` gab es bis hierher nicht — der Dokumenttyp lag seit Aufgabe 3
 * auf Eis, weil die Route fehlte, und die vier Beiträge standen fest im
 * Markup des Karussells. Beides ist damit aufgelöst.
 */
import Magazin from "../../templates/Magazine.astro";
import { loadPosts, loadMagazineIntro } from "../../lib/magazine";

const kopf = await loadMagazineIntro();
const posts = await loadPosts();
---

<Magazin kopf={kopf} posts={posts} />
