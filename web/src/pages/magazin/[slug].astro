---
/**
 * Eine Route für alle Beiträge. Daten laden, Renderer aufrufen.
 */
import Post from "../../templates/Post.astro";
import { loadPost, loadPosts, loadRelated } from "../../lib/magazine";

// Muss die Ladefunktion importieren, nicht auf Frontmatter-Konstanten
// zugreifen: Astro hebt getStaticPaths in einen eigenen Modulkontext.
export async function getStaticPaths() {
  const posts = await loadPosts();
  return posts.map((b) => ({ params: { slug: b.slug }, props: { title: b.title } }));
}

const { slug } = Astro.params;
const { title } = Astro.props;
const data = await loadPost(slug!);
const related = await loadRelated(data?.category, slug);
---

<Post data={data} title={data?.title || title || ""} related={related} />
