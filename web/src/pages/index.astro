---
/**
 * Die Route. Daten laden, Renderer aufrufen — mehr steht hier nicht.
 *
 * Der Zusammenbau liegt in `templates/Home.astro`, damit die
 * Vorschau-Route aus Aufgabe 6 exakt dasselbe rendern kann. Zwei
 * Zusammenbauten, die dasselbe zeigen sollen, laufen unbemerkt auseinander.
 */
import Home from "../templates/Home.astro";
import { loadHomepage } from "../lib/homepage";
import { loadPosts } from "../lib/magazine";

const data = await loadHomepage();
const posts = await loadPosts();
---

<Home data={data} posts={posts} />
