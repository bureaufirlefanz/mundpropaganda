---
/**
 * Die Route. Daten laden, Renderer aufrufen.
 *
 * Die Seite hing bis hierher an `lib/karriere.ts` und nicht am CMS. Jetzt
 * kommt beides aus dem Datensatz: der Rahmen aus dem Karriere-Dokument, die
 * Stellen aus ihrer eigenen Sammlung.
 */
import Karriere from "../seiten/Karriere.astro";
import { ladeKarriere, ladeStellen } from "../lib/karriere";

const daten = await ladeKarriere();
const stellen = await ladeStellen();
---

<Karriere daten={daten} stellen={stellen} />
