---
/**
 * Die Seite einer Person aus dem Team.
 *
 * Aufgebaut wie ein Porträt und nicht wie ein Lebenslauf: links das Bild,
 * das beim Scrollen stehen bleibt, rechts der Text. Wer hier landet, hat
 * meist einen Namen gehört und will ein Gesicht dazu — das Gesicht soll
 * nicht nach zwei Absätzen verschwinden.
 *
 * Vier Teile, alle wahlfrei bis auf Name und Rolle:
 *
 *   Zitat        ein Satz in eigenen Worten, groß gesetzt
 *   Ausführlich  Werdegang in Absätzen
 *   Stationen    Jahreszahlen, neueste zuerst
 *   Schwerpunkte Verweise auf die Leistungsseiten
 *
 * Die Schwerpunkte sind der eigentliche Gewinn dieser Seite für die Praxis:
 * Wer nach dem Namen sucht, findet über sie die Behandlung. Ohne sie wäre
 * das Porträt eine Sackgasse.
 *
 * Bleibt alles vier leer, ist die Seite kurz — Bild, Name, Rolle,
 * Kurzprofil, zurück zum Team. Das ist ein gültiger Zustand und kein Fehler.
 */
import Base from "../layouts/Base.astro";
import CmsImage from "../components/ui/CmsImage.astro";
import { PortableText } from "astro-portabletext";
import ToothLines from "../components/ui/ToothLines.astro";
import { isCmsImage } from "../lib/images";
import type { PersonContent } from "../lib/practice";

interface Props {
  person: PersonContent;
}

const { person: p } = Astro.props;
---

<Base
  title={p.seo?.title || `${p.name} - ${p.role}`}
  description={p.seo?.description || p.text || ""}
  noIndex={p.seo?.noIndex}
>
  <article class="s-person">
    <ToothLines />

    <div class="container s-person__inner">
      {
        /* Der Weg zurück steht oben und nicht unten: Wer merkt, dass er die
          falsche Person erwischt hat, will sofort zurück und nicht erst an
          einem Lebenslauf vorbei. */
      }
      <a class="s-person__back" href="/praxis#team">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path
            d="M19 12H6M13 5l-7 7 7 7"
            fill="none"
            stroke="currentColor"
            stroke-width="2"></path>
        </svg>
        Team
      </a>

      <div class="s-person__header">
        <div class="s-person__media">
          {
            isCmsImage(p.image) ? (
              <div class="s-person__image">
                <CmsImage
                  source={p.image}
                  alt=""
                  widths={[400, 640, 900, 1200]}
                  sizes="(max-width: 900px) 92vw, 38vw"
                  eager
                />
              </div>
            ) : (
              <div
                class="s-person__image s-person__image--fallback"
                data-surface="brand"
                aria-hidden="true"
              >
                {p.name.replace(/^(Dr\.|Prof\.)\s*/, "").charAt(0)}
              </div>
            )
          }
        </div>

        <div class="s-person__text">
          <h1 class="s-person__name" data-split="lines">{p.name}</h1>
          <p class="s-person__role">{p.role}</p>

          {
            p.quote && (
              <blockquote class="s-person__quote" data-reveal="up">
                {p.quote}
              </blockquote>
            )
          }

          {
            p.text && (
              <p
                class="s-person__intro"
                data-reveal="up"
                data-reveal-delay="0.08"
              >
                {p.text}
              </p>
            )
          }

          {
            p.bio && p.bio.length > 0 && (
              <div
                class="s-person__bio"
                data-reveal="up"
                data-reveal-delay="0.12"
              >
                <PortableText value={p.bio} />
              </div>
            )
          }

          {
            p.milestones && p.milestones.length > 0 && (
              <section class="s-person__milestones">
                <h2 class="s-person__subheading">Stationen</h2>
                <dl class="s-person__list">
                  {p.milestones.map((m) => (
                    <>
                      <dt>{m.year}</dt>
                      <dd>{m.text}</dd>
                    </>
                  ))}
                </dl>
              </section>
            )
          }

          {
            p.languages && p.languages.length > 0 && (
              <section class="s-person__milestones">
                <h2 class="s-person__subheading">Sprachen</h2>
                <p class="s-person__languages">{p.languages.join(", ")}</p>
              </section>
            )
          }

          {
            p.focusAreas && p.focusAreas.length > 0 && (
              <section class="s-person__milestones">
                <h2 class="s-person__subheading">Schwerpunkte</h2>
                <ul class="s-person__focus-areas">
                  {p.focusAreas.map((l) => (
                    <li>
                      <a
                        class="s-person__focus-area"
                        href={`/leistungen/${l.slug}`}
                      >
                        {l.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            p.email && (
              <a class="s-person__mail" href={`mailto:${p.email}`}>
                {p.email}
              </a>
            )
          }
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .s-person {
    position: relative;
    overflow-x: clip;
    padding-block: var(--page-top) var(--section-space);
  }

  .s-person__inner {
    position: relative;
    z-index: 1;
  }

  .s-person__back {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-8);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-text-muted);
  }

  .s-person__back:hover {
    color: var(--c-dark);
  }

  .s-person__back svg {
    transition: translate var(--d-base) var(--e-out);
  }

  .s-person__back:hover svg {
    translate: -4px 0;
  }

  .s-person__header {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: var(--flow-xl);
    align-items: start;
  }

  /* Das Bild bleibt beim Scrollen stehen. Der Text daneben kann lang werden,
     und ein Porträt, das nach zwei Absätzen oben hinausläuft, lässt die
     linke Hälfte der Seite leer stehen. */
  .s-person__media {
    position: sticky;
    top: var(--hero-offset);
  }

  .s-person__image {
    overflow: hidden;
    aspect-ratio: 3 / 4;
    border-radius: clamp(80px, 10vw, 160px) clamp(80px, 10vw, 160px) var(--r-lg)
      var(--r-lg);
    background: var(--c-tint);
  }

  /* :global(img), weil das Bild aus CmsImage.astro kommt. */
  .s-person__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Ohne Porträt: die Initiale auf Markenfläche, kein Platzhaltergesicht. */
  .s-person__image--fallback {
    display: grid;
    place-items: center;
    background: var(--c-brand);
    color: var(--c-text);
    font-size: var(--fs-display-md);
    font-weight: var(--fw-medium);
    line-height: var(--lh-tight);
  }

  .s-person__name {
    font: var(--font-title-page);
    letter-spacing: var(--tracking-title-page);
  }

  .s-person__role {
    font: var(--font-lead);
    margin-top: var(--sp-3);
    color: var(--c-text-muted);
  }

  /* Kein Anführungszeichen als Grafik davor: Der Satz steht groß genug, um
     als Zitat gelesen zu werden, und ein Zierzeichen zöge die
     Aufmerksamkeit auf sich statt auf ihn. Der Strich links ordnet ihn ein. */
  .s-person__quote {
    max-width: 30ch;
    margin: clamp(var(--sp-8), 5vw, var(--sp-10)) 0 0;
    padding-left: var(--sp-6);
    border-left: 2px solid var(--c-brand);
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-regular);
    line-height: var(--lh-compact);
    letter-spacing: var(--tracking-snug);
    text-wrap: balance;
  }

  .s-person__intro {
    font: var(--font-body-long);
    max-width: var(--measure-text);
    margin-top: var(--sp-8);
  }

  .s-person__bio {
    max-width: var(--measure-text);
    margin-top: var(--sp-6);
  }

  .s-person__milestones {
    margin-top: clamp(var(--sp-8), 5vw, var(--sp-10));
  }

  .s-person__subheading {
    margin-bottom: var(--sp-4);
    padding-bottom: var(--sp-3);
    border-bottom: var(--bw) solid var(--c-line);
    font-family: var(--f-mono);
    font-weight: var(--fw-light);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  /* Jahr links, Sache rechts. `max-content` und nicht zwei gleiche Spalten:
     „2016–2019" und „2014" sind unterschiedlich breit, und bei 1fr 1fr
     stünde der Text je Zeile an anderer Stelle. */
  .s-person__list {
    font: var(--font-body);
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--sp-3) var(--sp-6);
    max-width: var(--measure-text);
    margin: 0;
  }

  .s-person__list dt {
    color: var(--c-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .s-person__list dd {
    margin: 0;
  }

  .s-person__languages {
    font-size: var(--fs-text-main);
    line-height: var(--lh-body);
  }

  .s-person__focus-areas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Umrandet und nur leicht gerundet, nicht als Pille — dieselbe Form wie
     die Filter-Tags im Magazin. */
  .s-person__focus-area {
    display: inline-block;
    padding: var(--sp-2) var(--sp-4);
    border: var(--bw) solid var(--c-line);
    border-radius: var(--r-sm);
    font-size: var(--fs-text-small);
    line-height: var(--lh-snug);
    text-decoration: none;
    transition:
      border-color var(--d-base) var(--e-out),
      background var(--d-base) var(--e-out);
  }

  .s-person__focus-area:hover {
    border-color: var(--c-dark);
    background: var(--c-tint-brand);
  }

  /* :global(), weil PortableText das Markup zur Laufzeit erzeugt und das
     Scope-Attribut dieser Datei nicht trägt. */
  .s-person__bio :global(p) {
    font: var(--font-body-long);
  }

  .s-person__bio :global(p + p) {
    margin-top: var(--sp-4);
  }

  .s-person__mail {
    display: inline-block;
    margin-top: clamp(var(--sp-8), 5vw, var(--sp-10));
    font-family: var(--f-mono);
    font-size: var(--fs-text-small);
    letter-spacing: var(--tracking-mono);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .s-person__mail:hover {
    text-decoration-color: var(--c-brand);
    text-decoration-thickness: 2px;
  }

  @media (max-width: 900px) {
    .s-person {
      padding-block: var(--page-top-sm) var(--section-space-sm);
    }

    .s-person__header {
      grid-template-columns: 1fr;
    }

    /* Kein Kleben, wenn gestapelt wird — das Bild verdeckte sonst den Text,
       den es begleiten soll. */
    .s-person__media {
      position: static;
    }

    .s-person__image {
      aspect-ratio: 4 / 3;
    }
  }
</style>
