---
/**
 * Der Zusammenbau einer Leistungsseite.
 *
 * Bekommt alles als Prop und lädt nichts — dieselbe Bedingung wie bei
 * `Home.astro`: Die Vorschau-Route aus Aufgabe 6 reicht Entwurfsdaten
 * herein, wo hier die veröffentlichten stehen, und rendert dadurch
 * garantiert dasselbe.
 *
 * Jeder Abschnitt hängt an seinen eigenen Daten. Was das Dokument nicht
 * trägt, steht nicht da — das ist der Unterschied zu vor Aufgabe 4, wo eine
 * ungepflegte Leistung die Abschnitte einer anderen zeigte.
 */
import Base from "../layouts/Base.astro";
import ServiceHero from "../components/sections/ServiceHero.astro";
import Intro from "../components/sections/Intro.astro";
import Statement from "../components/sections/Statement.astro";
import Prices from "../components/sections/Prices.astro";
import Benefits from "../components/sections/Benefits.astro";
import BeforeAfter from "../components/sections/BeforeAfter.astro";
import Steps from "../components/sections/Steps.astro";
import Stories from "../components/sections/Stories.astro";
import Features from "../components/sections/Features.astro";
import Magazine from "../components/sections/Magazine.astro";
import Faq from "../components/sections/Faq.astro";
import TextColumns from "../components/sections/TextColumns.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import Contact from "../components/sections/Contact.astro";
import type { Service } from "../lib/services";
import type { HomepageContent } from "../lib/homepage";
import type { Post } from "../lib/magazine";

interface Props {
  data: Service | undefined;
  /** Aus der Liste, falls das Dokument fehlt — sonst stünde oben nichts. */
  title: string;
  /** Entscheidet, ob das Angebotsformular unten steht. Siehe MIT_FORMULAR. */
  slug: string;
  /** Dieselben Stimmen wie auf der Startseite, dort gepflegt. */
  stories: HomepageContent["storiesItems"];
  /** Beiträge, die im Studio auf genau diese Leistung verweisen. */
  posts: Post[];
}

const { data: d, title, slug, stories, posts } = Astro.props;

/* Wo das Angebotsformular steht.
 *
 * Es stand bis hierher unter jeder Leistungsseite, jeder Praxis-, Magazin-
 * und Beitragsseite. „Unverbindliches Angebot anfordern" ist aber kein
 * allgemeiner Kontaktweg, sondern eine Frage nach einem Kostenvoranschlag —
 * und die ergibt nur dort Sinn, wo es etwas zu veranschlagen gibt.
 *
 * Die Liste steht hier und nicht im CMS, weil sie eine Entscheidung über den
 * Auftritt ist und keine Pflege. Kommt eine Leistung dazu, gehört sie
 * bewusst eingetragen.
 *
 * Überall sonst führt `#kontakt` in den Fuß — dort stehen Telefon, E-Mail,
 * beide Anschriften und die Zeiten. Siehe `contactSection` in
 * `layouts/Base.astro`. */
const MIT_FORMULAR = ["veneers", "keramikinlays"];
const zeigtFormular = MIT_FORMULAR.includes(slug);

/* Ein Abschnitt ist wahlfrei, aber nicht halb.
 *
 * Das Schema verlangt innerhalb von Intro und Benefits alle Felder — wer den
 * Abschnitt anlegt, füllt ihn auch. Die Abfrage kann das nicht zusagen: GROQ
 * liefert jedes Feld für sich, und TypeGen bildet genau das ab. Die Prüfung
 * steht deshalb hier, an einer Stelle, statt in den Bausteinen als vier
 * einzelne `&&`. Fehlt ein Teil, erscheint der Abschnitt gar nicht — eine
 * Überschrift ohne Text wäre die halbe Wahrheit statt keiner. */
const intro =
  d?.intro?.topline && d.intro.headline && d.intro.columns?.length
    ? {
        topline: d.intro.topline,
        headline: d.intro.headline,
        columns: d.intro.columns,
      }
    : undefined;

const benefits =
  d?.benefits?.topline && d.benefits.headline && d.benefits.items?.length
    ? {
        topline: d.benefits.topline,
        headline: d.benefits.headline,
        items: d.benefits.items,
      }
    : undefined;

const statement =
  d?.statement?.topline && d.statement.text
    ? { topline: d.statement.topline, text: d.statement.text }
    : undefined;

const steps =
  d?.steps?.title && d.steps.items?.length
    ? { title: d.steps.title, items: d.steps.items }
    : undefined;

/* Die Textstrecken tragen ihre Position selbst.
 *
 * Eine Leistungsseite hat eine feste Abfolge, und das soll sie behalten —
 * ein Baukasten, in dem sich jeder Abschnitt überallhin schieben lässt, hat
 * am Ende auf jeder Seite eine andere Dramaturgie. Gleichzeitig gehört der
 * Text „Für wen kommen Veneers infrage" VOR die drei Arten und der über die
 * Kosten HINTER die Preise. Ein einziger fester Platz träfe immer nur einen
 * von beiden.
 *
 * Deshalb sagt `placement` am Eintrag, hinter welchem Abschnitt er steht,
 * und die Vorlage fragt an vier Stellen nach. Die Reihenfolge innerhalb
 * einer Stelle ist die der Liste im Studio.
 *
 * Dieselbe Bedingung wie bei Intro und Benefits: wahlfrei, aber nicht halb.
 * Ohne Überschrift oder ohne Spalten erscheint der Abschnitt nicht — eine
 * Überschrift über einer leeren Fläche wäre die halbe Wahrheit statt keiner.
 */
const textSectionsAt = (placement: string) =>
  (d?.textSections ?? []).filter(
    (s) => s.placement === placement && s.headline && s.columns?.length,
  );

/* Das Handlungsband. Die Überschrift trägt es, alles andere ist wahlfrei.
 *
 * Der Knopf zeigt immer auf `#kontakt` — die einzige Adresse, die es auf
 * jeder Seite gibt: entweder das Angebotsformular unten (siehe
 * MIT_FORMULAR) oder der Seitenfuß, der die Marke sonst übernimmt
 * (`layouts/Base.astro`). Ein Zielfeld im Studio hätte hier nur eine
 * sinnvolle Belegung und dafür jede unsinnige zugelassen. */
const ctaBand = d?.ctaBand?.headline ? d.ctaBand : undefined;
---

<Base
  title={d?.seo?.title || `${title} - Mundpropaganda`}
  description={d?.seo?.description ?? d?.hero?.text}
  noIndex={d?.seo?.noIndex}
  contactSection={zeigtFormular}
>
  <ServiceHero
    topline={d?.topline}
    title={title}
    slug={slug}
    text={d?.hero?.text}
    image={d?.hero?.image}
    alt={d?.hero?.image?.alt ?? ""}
  />

  {intro && <Intro {...intro} />}

  {
    textSectionsAt("intro").map((s) => (
      <TextColumns
        topline={s.topline}
        headline={s.headline!}
        lead={s.lead}
        columns={s.columns!}
        items={s.items}
      />
    ))
  }

  {benefits && <Benefits {...benefits} />}

  {
    d?.beforeAfter?.topline && (
      <BeforeAfter
        topline={d.beforeAfter.topline}
        before={d.beforeAfter.before}
        after={d.beforeAfter.after}
      />
    )
  }

  {statement && <Statement {...statement} />}

  {
    textSectionsAt("statement").map((s) => (
      <TextColumns
        topline={s.topline}
        headline={s.headline!}
        lead={s.lead}
        columns={s.columns!}
        items={s.items}
      />
    ))
  }

  {steps && <Steps title={steps.title} steps={steps.items} />}

  {
    textSectionsAt("steps").map((s) => (
      <TextColumns
        topline={s.topline}
        headline={s.headline!}
        lead={s.lead}
        columns={s.columns!}
        items={s.items}
      />
    ))
  }

  {
    /* Die Einladung zwischen den Kapiteln — dieselbe Karte wie auf der Pillar
      Page, hier hinter dem Ablauf: Wer gerade gelesen hat, wie es geht,
      fragt sich, ob es für ihn passt. Das Motiv fällt auf das gestaltete
      Bild zurück, wie bei Split, Experts und Stories auch; ohne Bild stünde
      die Karte auf einer leeren Fläche. */
  }
  {
    ctaBand && (
      <CtaBand
        headline={ctaBand.headline!}
        text={ctaBand.text}
        actionLabel={ctaBand.actionLabel}
        actionHref="#kontakt"
        image={ctaBand.image ?? "beratung-patientin"}
        alt={ctaBand.image?.alt ?? ""}
      />
    )
  }

  <Stories items={stories} />

  {d?.pricing?.length ? <Prices pricing={d.pricing} /> : null}

  {
    textSectionsAt("pricing").map((s) => (
      <TextColumns
        topline={s.topline}
        headline={s.headline!}
        lead={s.lead}
        columns={s.columns!}
        items={s.items}
      />
    ))
  }

  {d?.features?.length ? <Features lines={d.features} /> : null}

  {
    /* Nur Beiträge, die im Studio auf diese Leistung verweisen — dafür ist die
      Referenz im Schema da. Gibt es keine, entfällt der Abschnitt; ein
      Karussell, das dieselben vier Beiträge unter jeder Behandlung zeigt,
      war genau das Muster, das Aufgabe 4 abgeräumt hat. */
  }
  {
    posts.length > 0 && (
      <Magazine
        topline="Passend zum Thema"
        title="Magazin"
        text={`Weiterlesen zu ${title} und allem, was damit zusammenhängt.`}
        posts={posts}
      />
    )
  }

  {
    d?.faq?.length ? (
      <Faq title={`Häufige Fragen zu ${title}`} questions={d.faq} />
    ) : null
  }

  {zeigtFormular && <Contact service={title} />}
</Base>
