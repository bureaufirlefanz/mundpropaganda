---
/**
 * Der Zusammenbau der Karriereseite.
 *
 * Fünf eigene Bausteine, drei geliehene. Die Seite soll nicht aussehen wie
 * eine Leistungsseite mit anderem Text — geteilt sind nur der Seitenkopf
 * (damit sie zur Seite gehört), das Panel und das FAQ.
 *
 * Aufbau, und warum in dieser Reihenfolge:
 *   Hero      Wer sucht, und wofür
 *   Intro     Warum hier und nicht woanders — die Haltung
 *   Facts     Vier überprüfbare Angaben statt Versprechen         (eigener Baustein)
 *   Compare   Übliche Bedingungen gegen unsere, Zeile für Zeile   (eigener Baustein)
 *   Jobs      Der eigentliche Zweck der Seite. Steht in der Mitte,
 *             nicht am Ende: Wer wegen einer Stelle kommt, soll
 *             nicht erst durch die Selbstdarstellung scrollen.    (eigener Baustein)
 *   Voices    Drei Stimmen aus dem Team, versetzt gesetzt         (eigener Baustein)
 *   Timeline  Der Bewerbungsablauf als Bahn — nimmt die Hürde     (eigener Baustein)
 *   Panel     Initiativbewerbung, für alle ohne passende Stelle
 *   Faq       Was sonst noch gefragt wird
 *
 * Alle Inhalte kommen aus dem CMS. Bis hierher standen sie als 291 Zeilen in
 * `lib/karriere.ts` — vier Stellenausschreibungen darunter, die sich weder
 * ändern noch abschalten ließen. Jeder Abschnitt hängt an seinen eigenen
 * Daten: Was das Dokument nicht trägt, erscheint nicht.
 */
import Base from "../layouts/Base.astro";
import CareersHero from "../components/sections/CareersHero.astro";
import Intro from "../components/sections/Intro.astro";
import Facts from "../components/sections/Facts.astro";
import Compare from "../components/sections/Compare.astro";
import Jobs from "../components/sections/Jobs.astro";
import Timeline from "../components/sections/Timeline.astro";
import Voices from "../components/sections/Voices.astro";
import VideoBlock from "../components/sections/VideoBlock.astro";
import Perks from "../components/sections/Perks.astro";
import Reasons from "../components/sections/Reasons.astro";
import Application from "../components/sections/Application.astro";
import Panel from "../components/ui/Panel.astro";
import Button from "../components/ui/Button.astro";
import Faq from "../components/sections/Faq.astro";
import { applicationLink, type CareersContent, type Job } from "../lib/careers";
import { resolved } from "../lib/navigation";

interface Props {
  data: CareersContent | undefined;
  jobs: Job[];
}

const { data: d, jobs } = Astro.props;

const action = (await resolved([d?.action ?? null], Astro.url.pathname))[0];

/* Wahlfrei, aber nicht halb — dieselbe Regel wie auf der Leistungsseite:
   Wer einen Abschnitt anlegt, füllt ihn. Die Abfrage kann das nicht zusagen,
   also steht die Prüfung hier an einer Stelle. */
const intro =
  d?.introTopline && d.introHeadline && d.introColumns?.length
    ? { topline: d.introTopline, headline: d.introHeadline, columns: d.introColumns }
    : undefined;

const figures =
  d?.figuresTopline && d.figuresHeadline && d.figuresItems?.length
    ? { topline: d.figuresTopline, headline: d.figuresHeadline, figures: d.figuresItems }
    : undefined;

const comparison =
  d?.comparisonTopline && d.comparisonHeadline && d.comparisonColumns?.length && d.comparisonRows?.length
    ? {
        topline: d.comparisonTopline,
        headline: d.comparisonHeadline,
        columns: d.comparisonColumns,
        lines: d.comparisonRows,
        note: d.comparisonNote ?? undefined,
      }
    : undefined;

const voices =
  d?.voicesTopline && d.voicesHeadline && d.voicesItems?.length
    ? { topline: d.voicesTopline, headline: d.voicesHeadline, voices: d.voicesItems }
    : undefined;

const process =
  d?.processHeadline && d.processStages?.length
    ? { headline: d.processHeadline, stages: d.processStages }
    : undefined;

const week =
  d?.weekTopline && d.weekHeadline && d.weekText
    ? { topline: d.weekTopline, headline: d.weekHeadline, text: d.weekText }
    : undefined;

const perks =
  d?.benefitsTopline && d.benefitsHeadline && d.benefitsItems?.length
    ? { topline: d.benefitsTopline, headline: d.benefitsHeadline, items: d.benefitsItems }
    : undefined;

const reasons =
  d?.reasonsTopline && d.reasonsHeadline && d.reasonsItems?.length
    ? { topline: d.reasonsTopline, headline: d.reasonsHeadline, items: d.reasonsItems }
    : undefined;

/* Die Stellen sind der Zweck der Seite. Ohne ausgeschriebene Stelle entfällt
   der Abschnitt — dann trägt die Initiativbewerbung darunter die Seite. */
const showJobs = Boolean(d?.jobsTopline && d.jobsHeadline && jobs.length);
---

<Base
  title={d?.seo?.title || "Karriere - Mundpropaganda"}
  description={d?.seo?.description || d?.lead || ""}
  noIndex={d?.seo?.noIndex}
>
  <CareersHero
    title={d?.title ?? "Karriere"}
    topline={d?.topline}
    image={d?.image}
    alt={d?.image?.alt ?? ""}
  />

  {intro && <Intro {...intro} lead={d?.lead} action={action?.text} actionHref={action?.href} />}

  {/* Das Video steht direkt hinter der Haltung: Es zeigt, was der Absatz
      darüber behauptet. Weiter unten, zwischen Vergleichstabelle und
      Stellen, wäre es eine Unterbrechung. */}
  {d?.videoUrl && (
    <VideoBlock url={d.videoUrl} title={d.videoTitle ?? undefined} poster={d.videoPoster} />
  )}

  {figures && <Facts {...figures} />}

  {/* Die 4-Tage-Woche als eigener Block und nicht als Zeile in der Liste
      darunter — sie ist das Argument, das die Seite trägt. */}
  {week && <Panel id="vier-tage" topline={week.topline} title={week.headline} text={week.text} />}

  {perks && <Perks {...perks} />}

  {comparison && <Compare {...comparison} />}

  {reasons && <Reasons {...reasons} />}

  {showJobs && d && (
    <Jobs
      id="stellen"
      topline={d.jobsTopline!}
      headline={d.jobsHeadline!}
      jobs={jobs}
      applicationEmail={d.applicationEmail ?? ""}
      text={d.jobsText ?? undefined}
    />
  )}

  {voices && <Voices {...voices} />}

  {process && <Timeline {...process} />}

  {/* Hinter dem Ablauf: Erst weiß man, was einen erwartet, dann bewirbt man
      sich. Davor wäre das Formular eine Aufforderung ohne Auskunft. */}
  <Application
    id="bewerben"
    topline="Bewerbung"
    headline="In vier Schritten zu uns"
    text="Wähle die Stelle, auf die du dich bewirbst - die Fragen richten sich danach."
    jobs={jobs}
    fallbackEmail={d?.applicationEmail ?? undefined}
  />

  {d?.speculativeTopline && d.speculativeTitle && (
    <Panel
      id="initiativ"
      topline={d.speculativeTopline}
      title={d.speculativeTitle}
      text={d.speculativeText ?? undefined}
    >
      <div class="c-speculative">
        {d.speculativeParagraph && <p>{d.speculativeParagraph}</p>}
        {d.applicationEmail && (
          <div class="c-speculative__action">
            <Button label="Initiativ bewerben" href={applicationLink(d.applicationEmail)} />
            <a class="c-speculative__mail" href={`mailto:${d.applicationEmail}`}>{d.applicationEmail}</a>
          </div>
        )}
      </div>
    </Panel>
  )}

  {d?.faqTitle && d.faq?.length ? <Faq title={d.faqTitle} questions={d.faq} /> : null}
</Base>

<style>
  .c-speculative {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    max-width: 52ch;
    font-size: var(--fs-text-large);
    line-height: 1.45;
  }

  .c-speculative__action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4) var(--sp-6);
  }

  /* Die Adresse steht neben dem Knopf, nicht statt seiner: Manche schreiben
     lieber aus ihrem eigenen Postfach, statt einen mailto-Link zu öffnen. */
  .c-speculative__mail {
    font-family: var(--f-mono);
    font-size: var(--fs-text-small);
    letter-spacing: 0.04em;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .c-speculative__mail:hover {
    text-decoration-color: var(--c-brand);
    text-decoration-thickness: 2px;
  }
</style>
