---
/**
 * The emergency page, `/notdienst`.
 *
 * Gets everything as a prop and loads nothing, like the other templates: the
 * preview route hands in drafts where the real route hands in the published
 * state, and both render the same thing.
 *
 * ── What this page is for ────────────────────────────────────────────────
 *
 * Someone in pain, on a phone, deciding within minutes. So the phone number
 * comes before any running text: the hero's button dials, and it sits in the
 * first screen on mobile. The rest of the page answers the next three
 * questions in order — when to come, where to go when we are closed, what to
 * do until then — and only then costs and questions.
 *
 * No stories, no magazine, no offer form. This page sends people elsewhere on
 * purpose (nights, weekends, A&E), and a sales block between "call 112" and
 * the number of the Charité would read as exactly that.
 *
 * ── Building blocks ──────────────────────────────────────────────────────
 *
 * Nothing new: `ServiceHero` for the head, `SectionHeading` + `Prose` for the
 * text sections (the pairing from the pillar page, with Portable Text so the
 * emergency numbers can be `tel:` links), `Faq`, and `CtaBand` at the end.
 *
 * The hero takes the title as `claim`. On a service page the claim replaces
 * the service name; here the title IS a sentence ("Zahnarzt Notdienst in
 * Berlin: schnelle Hilfe bei Zahnschmerzen"), and the claim styling is the
 * one that sets a sentence instead of a single huge word. It stays the one
 * `<h1>` of the page.
 */
import Base from "../layouts/Base.astro";
import ServiceHero from "../components/sections/ServiceHero.astro";
import Prose from "../components/sections/Prose.astro";
import Faq from "../components/sections/Faq.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import { headingsFromSections } from "../lib/table-of-contents";
import { telLink } from "../lib/settings";
import type { EmergencyContent } from "../lib/emergency";
import type { PortableTextBlock } from "@portabletext/types";

interface Props {
  data: EmergencyContent | undefined;
  /** The practice's number, from the settings. */
  phone: string;
}

const { data: d, phone } = Astro.props;

const title = d?.title || "Notdienst";
const call = phone ? telLink(phone) : "#kontakt";

/* A section is optional but never half: heading and text, or nothing. */
const sections = (d?.sections ?? []).filter(
  (s) => s.headline && s.body?.length,
);

/* Anchors from the same `idFrom()` as everywhere else, so `#notdienst-nachts-…`
   is predictable from the heading. */
const anchors = headingsFromSections(sections.map((s) => s.headline));

/* TypeGen marks `children` optional, `PortableTextBlock` requires it — the
   same gap `withHeadingIds()` bridges for the posts. The schema makes the
   text required, so a block without children does not reach this page. */
const bodyOf = (section: (typeof sections)[number]) =>
  section.body as PortableTextBlock[];

const closing = d?.closing?.headline ? d.closing : undefined;

/* Until the document is published the route still builds, with the title
   fallback and the call button only. Such a page must not reach a search
   index, hence `noIndex` when there is no document at all. */
---

<Base
  title={d?.seo?.title || `${title} - Mundpropaganda`}
  description={d?.seo?.description || d?.lead || ""}
  noIndex={d ? d.seo?.noIndex : true}
>
  <ServiceHero
    title={title}
    claim={title}
    slug="notdienst"
    text={d?.lead}
    image={d?.image}
    alt={d?.image?.alt ?? ""}
    action={d?.actionLabel || "Jetzt anrufen"}
    actionHref={call}
    textFirst
  />

  {
    sections.map((section, i) => (
      <>
        <SectionHeading number={i + 1} headline={section.headline!} />
        <Prose
          id={anchors[i]!.id}
          body={bodyOf(section)}
          note={
            section.warning
              ? { variant: "warning", text: section.warning }
              : undefined
          }
        />
      </>
    ))
  }

  {d?.faq?.length ? <Faq questions={d.faq} /> : null}

  {
    closing && (
      <CtaBand
        headline={closing.headline!}
        text={closing.text}
        actionLabel={closing.actionLabel || "Jetzt anrufen"}
        actionHref={call}
      />
    )
  }
</Base>
