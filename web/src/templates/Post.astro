---
/**
 * Der Zusammenbau einer Beitragsseite.
 *
 * Editorial gesetzt, und das heißt hier drei Dinge:
 *
 * **Der Titel liegt auf dem Bild, nicht darunter.** Als eigene Fläche, die
 * sich über die Unterkante schiebt. Ein Titel unter einem randlosen Bild
 * liest sich als zweiter Anfang; so ist es einer.
 *
 * **Die Nebenangaben stehen im Rand, nicht in einer Zeile über dem Titel.**
 * Das war der Auftrag: Tag, Datum und Autor voneinander trennen. In einer
 * Reihe aus gleicher Schrift und gleicher Farbe unterscheidet sie niemand —
 * der Tag ist eine Eigenschaft des Beitrags, das Datum eine Tatsache über
 * ihn, der Autor ein Mensch. Drei verschiedene Dinge, drei Ebenen.
 *
 * **Die Textspalte bleibt bei 68 Zeichen, der Rand daneben wird benutzt.**
 * Nicht durch Verbreitern — das kostet Lesbarkeit —, sondern durch das, was
 * hineinragen darf: die Nebenangaben, die Nummern der Zwischentitel und
 * Bilder, die die Redaktion auf „über die Spalte hinaus" stellt.
 *
 * Der Fließtext ist Portable Text. Die Bausteine sind knapp gehalten, weil
 * das Schema die Auswahl schon begrenzt: Absatz, Zwischentitel, Unterpunkt,
 * Aufzählung, Bild. Kein h1 — den setzt diese Seite.
 */
import { PortableText } from "astro-portabletext";
import Base from "../layouts/Base.astro";
import CmsImage from "../components/ui/CmsImage.astro";
import Picture from "../components/ui/Picture.astro";
import Button from "../components/ui/Button.astro";
import PostCard from "../components/ui/PostCard.astro";
import SectionDock from "../components/ui/SectionDock.astro";
import TextHeading from "../components/ui/TextHeading.astro";
import PostImage from "../components/ui/PostImage.astro";
import PostTable from "../components/ui/PostTable.astro";
import { isCmsImage } from "../lib/images";
import { loadServiceList } from "../lib/service-list";
import { headingsFrom, withHeadingIds } from "../lib/table-of-contents";
import {
  categoryLabel,
  dateLabel,
  readingTime,
  motifFor,
  type Post,
  type FullPost,
} from "../lib/magazine";

interface Props {
  data: FullPost | undefined;
  /** Aus der Liste, falls das Dokument fehlt. */
  title: string;
  /** Beiträge derselben Kategorie. Leer, wenn es keine gibt. */
  related?: Post[];
}

const { data: d, title, related = [] } = Astro.props;

const description = d?.seo?.description || d?.lead || "";

/* Ab drei Zwischentiteln lohnt sich ein Verzeichnis. Bei zweien ist es keine
   Orientierung, sondern eine Dopplung der Überschriften, die man beim
   Scrollen ohnehin sieht. */
const headings = headingsFrom(d?.text);
const showToc = headings.length >= 3;
const blocks = withHeadingIds(d?.text, headings);
const minutes = readingTime(d?.text);

/* The way back to the service carries the name it has in menu and footer
   (`shortName`, falling back to the title), not the page title. The Button
   is a one-line pill and does not wrap: "Zur Leistung: Prophylaxe /
   Professionelle Zahnreinigung" ran 166px past the edge of a 320px phone.
   The prefix had to go as well — measured, "Zur Leistung: Wurzelbehandlung"
   is still 297px against 288px of room. The name alone fits every service
   down to 320px, the longest being "Zahnersatz / Prothetik" at 214px. */
const serviceSlug = d?.service?.slug;
const serviceName = serviceSlug
  ? ((await loadServiceList()).find((s) => s.slug === serviceSlug)?.name ??
    d?.service?.title ??
    "")
  : "";
---

<Base
  title={d?.seo?.title || `${title} - Mundpropaganda`}
  description={description}
  noIndex={d?.seo?.noIndex}
>
  <article class="s-post">
    {/* --- Kopf: Bild über die volle Breite, Titel darauf ---------------- */}
    <header class="s-post__header">
      {
        /* Ohne Bild im CMS dasselbe Ersatzmotiv wie auf der Karte im Raster
          und im Karussell — sonst zeigte ein Beitrag in der Übersicht ein
          Bild und auf seiner eigenen Seite ein anderes. */
      }
      <div class="s-post__headerimage">
        {
          isCmsImage(d?.previewImage) ? (
            <CmsImage
              source={d.previewImage}
              alt=""
              widths={[640, 1024, 1600, 2200]}
              sizes="(max-width: 700px) and (orientation: portrait) 78vh, 100vw"
              eager
            />
          ) : (
            <Picture
              name={motifFor(d?.slug)}
              alt=""
              sizes="(max-width: 700px) and (orientation: portrait) 78vh, 100vw"
              eager
            />
          )
        }
      </div>

      <div class="container s-post__headline">
        <div class="s-post__titlecard" data-surface="card">
          {
            d?.category && (
              <span class="s-post__tag" data-surface="dark">
                {categoryLabel(d.category)}
              </span>
            )
          }
          <h1 class="s-post__title" data-split="lines">{title}</h1>
          {
            d?.lead && (
              <p class="s-post__lead" data-reveal="up">
                {d.lead}
              </p>
            )
          }
        </div>

        {
          /* Die Nebenangaben stehen NEBEN der Titelkarte, nicht im Rand des
            Fließtextes. Damit sind sie dort, wo man sie sucht — beim Titel —
            und trotzdem vom Titel getrennt: eigene Spalte, eigene Ebene,
            eigener Schnitt. Tag, Datum und Autor sind drei verschiedene
            Dinge und sehen jetzt auch so aus. */
        }
        <div class="s-post__facts">
          <dl class="s-post__factlist">
            {
              d?.date && (
                <div class="s-post__fact">
                  <dt>Erschienen</dt>
                  <dd>
                    <time datetime={d.date}>{dateLabel(d.date)}</time>
                  </dd>
                </div>
              )
            }
            <div class="s-post__fact">
              <dt>Lesezeit</dt>
              <dd>{minutes} {minutes === 1 ? "Minute" : "Minuten"}</dd>
            </div>
          </dl>

          {
            /* Ohne Autor steht hier nichts. Kein „Redaktion" als Notbehelf:
              Das ist eine Behauptung über eine Urheberschaft. */
          }
          {
            d?.author?.name && (
              <div class="s-post__author">
                {isCmsImage(d.author.image) && (
                  <div class="s-post__authorimage">
                    <CmsImage
                      source={d.author.image}
                      alt=""
                      widths={[96, 192]}
                      sizes="48px"
                    />
                  </div>
                )}
                <div>
                  <p class="s-post__authorname">{d.author.name}</p>
                  {d.author.role && (
                    <p class="s-post__authorrole">{d.author.role}</p>
                  )}
                </div>
              </div>
            )
          }
        </div>
      </div>
    </header>

    {/* --- Satz: Verzeichnis, Text, Randspalte --------------------------- */}
    {
      d?.text && (
        <div class="container s-post__body">
          <div class="s-post__column">
            <div class="s-post__text" data-toc-bereich>
              <PortableText
                value={blocks}
                components={{
                  block: { h2: TextHeading, h3: TextHeading },
                  type: { inlineImage: PostImage, table: PostTable },
                }}
              />

              {/* Der Rückweg zur Leistung, wenn der Beitrag auf eine verweist.
                Das ist der Gewinn der Referenz im Schema: Sie trägt in beide
                Richtungen. */}
              {d?.service?.slug && (
                <div class="s-post__back">
                  <Button
                    label={serviceName}
                    href={`/leistungen/${d.service.slug}`}
                    variant="dark"
                  />
                </div>
              )}
            </div>
          </div>
        </div>
      )
    }
  </article>

  {
    /* --- Weiterlesen ------------------------------------------------------
      Nur echte Treffer aus derselben Kategorie. Kein Auffüllen mit den
      neuesten Beiträgen: „Ähnliche Beiträge", unter denen etwas Unähnliches
      steht, ist dieselbe stille Behauptung, die Aufgabe 4 abgeräumt hat. */
  }
  {
    related.length > 0 && (
      <section class="container s-more">
        <div class="s-more__head">
          <span class="c-topline" data-reveal="fade">
            Weiterlesen
          </span>
          <h2 class="s-more__title" data-split="lines">
            Mehr aus {categoryLabel(d?.category)}
          </h2>
        </div>

        <div class="s-more__grid" data-reveal-stagger="0.06">
          {related.map((p) => (
            <PostCard
              post={p}
              sizes="(max-width: 640px) 94vw, (max-width: 1000px) 47vw, 31vw"
              withButton
              data-reveal-child
            />
          ))}
        </div>
      </section>
    )
  }

  {
    /* Kein Kontaktabschnitt mehr. „Unverbindliches Angebot anfordern" ist die
      Frage nach einem Kostenvoranschlag, nicht der allgemeine Kontaktweg —
      sie steht nur noch dort, wo es etwas zu veranschlagen gibt (Veneers,
      Keramikinlays, Pillar Page).

      Die Sprungmarke `#kontakt` bleibt trotzdem erreichbar: Sie sitzt jetzt
      am Fuß, siehe `contactSection` in `layouts/Base.astro`. Die vier bis
      sieben Verweise aus Menü, Fuß und den „Termin buchen"-Buttons führen
      damit zu Telefon, E-Mail, beiden Anschriften und den Zeiten. */
  }

  {
    /* The table of contents lives in the section dock alone (since
       2026-10-14): the pill at the bottom edge reads "Inhalt", opens into the
       list of chapters (h2 only, the sub-headings stay in the text), and
       names the current chapter once the text is reached.
       Beside the text (200px next to a 68ch column) and in the head it was
       lost or made the head taller than the title card. */
  }
  {
    showToc && (
      <SectionDock
        headings={headings.filter((h) => h.level === 2)}
        label="Abschnitte in diesem Beitrag"
        rangeEnd="[data-toc-bereich]"
        idleLabel="Inhalt"
        activeLine="pill"
      />
    )
  }
</Base>

<style>
  .s-post {
    --card-inset: clamp(var(--sp-6), 3vw, var(--sp-10));
    /* The one width of the page: title card, facts and text column share
       it and sit centred. Inside it the text runs at the long measure; the
       card is wider by its own inset on both sides. */
    --post-width: calc(var(--measure-long) + 2 * var(--card-inset));
    padding-bottom: var(--section-space);
  }

  /* --- Kopf -------------------------------------------------------------
     Bild über die volle Breite, darauf die Titelfläche. Sie zieht sich mit
     einer negativen Marge über die Unterkante des Bildes; die Höhe des Bildes
     ist deshalb so bemessen, dass darunter noch Platz bleibt.
     -------------------------------------------------------------------- */
  /* `sizes` in the markup depends on this height: on a portrait phone the
     box is taller than wide, and a 3:2 photo covering 52vh needs 78vh of
     width. */
  .s-post__headerimage {
    height: clamp(300px, 52vh, 620px);
    overflow: hidden;
    background: var(--c-tint);
  }

  /* :global(img), weil das Bild aus CmsImage.astro bzw. Picture.astro kommt. */
  .s-post__headerimage :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Title card, the facts in one row beneath it. Until 2026-10-14 the facts
     stood in a second column to the right of the card on wide screens; the
     row below the card is the one form now, at every width. */
  .s-post__headline {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .s-post__titlecard {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--post-width);
    /* Weniger tief im Bild als zuerst gesetzt. Bei -140px lag die Oberkante
       mitten im Motiv und der Titel stand fast auf dem Bild statt davor. */
    margin-top: clamp(-88px, -5.5vw, -44px);
    margin-inline: auto;
    padding: var(--card-inset);
    border-radius: var(--r-md);
    /* Weiß wie die Karten in der Magazin-Übersicht — dieselbe Fläche, die
       dort einen Beitrag trägt, trägt hier seinen Titel. Auf dem
       Seitengrund (--c-bg) hob sie sich nicht ab und las sich als Loch im
       Bild statt als Karte darauf. */
    background: var(--c-white);
    color: var(--c-text);
  }

  /* Der Tag als eigene Zeile über dem Titel, nicht als Teil einer Meta-Reihe.
     Braun auf dem Seitengrund: 8,4:1. */
  .s-post__tag {
    display: inline-block;
    margin-bottom: var(--sp-4);
    padding: 5px var(--sp-3) 6px;
    border-radius: var(--r-sm);
    background: var(--c-dark);
    color: var(--c-text);
    font-family: var(--f-mono);
    font-weight: var(--fw-light);
    font-size: var(--fs-label);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .s-post__title {
    font: var(--font-title-page);
    letter-spacing: var(--tracking-title-page);
  }

  /* `--c-text-muted` comes from the card surface on the title card, so it
     is measured against white, not against the page ground. */
  .s-post__lead {
    font: var(--font-lead);
    margin-top: var(--sp-5);
    color: var(--c-text-muted);
  }

  /* --- Satz -------------------------------------------------------------
     Zwei Ebenen. Außen das Verzeichnis neben dem Inhalt, innen der Text neben
     seinem Rand. Zwei Raster statt eines dreispaltigen, weil die Kinder des
     Textblocks keine Rasterzellen wären — ein Bild könnte dann nicht über die
     Spalte hinausreichen.
     -------------------------------------------------------------------- */
  /* The text starts on the line of the title in the card above, not on the
     card's edge: the same inset as the card's padding, defined once as
     `--card-inset` on `.s-post`. Two starts on two lines read as a jump. */
  .s-post__body {
    padding-top: var(--sp-10);
  }

  /* Centred under the card at the card's width, the text inset like the
     card's. A size container so that a wide image can measure the text
     width in `cqi`, see the wide image below. Until 2026-10-14 the text
     stood at the left edge with a margin track for wide images beside it. */
  .s-post__column {
    container-type: inline-size;
    max-width: var(--post-width);
    margin-inline: auto;
    padding-inline: var(--card-inset);
  }

  .s-post__text {
    min-width: 0;
  }

  /* Die Angaben sitzen auf der Grundlinie der Titelkarte, nicht an deren
     Oberkante: Der Titel ist unterschiedlich hoch, die Unterkante ist die
     einzige Linie, die beide teilen. */
  /* Same width as the card, inset like its text: the facts start on the
     line of the title. */
  .s-post__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-6);
    /* `width: 100%` is not optional: as a grid item with auto margins the
       row would shrink to its content and centre that, 70px off the title's
       line. With a width it fills up to the card's width like the card. */
    width: 100%;
    max-width: var(--post-width);
    margin-top: var(--sp-6);
    margin-inline: auto;
    padding-inline: var(--card-inset);
  }

  .s-post__factlist {
    display: flex;
    gap: var(--sp-6);
  }

  .s-post__fact dt {
    font-family: var(--f-mono);
    font-weight: var(--fw-light);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .s-post__fact dd {
    margin-top: 2px;
    font-size: var(--fs-text-main);
    line-height: var(--lh-text);
  }

  /* Der Autor ist abgesetzt, nicht eingereiht: eine Linie darüber und ein
     Porträt daneben. Das ist der sichtbare Unterschied zwischen einer Angabe
     über den Text und einem Menschen, der ihn geschrieben hat. */
  .s-post__author {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-left: auto;
  }

  .s-post__authorimage {
    flex: 0 0 auto;
    width: var(--control-lg);
    height: var(--control-lg);
    border-radius: var(--r-round);
    overflow: hidden;
  }

  .s-post__authorimage :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .s-post__authorname {
    font-size: var(--fs-text-main);
    line-height: var(--lh-text);
  }

  .s-post__authorrole {
    margin-top: 2px;
    font-family: var(--f-mono);
    font-weight: var(--fw-light);
    font-size: var(--fs-label-lg);
    line-height: var(--lh-text);
    color: var(--c-text-muted);
  }

  /* --- Fließtext --------------------------------------------------------
     :global(), weil PortableText das Markup zur Laufzeit erzeugt.
     -------------------------------------------------------------------- */
  .s-post__text :global(p) {
    font: var(--font-body-long);
    margin-bottom: var(--sp-5);
  }

  /* Zwischentitel bekommen eine Nummer im linken Rand. Der Zähler läuft über
     die h2 und ignoriert die h3 — sonst zählte er Unterpunkte mit und die
     Nummerierung entspräche nicht dem Verzeichnis daneben. */
  .s-post__text {
    counter-reset: section;
  }

  .s-post__text :global(h2) {
    counter-increment: section;
    position: relative;
    margin-top: var(--sp-12);
    margin-bottom: var(--sp-4);
    font-size: var(--fs-title);
    font-weight: var(--fw-medium);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
    scroll-margin-top: calc(var(--nav-height) + var(--sp-4));
  }

  .s-post__text :global(h2)::before {
    content: counter(section, decimal-leading-zero);
    position: absolute;
    top: 0.15em;
    left: calc(-1 * var(--sp-8));
    font-family: var(--f-mono);
    font-weight: var(--fw-light);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-mono);
    color: var(--c-text-muted);
  }

  .s-post__text :global(h3) {
    margin-top: var(--sp-8);
    margin-bottom: var(--sp-3);
    font-size: var(--fs-title-xs);
    font-weight: var(--fw-medium);
    line-height: var(--lh-heading);
    scroll-margin-top: calc(var(--nav-height) + var(--sp-4));
  }

  .s-post__text :global(ul) {
    margin-bottom: var(--sp-5);
    padding-left: var(--sp-5);
    list-style: disc;
  }

  .s-post__text :global(li) {
    font: var(--font-body-long);
    margin-bottom: var(--sp-2);
  }

  .s-post__text :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--c-brand);
  }

  /* An image the editors set to "beyond the column" reaches the right edge
     of the type area: across the gap and the margin track, up to the table
     of contents or the container edge. `100cqi` is the width of
     `.s-post__column`, which is a size container for exactly this reason.

     Until 2026-09-27 this read `calc(100% + var(--rand-breite, 0px))`, and
     `--rand-breite` was defined nowhere: the fallback of 0 kept every wide
     image at column width, so the option did nothing. Where the text fills
     the whole column (phones), wide and column are the same width. */
  .s-post__text :global(.c-postimage[data-width="wide"]) {
    /* Out to the card's edges: the text width plus the inset on both sides. */
    width: calc(100cqi + 2 * var(--card-inset));
    margin-left: calc(-1 * var(--card-inset));
  }

  .s-post__back {
    margin-top: var(--sp-10);
  }

  /* --- Weiterlesen ------------------------------------------------------ */

  /* Closes the page like every other one: a full section space before the
     footer. It had none, and the post cards ran straight into it. */
  .s-more {
    padding-block: var(--section-space-sm) var(--section-space);
  }

  .s-more__head {
    margin-bottom: var(--sp-10);
  }

  .s-more__title {
    font: var(--font-section-title);
    margin-top: var(--sp-3);
    letter-spacing: var(--tracking-section-title);
  }

  /* Dieselben drei Spalten wie unter /magazin. Die Karte merkt selbst, dass
     sie hier schmal ist, und stapelt — siehe PostCard.astro. */
  .s-more__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: var(--flow-lg) var(--site-gutter);
  }

  /* --- Schmalere Fenster ------------------------------------------------
     Erst fällt der Rand weg (die Nebenangaben rücken über den Text), dann
     das Verzeichnis (es liegt darüber statt daneben).
     -------------------------------------------------------------------- */
  @media (max-width: 1000px) {
    .s-more__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Die Nummer im Rand hat keinen Rand mehr — sie rückt über die
       Überschrift. */
    .s-post__text :global(h2)::before {
      position: static;
      display: block;
      margin-bottom: var(--sp-2);
    }
  }

  @media (max-width: 640px) {
    .s-post__facts {
      flex-direction: column;
      align-items: flex-start;
    }

    .s-post__author {
      margin-left: 0;
    }

    .s-more__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-10) 0;
    }
  }
</style>
