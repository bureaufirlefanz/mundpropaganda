---
/**
 * Der Zusammenbau der Magazin-Übersicht.
 *
 * Der Kopf kommt aus dem Einzeldokument „Magazin (Übersicht)", die Beiträge
 * aus der Collection. Der Baukasten (`sections`), den das Dokument
 * ebenfalls hat, bleibt vorerst ungenutzt — er braucht einen Renderer für
 * frei zusammensteckbare Abschnitte, und das ist ein eigener Schritt. Bis
 * dahin trägt der Kopf die Seite, und das steht auch so im Studio.
 */
import Base from "../layouts/Base.astro";
import PostList from "../components/sections/PostList.astro";
import type { Post, MagazineIntro } from "../lib/magazine";

interface Props {
  intro: MagazineIntro | undefined;
  posts: Post[];
}

const { intro, posts } = Astro.props;

/* Wie auf der Startseite: Suchmaschinenangaben sind kein sichtbarer
   Seiteninhalt, deshalb darf der Seitentitel auf die Überschrift der Seite
   zurückfallen. Das sagt das Schema dem Kunden auch zu. */
const title =
  intro?.seo?.title || `${intro?.title || "Magazin"} - Mundpropaganda`;
const description = intro?.seo?.description || intro?.lead || "";
---

<Base title={title} description={description} noIndex={intro?.seo?.noIndex}>
  <section class="container s-magazine-intro">
    {
      intro?.topline && (
        <span class="c-topline" data-reveal="fade">
          {intro.topline}
        </span>
      )
    }
    <h1 class="s-magazine-intro__title" data-split="lines">{intro?.title}</h1>
    {
      intro?.lead && (
        <p class="s-magazine-intro__text" data-reveal="up">
          {intro.lead}
        </p>
      )
    }
  </section>

  {posts.length > 0 && <PostList posts={posts} />}

  {
    /* Kein Kontaktabschnitt mehr. „Unverbindliches Angebot anfordern" ist die
      Frage nach einem Kostenvoranschlag, nicht der allgemeine Kontaktweg —
      sie steht nur noch dort, wo es etwas zu veranschlagen gibt (Veneers,
      Keramikinlays, Pillar Page).

      Die Sprungmarke `#kontakt` bleibt trotzdem erreichbar: Sie sitzt jetzt
      am Fuß, siehe `contactSection` in `layouts/Base.astro`. Die vier bis
      sieben Verweise aus Menü, Fuß und den „Termin buchen"-Buttons führen
      damit zu Telefon, E-Mail, beiden Anschriften und den Zeiten. */
  }
</Base>

<style>
  /* Der Kopf einer Übersichtsseite. Steht hier und nicht in einem Baustein:
     Er ist das Markup dieses Zusammenbaus, und ein zweiter Ort bräuchte ihn
     erst, wenn eine weitere Übersicht dazukommt. */
  .s-magazine-intro {
    padding-block: calc(var(--section-space) + 80px) var(--sp-6);
  }

  .s-magazine-intro .c-topline {
    display: block;
    margin-bottom: var(--sp-4);
  }

  /* Hieß `s-magazinkopf__titel`, während das Markup `s-magazinekopf__titel`
     schrieb — ein halb migriertes Paar, keine der beiden Regeln griff je.
     Die Überschrift stand seit der Umbenennung in Browser-Defaults, und
     niemandem fiel es auf, weil h1 auch ungestylt nach Überschrift
     aussieht. Jetzt Elemente der Section, wie die Konvention es will. */
  .s-magazine-intro__title {
    max-width: 16ch;
    font-size: var(--fs-display-2);
    font-weight: var(--fw-medium);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tighter);
  }

  .s-magazine-intro__text {
    max-width: 52ch;
    margin-top: var(--sp-6);
    font-size: var(--fs-text-large);
    line-height: var(--lh-text);
    color: var(--c-text-muted);
  }
</style>
