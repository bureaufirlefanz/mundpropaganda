---
/**
 * Der Zusammenbau der Startseite — Bausteine und ihre Reihenfolge.
 *
 * Bekommt die Inhalte als Prop und lädt selbst nichts. Das ist die
 * Bedingung, unter der die Vorschau-Route (Aufgabe 6) dasselbe rendern kann
 * wie die echte Seite: Sie reicht Entwurfsdaten herein, wo hier die
 * veröffentlichten stehen.
 *
 * Zwei Zusammenbauten, die dasselbe zeigen sollen, laufen garantiert
 * auseinander — und zwar unbemerkt, weil man immer nur eine von beiden
 * ansieht. Deshalb gibt es diesen einen.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/sections/Hero.astro";
import Split from "../components/sections/Split.astro";
import Services from "../components/sections/Services.astro";
import Standards from "../components/sections/Standards.astro";
import Gallery from "../components/sections/Gallery.astro";
import Experts from "../components/sections/Experts.astro";
import Stories from "../components/sections/Stories.astro";
import Magazine from "../components/sections/Magazine.astro";
import Faq from "../components/sections/Faq.astro";
import { istCmsBild, bildUrl } from "../lib/bilder";
import { aufgeloest } from "../lib/navigation";
import type { StartseiteInhalt } from "../lib/startseite";
import type { Beitrag } from "../lib/magazin";

interface Props {
  daten: StartseiteInhalt;
  beitraege: Beitrag[];
}

const { daten, beitraege } = Astro.props;

/* Seitentitel und Beschreibung aus dem SEO-Feld. Kein Rückfall im Sinne der
   Aufgabe 4: Suchmaschinenangaben sind kein sichtbarer Seiteninhalt, und ein
   Dokument ohne <title> ist kaputt statt leer. Das Schema sagt dem Kunden
   genau das zu — „Leer lassen übernimmt die Überschrift der Seite". */
const title = daten.seo?.title || "Mundpropaganda - Zahnarzt Prenzlauer Berg Berlin";
const description =
  daten.seo?.description ||
  "Praxis für ästhetische und allgemeine Zahnmedizin auf höchstem Niveau. Veneers, Keramikimplantate und Prophylaxe in Berlin Prenzlauer Berg.";

/* Das Teilen-Motiv. 1200 breit im Format 1.91:1 — das ist, was Facebook,
   LinkedIn und WhatsApp erwarten; mit `ratio` beschneidet Sanity serverseitig,
   und erst dadurch wirkt der im Studio gesetzte Bildmittelpunkt. */
const storiesAction = (await aufgeloest([daten.storiesAction ?? null], Astro.url.pathname))[0];

const teilenBild = istCmsBild(daten.seo?.image)
  ? bildUrl(daten.seo.image, 1200, 1.91)
  : undefined;
---

<Base
  title={title}
  description={description}
  noIndex={daten.seo?.noIndex}
  image={teilenBild}
>
  <Hero lines={daten.heroLines} />
  <Split
    topline={daten.splitTopline}
    title={daten.splitTitle}
    absaetze={daten.splitParagraphs}
    image={daten.splitImage}
  />
  <Services title={daten.servicesTitle} />
  <Standards title={daten.standardsTitle} items={daten.standardsItems} />
  <Gallery variante="ring" title={daten.locationsTitle} bilder={daten.locationsImages} />
  <Experts
    title={daten.expertsTitle}
    namen={daten.expertsNames}
    absaetze={daten.expertsParagraphs}
    image={daten.expertsImage}
  />
  <Stories items={daten.storiesItems} action={storiesAction} />
  {beitraege.length > 0 && (
    <Magazine
      topline={daten.magazineTopline}
      title={daten.magazineTitle}
      text={daten.magazineText}
      beitraege={beitraege}
    />
  )}
  <Faq title={daten.faqTitle} text={daten.faqText} questions={daten.faq} />
</Base>
