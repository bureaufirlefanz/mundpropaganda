---
/**
 * Der Zusammenbau der Karriereseite.
 *
 * Fünf eigene Bausteine, drei geliehene. Die Seite soll nicht aussehen wie
 * eine Leistungsseite mit anderem Text — geteilt sind nur der Seitenkopf
 * (damit sie zur Seite gehört), das Panel und das FAQ.
 *
 * Aufbau, und warum in dieser Reihenfolge:
 *   Hero      Wer sucht, und wofür
 *   Intro     Warum hier und nicht woanders — die Haltung
 *   Facts     Vier überprüfbare Angaben statt Versprechen         (eigener Baustein)
 *   Compare   Übliche Bedingungen gegen unsere, Zeile für Zeile   (eigener Baustein)
 *   Jobs      Der eigentliche Zweck der Seite. Steht in der Mitte,
 *             nicht am Ende: Wer wegen einer Stelle kommt, soll
 *             nicht erst durch die Selbstdarstellung scrollen.    (eigener Baustein)
 *   Voices    Drei Stimmen aus dem Team, versetzt gesetzt         (eigener Baustein)
 *   Timeline  Der Bewerbungsablauf als Bahn — nimmt die Hürde     (eigener Baustein)
 *   Panel     Initiativbewerbung, für alle ohne passende Stelle
 *   Faq       Was sonst noch gefragt wird
 *
 * Alle Inhalte kommen aus dem CMS. Bis hierher standen sie als 291 Zeilen in
 * `lib/karriere.ts` — vier Stellenausschreibungen darunter, die sich weder
 * ändern noch abschalten ließen. Jeder Abschnitt hängt an seinen eigenen
 * Daten: Was das Dokument nicht trägt, erscheint nicht.
 */
import Base from "../layouts/Base.astro";
import ServiceHero from "../components/sections/ServiceHero.astro";
import Intro from "../components/sections/Intro.astro";
import Facts from "../components/sections/Facts.astro";
import Compare from "../components/sections/Compare.astro";
import Jobs from "../components/sections/Jobs.astro";
import Timeline from "../components/sections/Timeline.astro";
import Voices from "../components/sections/Voices.astro";
import Panel from "../components/ui/Panel.astro";
import Button from "../components/ui/Button.astro";
import Faq from "../components/sections/Faq.astro";
import { bewerbungLink, type Karriere, type Stelle } from "../lib/karriere";
import { aufgeloest } from "../lib/navigation";

interface Props {
  daten: Karriere | undefined;
  stellen: Stelle[];
}

const { daten: d, stellen } = Astro.props;

const aktion = (await aufgeloest([d?.aktion ?? null], Astro.url.pathname))[0];

/* Wahlfrei, aber nicht halb — dieselbe Regel wie auf der Leistungsseite:
   Wer einen Abschnitt anlegt, füllt ihn. Die Abfrage kann das nicht zusagen,
   also steht die Prüfung hier an einer Stelle. */
const intro =
  d?.introTopline && d.introHeadline && d.introSpalten?.length
    ? { topline: d.introTopline, headline: d.introHeadline, spalten: d.introSpalten }
    : undefined;

const zahlen =
  d?.zahlenTopline && d.zahlenHeadline && d.zahlenEintraege?.length
    ? { topline: d.zahlenTopline, headline: d.zahlenHeadline, zahlen: d.zahlenEintraege }
    : undefined;

const vergleich =
  d?.vergleichTopline && d.vergleichHeadline && d.vergleichSpalten?.length && d.vergleichZeilen?.length
    ? {
        topline: d.vergleichTopline,
        headline: d.vergleichHeadline,
        spalten: d.vergleichSpalten,
        zeilen: d.vergleichZeilen,
        hinweis: d.vergleichHinweis ?? undefined,
      }
    : undefined;

const stimmen =
  d?.stimmenTopline && d.stimmenHeadline && d.stimmenEintraege?.length
    ? { topline: d.stimmenTopline, headline: d.stimmenHeadline, stimmen: d.stimmenEintraege }
    : undefined;

const ablauf =
  d?.ablaufTopline && d.ablaufHeadline && d.ablaufEtappen?.length
    ? { topline: d.ablaufTopline, headline: d.ablaufHeadline, etappen: d.ablaufEtappen }
    : undefined;

/* Die Stellen sind der Zweck der Seite. Ohne ausgeschriebene Stelle entfällt
   der Abschnitt — dann trägt die Initiativbewerbung darunter die Seite. */
const zeigeStellen = Boolean(d?.stellenTopline && d.stellenHeadline && stellen.length);
---

<Base
  title={d?.seo?.titel || "Karriere - Mundpropaganda"}
  description={d?.seo?.beschreibung || d?.einleitung || ""}
  nichtIndexieren={d?.seo?.nichtIndexieren}
>
  <ServiceHero
    topline={d?.topline}
    titel={d?.titel ?? ""}
    text={d?.einleitung}
    bild={d?.bild}
    aktion={aktion?.text}
    aktionZiel={aktion?.href}
  />

  {intro && <Intro {...intro} />}

  {zahlen && <Facts {...zahlen} />}

  {vergleich && <Compare {...vergleich} />}

  {zeigeStellen && d && (
    <Jobs
      id="stellen"
      topline={d.stellenTopline!}
      headline={d.stellenHeadline!}
      stellen={stellen}
      bewerbungMail={d.bewerbungMail ?? ""}
    />
  )}

  {stimmen && <Voices {...stimmen} />}

  {ablauf && <Timeline {...ablauf} />}

  {d?.initiativTopline && d.initiativTitel && (
    <Panel
      id="initiativ"
      topline={d.initiativTopline}
      titel={d.initiativTitel}
      text={d.initiativText ?? undefined}
    >
      <div class="k-initiativ">
        {d.initiativAbsatz && <p>{d.initiativAbsatz}</p>}
        {d.bewerbungMail && (
          <div class="k-initiativ__aktion">
            <Button label="Initiativ bewerben" href={bewerbungLink(d.bewerbungMail)} />
            <a class="k-initiativ__mail" href={`mailto:${d.bewerbungMail}`}>{d.bewerbungMail}</a>
          </div>
        )}
      </div>
    </Panel>
  )}

  {d?.faqTitel && d.faq?.length ? <Faq titel={d.faqTitel} fragen={d.faq} /> : null}
</Base>

<style>
  .k-initiativ {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    max-width: 52ch;
    font-size: var(--fs-text-large);
    line-height: 1.45;
  }

  .k-initiativ__aktion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4) var(--sp-6);
  }

  /* Die Adresse steht neben dem Knopf, nicht statt seiner: Manche schreiben
     lieber aus ihrem eigenen Postfach, statt einen mailto-Link zu öffnen. */
  .k-initiativ__mail {
    font-family: var(--f-mono);
    font-size: var(--fs-text-small);
    letter-spacing: 0.04em;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .k-initiativ__mail:hover {
    text-decoration-color: var(--c-brand);
    text-decoration-thickness: 2px;
  }
</style>
