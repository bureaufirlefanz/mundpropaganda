---
/**
 * Frame for the two design pages (styleguide and component catalogue).
 *
 * Deliberately not Base.astro: that one brings the navigation, footer,
 * transition layer and backdrop. On a documentation page those would be
 * blocks you want to show and at the same time a frame around everything
 * else; the navigation is fixed and would sit on top of every sample. So
 * neither Nav nor Footer nor Backdrop appears on these pages.
 *
 * The same foundations as everywhere (tokens.css, base.css, shared.css), so
 * nothing here looks different from the site itself. A change that only
 * shows here has not been documented; it has created a second truth.
 *
 * The script bundle runs too: the samples should move as they do in use,
 * not stand there as dead pictures.
 */
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/shared.css";
import Icons from "../components/ui/Icons.astro";
// TEST 2026-09-29: photo grade, remove once decided (see PhotoGrade.astro).
import PhotoGrade from "../components/ui/PhotoGrade.astro";

interface Props {
  title: string;
  active: "styleguide" | "komponenten";
}
const { title, active } = Astro.props;

const PAGES = [
  {
    key: "styleguide",
    path: "/design/styleguide",
    name: "Styleguide",
    note: "Grundwerte, Rollen, Flächen",
  },
  {
    key: "komponenten",
    path: "/design/komponenten",
    name: "Komponenten",
    note: "Jeder Baustein mit Beschreibung und Beispiel",
  },
] as const;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#d6d6d6" />
    <title>{title} - Mundpropaganda Design</title>
    {/* Internal page: not for a search engine's index. */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/svg/logo-mark.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/PPNeueMontreal-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/GT-Pressura-Mono-Light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="d-body">
    {
      /* WCAG 2.2, 2.4.1, as in Base.astro. Must be the first focusable
        element, or the jump cannot be reached before the navigation. */
    }
    <a class="c-skiplink" href="#main">Zum Inhalt springen</a>

    <Icons />

    <PhotoGrade />

    <header class="d-header">
      <a class="d-header__brand" href="/">Mundpropaganda</a>
      <nav class="d-header__nav" aria-label="Design">
        {
          PAGES.map((s) => (
            <a
              href={s.path}
              title={s.note}
              aria-current={s.key === active ? "page" : undefined}
            >
              {s.name}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="d-main" id="main" tabindex="-1"><slot /></main>

    <script>
      import { init } from "../js/init.js";
      init();
    </script>

    <style is:global>
      /* --- Frame of the documentation pages ----------------------------
         Everything here carries the `d-` prefix and styles only the
         surroundings: header, chapters, captions. No `d-` rule may ever
         reach into a sample, or the page would show something other than
         what it claims.
         ---------------------------------------------------------------- */

      .d-body {
        background: var(--c-bg);
        color: var(--c-text);
      }

      .d-header {
        position: sticky;
        top: 0;
        z-index: var(--z-nav);
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--sp-3) var(--sp-6);
        padding: var(--sp-3) var(--site-margin);
        background: var(--c-dark);
        color: var(--c-grey);
        font-family: var(--f-mono);
        font-size: var(--fs-text-small);
        letter-spacing: var(--tracking-mono);
        text-transform: uppercase;
      }

      .d-header__brand {
        font-weight: var(--fw-medium);
      }

      .d-header__nav {
        display: flex;
        gap: var(--sp-5);
      }

      /* The current entry is underlined, not only coloured: colour alone is
         no difference for anyone who cannot see it (WCAG 1.4.1). */
      .d-header__nav a[aria-current="page"] {
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      .d-main {
        padding-bottom: var(--sp-16);
      }

      /* A chapter. Its samples run full width, the describing text stays
         narrow; nobody reads long lines. Tighter than on the site itself:
         --section-space is meant for a page you scroll through, here it
         would leave one heading per screen and nothing else. */
      .d-section {
        padding-block: var(--sp-10);
        border-top: var(--bw) solid var(--c-line);
      }

      .d-section:first-child {
        border-top: 0;
      }

      .d-section__header {
        max-width: calc(var(--measure-text) + 2 * var(--site-margin));
        margin-bottom: var(--sp-6);
        padding-inline: var(--site-margin);
      }

      .d-section__number {
        display: block;
        margin-bottom: var(--sp-2);
        font-family: var(--f-mono);
        font-size: var(--fs-text-small);
        letter-spacing: var(--tracking-mono);
        color: var(--c-text-muted);
      }

      .d-section__title {
        font-size: var(--fs-title);
        font-weight: var(--fw-regular);
        line-height: var(--lh-heading);
      }

      .d-section__text {
        margin-top: var(--sp-3);
        font-size: var(--fs-text-main);
        line-height: var(--lh-text);
        color: var(--c-text-muted);
      }

      /* A single sample: caption above, example below. */
      .d-sample {
        padding-inline: var(--site-margin);
        margin-bottom: var(--sp-8);
      }

      .d-sample__header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--sp-2) var(--sp-4);
        margin-bottom: var(--sp-3);
        padding-bottom: var(--sp-2);
        border-bottom: var(--bw) solid var(--c-line);
      }

      .d-sample__name {
        font-family: var(--f-mono);
        font-size: var(--fs-text-small);
        letter-spacing: var(--tracking-mono);
        text-transform: uppercase;
      }

      /* The source path: it finds the file without searching, the most
         common reason to open a page like this at all. */
      .d-sample__path {
        font-family: var(--f-mono);
        font-size: var(--fs-label);
        letter-spacing: var(--tracking-mono);
        color: var(--c-text-muted);
      }

      .d-sample__text {
        max-width: var(--measure-long);
        margin-bottom: var(--sp-4);
        font-size: var(--fs-text-main);
        line-height: var(--lh-text);
        color: var(--c-text-muted);
      }

      /* The stage a sample stands on. A light ground so the edge of the
         block shows; on the page grey it would blur. */
      .d-stage {
        padding: var(--sp-5);
        border: var(--bw) solid var(--c-line);
        border-radius: var(--r-md);
        background: var(--c-surface);
      }

      /* On a stage the focus ring is drawn inside.

         Some stages clip on purpose (`overflow: hidden`) so a sample does not
         run out of its box, and with it they cut off the ring of the
         controls inside. Measured in a keyboard run over /design/komponenten:
         the carousel arrows, 1 pixel of air.

         The rule lives here and not in the components: on the real pages the
         same arrows sit free and get their ring outside as intended. The
         problem belongs to the stage. */
      .d-stage :focus-visible {
        outline-offset: calc(var(--focus-width) * -1);
      }

      /* A dark stage. Put `data-surface="dark"` on it as well where the
         sample inside reads the colour roles. */
      .d-stage--dark {
        background: var(--c-dark);
        color: var(--c-on-dark);
      }

      .d-stage--borderless {
        padding: 0;
        overflow: hidden;
      }

      .d-stage--row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--sp-4);
      }

      /* Grid for colour and value tiles. */
      .d-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: var(--sp-4);
      }

      .d-note {
        padding: var(--sp-4);
        border: var(--bw) dashed var(--c-line);
        border-radius: var(--r-md);
        font-size: var(--fs-text-main);
        line-height: var(--lh-text);
        color: var(--c-text-muted);
      }

      code {
        font-family: var(--f-mono);
        font-size: 0.9em;
      }

      /* Links in the describing text. The class .c-link does not exist here:
         it is scoped inside the components that use it. Hence the text
         classes, and never a bare `a` selector that would reach into the
         embedded samples. */
      .d-section__text a,
      .d-sample__text a,
      .d-note a {
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: var(--bw);
      }

      .d-section__text a:hover,
      .d-sample__text a:hover,
      .d-note a:hover {
        color: var(--c-text);
        text-decoration-color: var(--c-brand);
        text-decoration-thickness: 2px;
      }
    </style>
  </body>
</html>
