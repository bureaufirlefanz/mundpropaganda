---
/**
 * Dokumentchrome. Entspricht head.hbs plus body-Gerüst.
 *
 * Global sind nur die beiden Grundlagen — Werte und Rahmen. Sie kommen
 * unverändert aus dem Prototyp nebenan, nicht kopiert, damit es weiterhin
 * genau eine Quelle für Farben, Typo-Skala und Abstände gibt.
 *
 * components.css und sections.css sind hier bewusst NICHT eingebunden: die
 * Regeln der Bausteine liegen im <style>-Block der jeweiligen .astro-Datei.
 * Astro grenzt sie dort ab, dadurch kann keine Section mehr in eine andere
 * hineinschreiben. Wer eine Regel sucht, findet sie neben ihrem Markup.
 */
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/shared.css";

import Icons from "../components/ui/Icons.astro";
import Backdrop from "../components/ui/Backdrop.astro";
import Transition from "../components/ui/Transition.astro";
import Nav from "../components/ui/Nav.astro";
import Footer from "../components/ui/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { loadSettings } from "../lib/settings";

interface Props {
  title: string;
  description?: string;
  /** Setzt `noindex`. Aus dem SEO-Feld des jeweiligen Dokuments. */
  noIndex?: boolean;
  /** Absolute URL des Teilen-Motivs. Aus dem CMS, deshalb schon absolut. */
  image?: string;
  /**
   * Ob die Seite einen eigenen Kontaktabschnitt zeigt.
   *
   * Entscheidet, wo die Sprungmarke `#kontakt` liegt. Das Angebotsformular
   * steht nur noch auf wenigen Seiten; überall sonst führen die vier bis
   * sieben Verweise aus Menü, Fuß und den „Termin buchen"-Knöpfen in den
   * Fuß, wo Telefon, E-Mail, Standorte und Zeiten ohnehin stehen.
   *
   * Die Angabe ist nötig, weil es die id sonst zweimal gäbe: einmal am Panel,
   * einmal am Fuß. Ein Dokument mit doppelter id ist nicht nur unsauber — der
   * Browser springt zum ersten Treffer, und welcher das ist, entscheidet die
   * Reihenfolge im Markup statt die Absicht.
   */
  contactSection?: boolean;
}
const {
  title,
  description = "",
  noIndex = false,
  image,
  contactSection = false,
} = Astro.props;

/* Die Angaben zur ganzen Website holt der Rahmen selbst und nicht über Props:
   Sie sind auf jeder Seite dieselben, und ein Durchreichen durch elf Templates
   hätte elf Gelegenheiten, eine zu vergessen. `loadSettings` merkt sich das
   Ergebnis, die Abfrage läuft also einmal je Build. */
const { website } = await loadSettings();

/* Der Titel bekommt den Websitenamen angehängt — außer er steht schon darin.
   Ohne diese Prüfung stünde „Karriere - Mundpropaganda - Mundpropaganda" im
   Tab, sobald jemand im SEO-Feld den vollständigen Titel gepflegt hat. */
const fullTitle = title.includes(website.siteName)
  ? title
  : `${title} - ${website.siteName}`;

/* Reihenfolge der Rückfälle: was die Seite mitbringt, sonst was global
   gepflegt ist, sonst nichts. Kein eingebauter Text — fehlt beides, entfällt
   die Zeile. */
const metaDescription = description || website.defaultDescription || "";
const shareImage = image || website.shareImageUrl;

/* Zwei Wege in denselben Zustand: Der Schalter im Studio sperrt die ganze
   Website, das SEO-Feld sperrt eine einzelne Seite. Beides zusammen mit ODER,
   weil „nicht indexieren" die stärkere Aussage ist. */
const blockIndexing = noIndex || !website.searchEngines;
---

<!doctype html>
<html lang="de" data-astro-router>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#d6d6d6" />

    {
      /*
      Muss synchron und vor dem ersten Bild laufen. Am Attribut `js` hängen
      alle Regeln, die Elemente bis zu ihrer Animation verbergen
      (`html.js [data-reveal]`, `html.js .s-hero__word` …).

      init.js setzt dieselbe Klasse, aber zu spät: das Bundle ist ein
      Modul-Skript und läuft erst nach dem Parsen des Dokuments. Das
      Stylesheet steht da längst, der Browser hat den Hero also fertig
      gezeichnet — Wortmarke, Leiste und Reveals waren einen Moment in ihrer
      Endlage zu sehen und sprangen dann in den Startzustand zurück.

      Beim ersten Aufruf fiel das nicht auf: solange die Schrift noch lädt,
      zeichnet der Browser den Text ohnehin nicht. Mit warmem Cache entfällt
      diese Sperre — und genau dann stand die Headline sofort komplett da.

      Beim Seitenwechsel über den Router geht die Klasse allerdings verloren —
      sie wird unten in `astro:after-swap` nachgesetzt.
    */
    }
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    {blockIndexing && <meta name="robots" content="noindex, nofollow" />}
    {
      website.googleVerification && (
        <meta
          name="google-site-verification"
          content={website.googleVerification}
        />
      )
    }

    {
      /*
      Open Graph und Twitter — was Messenger, soziale Netzwerke und Slack
      auslesen, wenn jemand einen Link auf die Praxis teilt. Ohne diese Zeilen
      raten sie, und das Ergebnis ist meist der erste Textbrocken der Seite.

      `og:url` fehlt bewusst: Es müsste absolut sein, und dafür bräuchte es
      `site` in astro.config.mjs. Die Domain steht noch nicht fest — ein
      geratener Wert stünde als `http://localhost:4321` im ausgelieferten
      HTML, und das ist schlechter als die fehlende Angabe. Sobald die Domain
      da ist: `site` setzen und `og:url` mit `Astro.url` ergänzen.

      Das Bild kommt aus dem CMS und trägt deshalb schon eine absolute
      URL vom Sanity-CDN. Ein lokales Motiv ginge hier nicht ohne `site`.
    */
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={website.siteName} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={fullTitle} />
    {
      metaDescription && (
        <meta property="og:description" content={metaDescription} />
      )
    }
    {shareImage && <meta property="og:image" content={shareImage} />}

    <meta
      name="twitter:card"
      content={shareImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={fullTitle} />
    {
      metaDescription && (
        <meta name="twitter:description" content={metaDescription} />
      )
    }
    {shareImage && <meta name="twitter:image" content={shareImage} />}

    {
      /* Die beiden Schnitte, die above the fold sichtbar sind — sonst
         blitzt die Fallback-Schrift im Hero auf. */
    }
    <link
      rel="preload"
      href="/fonts/PPNeueMontreal-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/GT-Pressura-Mono-Light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/svg/tooth-3d-mask.png" as="image" />
    {
      /* Gepflegtes Favicon oder die Wortmarke. Kein `type` beim CMS-Motiv:
        Das Format hängt daran, was hochgeladen wurde, und eine falsche
        Angabe ist schlechter als keine. */
    }
    {
      website.faviconUrl ? (
        <link rel="icon" href={website.faviconUrl} />
      ) : (
        <link rel="icon" href="/svg/logo-mark.svg" type="image/svg+xml" />
      )
    }

    {
      /* Plausible misst ohne Cookies und ohne personenbezogene Daten, braucht
        also kein Einwilligungsbanner. Ohne gepflegte Domain wird gar nichts
        geladen — kein leerer Aufruf, kein fremder Host im Netzwerk. */
    }
    {
      website.plausibleDomain && (
        <script
          is:inline
          defer
          data-domain={website.plausibleDomain}
          src="https://plausible.io/js/script.js"
        />
      )
    }

    {
      /* Astros eigener Router. Ersetzt die selbstgebaute Navigation aus
         modules/transition.js: er tauscht nur den geänderten Teil des
         Dokuments aus, statt die Seite neu zu laden. */
    }
    <ClientRouter />
  </head>

  <body>
    {
      /* WCAG 2.2, 2.4.1 Bypass Blocks. Vor dem Inhalt jeder Seite stehen
        Navigation und Menü — mit der Tastatur waren das bis hierher rund
        zwanzig Anschläge, auf jeder Seite neu. Der Sprung muss das erste
        fokussierbare Element im Dokument sein, sonst ist er nicht zu
        erreichen, bevor die Blöcke kommen, die er überspringen soll. */
    }
    <a class="c-skiplink" href="#main">Zum Inhalt springen</a>

    {
      /* Kein `transition:persist` an Backdrop und Nav.

        Es stand hier, hat aber nie etwas getan: Astro setzt die Direktive
        auf das Element, an dem sie steht — bei einem Komponenten-Tag landet
        sie nirgends im HTML. Gemessen trug im gebauten Dokument genau ein
        Element `data-astro-transition-persist`, und das ist der Vorhang aus
        `Transition.astro`, der sie an einem echten `<div>` führt.

        Sie hier wirksam zu machen hieße, sie in die beiden Komponenten an
        ihr Wurzelelement zu setzen — und zugleich jeden Listener, den `nav.js`
        an Knöpfe und Verweise hängt, an das Abbruchsignal zu binden. Sonst
        sammelten sich die an den überlebenden Elementen an, und aus einem
        stillen Nichtstun würde ein echtes Leck. Die beiden neu zu rendern
        kostet nichts; der Fall ist gemessen und nicht vermutet. */
    }
    <Icons />
    <Backdrop />
    <Transition />
    <Nav />

    {
      /* `tabindex="-1"`: Ohne das nimmt ein <main> den Fokus nicht an, der
        Sprung verschöbe nur den Bildausschnitt und der Tabulator liefe
        danach weiter in der Navigation. */
    }
    <main id="main" tabindex="-1"><slot /></main>

    <Footer id={contactSection ? undefined : "kontakt"} />

    <script>
      import { init } from "../js/init.js";
      import { teardown } from "../js/lib/lifecycle.js";
      import { gsap, ScrollTrigger } from "../js/lib/gsap.js";

      /* Bei einem Seitenwechsel tauscht der Router nur den Inhalt aus — die
         Module müssen danach erneut anlaufen, sonst sind Reveals, Kartendeck
         und der durchlaufende Pfad auf der neuen Seite tot.
         `astro:page-load` feuert beim ersten Aufruf und nach jedem Wechsel. */
      /* Der Router übernimmt beim Wechsel die Attribute des eingehenden
         <html>-Elements — und weil der Server die Klasse `js` nicht
         mitrendert, ist sie danach weg. Damit galt auf jeder über den Router
         erreichten Seite keine einzige Startregel: Reveals und Headlines
         standen sofort sichtbar da und sprangen erst zurück, wenn `init` sie
         übernahm.

         `astro:after-swap` läuft unmittelbar nach dem Austausch und noch vor
         dem ersten Bild der neuen Seite — früh genug, dass niemand die
         Endlage sieht. Der Listener hängt am document und wird deshalb nur
         einmal registriert, nicht bei jedem Wechsel neu. */
      document.addEventListener("astro:after-swap", () =>
        document.documentElement.classList.add("js"),
      );

      document.addEventListener("astro:page-load", () => init());

      /* Vor dem Austausch aufräumen. Ohne das behalten die ScrollTrigger ihre
         Verweise auf Elemente, die es gleich nicht mehr gibt — sie messen dann
         gegen Leichen und stapeln sich bei jedem Wechsel weiter auf.

         `teardown()` nimmt alles Übrige mit: die Lenis-Instanz samt
         Ticker-Rückruf, die Listener an `document` und `window` aus
         Navigation, Filter, Leistungsvorschau und Hero, den Ticker des
         Kartendecks und den Medienkontext der Marker-Zeilen. Bis hierher
         wurden nur die ScrollTrigger abgeräumt — alles andere häufte sich
         mit jedem Seitenwechsel an. Die Begründung im Einzelnen steht in
         `js/lib/lifecycle.js`. */
      document.addEventListener("astro:before-swap", () => {
        ScrollTrigger.getAll().forEach((t) => t.kill());
        gsap.globalTimeline.clear();
        teardown();
      });
    </script>

    <style>
      /* Der Inhalt liegt über den Hintergrundebenen. Die Navigation bleibt
         außen vor — sie trägt bereits --z-nav; ein zweiter Wert hier hätte
         sie auf dieselbe Ebene wie den Inhalt gesetzt, der im DOM später
         kommt und sie damit überdeckt.
         Den Gegenwert für den Footer setzt Footer.astro selbst. */
      main {
        position: relative;
        z-index: 1;
      }
    </style>
  </body>
</html>
