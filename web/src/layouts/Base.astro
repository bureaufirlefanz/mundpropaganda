---
/**
 * Dokumentrahmen. Entspricht head.hbs plus body-Gerüst.
 *
 * Global sind nur die beiden Grundlagen — Werte und Rahmen. Sie kommen
 * unverändert aus dem Prototyp nebenan, nicht kopiert, damit es weiterhin
 * genau eine Quelle für Farben, Typo-Skala und Abstände gibt.
 *
 * components.css und sections.css sind hier bewusst NICHT eingebunden: die
 * Regeln der Bausteine liegen im <style>-Block der jeweiligen .astro-Datei.
 * Astro grenzt sie dort ab, dadurch kann keine Section mehr in eine andere
 * hineinschreiben. Wer eine Regel sucht, findet sie neben ihrem Markup.
 */
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/shared.css";

import Icons from "../components/ui/Icons.astro";
import Backdrop from "../components/ui/Backdrop.astro";
import Transition from "../components/ui/Transition.astro";
import Nav from "../components/ui/Nav.astro";
import Footer from "../components/ui/Footer.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  /** Setzt `noindex`. Aus dem SEO-Feld des jeweiligen Dokuments. */
  nichtIndexieren?: boolean;
  /** Absolute URL des Teilen-Motivs. Aus dem CMS, deshalb schon absolut. */
  bild?: string;
}
const { title, description = "", nichtIndexieren = false, bild } = Astro.props;
---

<!doctype html>
<html lang="de" data-astro-router>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#d6d6d6" />

    {/*
      Muss synchron und vor dem ersten Bild laufen. Am Attribut `js` hängen
      alle Regeln, die Elemente bis zu ihrer Animation verbergen
      (`html.js [data-reveal]`, `html.js .s-hero__word` …).

      init.js setzt dieselbe Klasse, aber zu spät: das Bundle ist ein
      Modul-Skript und läuft erst nach dem Parsen des Dokuments. Das
      Stylesheet steht da längst, der Browser hat den Hero also fertig
      gezeichnet — Wortmarke, Leiste und Reveals waren einen Moment in ihrer
      Endlage zu sehen und sprangen dann in den Startzustand zurück.

      Beim ersten Aufruf fiel das nicht auf: solange die Schrift noch lädt,
      zeichnet der Browser den Text ohnehin nicht. Mit warmem Cache entfällt
      diese Sperre — und genau dann stand die Headline sofort komplett da.

      Beim Seitenwechsel über den Router geht die Klasse allerdings verloren —
      sie wird unten in `astro:after-swap` nachgesetzt.
    */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {nichtIndexieren && <meta name="robots" content="noindex, nofollow" />}

    {/*
      Open Graph und Twitter — was Messenger, soziale Netzwerke und Slack
      auslesen, wenn jemand einen Link auf die Praxis teilt. Ohne diese Zeilen
      raten sie, und das Ergebnis ist meist der erste Textbrocken der Seite.

      `og:url` fehlt bewusst: Es müsste absolut sein, und dafür bräuchte es
      `site` in astro.config.mjs. Die Domain steht noch nicht fest — ein
      geratener Wert stünde als `http://localhost:4321` im ausgelieferten
      HTML, und das ist schlechter als die fehlende Angabe. Sobald die Domain
      da ist: `site` setzen und `og:url` mit `Astro.url` ergänzen.

      Das Bild kommt aus dem CMS und trägt deshalb schon eine absolute
      URL vom Sanity-CDN. Ein lokales Motiv ginge hier nicht ohne `site`.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mundpropaganda" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {bild && <meta property="og:image" content={bild} />}

    <meta name="twitter:card" content={bild ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {bild && <meta name="twitter:image" content={bild} />}

    <!-- Die beiden Schnitte, die above the fold sichtbar sind — sonst
         blitzt die Fallback-Schrift im Hero auf. -->
    <link rel="preload" href="/fonts/PPNeueMontreal-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GT-Pressura-Mono-Light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/svg/tooth-3d-mask.png" as="image" />
    <link rel="icon" href="/svg/logo-mark.svg" type="image/svg+xml" />

    <!-- Astros eigener Router. Ersetzt die selbstgebaute Navigation aus
         modules/transition.js: er tauscht nur den geänderten Teil des
         Dokuments aus, statt die Seite neu zu laden. -->
    <ClientRouter />

  </head>

  <body>
    <Icons />
    <Backdrop transition:persist />
    <Transition />
    <Nav transition:persist />

    <main><slot /></main>

    <Footer />

    <script>
      import { init } from "../js/init.js";
      import { gsap, ScrollTrigger } from "../js/lib/gsap.js";

      /* Bei einem Seitenwechsel tauscht der Router nur den Inhalt aus — die
         Module müssen danach erneut anlaufen, sonst sind Reveals, Kartendeck
         und der durchlaufende Pfad auf der neuen Seite tot.
         `astro:page-load` feuert beim ersten Aufruf und nach jedem Wechsel. */
      /* Der Router übernimmt beim Wechsel die Attribute des eingehenden
         <html>-Elements — und weil der Server die Klasse `js` nicht
         mitrendert, ist sie danach weg. Damit galt auf jeder über den Router
         erreichten Seite keine einzige Startregel: Reveals und Headlines
         standen sofort sichtbar da und sprangen erst zurück, wenn `init` sie
         übernahm.

         `astro:after-swap` läuft unmittelbar nach dem Austausch und noch vor
         dem ersten Bild der neuen Seite — früh genug, dass niemand die
         Endlage sieht. Der Listener hängt am document und wird deshalb nur
         einmal registriert, nicht bei jedem Wechsel neu. */
      document.addEventListener("astro:after-swap", () =>
        document.documentElement.classList.add("js")
      );

      document.addEventListener("astro:page-load", () => init());

      /* Vor dem Austausch aufräumen. Ohne das behalten die ScrollTrigger ihre
         Verweise auf Elemente, die es gleich nicht mehr gibt — sie messen dann
         gegen Leichen und stapeln sich bei jedem Wechsel weiter auf. */
      document.addEventListener("astro:before-swap", () => {
        ScrollTrigger.getAll().forEach((t) => t.kill());
        gsap.globalTimeline.clear();
      });
    </script>

    <style>
      /* Der Inhalt liegt über den Hintergrundebenen. Die Navigation bleibt
         außen vor — sie trägt bereits --z-nav; ein zweiter Wert hier hätte
         sie auf dieselbe Ebene wie den Inhalt gesetzt, der im DOM später
         kommt und sie damit überdeckt.
         Den Gegenwert für den Footer setzt Footer.astro selbst. */
      main {
        position: relative;
        z-index: 1;
      }
    </style>
  </body>
</html>
